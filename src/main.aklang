; ak: the Ak compiler, written in Ak. Compiles Ak source to a native x86-64 Linux executable (no libc, no linker).
;   ak file.aklang [args]      compile and run        ak build file.aklang out   write an executable
;   ak -e 'code'           run a snippet           ak check file.aklang       parse + resolve only
(use "parse.aklang")
(use "lower.aklang")
(use "gen.aklang")
(use "fmt.aklang")
PRELUDE=(++ (embed "../rt/core.aklang") "\n" (embed "../rt/data.aklang") "\n" (embed "../rt/map.aklang") "\n" (embed "../rt/num.aklang") "\n" (embed "../rt/show.aklang") "\n" (embed "../rt/io.aklang") "\n" (embed "../rt/net.aklang") "\n" (embed "../rt/term.aklang") "\n" (embed "../rt/math.aklang") "\n" (embed "../rt/regex.aklang") "\n" (embed "../rt/big.aklang") "\n" (embed "../rt/json.aklang") "\n" (embed "../rt/typed.aklang") "\n" (embed "../rt/gc.aklang") "\n" (embed "../rt/prof.aklang"))
VERSION="0.6.0"

; ---- tree shaking: keep only the runtime functions the program can reach (by name)
ROOTS=["at" "dot" "put" "setdot" "dotc" "setdotc" "slice" "apply" "concat" "isnum" "iter" "push1" "lpush" "cat2" "len" "list" "map" "sym" "toarr" "fatal" "finish" "gc" "chars_init" "bigfrom"
       "add2" "sub2" "mul2" "div2" "lt2" "gt2" "le2" "ge2" "eq2" "ne2" "mod2" "fdiv2" "pow2" "band2" "bor2" "bxor2" "shl2" "shr2" "ushr2" "neg1" "bnot1" "max2" "min2" "append1" "map1" "p1" "maplit"]
(= (collect x out) (? (is "sym" x) out[($ x)]=true (is "list" x) (for y x (collect y out))))
(= (fdef x)
  (? (&& (is "list" x) #x>=3 (is "sym" x[0]) (== ($ x[0]) "=") (is "list" x[1]) #x[1]>0 (is "sym" x[1][0]) (! (starts ($ x[1][0]) "%")))
     ($ x[1][0])))
(= (shake pre user)
  need={} (for r ROOTS need[r]=true) (for u user (collect u need))
  defs=[] (for f pre n=(fdef f) (? n (push defs [n f]) (collect f need)))
  incl={} changed=true
  (wh changed changed=false
    (for [n f] defs (? (&& need[n] (! incl[n])) (: incl[n]=true (collect f need) changed=true))))
  (~? f=>(|| (! (fdef f)) incl[(fdef f)]) pre))

(= (tm what) (? (env "AK_TIME") (ep what (clock))))
IMAGE=nil                       ; a prebuilt runtime image (see gen_image), baked into the compiler by `ak build --image`
(= (front src file img=nil)   ; full path: parse + shake + lower the runtime together with the program (img: bake it in as IMAGE)
  (tm "start")
  pre=(parse PRELUDE "rt/core.aklang")
  (tm "parsed prelude")
  user=(~ y=>(expand y (dirname file) {}) (parse src file))
  (tm "parsed user")
  (? img (: user=(bake user img) L.statics=[img]))
  pre=(shake pre user)
  main=(lower_program pre user file)
  (tm "lowered")
  main)
(= (build_image)
  (reset_lower)
  main=(lower_program (parse PRELUDE "rt/core.aklang") [] "rt/core.aklang")
  (gen_image main))
(= (get_image)               ; AK_NOIMAGE=1 forces the slow path (runtime lowered together with the program)
  (? (env "AK_NOIMAGE") nil
     (!= IMAGE nil) IMAGE
     (env "AK_IMGTEST") (: (<- IMAGE (build_image)) IMAGE)))
(= (bake forms img)           ; `IMAGE=...` at top level of the program becomes the baked image
  (~ f=>(? (&& (is "list" f) #f==3 (is "sym" f[0]) (== ($ f[0]) "=") (is "sym" f[1]) (== ($ f[1]) "IMAGE")) [f[0] f[1] [(S "%static") 0]] f) forms))
SRCS={}                       ; source text by name, so a compile error can show its line
(= (compile_src src file bake=false)
  (<- SRCS[file] src)
  img=(? bake (build_image) (get_image))
  (reset_lower)
  (? (&& img (! bake))
     (: user=(~ y=>(expand y (dirname file) {}) (parse src file))
        (tm "parsed")
        main=(lower_user img user file)
        (tm "lowered")
        bytes=(gen_user main img)
        (tm "generated") bytes)
     (: bytes=(gen_program (front src file (? bake img))) (tm "generated") bytes)))

USAGE="usage: ak file.aklang [args] | ak - (program on stdin) | ak build file.aklang out | ak -e 'code' | ak check file.aklang | ak fmt file.aklang | ak test [paths] | ak --version | ak --help"
(= (usage) (ep USAGE) (exit 2))
;---- ak test: run *.test.aklang files (or the given files/directories), each in its own process; a test passes when it exits 0
(= (shq s) (++ "'" (rep s "'" "'\\''") "'"))
(= (istest f) (|| (ends f ".test.aklang") (ends f ".test.ak")))
(= (findtests p out)         ; a directory is searched recursively for *.test.aklang; a file is taken as given
  (? (isdir p) (for f (ls p) (? (&& (! (starts f ".")) f!="node_modules") (findtests (? p=="." f (++ p "/" f)) out)))
     (? (ex p) (? (istest p) (push out p)) (err "no such file or directory:" p))))
(= (runtest exe f)
  r=(split (sh (++ shq(exe) " " shq(f) " </dev/null 2>&1; printf '\\n@@%s\\n' $?")) "@@")
  code=(num (trim r[#r-1]))
  [code (trim (join r[0..#r-1] "@@"))])
(= (cmd_test a)
  files=[] (for p (? #a a ["."]) (? (&& (ex p) (! (isdir p))) (push files p) (findtests p files)))
  (? #files==0 (: (ep "ak test: no test files found (*.test.aklang)") (exit 1)))
  exe=(selfexe) pass=0 fail=0
  (for f (sort files)
    [code out]=(runtest exe f)
    (? code==0 (: pass+=1 (p (++ "PASS " f)))
       (: fail+=1 (p (++ "FAIL " f " (exit " ($ code) ")")) (? out (p (++ "  " (rep out "\n" "\n  ")))))))
  (p (++ ($ pass) " passed, " ($ fail) " failed, " ($ pass+fail) " files"))
  (? fail>0 (exit 1)))
(= (srcname f) (? f=="-" "<stdin>" f))      ; `-` means the program is read from stdin
(= (rdsrc f) (? f=="-" (inall) (rd f)))
(= (withline e)               ; "f:L:C: msg" -> the same plus the source line and a caret under column C
  m=(match "^(.+?):(\\d+):(\\d+): " e)
  src=(? m (?? SRCS[m[1]] (? (ex m[1]) (rd m[1]))))
  ls=(? src (split src "\n"))
  l=(? ls (num m[2]))
  (? (&& ls l>=1 l<=#ls (> #(rep ls[l-1] "\r" "") 0)) (++ e "\n  " (rep ls[l-1] "\r" "") "\n  " (rpt " " (num m[3])-1) "^") e))
(= (cli) a=(args)
  (? #a==0 (usage)
     (sw a[0]
       ["-v" "--version" "version"] (p (++ "ak " VERSION))
       ["-h" "--help" "help"] (p USAGE)
       "-e" (? #a<2 (usage) (runx (compile_src a[1] "<-e>") a[2..]))
       ["build" "exe"] (? (&& #a==4 a[1]=="--image") (wrx a[3] (compile_src (rd a[2]) a[2] true))
                          #a!=3 (usage)
                          (wrx a[2] (compile_src (rd a[1]) a[1])))
       "check" (? #a!=2 (usage) (: (front (rdsrc a[1]) (srcname a[1])) (p "ok")))
       "fmt" (? #a!=2 (usage) (pr (fmtforms (parse (rdsrc a[1]) (srcname a[1])))))
       "test" (cmd_test a[1..])
       "run" (? #a<2 (usage) (runx (compile_src (rd a[1]) a[1]) a[2..]))
       "compile" (? #a!=3 (usage) (wrx a[2] (compile_src (rd a[1]) a[1])))
       (runx (compile_src (rdsrc a[0]) (srcname a[0])) a[1..]))))
(? (env "AK_DEBUG") (cli) (try (cli) e=>(: (ep (++ "error: " (withline e))) (exit 1))))
