; ak native compiler driver: ak compile in.ak out
(use "parse.ak")
(use "lower.ak")
(use "gen.ak")
PRELUDE=(embed "../rt/core.ak")
(= (compile_file infile outfile)
  pre=(parse PRELUDE "rt/core.ak")
  user=(~ y=>(expand y (dirname infile) {}) (parse (rd infile) infile))
  main=(lower_program pre user infile)
  (wrx outfile (gen_program main)))
(= (cli) a=(args)
  (? (&& #a==3 a[0]=="compile") (compile_file a[1] a[2])
     (: (ep "usage: native compile in.ak out") (exit 2))))
(? (env "AK_DEBUG") (cli) (try (cli) e=>(: (ep (++ "error: " e)) (exit 1))))
