; Core IR -> x86-64. Conventions:
;   value = NaN-boxed 64-bit word: doubles raw; nil=0xFFF9<<48, false=nil+1, true=nil+2, undef=nil+3; heap pointer = 0xFFFA<<48 | addr
;   r11 = nil constant (0xFFF9<<48), r10 = pointer tag (0xFFFA<<48), r13 = heap bump pointer, r14 = frame base, r15 = value-stack pointer
;   machine stack holds only return addresses / saved r14 / exception records; all Ak values live on the value stack (precise GC roots)
;   frame (value stack): [closure, arg1..argP, (rest), locals..., temporaries...]; slot i at [r14 + 8*i]
;   call: push closure, push args, rcx = nargs, call callclosure; callee pops its whole frame (r15 = r14) and returns rax
; heap object header (8 bytes): low byte = type, upper 32 bits = length.
(use "x86.aklang")
HEAD_ADDR=0x10000000
HLIM_ADDR=0x10000008
ARGV_ADDR=0x10000010
GBASE=0x30000000
T_STR=1 T_LIST=2 T_ARR=3 T_MAP=4 T_CLOSURE=5 T_BOX=6 T_SYM=7 T_BYTES=8
HEAP_SIZE=17179869184
GC_FIRST=8388608
G={:postab [] :curpos nil :fn nil :lbl 0 :data [] :dfix [] :strs {} :nglob 0 :stubs {} :dbase 0 :img nil :cons {} :cold []}

TRACE_ADDR=268435480
TRACE_BASE=268435488
(= (a s) (asm s))
(= (gen_poll) skip=(nl) (a "cmp r13, [268435496]") (a (++ "jb " skip)) (a "call .gc") (label skip))
(= (trace_push f) (a "mov rax, [268435480]") (af "mov rdx, %d" f.id) (a "mov [rax], rdx") (a "add rax, 8") (a "mov [268435480], rax"))
(= (trace_pop) (a "mov rcx, [268435480]") (a "sub rcx, 8") (a "mov [268435480], rcx"))
(= (af f ..xs) (asm (fmt f ..xs)))
(= (nl) G.lbl+=1 (++ ".L" G.lbl))
(= (untag r) (af "xor %s, r10" r))                       ; heap pointer -> address (the tag is exactly r10)
(= (push_rax) (a "mov [r15], rax") (a "add r15, 8"))
(= (popr r) (a "sub r15, 8") (af "mov %s, [r15]" r))
(= (gaddr gid) GBASE+8*gid)
(= (boxed v) (&& v.kind=="local" v.captured v.set))

; ---- static data (strings, closures); addresses are absolute (non-PIE image)
(= (dpos) G.dbase+#G.data)
(= (dbyte b) (push G.data b&255))
(= (dalign) (wh (dpos)%8!=0 (dbyte 0)))
(= (dword lo hi) (for i 4 (dbyte lo>>(8*i))) (for i 4 (dbyte hi>>(8*i))))
(= (strobj s)
  (? G.strs[s]!=nil G.strs[s]
     (&& G.img G.img.strs[s]!=nil) G.img.strs[s]
     (: (dalign) addr=0x10000000+(dpos) bs=(bytes s)
        (dword T_STR #bs) (for b bs (dbyte b)) (dbyte 0) (dalign)
        G.strs[s]=addr addr)))
(= (staticclo f)
  (? f.static!=nil f.static
     (: (dalign) addr=0x10000000+(dpos)
        (dword T_CLOSURE 0) (push G.dfix [(dpos) (++ ".f" f.id)]) (dword 0 0)
        f.static=addr addr)))
(= (ptrconst r addr) (mov_imm64 r 0xFFFA0000 addr))
(= (numconst r x) [hi lo]=(f64bits x) (mov_imm64 r hi lo))

; ---- variable access
(= (freeidx v) i=G.fn.freeidx[v.id] (? i==nil (err (++ "internal: " v.name " is not captured by " G.fn.name))) i)
(= (load_var v)       ; value of variable -> rax
  (? v.kind=="global" (af "mov rax, [%d]" (gaddr v.gid))
     v.fn.id==G.fn.id (: (af "mov rax, [r14+%d]" 8*v.slot) (? (boxed v) (: (untag "rax") (a "mov rax, [rax+8]"))))
     (: (a "mov rax, [r14]") (untag "rax") (af "mov rax, [rax+%d]" 16+8*(freeidx v)) (? (boxed v) (: (untag "rax") (a "mov rax, [rax+8]"))))))
(= (load_cap v r)     ; what a closure captures for v: the box pointer if boxed, else the value
  (? v.fn.id==G.fn.id (af "mov %s, [r14+%d]" r 8*v.slot)
     (: (af "mov %s, [r14]" r) (untag r) (af "mov %s, [%s+%d]" r r 16+8*(freeidx v)))))
(= (store_var v)      ; rax -> variable (rax preserved)
  (? v.kind=="global" (af "mov [%d], rax" (gaddr v.gid))
     (boxed v) (: (? v.fn.id==G.fn.id (af "mov rcx, [r14+%d]" 8*v.slot)
                     (: (a "mov rcx, [r14]") (untag "rcx") (af "mov rcx, [rcx+%d]" 16+8*(freeidx v))))
                  (untag "rcx") (a "mov [rcx+8], rax"))
     v.fn.id==G.fn.id (af "mov [r14+%d], rax" 8*v.slot)
     (err (++ "internal: assignment to captured unboxed variable " v.name))))

; ---- allocation (bump). result: raw address in rax. clobbers nothing else.
(= (alloc_const nbytes) (a "mov rax, r13") (af "add r13, %d" nbytes) (a "cmp r13, [268435464]") (a "ja .oom"))
(= (alloc_reg r)        (a "mov rax, r13") (af "add r13, %s" r) (a "cmp r13, [268435464]") (a "ja .oom"))

; ---- expression codegen: result in rax
(= (recpos) (? G.curpos (push G.postab [(here) G.curpos])))
(= (gen x) (sw x[0]
  "nil" (a "mov rax, r11")
  "true" (a "lea rax, [r11+2]")
  "false" (a "lea rax, [r11+1]")
  "num" (numconst 0 x[1])
  "str" (ptrconst 0 (strobj x[1]))
  "ref" (load_var x[1])
  "set" (: (gen x[2]) (store_var x[1]))
  "init" (gen_init x)
  "seq" (for e x[1..] (gen e))
  "if" (gen_if x)
  "and" (gen_andor x true)
  "or" (gen_andor x false)
  "nilor" (gen_nilor x)
  "not" (: (gen x[1]) (a "call .truthy") (a "lea rax, [r11+2]") (a "lea rcx, [r11+1]") (a "test rdx, rdx") (a "cmovnz rax, rcx"))
  "while" (gen_while x)
  "call" (: old=G.curpos G.curpos=x[3] (gen_call x false) G.curpos=old)
  "tcall" (: old=G.curpos G.curpos=x[3] (gen_call x true) G.curpos=old)
  "fn" (gen_closure x[1])
  "prim" (: old=G.curpos G.curpos=x[3] (gen_prim x[1] x[2]) G.curpos=old)
  "static" (af "mov rax, [%d]" 268435600+8*x[1])
  "initcall" (: (a "mov [r15], r11") (a "add r15, 8") (a "mov rcx, 0") (a (++ "call .f" x[1])))
  "try" (gen_try x)
  (err (++ "internal: unknown IR node " x[0]))))

(= (gen_init x) v=x[1]
  (? (boxed v)
     (: (alloc_const 16) (mov_imm64 1 1 T_BOX) (a "mov [rax], rcx") (a "mov [rax+8], r11") (a "or rax, r10")
        (af "mov [r14+%d], rax" 8*v.slot)
        (gen x[2])
        (af "mov rcx, [r14+%d]" 8*v.slot) (untag "rcx") (a "mov [rcx+8], rax"))
     (: (gen x[2]) (af "mov [r14+%d], rax" 8*v.slot))))

(= (gen_if x) lelse=(nl) lend=(nl)
  (genjump x[1] lelse false)
  (gen x[2]) (a (++ "jmp " lend))
  (label lelse) (gen x[3]) (label lend))

(= (gen_andor x isand) lend=(nl)
  (gen x[1]) (a "call .truthy") (a "test rdx, rdx")
  (a (++ (? isand "jz " "jnz ") lend))
  (gen x[2]) (label lend))
(= (gen_nilor x) lend=(nl)
  (gen x[1]) (a "cmp rax, r11") (a (++ "jne " lend)) (gen x[2]) (label lend))

(= (gen_while x) ltop=(nl) lcond=(nl)         ; condition at the bottom: one jump per iteration
  (a (++ "jmp " lcond)) (label ltop) (gen x[2]) (label lcond) (gen_poll) (genjump x[1] ltop true) (a "mov rax, r11"))

; jump to L when condition is `when` (true/false); otherwise fall through
(= (genjump c lbl when)
  (sw c[0]
    "not" (genjump c[1] lbl !when)
    "true" (? when (a (++ "jmp " lbl)))
    "false" (? !when (a (++ "jmp " lbl)))
    "nil" (? !when (a (++ "jmp " lbl)))
    "and" (? !when (: (genjump c[1] lbl false) (genjump c[2] lbl false))
                   (: skip=(nl) (genjump c[1] skip false) (genjump c[2] lbl true) (label skip)))
    "or" (? when (: (genjump c[1] lbl true) (genjump c[2] lbl true))
                 (: skip=(nl) (genjump c[1] skip true) (genjump c[2] lbl false) (label skip)))
    "prim" (: old=G.curpos G.curpos=(? c[3] c[3] old)          ; errors raised by a condition report the condition's own position
              (? (has ["<" ">" "<=" ">=" "==" "!="] c[1]) (gen_cmpjump c[1] c[2] lbl when)
                 (has PREDPRIMS c[1]) (gen_predjump c[1] c[2] lbl when)
                 c[1]=="isundef" (: (gen c[2][0]) (a "lea rcx, [r11+3]") (a "cmp rax, rcx") (a (++ (? when "je " "jne ") lbl)))
                 c[1]=="!" (genjump c[2][0] lbl !when)
                 (gen_truthjump c lbl when))
              G.curpos=old)
    (gen_truthjump c lbl when)))
; ---- type predicates compiled to compare+jump
TYPEPREDS={"$islist" 2 "$isstr" 1 "$ismap" 4 "$issym" 7 "$isfn" 5}
PREDPRIMS=["$islist" "$isstr" "$ismap" "$issym" "$isfn" "$isnum" "$isnil" "$isptr" "$eqp" "$streq"]
(= (typecheck_jump t lbl when)       ; value in rax; jump to lbl when (is type t) == when
  skip=(nl)
  (a "cmp rax, r10") (? when (a (++ "jb " skip)) (a (++ "jb " lbl)))
  (a "mov rcx, rax") (untag "rcx") (af "cmp byte ptr [rcx], %d" t)
  (a (++ (? when "je " "jne ") lbl))
  (? when (label skip)))
(= (gen_predjump op args lbl when)
  d=(leafdesc args[0])
  (? TYPEPREDS[op] (: (gen args[0]) (typecheck_jump TYPEPREDS[op] lbl when))
     (== op "$isnum") (: (? (&& d d[0]=="m") (af "cmp qword ptr %s, r11" d[1]) (: (gen args[0]) (a "cmp rax, r11"))) (a (++ (? when "jb " "jae ") lbl)))
     (== op "$isnil") (: (? (&& d d[0]=="m") (af "cmp qword ptr %s, r11" d[1]) (: (gen args[0]) (a "cmp rax, r11"))) (a (++ (? when "je " "jne ") lbl)))
     (== op "$isptr") (: (gen args[0]) (a "cmp rax, r10") (a (++ (? when "jae " "jb ") lbl)))
     (== op "$streq") (: [L R]=(operands args[0] args[1]) (ldd L 1) (ldd R 0) (a "call .streqany") (a "test rdx, rdx") (a (++ (? when "jnz " "jz ") lbl)))
     (: [L R]=(operands args[0] args[1])
        (ldd L 1)
        (? (== R[0] "m") (af "cmp rcx, %s" R[1]) (: (ldd R 0) (a "cmp rcx, rax")))
        (a (++ (? when "je " "jne ") lbl)))))
(= (pred_value op args)
  lt=(nl) ld=(nl)
  (gen_predjump op args lt true)
  (a "lea rax, [r11+1]") (a (++ "jmp " ld)) (label lt) (a "lea rax, [r11+2]") (label ld))
(= (gen_truthjump c lbl when) (gen c) (a "call .truthy") (a "test rdx, rdx") (a (++ (? when "jnz " "jz ") lbl)))

; ---- calls
; a global bound exactly once, to a closed top-level function, is called directly (no closure dispatch)
(= (walk_ir x)
  (? (&& (is "list" x) #x>0)
     (? (is "str" x[0])
        (: (? (&& (|| x[0]=="set" x[0]=="init") (is "map" x[1]) x[1].kind=="global" (! (&& G.img x[1].pre)))
              (: v=x[1] v.nsets=(+ (?? v.nsets 0) 1) (? (&& x[0]=="set" (is "list" x[2]) x[2][0]=="fn") v.defn=x[2][1])))
           (for y x[1..] (walk_ir y)))
        (for y x (walk_ir y)))))
(= (direct_target f)
  (? (&& f[0]=="ref" f[1].kind=="global" (== f[1].nsets 1) f[1].defn (== #f[1].defn.free 0)) f[1].defn))
(= (gen_call x tail) f=x[1] args=x[2] n=#args d=(direct_target f)
  fast=(&& d d.nparams==n (! d.rest))           ; exactly the declared number of arguments: enter at the direct entry (no count check / adjust)
  pend=0                                        ; slots written above r15 but not yet counted in r15
  (? d (: (a "mov [r15], r11") pend=1)           ; callee frame = [closure, args..]; a closed top-level function never reads its closure slot
       (: (gen f) (push_rax)))
  (for e args
    k=(leafdesc e)
    (? k (: (ldd k 0) (af "mov [r15+%d], rax" 8*pend) pend+=1)
         (: (? pend>0 (: (af "add r15, %d" 8*pend) pend=0)) (gen e) (push_rax))))
  (? pend>0 (af "add r15, %d" 8*pend))
  (? tail
     (: (for i n+1 (af "mov rax, [r15-%d]" 8*(n+1-i)) (af "mov [r14+%d], rax" 8*i))
        (af "lea r15, [r14+%d]" 8*(n+1))
        (a "pop r14") (? G.trace (trace_pop))
        (? fast (a (++ "jmp .d" d.id))
            d (: (af "mov rcx, %d" n) (a (++ "jmp .f" d.id)))
            (: (af "mov rdx, [r15-%d]" 8*(n+1)) (af "mov rcx, %d" n) (a "jmp .callrdx"))))
     (? fast (: (a (++ "call .d" d.id)) (recpos))
         d (: (af "mov rcx, %d" n) (a (++ "call .f" d.id)) (recpos))
         (: (af "mov rdx, [r15-%d]" 8*(n+1)) (af "mov rcx, %d" n) (a "call .callrdx") (recpos)))))

; ---- closures
(= (gen_closure f) k=#f.free
  (? k==0 (ptrconst 0 (staticclo f))
     (: (alloc_const 16+8*k)
        (mov_imm64 1 k T_CLOSURE) (a "mov [rax], rcx")
        (lea_l 1 (++ ".f" f.id)) (a "mov [rax+8], rcx")
        (for [i v] (enum f.free) (load_cap v "rcx") (af "mov [rax+%d], rcx" 16+8*i))
        (a "or rax, r10"))))

; ---- exceptions: record on the machine stack = [r15, r14, handler, prev]; HEAD points at it
(= (gen_try x) body=x[1] v=x[2] handler=x[3] lh=(nl) lend=(nl)
  (? G.trace (: (a "mov rax, [268435480]") (a "push rax")))
  (a "mov rax, [268435456]") (a "push rax")
  (lea_l 0 lh) (a "push rax") (a "push r14") (a "push r15")
  (a "mov [268435456], rsp")
  (gen body)
  (a "add rsp, 24") (a "pop rcx") (a "mov [268435456], rcx")
  (? G.trace (a "add rsp, 8"))
  (a (++ "jmp " lend))
  (label lh)
  (a "pop r15") (a "pop r14") (a "add rsp, 8") (a "pop rcx") (a "mov [268435456], rcx")
  (? G.trace (: (a "pop rcx") (a "mov [268435480], rcx")))
  (af "mov [r14+%d], rax" 8*v.slot)
  (? (boxed v) (: (alloc_const 16) (mov_imm64 1 1 T_BOX) (a "mov [rax], rcx") (af "mov rcx, [r14+%d]" 8*v.slot) (a "mov [rax+8], rcx") (a "or rax, r10") (af "mov [r14+%d], rax" 8*v.slot)))
  (gen handler)
  (label lend))

; ---- primitives
(= (slow2 name) (a (++ "call .slow_" name)) (recpos))          ; operands [a, b] on the value stack -> prelude function name -> rax
(= (binop_slow x y name)       ; both operands on the value stack, no fast path
  (gen x) (push_rax) (gen y) (push_rax) (slow2 name))

; ---- cold code: slow paths are emitted after the function body, so the hot paths fall through without jumping over them
(= (cold f) (push G.cold [G.curpos f]))
(= (flush_cold) (for [pos f] G.cold G.curpos=pos (f)) G.cold=[])
; ---- 8-byte constants in the data segment (deduplicated per compile): absolute address, usable as [disp32]
(= (dconst64 lo hi) k=(++ lo "," hi) ad=G.cons[k]
  (? ad ad (: (dalign) ad=0x10000000+(dpos) (dword lo hi) G.cons[k]=ad ad)))
(= (dconst x) [hi lo]=(f64bits x) (dconst64 lo hi))

; ---- operands.  A descriptor says where a value is: ["r" n] register n, ["m" "[..]"] a memory operand, ["n" x] a number constant.
; A leaf (number constant, plain variable) needs no code: binary operators use it in place instead of pushing it on the value stack.
PUREPRIMS=["+" "-" "*" "/" "%" "//" "**" "<" ">" "<=" ">=" "==" "!=" "!" "&" "|" "^" "<<" ">>" ">>>" "bnot" "#" "@" "num" "dotc"]
NUMPRIMS=["+" "-" "*" "/" "%" "//" "**" "&" "|" "^" "<<" ">>" ">>>"]
(= (memtext v)                  ; operand text of a variable read by one plain load (global, or unboxed local of this function), else nil
  (? v.kind=="global" (fmt "[%d]" (gaddr v.gid))
     (&& v.kind=="local" v.fn.id==G.fn.id (! (boxed v))) (fmt "[r14+%d]" 8*v.slot)))
(= (leafdesc x)
  (? x[0]=="num" ["n" x[1]]
     (&& x[0]=="ref" (memtext x[1])) ["m" (memtext x[1])]))
(= (pure x)                     ; evaluating x changes no variable (so a variable read may be moved after it)
  (sw x[0]
    ["nil" "true" "false" "num" "str" "ref"] true
    "prim" (&& (has PUREPRIMS x[1]) (all pure x[2]))
    "not" (pure x[1])
    ["and" "or" "nilor"] (&& (pure x[1]) (pure x[2]))
    "if" (&& (pure x[1]) (pure x[2]) (pure x[3]))
    false))
NUMINTRIN=["#" "num" "$ldb" "$type" "$hlen" "$bitshi" "$bitslo" "$ld16" "$toint" "$band" "$bor" "$bxor" "$shl" "$shr" "$ushr" "$addr" "$peek"]
(= (isnumir x)                  ; x always yields a double (or throws)
  (|| x[0]=="num" (&& x[0]=="ref" x[1].isnum) (&& x[0]=="prim" (has NUMINTRIN x[1]))
      (&& x[0]=="prim" (has NUMPRIMS x[1]) (all isnumir x[2]))))
(= (boundok op b1 b2)           ; bounds known and the result cannot leave 2^53
  (&& b1!=nil b2!=nil (? (== op "*") (&& b1<=67108864 b2<=67108864) (&& b1<=4503599627370496 b2<=4503599627370496))))
(= (bound x)                    ; |value of x| <= bound, or nil when unknown (lets + - * skip the 2^53 overflow test)
  (? x[0]=="num" (abs x[1])
     x[0]=="prim"
       (: op=x[1] args=x[2]
          (? (has ["$hlen" "$bitshi" "$bitslo" "$ushr" "#"] op) 4294967296
             (has ["$ldb" "$type" "$ld16"] op) 65536
             (&& (== op "$band") (immk args[1])!=nil (>= (immk args[1]) 0)) 1+(immk args[1])
             (&& (has ["+" "-" "*"] op) #args==2)
               (: b1=(bound args[0]) b2=(bound args[1])
                  (? (boundok op b1 b2) (? (== op "*") (* b1 b2) (+ b1 b2))))))))
(= (operands x y)               ; evaluate x then y -> [L R]; R is rax or a leaf; L is rax (x), rcx (x, popped) or a leaf
  kx=(leafdesc x) ky=(leafdesc y)
  (? ky [(? kx kx (: (gen x) ["r" 0])) ky]
     (&& kx (pure y)) (: (gen y) [kx ["r" 0]])
     (: (gen x) (push_rax) (gen y) (a "mov rcx, [r15-8]") (a "sub r15, 8") [["r" 1] ["r" 0]])))
(= (chkd d slow)                ; jump to slow unless the value is a double
  (sw d[0] "r" (: (af "cmp %s, r11" REG64[d[1]]) (a (++ "jae " slow)))
           "m" (: (af "cmp qword ptr %s, r11" d[1]) (a (++ "jae " slow)))
           nil))
(= (ldd d r)                    ; descriptor -> general register number r
  (sw d[0] "r" (? d[1]!=r (af "mov %s, %s" REG64[r] REG64[d[1]]))
           "m" (af "mov %s, %s" REG64[r] d[1])
           (numconst r d[1])))
(= (ldx d n)                    ; descriptor -> xmm n
  (sw d[0] "r" (af "movq xmm%d, %s" n REG64[d[1]])
           "m" (: (af "mov rdx, %s" d[1]) (af "movq xmm%d, rdx" n))      ; (a movsd load straight after a GPR store of the variable is ~25% slower than load + movq)
           (af "movsd xmm%d, [%d]" n (dconst d[1]))))
(= (srcx d n)                   ; descriptor as the source operand of an SSE instruction (loads xmm n first when it is a register)
  (sw d[0] "r" (: (af "movq xmm%d, %s" n REG64[d[1]]) (fmt "xmm%d" n))
           "m" d[1]
           (fmt "[%d]" (dconst d[1]))))
(= (push_ops l r)               ; slow paths: both operands to [r15] [r15+8] and r15+=16 (left first, so rax is free for the right one)
  (sw l[0] "r" (af "mov [r15], %s" REG64[l[1]])
           "m" (: (af "mov rcx, %s" l[1]) (a "mov [r15], rcx"))
           (: (numconst 1 l[1]) (a "mov [r15], rcx")))
  (sw r[0] "r" nil
           "m" (af "mov rax, %s" r[1])
           (numconst 0 r[1]))
  (a "mov [r15+8], rax") (a "add r15, 16"))

;---- argument evaluation for intrinsics: evaluate args left to right; arg k ends up in register specs[k][0], converted as specs[k][1]:
; "raw" the value, "int" truncated to an int64, "ptr" the untagged address. Plain variables and constants are read late, straight from their home
; (no value-stack traffic) when the arguments after them are side-effect free. rax may only be the target of the last argument.
(= (conv_from d spec)
  r=spec[0] c=spec[1]
  (sw c
    "raw" (ldd d r)
    "ptr" (: (ldd d r) (untag REG64[r]))
    (sw d[0] "n" (af "mov %s, %d" REG64[r] (int d[1]))
             "m" (af "cvttsd2si %s, qword ptr %s" REG64[r] d[1])
             (: (af "movq xmm0, %s" REG64[d[1]]) (af "cvttsd2si %s, xmm0" REG64[r])))))
(= (gen_regs args specs)
  n=#args late=[] last=-1 np=0 pushed=[]
  (for k n (push late (&& (leafdesc args[k]) (all pure args[k+1..]))))
  (for k n (? !late[k] last=k))
  (for k n (? !late[k] (: (gen args[k]) (? k!=last (: (push_rax) (push pushed k) np+=1)))))
  (? last>=0 (conv_from ["r" 0] specs[last]))
  (for [j k] (enum pushed) (conv_from ["m" (fmt "[r15-%d]" 8*(np-j))] specs[k]))
  (for k n (? late[k] (conv_from (leafdesc args[k]) specs[k])))
  (? np>0 (af "sub r15, %d" 8*np)))

(= (gen_arith op args)         ; + - * /  folded left; fast path for two doubles
  n=#args
  (? n==1 (gen_neg args[0])
     n==2 (gen_arith2 op args[0] args[1])
     (: acc=args[0]
        (for e args[1..] acc=["prim" op [acc e] G.curpos])
        (gen acc))))
(= (gen_arith2 op x y)
  [L R]=(operands x y)
  slow=(nl) done=(nl) isdiv=(== op "/")
  (? !(isnumir x) (chkd L slow))
  (? !(isnumir y) (chkd R slow))
  (ldx L 0)
  src=(? (&& isdiv (|| (!= R[0] "n") R[1]==0))
         (: (ldx R 1) (a "xorpd xmm2, xmm2") (a "ucomisd xmm1, xmm2") (a (++ "je " slow)) "xmm1")
         (srcx R 1))
  (sw op "+" (af "addsd xmm0, %s" src) "-" (af "subsd xmm0, %s" src) "*" (af "mulsd xmm0, %s" src) (af "divsd xmm0, %s" src))
  b1=(bound x) b2=(bound y)
  (? (&& !isdiv (! (boundok op b1 b2)))
     (: (a "movq rdx, xmm0") (a "add rdx, rdx") (af "cmp rdx, [%d]" (dconst64 0 0x86800000)) (a (++ "ja " slow))))     ; |result| > 2^53: runtime decides
  (a "movq rax, xmm0")
  (label done)
  (cold (\ () (label slow) (push_ops L R) (slow2 ({"+" "add2" "-" "sub2" "*" "mul2" "/" "div2"}[op])) (a (++ "jmp " done)))))
(= (gen_neg e) slow=(nl) done=(nl)
  (gen e) (a "cmp rax, r11") (a (++ "jae " slow))
  (mov_imm64 1 0x80000000 0) (a "xor rax, rcx")
  (label done)
  (cold (\ () (label slow) (push_rax) (a "call .slow1_neg1") (recpos) (a (++ "jmp " done)))))

(= (eqconst args) ; for == / != with a nil/true/false/string constant on either side: [other const]
  (? (has ["str" "nil" "true" "false"] args[1][0]) [args[0] args[1]]
     (has ["str" "nil" "true" "false"] args[0][0]) [args[1] args[0]]))
(= (gen_eqconst c other k)     ; sets rdx=1 when equal; clobbers rax rcx rsi rdi r8 r9
  (gen other)
  (sw k[0]
    "nil" (: (a "xor rdx, rdx") (a "cmp rax, r11") (a "sete dl"))
    "true" (: (a "lea rcx, [r11+2]") (a "xor rdx, rdx") (a "cmp rax, rcx") (a "sete dl"))
    "false" (: (a "lea rcx, [r11+1]") (a "xor rdx, rdx") (a "cmp rax, rcx") (a "sete dl"))
    (: (ptrconst 1 (strobj k[1])) (a "call .streqany"))))
;---- inline indexing: lists, u8/f64 typed arrays and strings are handled without a call; everything else goes to the runtime
; rcx = container (tagged), rax = index. Failures before the container is untagged jump to `slow`, later ones to `slowx` (which retags it).
(= (gen_at x i)
  [L R]=(operands x i)
  slow=(nl) slowx=(nl) done=(nl) notlist=(nl) notarr=(nl) f64=(nl)
  kidx=(? (&& R[0]=="n" R[1]>=0 R[1]<2147483648 R[1]==(flr R[1])) R[1])
  (ldd L 1)
  (? kidx==nil (: (ldd R 0) (? !(isnumir i) (: (a "cmp rax, r11") (a (++ "jae " slow))))))
  (a "cmp rcx, r10") (a (++ "jb " slow))
  (a "xor rcx, r10")
  (a "movzx rsi, byte ptr [rcx]")
  (? kidx!=nil (af "mov rdi, %d" kidx)
     (: (a "movq xmm0, rax") (a "cvttsd2si rdi, xmm0") (a "cvtsi2sd xmm1, rdi") (a "ucomisd xmm1, xmm0") (a (++ "jne " slowx)) (a (++ "jp " slowx))))
  (a "cmp rsi, 2") (a (++ "jne " notlist))
  (a "cvttsd2si r8, [rcx+8]") (a "cmp rdi, r8") (a (++ "jae " slowx))
  (a "mov r9, [rcx+16]") (a "xor r9, r10") (a "mov rax, [r9+rdi*8+8]")
  (label done)
  (cold (\ ()
    (label notlist)
    (a "cmp rsi, 9") (a (++ "jne " notarr))
    (a "movzx r9, byte ptr [rcx+1]") (a "mov rsi, [rcx]") (a "shr rsi, 32")
    (a "cmp r9, 0") (a (++ "jne " f64))
    (a "cmp rdi, rsi") (a (++ "jae " slowx)) (a "movzx rax, byte ptr [rcx+rdi+8]") (a "cvtsi2sd xmm0, rax") (a "movq rax, xmm0") (a (++ "jmp " done))
    (label f64)
    (a "cmp r9, 7") (a (++ "jne " slowx)) (a "shr rsi, 3") (a "cmp rdi, rsi") (a (++ "jae " slowx)) (a "mov rax, [rcx+rdi*8+8]") (a (++ "jmp " done))
    (label notarr)
    (a "cmp rsi, 1") (a (++ "jne " slowx))
    (a "mov rsi, [rcx]") (a "shr rsi, 32") (a "cmp rdi, rsi") (a (++ "jae " slowx))
    (af "mov rdx, [%d]" (gaddr (prelude_gid "CHARS"))) (a "cmp rdx, r11") (a (++ "je " slowx))
    (a "movzx rax, byte ptr [rcx+rdi+8]") (a "xor rdx, r10") (a "mov rdx, [rdx+16]") (a "xor rdx, r10") (a "mov rax, [rdx+rax*8+8]") (a (++ "jmp " done))
    (label slowx) (a "xor rcx, r10")
    (label slow)                        ; rcx = container (tagged). A string or integer key of a map: the shared stub .atmap
    mgen=(nl)
    (? kidx!=nil (ldd R 0))
    (a "call .atmap") (a "test rdx, rdx") (a (++ "jz " mgen)) (a (++ "jmp " done))
    (label mgen) (push_ops ["r" 1] (? kidx!=nil R ["r" 0])) (slow2 "at") (a (++ "jmp " done)))))
(= (gen_put x i v)
  slow=(nl) slowx=(nl) done=(nl) notlist=(nl) f64=(nl)
  pv=(pure v) dx=(leafdesc x) di=(leafdesc i)
  latex=(&& dx pv (|| di (pure i)))                 ; plain-variable operands are read late when nothing evaluated after them can change them
  latei=(&& di pv)
  np=0
  (? !latex (: (gen x) (push_rax) np+=1))
  (? !latei (: (gen i) (push_rax) np+=1))
  (gen v)
  (? latex (ldd dx 1) (af "mov rcx, [r15-%d]" 8*np))
  (? latei (ldd di 2) (a "mov rdx, [r15-8]"))
  (? np>0 (af "sub r15, %d" 8*np))
  (? !(isnumir i) (: (a "cmp rdx, r11") (a (++ "jae " slow))))
  (a "cmp rcx, r10") (a (++ "jb " slow))
  (a "xor rcx, r10")
  (a "movzx rsi, byte ptr [rcx]")
  (a "movq xmm0, rdx") (a "cvttsd2si rdi, xmm0") (a "cvtsi2sd xmm1, rdi") (a "ucomisd xmm1, xmm0") (a (++ "jne " slowx)) (a (++ "jp " slowx))
  (a "cmp rsi, 2") (a (++ "jne " notlist))
  (a "cvttsd2si r8, [rcx+8]") (a "cmp rdi, r8") (a (++ "jae " slowx))
  (a "mov r9, [rcx+16]") (a "xor r9, r10") (a "mov [r9+rdi*8+8], rax")
  (label done)
  (cold (\ ()
    (label notlist)
    (a "cmp rsi, 9") (a (++ "jne " slowx))
    (a "cmp rax, r11") (a (++ "jae " slowx))
    (a "movzx r9, byte ptr [rcx+1]") (a "mov rsi, [rcx]") (a "shr rsi, 32")
    (a "cmp r9, 0") (a (++ "jne " f64))
    (a "cmp rdi, rsi") (a (++ "jae " slowx)) (a "movq xmm0, rax") (a "cvttsd2si r8, xmm0") (a "mov byte ptr [rcx+rdi+8], r8b") (a (++ "jmp " done))
    (label f64)
    (a "cmp r9, 7") (a (++ "jne " slowx)) (a "shr rsi, 3") (a "cmp rdi, rsi") (a (++ "jae " slowx)) (a "mov [rcx+rdi*8+8], rax") (a (++ "jmp " done))
    (label slowx) (a "xor rcx, r10")
    (label slow)                        ; rcx = container (tagged), rdx = key, rax = value. An existing string or integer key of a map is overwritten in place by the shared stub .putmap
    (a "call .putmap") (a "test rsi, rsi") (a (++ "jnz " done))
    (a "mov [r15], rcx") (a "mov [r15+8], rdx") (a "mov [r15+16], rax") (a "add r15, 24") (a "call .slow_put") (recpos) (a (++ "jmp " done)))))
(= (gen_len x)
  slow=(nl) done=(nl) cnt=(nl) str=(nl)
  (gen x) (a "cmp rax, r10") (a (++ "jb " slow))
  (a "mov rcx, rax") (a "xor rcx, r10") (a "movzx rsi, byte ptr [rcx]")
  (a "cmp rsi, 2") (a (++ "je " cnt)) (a "cmp rsi, 4") (a (++ "jne " str))
  (label cnt) (a "mov rax, [rcx+8]")
  (label done)
  (cold (\ ()
    (label str) (a "cmp rsi, 1") (a (++ "jne " slow))
    (a "mov rax, [rcx]") (a "shr rax, 32") (a "cvtsi2sd xmm0, rax") (a "movq rax, xmm0") (a (++ "jmp " done))
    (label slow) (push_rax) (a "call .slow1_len") (recpos) (a (++ "jmp " done)))))
;---- inline integer operators on doubles: % // & | ^ << >> >>> (anything unusual goes to the runtime)
(= (gen_intop op x y)
  [L R]=(operands x y)
  slow=(nl) done=(nl)
  k=(? R[0]=="n" R[1])
  kint=(&& k!=nil k==(flr k) -2147483648<=k<=2147483647)       ; constant int32 right operand: no checks, no load
  (? !(isnumir x) (chkd L slow))
  (? !(|| kint (isnumir y)) (chkd R slow))
  (ldx L 0) (a "cvttsd2si rsi, xmm0")
  (? kint (af "mov rdi, %d" k) (: (ldx R 1) (a "cvttsd2si rdi, xmm1")))
  (sw op
    ["&" "|" "^"] (: (a (++ ({"&" "and" "|" "or" "^" "xor"}[op]) " rsi, rdi")) (a "shl rsi, 32") (a "sar rsi, 32"))
    "<<" (: (? kint (af "shl rsi, %d" k&31) (: (a "mov rcx, rdi") (a "and rcx, 31") (a "shl rsi, cl"))) (a "shl rsi, 32") (a "sar rsi, 32"))
    ">>" (: (a "shl rsi, 32") (a "sar rsi, 32") (? kint (af "sar rsi, %d" k&31) (: (a "mov rcx, rdi") (a "and rcx, 31") (a "sar rsi, cl"))))
    ">>>" (: (a "shl rsi, 32") (a "shr rsi, 32") (? kint (af "shr rsi, %d" k&31) (: (a "mov rcx, rdi") (a "and rcx, 31") (a "shr rsi, cl"))))
    (: (a "cvtsi2sd xmm2, rsi") (a "ucomisd xmm2, xmm0") (a (++ "jne " slow)) (a (++ "jp " slow))      ; % and //: both operands must be integral, divisor not 0 or -1
       (? !kint (: (a "cvtsi2sd xmm2, rdi") (a "ucomisd xmm2, xmm1") (a (++ "jne " slow)) (a (++ "jp " slow))))
       (? (&& kint k>0 (== (k&(k-1)) 0))
            (: m=0 t=k (wh t>1 t=t//2 m+=1)                                    ; power of two: mask / arithmetic shift (floored, also for negative dividends)
               (? (== op "%") (af "and rsi, %d" k-1) (af "sar rsi, %d" m)))
          (&& kint k>0)
            (: fl=(nl) (a "mov rax, rsi") (a "cqo") (a "idiv rdi")
               (? (== op "%") (: (a "mov rsi, rdx") (a "test rsi, rsi") (a (++ "jns " fl)) (a "add rsi, rdi") (label fl))
                              (: (a "test rdx, rdx") (a (++ "jns " fl)) (a "sub rax, 1") (label fl) (a "mov rsi, rax"))))
          (: (? !(&& kint k!=0 k!=-1) (: (a "lea rdx, [rdi+1]") (a "cmp rdx, 1") (a (++ "jbe " slow))))
             (a "mov rax, rsi") (a "cqo") (a "idiv rdi")
             (: fl=(nl) (a "test rdx, rdx") (a (++ "jz " fl)) (a "mov rcx, rdx") (a "xor rcx, rdi") (a (++ "jns " fl))
                (? (== op "%") (a "add rdx, rdi") (a "sub rax, 1"))
                (label fl))
             (a (? (== op "%") "mov rsi, rdx" "mov rsi, rax"))))))
  (a "cvtsi2sd xmm0, rsi") (a "movq rax, xmm0")
  (label done)
  (cold (\ () (label slow) (push_ops L R) (slow2 ({"%" "mod2" "//" "fdiv2" "&" "band2" "|" "bor2" "^" "bxor2" "<<" "shl2" ">>" "shr2" ">>>" "ushr2"}[op])) (a (++ "jmp " done)))))
(= (gen_cmpvalue op x y)
  ec=(? (has ["==" "!="] op) (eqconst [x y]))
  (? ec (: (gen_eqconst op ec[0] ec[1])
           (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "test rdx, rdx") (a (? (== op "==") "cmovnz rax, rcx" "cmovz rax, rcx")))
     (gen_cmp op x y false nil nil)))
(= (gen_cmpjump op args lbl when)
  ec=(? (has ["==" "!="] op) (eqconst args))
  (? ec (: (gen_eqconst op ec[0] ec[1])
           (a "test rdx, rdx") (a (++ (? (== when (== op "==")) "jnz " "jz ") lbl)))
     (gen_cmp op args[0] args[1] true lbl when)))
; compare x and y; jump form when isjump: jump to lbl when the comparison is `when`
(= (gen_cmp op x y isjump lbl when)
  [L R]=(operands x y)
  slow=(nl) done=(nl) skip=(nl)
  (? !(isnumir x) (chkd L slow))
  (? !(isnumir y) (chkd R slow))
  ordered=(has ["<" ">" "<=" ">=" ] op)
  (? (has ["<" "<="] op)
     (: (ldx R 1) (af "ucomisd xmm1, %s" (srcx L 0)))                  ; a<b is b>a: unordered (NaN) then fails `a`/`ae`
     (: (ldx L 0) (af "ucomisd xmm0, %s" (srcx R 1))))
  cc=({"<" "a" ">" "a" "<=" "ae" ">=" "ae"}[op])
  nc=({"<" "be" ">" "be" "<=" "b" ">=" "b"}[op])
  (? isjump
     (? ordered (? when (a (++ "j" cc " " lbl)) (a (++ "j" nc " " lbl)))
        (== op "==") (? when (: (a (++ "jp " skip)) (a (++ "je " lbl)) (label skip))
                             (: (a (++ "jp " lbl)) (a (++ "jne " lbl))))
        (? when (: (a (++ "jp " lbl)) (a (++ "jne " lbl)))
                (: (a (++ "jp " skip)) (a (++ "je " lbl)) (label skip))))
     (? ordered
        (: (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a (++ "cmov" cc " rax, rcx")))
        (: (a "sete al") (a "setnp dl") (a "movzx rax, al") (a "movzx rdx, dl") (a "and rax, rdx")
           (? (== op "!=") (a "xor rax, 1"))
           (a "lea rcx, [r11+1]") (a "add rax, rcx"))))
  (label done)
  (cold (\ ()
    (label slow)
    (? (has ["==" "!="] op)         ; identical values, a string on either side, mismatched kinds: decided in a stub; the rest (lists, maps ..) by the runtime
       (: lgen=(nl) (ldd L 1) (ldd R 0) (a "call .eqany") (a "cmp rdx, 2") (a (++ "je " lgen))
          (? isjump (: (a "test rdx, rdx") (a (++ (? (== when (== op "==")) "jnz " "jz ") lbl)))
                    (: (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "test rdx, rdx") (a (? (== op "==") "cmovnz rax, rcx" "cmovz rax, rcx"))))
          (a (++ "jmp " done))
          (label lgen) (push_ops ["r" 1] ["r" 0]))
       (push_ops L R))
    (slow2 ({"<" "lt2" ">" "gt2" "<=" "le2" ">=" "ge2" "==" "eq2" "!=" "ne2"}[op]))
    (? isjump (: (a "lea rcx, [r11+2]") (a "cmp rax, rcx") (a (++ (? when "je " "jne ") lbl))))
    (a (++ "jmp " done)))))

; ---- field access o.k / o.k=v with a literal key: a per-site inline cache of where the key was last found in the map's entry array
; (the byte offset of its value slot; initially "never matches"). A hit needs the exact same key object (map literals and field accesses share
; the compile-time string), so it is correct whatever the map's history; the runtime function dotc/setdotc refreshes the cache on a miss.
(= (site_alloc) (dalign) ad=0x10000000+(dpos) (dword 0xFFFFFFFF 0x7FFFFFFF) ad)
(= (rt_direct name) d=(direct_target (rtref name)) (? (&& d d.nparams>0) d (err (++ "internal: " name " cannot be called directly"))))
(= (cache_probe slow site kaddr)      ; rcx = untagged map; jumps to slow unless the cached entry holds the key -> rdx = entry array, rsi = value offset
  (a "mov rdx, [rcx+16]") (a "xor rdx, r10")
  (af "mov rsi, [%d]" site)
  (a "mov r8, [rdx]") (a "shr r8, 29") (a "cmp rsi, r8") (a (++ "ja " slow))
  (af "lea rdi, [r10+%d]" kaddr)
  (a "cmp [rdx+rsi-8], rdi") (a (++ "jne " slow)))
(= (gen_dotc o k h)
  slow=(nl) done=(nl) site=(site_alloc) kaddr=(strobj k) d=(rt_direct "dotc")
  (gen o)
  (a "cmp rax, r10") (a (++ "jb " slow))
  (a "mov rcx, rax") (a "xor rcx, r10") (a "cmp byte ptr [rcx], 4") (a (++ "jne " slow))
  (cache_probe slow site kaddr)
  (a "mov rax, [rdx+rsi]")
  (label done)
  (cold (\ ()
    (label slow)
    (a "mov [r15+8], rax") (a "mov [r15], r11") (af "lea rcx, [r10+%d]" kaddr) (a "mov [r15+16], rcx")
    (numconst 0 h) (a "mov [r15+24], rax") (numconst 0 site) (a "mov [r15+32], rax")
    (a "add r15, 40") (a (++ "call .d" d.id)) (recpos) (a (++ "jmp " done)))))
(= (gen_setdotc o k h v)
  slow=(nl) slowx=(nl) done=(nl) site=(site_alloc) kaddr=(strobj k) d=(rt_direct "setdotc")
  [L R]=(operands o v)
  (ldd L 1) (ldd R 0)
  (a "cmp rcx, r10") (a (++ "jb " slow))
  (a "xor rcx, r10") (a "cmp byte ptr [rcx], 4") (a (++ "jne " slowx))
  (cache_probe slowx site kaddr)
  (a "mov [rdx+rsi], rax")
  (label done)
  (cold (\ ()
    (label slowx) (a "xor rcx, r10")
    (label slow)
    (a "mov [r15], r11") (a "mov [r15+8], rcx") (a "mov [r15+32], rax") (af "lea rcx, [r10+%d]" kaddr) (a "mov [r15+16], rcx")
    (numconst 0 h) (a "mov [r15+24], rax") (numconst 0 site) (a "mov [r15+40], rax")
    (a "add r15, 48") (a (++ "call .d" d.id)) (recpos) (a (++ "jmp " done)))))

; (push l x) with one value: append in place when the list's array has room, else the runtime function push1 (which grows it)
(= (gen_push l x retlist)
  slow=(nl) done=(nl) d=(rt_direct (? retlist "push1" "lpush"))
  [L R]=(operands l x)
  (ldd L 1) (ldd R 0)
  (a "cmp rcx, r10") (a (++ "jb " slow))
  (a "mov rdx, rcx") (a "xor rdx, r10") (a "cmp byte ptr [rdx], 2") (a (++ "jne " slow))
  (a "cvttsd2si rsi, qword ptr [rdx+8]")
  (a "mov rdi, [rdx+16]") (a "xor rdi, r10")
  (a "mov r8, [rdi]") (a "shr r8, 32") (a "cmp rsi, r8") (a (++ "jae " slow))
  (a "mov [rdi+rsi*8+8], rax")
  (a "add rsi, 1") (a "cvtsi2sd xmm0, rsi") (a "movsd [rdx+8], xmm0")
  (? retlist (a "mov rax, rcx"))
  (label done)
  (cold (\ ()
    (label slow)
    (a "mov [r15], r11") (a "mov [r15+8], rcx") (a "mov [r15+16], rax") (a "add r15, 24") (a (++ "call .d" d.id)) (recpos) (a (++ "jmp " done)))))

(= (gen_prim op args)
  (sw op
    "push1" (gen_push args[0] args[1] true)
    "lpush" (gen_push args[0] args[1] false)
    "dotc" (gen_dotc args[0] args[1][1] args[2][1])
    "setdotc" (gen_setdotc args[0] args[1][1] args[2][1] args[3])
    ["+" "-" "*" "/"] (gen_arith op args)
    ["<" ">" "<=" ">=" "==" "!="] (gen_cmpvalue op args[0] args[1])
    "!" (gen [ "not" args[0] ])
    "@" (gen_at args[0] args[1])
    "<@" (gen_put args[0] args[1] args[2])
    "#" (gen_len args[0])
    "dotc" (gen_dotc args[0] args[1] args[2])
    "num" (: (gen args[0]) (a "cmp rax, r11") (: ok=(nl) (a (++ "jb " ok)) (a "call .err_num") (recpos) (label ok)))
    "isundef" (: (gen args[0]) (a "lea rcx, [r11+3]") (a "cmp rax, rcx") (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "cmove rax, rcx"))
    ["%" "//" "&" "|" "^" "<<" ">>" ">>>"] (gen_intop op args[0] args[1])
    "**" (binop_slow args[0] args[1] "pow2")
    "bnot" (: (gen args[0]) (push_rax) (a "call .slow1_bnot1") (recpos))
    (gen_intrinsic op args)))

; ---- number <-> int helpers (rax holds a NaN-boxed double)
(= (num2int src dst) (af "movq xmm0, %s" src) (af "cvttsd2si %s, xmm0" dst))
(= (int2num r) (af "cvtsi2sd xmm0, %s" r) (a "movq rax, xmm0"))
(= (boolcc cc) (a "lea rax, [r11+1]") (a "lea rdx, [r11+2]") (a (++ "cmov" cc " rax, rdx")))
(= (reload_consts) (mov_imm64 11 0xFFF90000 0) (mov_imm64 10 0xFFFA0000 0))

; ---- intrinsics ($name): inline low-level operations for the runtime written in Ak
(= (gen_intrinsic op args)
  ci=(? #args>=2 (constidx args[1]))
  (sw op
    "$ldw" (? ci!=nil (: (gen_regs [args[0]] [[0 "ptr"]]) (af "mov rax, [rax+%d]" 8*ci))
              (: (gen_regs args [[1 "ptr"] [2 "int"]]) (a "mov rax, [rcx+rdx*8]")))
    "$stw" (? ci!=nil (: (gen_regs [args[0] args[2]] [[1 "ptr"] [0 "raw"]]) (af "mov [rcx+%d], rax" 8*ci))
              (: (gen_regs args [[1 "ptr"] [2 "int"] [0 "raw"]]) (a "mov [rcx+rdx*8], rax")))
    "$ldb" (: (? ci!=nil (: (gen_regs [args[0]] [[0 "ptr"]]) (af "movzx rax, byte ptr [rax+%d]" 8+ci))
                 (: (gen_regs args [[1 "ptr"] [2 "int"]]) (a "movzx rax, byte ptr [rcx+rdx+8]")))
              (int2num "rax"))
    "$stb" (: (? ci!=nil (: (gen_regs [args[0] args[2]] [[1 "ptr"] [0 "raw"]]) (a "movq xmm0, rax") (a "cvttsd2si rsi, xmm0") (af "mov byte ptr [rcx+%d], sil" 8+ci))
                 (: (gen_regs args [[1 "ptr"] [2 "int"] [0 "raw"]]) (a "movq xmm0, rax") (a "cvttsd2si rsi, xmm0") (a "mov byte ptr [rcx+rdx+8], sil"))))
    "$type" (: (gen_regs args [[0 "ptr"]]) (a "mov rax, [rax]") (a "and rax, 255") (int2num "rax"))
    "$hlen" (: (gen_regs args [[0 "ptr"]]) (a "mov rax, [rax]") (a "shr rax, 32") (int2num "rax"))
    "$ndig" (: l1=(nl) l2=(nl) (gen_regs args [[0 "int"]])                      ; number of decimal digits of the integer n >= 1
               (a "mov rcx, 1") (mov_imm64 6 0xCCCCCCCC 0xCCCCCCCD)
               (label l1) (a "cmp rax, 10") (a (++ "jb " l2)) (a "mul rsi") (a "shr rdx, 3") (a "mov rax, rdx") (a "add rcx, 1") (a (++ "jmp " l1))
               (label l2) (int2num "rcx"))
    "$utoa" (: l1=(nl) (gen_regs args [[7 "ptr"] [1 "int"] [0 "int"]])          ; write the decimal digits of n >= 1 into string s, ending just before index end
               (a "lea rdi, [rdi+rcx+8]") (mov_imm64 6 0xCCCCCCCC 0xCCCCCCCD)
               (label l1) (a "mov r8, rax") (a "mul rsi") (a "shr rdx, 3") (a "lea r9, [rdx+rdx*4]") (a "add r9, r9") (a "sub r8, r9") (a "add r8, 48")
               (a "sub rdi, 1") (a "mov byte ptr [rdi], r8b") (a "mov rax, rdx") (a "test rax, rax") (a (++ "jnz " l1))
               (a "mov rax, r11"))
    "$sethdr" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx")
                 (popr "rcx") (num2int "rcx" "rcx") (popr "rdi") (untag "rdi") (a "shl rdx, 32") (a "or rdx, rcx") (a "mov [rdi], rdx") (a "mov rax, r11"))
    "$new" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx")
              (popr "rsi") (num2int "rsi" "rsi") (popr "rcx") (num2int "rcx" "rcx")
              (a "mov r9, rsi") (a "test r9, r9") (: l1=(nl) (a (++ "jnz " l1)) (a "mov r9, 1") (label l1))
              (a "lea rdi, [r9*8+8]") (a "mov rax, r13") (a "add r13, rdi") (a "cmp r13, [268435464]") (a "ja .oom")
              (a "shl rdx, 32") (a "or rdx, rcx") (a "mov [rax], rdx")
              (a "mov r8, rax") (a "lea rdi, [rax+8]") (a "mov rcx, r9") (a "mov rax, r11") (a "rep stosq") (a "mov rax, r8") (a "or rax, r10"))
    "$newb" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx")
               (popr "rsi") (num2int "rsi" "rsi") (popr "rcx") (num2int "rcx" "rcx")
               (a "lea rdi, [rsi+8]") (a "and rdi, -8") (a "mov r9, rdi") (a "add rdi, 8")
               (a "mov rax, r13") (a "add r13, rdi") (a "cmp r13, [268435464]") (a "ja .oom")
               (a "shl rdx, 32") (a "or rdx, rcx") (a "mov [rax], rdx")
               (a "mov r8, rax") (a "lea rdi, [rax+8]") (a "mov rcx, r9") (a "xor rax, rax") (a "rep stosb") (a "mov rax, r8") (a "or rax, r10"))
    "$addr" (: (gen args[0]) (untag "rax") (a "add rax, 8") (int2num "rax"))
    "$syscall" (: n=#args (for e args (gen e) (push_rax))
                  (for k (reverse_idx n) (popr "rcx") (num2int "rcx" ["rax" "rdi" "rsi" "rdx" "r10" "r8" "r9"][k]))
                  (a "syscall") (reload_consts) (int2num "rax"))
    ["$isptr" "$isnum" "$isnil" "$eqp" "$islist" "$isstr" "$ismap" "$issym" "$isfn"] (pred_value op args)
    "$bitshi" (: (gen args[0]) (a "shr rax, 32") (int2num "rax"))
    "$bitslo" (: (gen args[0]) (a "shl rax, 32") (a "shr rax, 32") (int2num "rax"))
    "$frombits" (: (gen args[0]) (push_rax) (gen args[1]) (num2int "rax" "rax") (popr "rcx") (num2int "rcx" "rcx") (a "shl rcx, 32") (a "or rax, rcx"))
    "$toint" (: (gen args[0]) (num2int "rax" "rax") (a "shl rax, 32") (a "sar rax, 32") (int2num "rax"))
    "$fadd" (binraw args "addsd") "$fsub" (binraw args "subsd") "$fmul" (binraw args "mulsd") "$fdiv" (binraw args "divsd")
    "$fsqrt" (: (gen args[0]) (a "movq xmm0, rax") (a "sqrtsd xmm0, xmm0") (a "movq rax, xmm0"))
    "$ffloor" (: (gen args[0]) (a "movq xmm0, rax") (a "roundsd xmm0, xmm0, 9") (a "movq rax, xmm0"))
    "$fceil" (: (gen args[0]) (a "movq xmm0, rax") (a "roundsd xmm0, xmm0, 10") (a "movq rax, xmm0"))
    "$ftrunc" (: (gen args[0]) (a "movq xmm0, rax") (a "roundsd xmm0, xmm0, 11") (a "movq rax, xmm0"))
    "$peek" (: (gen args[0]) (num2int "rax" "rcx") (a "movzx rax, byte ptr [rcx]") (int2num "rax"))
    "$poke" (: (gen args[0]) (push_rax) (gen args[1]) (num2int "rax" "rsi") (popr "rcx") (num2int "rcx" "rcx") (a "mov byte ptr [rcx], sil") (a "mov rax, r11"))
    "$argc" (: (a "mov rcx, [268435472]") (a "mov rax, [rcx]") (int2num "rax"))
    "$argv" (: (gen args[0]) (num2int "rax" "rdx") (a "mov rcx, [268435472]") (a "mov rax, [rcx+rdx*8+8]") (int2num "rax"))
    "$throw" (: (gen args[0]) (a "mov rcx, 0") (a "mov [268435672], rcx") (a "jmp .throw"))
    "$throwk" (: (gen args[1]) (af "mov rcx, %d" args[0][1]) (a "mov [268435672], rcx") (a "jmp .throw"))      ; error kind code (0 error 1 assert 2 arith 3 type 4 io 5 index 255 raised), read by $errkind
    "$errkind" (: (a "mov rax, [268435672]") (int2num "rax"))
    "$band" (binint args "and") "$bor" (binint args "or") "$bxor" (binint args "xor")
    "$shl" (shiftint args "shl") "$shr" (shiftint args "sar") "$ushr" (shiftint args "ushr")
    "$apply" (: (gen args[0]) (push_rax) (gen args[1]) (untag "rax")
                (a "mov rdx, [rax+8]") (a "movq xmm0, rdx") (a "cvttsd2si rdx, xmm0")
                (a "mov rsi, [rax+16]") (untag "rsi") (a "add rsi, 8") (a "mov rdi, r15") (a "mov rcx, rdx") (a "rep movsq")
                (a "mov r15, rdi") (a "mov rcx, rdx") (a "call .callclosure"))
    "$peekw" (: (gen args[0]) (num2int "rax" "rcx") (a "mov rax, [rcx]"))
    "$pokew" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (num2int "rcx" "rcx") (a "mov [rcx], rax"))
    "$ptraddr" (: (gen args[0]) (untag "rax") (int2num "rax"))
    "$mkptr" (: (gen args[0]) (num2int "rax" "rax") (a "or rax, r10"))
    "$rawcopy" (: (for e args (gen e) (push_rax)) (popr "rcx") (num2int "rcx" "rcx") (popr "rsi") (num2int "rsi" "rsi") (popr "rdi") (num2int "rdi" "rdi") (a "rep movsb") (a "mov rax, r11"))
    "$envp" (: (a "mov rcx, [268435472]") (a "mov rax, [rcx]") (a "lea rax, [rcx+rax*8+16]") (int2num "rax"))
    "$gbase" (numconst 0 GBASE)
    "$lget" (? ci!=nil (: (gen_regs [args[0]] [[0 "ptr"]]) (a "mov rax, [rax+16]") (untag "rax") (af "mov rax, [rax+%d]" 8+8*ci))
               (: (gen_regs args [[1 "ptr"] [2 "int"]]) (a "mov rcx, [rcx+16]") (untag "rcx") (a "mov rax, [rcx+rdx*8+8]")))
    "$lset" (? ci!=nil (: (gen_regs [args[0] args[2]] [[1 "ptr"] [0 "raw"]]) (a "mov rcx, [rcx+16]") (untag "rcx") (af "mov [rcx+%d], rax" 8+8*ci))
               (: (gen_regs args [[1 "ptr"] [2 "int"] [0 "raw"]]) (a "mov rcx, [rcx+16]") (untag "rcx") (a "mov [rcx+rdx*8+8], rax")))
    "$hslot" (: [L R]=(operands args[0] args[1]) (ldx L 0)                    ; floor(frac(h*phi) * size): multiplicative (Fibonacci) hashing
                (af "mulsd xmm0, [%d]" (dconst64 0x372FE950 0x3FE3C6EF)) (a "roundsd xmm3, xmm0, 9") (a "subsd xmm0, xmm3")
                (af "mulsd xmm0, %s" (srcx R 1)) (a "roundsd xmm0, xmm0, 9") (a "movq rax, xmm0"))
    "$sp" (: (a "mov rax, rsp") (int2num "rax"))
    "$ld16" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (num2int "rax" "rdx") (a "movzx rax, word ptr [rcx+rdx+8]") (int2num "rax"))
    "$st16" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (a "mov rdi, rax") (num2int "rax" "rsi")
               (popr "rdx") (popr "rcx") (untag "rcx") (num2int "rdx" "rdx") (a "mov byte ptr [rcx+rdx+8], sil") (a "shr rsi, 8") (a "mov byte ptr [rcx+rdx+9], sil") (a "mov rax, rdi"))
    "$ldf32" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (num2int "rax" "rdx") (a "movss xmm0, dword ptr [rcx+rdx+8]") (a "cvtss2sd xmm0, xmm0") (a "movq rax, xmm0"))
    "$stf32" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (a "mov rdi, rax")
                (popr "rdx") (popr "rcx") (untag "rcx") (num2int "rdx" "rdx") (a "movq xmm0, rdi") (a "cvtsd2ss xmm0, xmm0") (a "movss dword ptr [rcx+rdx+8], xmm0") (a "mov rax, rdi"))
    "$gccopy" (: (for e args (gen e) (push_rax)) (popr "rdx") (num2int "rdx" "rdx") (popr "rsi") (num2int "rsi" "rsi") (popr "rdi") (num2int "rdi" "rdi") (a "call .gccopy"))
    "$strhash" (: (gen args[0]) (a "call .strhash"))
    "$find" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx") (popr "rcx") (popr "rsi") (untag "rcx") (untag "rsi") (a "call .strfind") (int2num "rax"))
    "$mapfind_s" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx") (popr "rax") (popr "rbx") (untag "rbx") (a "call .mapfind_s") (int2num "rax"))
    "$mapfind_n" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rbx") (untag "rbx") (a "call .mapfind_n") (int2num "rax"))
    "$streq" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (a "call .streqany") (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "test rdx, rdx") (a "cmovnz rax, rcx"))
    "$label" (: (lea_l 0 args[0][1]) (int2num "rax"))
    "$vtop" (: (a "mov rax, r14") (int2num "rax"))
    "$vbase" (: (a "mov rax, [268435512]") (int2num "rax"))
    "$hptr" (: (a "mov rax, r13") (int2num "rax"))
    "$heapbase" (: (a "mov rax, [268435504]") (int2num "rax"))
    "$nglob" (: (a "mov rax, [268435624]") (int2num "rax"))
    "$gcset" (: (for e args (gen e) (push_rax))
                (popr "rcx") (num2int "rcx" "rcx") (popr "rdx") (num2int "rdx" "rdx") (popr "rsi") (num2int "rsi" "rsi") (popr "r13") (num2int "r13" "r13")
                (a "mov [268435464], rdx") (a "mov [268435504], rsi") (a "mov [268435496], rcx") (a "mov rax, r11"))
    "$gclim" (: (gen args[0]) (num2int "rax" "rcx") (a "add rcx, r13") (a "mov [268435496], rcx") (a "mov rax, r11"))
    "$tracetop" (: (a "mov rax, [268435480]") (int2num "rax"))
    "$tracebase" (: (a "mov rax, [268435488]") (int2num "rax"))
    "$tracenames" (ptrconst 0 (strobj G.tracetab))
    "$void" (a "mov rax, r11")
    "$copy" (: (for e args (gen e) (push_rax))
               (popr "rcx") (num2int "rcx" "rcx") (popr "rdx") (num2int "rdx" "rdx") (popr "rsi") (untag "rsi") (popr "r8") (num2int "r8" "r8") (popr "rdi") (untag "rdi")
               (a "lea rsi, [rsi+rdx+8]") (a "lea rdi, [rdi+r8+8]") (a "rep movsb") (a "mov rax, r11"))
    (err (++ "internal: unknown primitive " op))))
; JS int32 semantics: operands are ToInt32'd (wrap to 32 bits), results are int32 (ushr: uint32)
(= (norm32) (a "shl rcx, 32") (a "sar rcx, 32"))
(= (constidx x) (? (&& x[0]=="num" x[1]==(flr x[1]) -1000000000<=x[1]<=1000000000) x[1]))      ; a constant integer index folds into the displacement
(= (immk x) (? (&& x[0]=="num" x[1]==(flr x[1]) -2147483648<=x[1]<=2147483647) x[1]))          ; a constant int32 operand becomes an immediate
(= (binint args mn)
  k=(immk args[1])
  (? k!=nil (: (gen_regs [args[0]] [[1 "int"]]) (af "%s rcx, %d" mn k))
            (: (gen_regs args [[1 "int"] [2 "int"]]) (af "%s rcx, rdx" mn)))
  (norm32) (int2num "rcx"))
(= (shiftint args mn)
  k=(immk args[1])
  (? k!=nil (gen_regs [args[0]] [[0 "int"]])
            (: (gen_regs args [[6 "int"] [1 "int"]]) (a "and rcx, 31") (a "mov rax, rsi")))
  (sw mn "ushr" (: (a "shl rax, 32") (a "shr rax, 32") (? k!=nil (af "shr rax, %d" k&31) (a "shr rax, cl")))
         "shl" (: (a "shl rax, 32") (a "sar rax, 32") (? k!=nil (af "shl rax, %d" k&31) (a "shl rax, cl")) (a "shl rax, 32") (a "sar rax, 32"))
         (: (a "shl rax, 32") (a "sar rax, 32") (? k!=nil (af "sar rax, %d" k&31) (a "sar rax, cl"))))
  (int2num "rax"))
(= (reverse_idx n) r=[] (for i n (push r n-1-i)) r)
(= (binraw args mn) [L R]=(operands args[0] args[1]) (ldx L 0) (af "%s xmm0, %s" mn (srcx R 1)) (a "movq rax, xmm0"))

; ---- function code
(= (collect_inits x)
  (? (&& (is "list" x) #x>0 (is "str" x[0]))
     (: (? x[0]=="init" x[1].inited=true)
        (for y x[1..] (? (&& (is "list" y) (!= x[0] "fn")) (collect_inits y))))))
(= (box_new_nil) (alloc_const 16) (mov_imm64 1 1 T_BOX) (a "mov [rax], rcx") (a "mov [rax+8], r11") (a "or rax, r10"))
(= (gen_fn f)
  G.fn=f P=f.nparams ok=(nl)
  (label (++ ".f" f.id))                        ; general entry: rcx = number of arguments
  (a "push r14") (a "mov r14, r15") (a "mov rax, rcx") (a "shl rax, 3") (a "sub r14, rax") (a "sub r14, 8")
  (? !f.rest (: (af "cmp rcx, %d" P) (a (++ "je " ok))))
  (af "mov rdx, %d" P) (a (? f.hasdef "lea rsi, [r11+3]" "mov rsi, r11")) (af "mov rdi, %d" (? f.rest 1 0)) (a "call .adjust")
  (? !f.rest (: (a (++ "jmp " ok))
                (label (++ ".d" f.id))          ; direct entry: exactly P arguments are on the value stack
                (a "push r14") (af "lea r14, [r15-%d]" 8*(P+1))))
  (label ok)
  (gen_poll)
  (? G.trace (trace_push f))
  nloc=f.nslots-1-P-(? f.rest 1 0)
  (for k nloc (af "mov [r15+%d], r11" 8*k))
  (? nloc>0 (af "add r15, %d" 8*nloc))
  (for v f.vars
    (? (boxed v)
       (? v.param (: (box_new_nil) (af "mov rcx, [r14+%d]" 8*v.slot) (a "mov [rax+8], rcx") (af "mov [r14+%d], rax" 8*v.slot))
          (! v.inited) (: (box_new_nil) (af "mov [r14+%d], rax" 8*v.slot)))))
  (gen f.body)
  (? G.trace (trace_pop))
  (a "mov r15, r14") (a "pop r14") (a "ret")
  (flush_cold))

; ---- runtime stubs (assembly)
(= (gen_stubs)
  (label ".oom") (a "mov rdi, 137") (a "mov rax, 231") (a "syscall")
  (label ".err_num") (ptrconst 0 (strobj "expected number")) (a "mov rcx, 3") (a "mov [268435672], rcx") (a "jmp .throw")
  (label ".gc")
  (mov_imm64 0 0x7FFFFFFF 0xFFFFFFFF) (a "mov [268435496], rax")
  (af "mov rsi, [%d]" (gaddr (prelude_gid "gc"))) (a "mov [r15], rsi") (a "add r15, 8") (a "mov rcx, 0") (a "call .callclosure") (a "ret")
  (label ".streqany")                                   ; rax = any value, rcx = string pointer -> rdx = 1 when rax is an equal string
  (a "cmp rax, rcx") (a "je .seq_yes")
  (a "cmp rax, r10") (a "jb .seq_no")
  (a "mov rsi, rax") (untag "rsi") (a "cmp byte ptr [rsi], 1") (a "jne .seq_no")
  (a "mov rdi, rcx") (untag "rdi")
  (a "mov r8, [rsi]") (a "mov r9, [rdi]") (a "shr r8, 32") (a "shr r9, 32") (a "cmp r8, r9") (a "jne .seq_no")
  (a "add r8, 7") (a "shr r8, 3") (a "jz .seq_yes")                  ; equal lengths: compare whole words (every string's padding is zero)
  (label ".seq_lp") (a "mov r9, [rsi+r8*8]") (a "cmp r9, [rdi+r8*8]") (a "jne .seq_no") (a "sub r8, 1") (a "jnz .seq_lp")
  (label ".seq_yes") (a "mov rdx, 1") (a "ret")
  (label ".seq_no") (a "mov rdx, 0") (a "ret")
  (label ".eqany")                                      ; rcx = a, rax = b (not both doubles) -> rdx = 1 equal, 0 different, 2 = the runtime must decide (lists, maps, ..)
  (a "cmp rcx, rax") (a "je .seq_yes") (a "cmp rcx, r10") (a "jb .seq_no") (a "cmp rax, r10") (a "jb .seq_no")
  (a "mov rsi, rcx") (untag "rsi") (a "movzx rdx, byte ptr [rsi]") (a "mov rdi, rax") (untag "rdi") (a "movzx r8, byte ptr [rdi]") (a "cmp rdx, r8") (a "jne .seq_no")
  (a "cmp rdx, 1") (a "jne .eq_undecided") (a "jmp .streqany")
  (label ".eq_undecided") (a "mov rdx, 2") (a "ret")
  (label ".strfind")                                    ; rsi = haystack, rcx = needle (m >= 1), rdx = start -> rax = first index of the needle at or after rdx, or -1
  (a "mov r8, [rsi]") (a "shr r8, 32") (a "mov r9, [rcx]") (a "shr r9, 32") (a "add rsi, 8") (a "add rcx, 8")
  (mov_imm64 3 0x01010101 0x01010101) (mov_imm64 12 0x80808080 0x80808080)
  (a "movzx rax, byte ptr [rcx]") (a "imul rax, rbx")
  (label ".sf_loop")                                    ; 8 bytes at a time: does the window contain the needle's first byte?
  (a "mov rdi, r8") (a "sub rdi, r9") (a "cmp rdx, rdi") (a "jg .sf_no")
  (a "lea rdi, [rdx+8]") (a "cmp rdi, r8") (a "ja .sf_b")
  (a "mov rbp, [rsi+rdx]") (a "xor rbp, rax") (a "mov rdi, rbp") (a "sub rdi, rbx") (a "not rbp") (a "and rdi, rbp") (a "and rdi, r12") (a "jnz .sf_b")
  (a "add rdx, 8") (a "jmp .sf_loop")
  (label ".sf_b")                                       ; byte scan for the first byte, then compare the rest
