; Core IR -> x86-64. Conventions:
;   value = NaN-boxed 64-bit word: doubles raw; nil=0xFFF9<<48, false=nil+1, true=nil+2, undef=nil+3; heap pointer = 0xFFFA<<48 | addr
;   r11 = nil constant (0xFFF9<<48), r10 = pointer tag (0xFFFA<<48), r13 = heap bump pointer, r14 = frame base, r15 = value-stack pointer
;   machine stack holds only return addresses / saved r14 / exception records; all Ak values live on the value stack (precise GC roots)
;   frame (value stack): [closure, arg1..argP, (rest), locals..., temporaries...]; slot i at [r14 + 8*i]
;   call: push closure, push args, rcx = nargs, call callclosure; callee pops its whole frame (r15 = r14) and returns rax
; heap object header (8 bytes): low byte = type, upper 32 bits = length.
(use "x86.ak")
HEAD_ADDR=0x10000000
HLIM_ADDR=0x10000008
ARGV_ADDR=0x10000010
GBASE=0x30000000
T_STR=1 T_LIST=2 T_ARR=3 T_MAP=4 T_CLOSURE=5 T_BOX=6 T_SYM=7 T_BYTES=8
HEAP_SIZE=17179869184
GC_FIRST=67108864
G={:postab [] :curpos nil :fn nil :lbl 0 :data [] :dfix [] :strs {} :nglob 0 :stubs {} :dbase 0 :img nil}

TRACE_ADDR=268435480
TRACE_BASE=268435488
(= (a s) (asm s))
(= (gen_poll) skip=(nl) (a "cmp r13, [268435496]") (a (++ "jb " skip)) (a "call .gc") (label skip))
(= (trace_push f) (a "mov rax, [268435480]") (af "mov rdx, %d" f.id) (a "mov [rax], rdx") (a "add rax, 8") (a "mov [268435480], rax"))
(= (trace_pop) (a "mov rcx, [268435480]") (a "sub rcx, 8") (a "mov [268435480], rcx"))
(= (af f ..xs) (asm (fmt f ..xs)))
(= (nl) G.lbl+=1 (++ ".L" G.lbl))
(= (untag r) (af "shl %s, 16" r) (af "shr %s, 16" r))
(= (push_rax) (a "mov [r15], rax") (a "add r15, 8"))
(= (popr r) (a "sub r15, 8") (af "mov %s, [r15]" r))
(= (gaddr gid) GBASE+8*gid)
(= (boxed v) (&& v.kind=="local" v.captured v.set))

; ---- static data (strings, closures); addresses are absolute (non-PIE image)
(= (dpos) G.dbase+#G.data)
(= (dbyte b) (push G.data b&255))
(= (dalign) (wh (dpos)%8!=0 (dbyte 0)))
(= (dword lo hi) (for i 4 (dbyte lo>>(8*i))) (for i 4 (dbyte hi>>(8*i))))
(= (strobj s)
  (? G.strs[s]!=nil G.strs[s]
     (&& G.img G.img.strs[s]!=nil) G.img.strs[s]
     (: (dalign) addr=0x10000000+(dpos) bs=(bytes s)
        (dword T_STR #bs) (for b bs (dbyte b)) (dbyte 0) (dalign)
        G.strs[s]=addr addr)))
(= (staticclo f)
  (? f.static!=nil f.static
     (: (dalign) addr=0x10000000+(dpos)
        (dword T_CLOSURE 0) (push G.dfix [(dpos) (++ ".f" f.id)]) (dword 0 0)
        f.static=addr addr)))
(= (ptrconst r addr) (mov_imm64 r 0xFFFA0000 addr))
(= (numconst r x) [hi lo]=(f64bits x) (mov_imm64 r hi lo))

; ---- variable access
(= (freeidx v) i=G.fn.freeidx[v.id] (? i==nil (err (++ "internal: " v.name " is not captured by " G.fn.name))) i)
(= (load_var v)       ; value of variable -> rax
  (? v.kind=="global" (af "mov rax, [%d]" (gaddr v.gid))
     v.fn.id==G.fn.id (: (af "mov rax, [r14+%d]" 8*v.slot) (? (boxed v) (: (untag "rax") (a "mov rax, [rax+8]"))))
     (: (a "mov rax, [r14]") (untag "rax") (af "mov rax, [rax+%d]" 16+8*(freeidx v)) (? (boxed v) (: (untag "rax") (a "mov rax, [rax+8]"))))))
(= (load_cap v r)     ; what a closure captures for v: the box pointer if boxed, else the value
  (? v.fn.id==G.fn.id (af "mov %s, [r14+%d]" r 8*v.slot)
     (: (af "mov %s, [r14]" r) (untag r) (af "mov %s, [%s+%d]" r r 16+8*(freeidx v)))))
(= (store_var v)      ; rax -> variable (rax preserved)
  (? v.kind=="global" (af "mov [%d], rax" (gaddr v.gid))
     (boxed v) (: (? v.fn.id==G.fn.id (af "mov rcx, [r14+%d]" 8*v.slot)
                     (: (a "mov rcx, [r14]") (untag "rcx") (af "mov rcx, [rcx+%d]" 16+8*(freeidx v))))
                  (untag "rcx") (a "mov [rcx+8], rax"))
     v.fn.id==G.fn.id (af "mov [r14+%d], rax" 8*v.slot)
     (err (++ "internal: assignment to captured unboxed variable " v.name))))

; ---- allocation (bump). result: raw address in rax. clobbers nothing else.
(= (alloc_const nbytes) (a "mov rax, r13") (af "add r13, %d" nbytes) (a "cmp r13, [268435464]") (a "ja .oom"))
(= (alloc_reg r)        (a "mov rax, r13") (af "add r13, %s" r) (a "cmp r13, [268435464]") (a "ja .oom"))

; ---- expression codegen: result in rax
(= (recpos) (? G.curpos (push G.postab [(here) G.curpos])))
(= (gen x) (sw x[0]
  "nil" (a "mov rax, r11")
  "true" (a "lea rax, [r11+2]")
  "false" (a "lea rax, [r11+1]")
  "num" (numconst 0 x[1])
  "str" (ptrconst 0 (strobj x[1]))
  "ref" (load_var x[1])
  "set" (: (gen x[2]) (store_var x[1]))
  "init" (gen_init x)
  "seq" (for e x[1..] (gen e))
  "if" (gen_if x)
  "and" (gen_andor x true)
  "or" (gen_andor x false)
  "nilor" (gen_nilor x)
  "not" (: (gen x[1]) (a "call .truthy") (a "lea rax, [r11+2]") (a "lea rcx, [r11+1]") (a "test rdx, rdx") (a "cmovnz rax, rcx"))
  "while" (gen_while x)
  "call" (: old=G.curpos G.curpos=x[3] (gen_call x false) G.curpos=old)
  "tcall" (: old=G.curpos G.curpos=x[3] (gen_call x true) G.curpos=old)
  "fn" (gen_closure x[1])
  "prim" (: old=G.curpos G.curpos=x[3] (gen_prim x[1] x[2]) G.curpos=old)
  "static" (af "mov rax, [%d]" 268435600+8*x[1])
  "initcall" (: (a "mov [r15], r11") (a "add r15, 8") (a "mov rcx, 0") (a (++ "call .f" x[1])))
  "try" (gen_try x)
  (err (++ "internal: unknown IR node " x[0]))))

(= (gen_init x) v=x[1]
  (? (boxed v)
     (: (alloc_const 16) (mov_imm64 1 1 T_BOX) (a "mov [rax], rcx") (a "mov [rax+8], r11") (a "or rax, r10")
        (af "mov [r14+%d], rax" 8*v.slot)
        (gen x[2])
        (af "mov rcx, [r14+%d]" 8*v.slot) (untag "rcx") (a "mov [rcx+8], rax"))
     (: (gen x[2]) (af "mov [r14+%d], rax" 8*v.slot))))

(= (gen_if x) lelse=(nl) lend=(nl)
  (genjump x[1] lelse false)
  (gen x[2]) (a (++ "jmp " lend))
  (label lelse) (gen x[3]) (label lend))

(= (gen_andor x isand) lend=(nl)
  (gen x[1]) (a "call .truthy") (a "test rdx, rdx")
  (a (++ (? isand "jz " "jnz ") lend))
  (gen x[2]) (label lend))
(= (gen_nilor x) lend=(nl)
  (gen x[1]) (a "cmp rax, r11") (a (++ "jne " lend)) (gen x[2]) (label lend))

(= (gen_while x) ltop=(nl) lend=(nl)
  (label ltop) (gen_poll) (genjump x[1] lend false) (gen x[2]) (a (++ "jmp " ltop)) (label lend) (a "mov rax, r11"))

; jump to L when condition is `when` (true/false); otherwise fall through
(= (genjump c lbl when)
  (sw c[0]
    "not" (genjump c[1] lbl !when)
    "true" (? when (a (++ "jmp " lbl)))
    "false" (? !when (a (++ "jmp " lbl)))
    "nil" (? !when (a (++ "jmp " lbl)))
    "and" (? !when (: (genjump c[1] lbl false) (genjump c[2] lbl false))
                   (: skip=(nl) (genjump c[1] skip false) (genjump c[2] lbl true) (label skip)))
    "or" (? when (: (genjump c[1] lbl true) (genjump c[2] lbl true))
                 (: skip=(nl) (genjump c[1] skip true) (genjump c[2] lbl false) (label skip)))
    "prim" (? (has ["<" ">" "<=" ">=" "==" "!="] c[1]) (gen_cmpjump c[1] c[2] lbl when)
              (has PREDPRIMS c[1]) (gen_predjump c[1] c[2] lbl when)
              c[1]=="isundef" (: (gen c[2][0]) (a "lea rcx, [r11+3]") (a "cmp rax, rcx") (a (++ (? when "je " "jne ") lbl)))
              (gen_truthjump c lbl when))
    (gen_truthjump c lbl when)))
; ---- type predicates compiled to compare+jump
TYPEPREDS={"$islist" 2 "$isstr" 1 "$ismap" 4 "$issym" 7 "$isfn" 5}
PREDPRIMS=["$islist" "$isstr" "$ismap" "$issym" "$isfn" "$isnum" "$isnil" "$isptr" "$eqp"]
(= (typecheck_jump t lbl when)       ; value in rax; jump to lbl when (is type t) == when
  skip=(nl)
  (a "mov rcx, rax") (a "shr rcx, 48") (a "cmp rcx, 0xFFFA")
  (? when (a (++ "jne " skip)) (a (++ "jne " lbl)))
  (untag "rax") (af "cmp byte ptr [rax], %d" t)
  (a (++ (? when "je " "jne ") lbl))
  (? when (label skip)))
(= (gen_predjump op args lbl when)
  (? TYPEPREDS[op] (: (gen args[0]) (typecheck_jump TYPEPREDS[op] lbl when))
     (== op "$isnum") (: (gen args[0]) (a "cmp rax, r11") (a (++ (? when "jb " "jae ") lbl)))
     (== op "$isnil") (: (gen args[0]) (a "cmp rax, r11") (a (++ (? when "je " "jne ") lbl)))
     (== op "$isptr") (: (gen args[0]) (a "mov rcx, rax") (a "shr rcx, 48") (a "cmp rcx, 0xFFFA") (a (++ (? when "je " "jne ") lbl)))
     (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (a "cmp rcx, rax") (a (++ (? when "je " "jne ") lbl)))))
(= (pred_value op args)
  lt=(nl) ld=(nl)
  (gen_predjump op args lt true)
  (a "lea rax, [r11+1]") (a (++ "jmp " ld)) (label lt) (a "lea rax, [r11+2]") (label ld))
(= (gen_truthjump c lbl when) (gen c) (a "call .truthy") (a "test rdx, rdx") (a (++ (? when "jnz " "jz ") lbl)))

; ---- calls
; a global bound exactly once, to a closed top-level function, is called directly (no closure dispatch)
(= (walk_ir x)
  (? (&& (is "list" x) #x>0)
     (? (is "str" x[0])
        (: (? (&& (|| x[0]=="set" x[0]=="init") (is "map" x[1]) x[1].kind=="global" (! (&& G.img x[1].pre)))
              (: v=x[1] v.nsets=(+ (?? v.nsets 0) 1) (? (&& x[0]=="set" (is "list" x[2]) x[2][0]=="fn") v.defn=x[2][1])))
           (for y x[1..] (walk_ir y)))
        (for y x (walk_ir y)))))
(= (direct_target f)
  (? (&& f[0]=="ref" f[1].kind=="global" (== f[1].nsets 1) f[1].defn (== #f[1].defn.free 0)) f[1].defn))
(= (gen_call x tail) f=x[1] args=x[2] n=#args d=(direct_target f)
  (? d (af "lea rax, [r10+%d]" (staticclo d)) (gen f))
  (push_rax)
  (for e args (gen e) (push_rax))
  (? tail
     (: (for i n+1 (af "mov rax, [r15-%d]" 8*(n+1-i)) (af "mov [r14+%d], rax" 8*i))
        (af "lea r15, [r14+%d]" 8*(n+1))
        (a "pop r14") (? G.trace (trace_pop)) (af "mov rcx, %d" n) (a (? d (++ "jmp .f" d.id) "jmp .callclosure")))
     (: (af "mov rcx, %d" n) (a (? d (++ "call .f" d.id) "call .callclosure")) (recpos))))

; ---- closures
(= (gen_closure f) k=#f.free
  (? k==0 (ptrconst 0 (staticclo f))
     (: (alloc_const 16+8*k)
        (mov_imm64 1 k T_CLOSURE) (a "mov [rax], rcx")
        (lea_l 1 (++ ".f" f.id)) (a "mov [rax+8], rcx")
        (for [i v] (enum f.free) (load_cap v "rcx") (af "mov [rax+%d], rcx" 16+8*i))
        (a "or rax, r10"))))

; ---- exceptions: record on the machine stack = [r15, r14, handler, prev]; HEAD points at it
(= (gen_try x) body=x[1] v=x[2] handler=x[3] lh=(nl) lend=(nl)
  (? G.trace (: (a "mov rax, [268435480]") (a "push rax")))
  (a "mov rax, [268435456]") (a "push rax")
  (lea_l 0 lh) (a "push rax") (a "push r14") (a "push r15")
  (a "mov [268435456], rsp")
  (gen body)
  (a "add rsp, 24") (a "pop rcx") (a "mov [268435456], rcx")
  (? G.trace (a "add rsp, 8"))
  (a (++ "jmp " lend))
  (label lh)
  (a "pop r15") (a "pop r14") (a "add rsp, 8") (a "pop rcx") (a "mov [268435456], rcx")
  (? G.trace (: (a "pop rcx") (a "mov [268435480], rcx")))
  (af "mov [r14+%d], rax" 8*v.slot)
  (? (boxed v) (: (alloc_const 16) (mov_imm64 1 1 T_BOX) (a "mov [rax], rcx") (af "mov rcx, [r14+%d]" 8*v.slot) (a "mov [rax+8], rcx") (a "or rax, r10") (af "mov [r14+%d], rax" 8*v.slot)))
  (gen handler)
  (label lend))

; ---- primitives
(= (slow2 name) (a (++ "call .slow_" name)) (recpos))          ; operands [a, b] on the value stack -> prelude function name -> rax
(= (binop_slow x y name)       ; both operands on the value stack, no fast path
  (gen x) (push_rax) (gen y) (push_rax) (slow2 name))

(= (gen_arith op args)         ; + - * /  folded left; fast path for two doubles
  n=#args
  (? n==1 (gen_neg args[0])
     (: (gen args[0])
        (for e args[1..] (push_rax) (gen e) (gen_arith2 op)))))
(= (gen_arith2 op)             ; left operand on top of the value stack, right in rax -> result in rax
  slow=(nl) done=(nl)
  (a "mov rcx, [r15-8]") (a "cmp rcx, r11") (a (++ "jae " slow)) (a "cmp rax, r11") (a (++ "jae " slow))
  (a "movq xmm0, rcx") (a "movq xmm1, rax")
  (sw op "+" (a "addsd xmm0, xmm1") "-" (a "subsd xmm0, xmm1") "*" (a "mulsd xmm0, xmm1")
         "/" (: (a "xorpd xmm2, xmm2") (a "ucomisd xmm1, xmm2") (a (++ "je " slow)) (a "divsd xmm0, xmm1")))
  (a "movq rdx, xmm0")
  (? (!= op "/") (: (a "mov rsi, rdx") (a "shl rsi, 1") (a "shr rsi, 1") (mov_imm64 7 0x43400000 0) (a "cmp rsi, rdi") (a (++ "ja " slow))))
  (a "mov rax, rdx") (a "sub r15, 8") (a (++ "jmp " done))
  (label slow) (push_rax) (slow2 ({"+" "add2" "-" "sub2" "*" "mul2" "/" "div2"}[op])) (label done))
(= (gen_neg e) slow=(nl) done=(nl)
  (gen e) (a "cmp rax, r11") (a (++ "jae " slow))
  (mov_imm64 1 0x80000000 0) (a "xor rax, rcx") (a (++ "jmp " done))
  (label slow) (push_rax) (a "call .slow1_neg1") (recpos) (label done))

(= (eqconst args) ; for == / != with a nil/true/false/string constant on either side: [other const]
  (? (has ["str" "nil" "true" "false"] args[1][0]) [args[0] args[1]]
     (has ["str" "nil" "true" "false"] args[0][0]) [args[1] args[0]]))
(= (gen_eqconst c other k)     ; sets rdx=1 when equal; clobbers rax rcx rsi rdi r8 r9
  (gen other)
  (sw k[0]
    "nil" (: (a "xor rdx, rdx") (a "cmp rax, r11") (a "sete dl"))
    "true" (: (a "lea rcx, [r11+2]") (a "xor rdx, rdx") (a "cmp rax, rcx") (a "sete dl"))
    "false" (: (a "lea rcx, [r11+1]") (a "xor rdx, rdx") (a "cmp rax, rcx") (a "sete dl"))
    (: (ptrconst 1 (strobj k[1])) (a "call .streqany"))))
;---- inline indexing: lists and u8/f64 typed arrays are handled without a call; everything else goes to the runtime
(= (gen_at x i)
  slow=(nl) done=(nl) notlist=(nl)
  (gen x) (push_rax) (gen i)
  (a "cmp rax, r11") (a (++ "jae " slow))
  (a "mov rcx, [r15-8]") (a "mov rdx, rcx") (a "shr rdx, 48") (a "cmp rdx, 0xFFFA") (a (++ "jne " slow))
  (a "shl rcx, 16") (a "shr rcx, 16") (a "movzx rsi, byte ptr [rcx]")
  (a "movq xmm0, rax") (a "cvttsd2si rdi, xmm0") (a "cvtsi2sd xmm1, rdi") (a "ucomisd xmm1, xmm0") (a (++ "jne " slow)) (a (++ "jp " slow))
  (a "cmp rsi, 2") (a (++ "jne " notlist))
  (a "mov rdx, [rcx+8]") (a "movq xmm2, rdx") (a "cvttsd2si r8, xmm2") (a "cmp rdi, r8") (a (++ "jae " slow))
  (a "mov r9, [rcx+16]") (a "shl r9, 16") (a "shr r9, 16") (a "mov rax, [r9+rdi*8+8]") (a "sub r15, 8") (a (++ "jmp " done))
  (label notlist)
  (a "cmp rsi, 9") (a (++ "jne " slow))
  (a "movzx r9, byte ptr [rcx+1]") (a "mov rsi, [rcx]") (a "shr rsi, 32")
  (a "cmp r9, 0") (: u8=(nl) (a (++ "jne " u8)) (a "cmp rdi, rsi") (a (++ "jae " slow)) (a "movzx rax, byte ptr [rcx+rdi+8]") (a "cvtsi2sd xmm0, rax") (a "movq rax, xmm0") (a "sub r15, 8") (a (++ "jmp " done)) (label u8))
  (a "cmp r9, 7") (a (++ "jne " slow))
  (a "shr rsi, 3") (a "cmp rdi, rsi") (a (++ "jae " slow)) (a "mov rax, [rcx+rdi*8+8]") (a "sub r15, 8") (a (++ "jmp " done))
  (label slow) (push_rax) (slow2 "at") (label done))
(= (gen_put x i v)
  slow=(nl) done=(nl) notlist=(nl) typed=(nl)
  (gen x) (push_rax) (gen i) (push_rax) (gen v)
  (a "mov rdx, [r15-8]") (a "cmp rdx, r11") (a (++ "jae " slow))
  (a "mov rcx, [r15-16]") (a "mov rsi, rcx") (a "shr rsi, 48") (a "cmp rsi, 0xFFFA") (a (++ "jne " slow))
  (a "shl rcx, 16") (a "shr rcx, 16") (a "movzx rsi, byte ptr [rcx]")
  (a "movq xmm0, rdx") (a "cvttsd2si rdi, xmm0") (a "cvtsi2sd xmm1, rdi") (a "ucomisd xmm1, xmm0") (a (++ "jne " slow)) (a (++ "jp " slow))
  (a "cmp rsi, 2") (a (++ "jne " notlist))
  (a "mov rsi, [rcx+8]") (a "movq xmm2, rsi") (a "cvttsd2si r8, xmm2") (a "cmp rdi, r8") (a (++ "jae " slow))
  (a "mov r9, [rcx+16]") (a "shl r9, 16") (a "shr r9, 16") (a "mov [r9+rdi*8+8], rax") (a "sub r15, 16") (a (++ "jmp " done))
  (label notlist)
  (a "cmp rsi, 9") (a (++ "jne " slow))
  (a "cmp rax, r11") (a (++ "jae " slow))
  (a "movzx r9, byte ptr [rcx+1]") (a "mov rsi, [rcx]") (a "shr rsi, 32")
  (a "cmp r9, 0") (: f64=(nl) (a (++ "jne " f64)) (a "cmp rdi, rsi") (a (++ "jae " slow)) (a "movq xmm0, rax") (a "cvttsd2si r8, xmm0") (a "mov byte ptr [rcx+rdi+8], r8b") (a "sub r15, 16") (a (++ "jmp " done)) (label f64))
  (a "cmp r9, 7") (a (++ "jne " slow))
  (a "shr rsi, 3") (a "cmp rdi, rsi") (a (++ "jae " slow)) (a "mov [rcx+rdi*8+8], rax") (a "sub r15, 16") (a (++ "jmp " done))
  (label slow) (push_rax) (a "call .slow_put") (recpos) (label done))
(= (gen_len x)
  slow=(nl) done=(nl)
  (gen x) (a "mov rcx, rax") (a "mov rdx, rax") (a "shr rdx, 48") (a "cmp rdx, 0xFFFA") (a (++ "jne " slow))
  (a "shl rcx, 16") (a "shr rcx, 16") (a "movzx rsi, byte ptr [rcx]")
  (a "cmp rsi, 2") (: cnt=(nl) (a (++ "je " cnt)) (a "cmp rsi, 4") (a (++ "jne " slow)) (label cnt))
  (a "mov rax, [rcx+8]") (a (++ "jmp " done))
  (label slow) (push_rax) (a "call .slow1_len") (recpos) (label done))
;---- inline integer operators on doubles: % // & | ^ << >> >>> (anything unusual goes to the runtime)
(= (gen_intop op x y)
  slow=(nl) done=(nl)
  (gen x) (push_rax) (gen y)
  (a "mov rcx, [r15-8]") (a "cmp rcx, r11") (a (++ "jae " slow)) (a "cmp rax, r11") (a (++ "jae " slow))
  (a "movq xmm0, rcx") (a "cvttsd2si rsi, xmm0") (a "movq xmm1, rax") (a "cvttsd2si rdi, xmm1")
  (sw op
    ["&" "|" "^"] (: (a (++ ({"&" "and" "|" "or" "^" "xor"}[op]) " rsi, rdi")) (a "shl rsi, 32") (a "sar rsi, 32"))
    "<<" (: (a "mov rcx, rdi") (a "and rcx, 31") (a "shl rsi, cl") (a "shl rsi, 32") (a "sar rsi, 32"))
    ">>" (: (a "mov rcx, rdi") (a "and rcx, 31") (a "shl rsi, 32") (a "sar rsi, 32") (a "sar rsi, cl"))
    ">>>" (: (a "mov rcx, rdi") (a "and rcx, 31") (a "shl rsi, 32") (a "shr rsi, 32") (a "shr rsi, cl"))
    (: (a "cvtsi2sd xmm2, rsi") (a "ucomisd xmm2, xmm0") (a (++ "jne " slow)) (a (++ "jp " slow))      ; % and //: both operands must be integral, divisor not 0 or -1
       (a "cvtsi2sd xmm2, rdi") (a "ucomisd xmm2, xmm1") (a (++ "jne " slow)) (a (++ "jp " slow))
       (a "lea rdx, [rdi+1]") (a "cmp rdx, 1") (a (++ "jbe " slow))
       (a "mov rax, rsi") (a "cqo") (a "idiv rdi")
       (: fl=(nl) (a "test rdx, rdx") (a (++ "jz " fl)) (a "mov rcx, rdx") (a "xor rcx, rdi") (a (++ "jns " fl))
          (? (== op "%") (a "add rdx, rdi") (a "sub rax, 1"))
          (label fl))
       (a (? (== op "%") "mov rsi, rdx" "mov rsi, rax"))))
  (a "cvtsi2sd xmm0, rsi") (a "movq rax, xmm0") (a "sub r15, 8") (a (++ "jmp " done))
  (label slow) (push_rax) (slow2 ({"%" "mod2" "//" "fdiv2" "&" "band2" "|" "bor2" "^" "bxor2" "<<" "shl2" ">>" "shr2" ">>>" "ushr2"}[op])) (label done))
(= (gen_cmpvalue op x y)
  ec=(? (has ["==" "!="] op) (eqconst [x y]))
  (? ec (: (gen_eqconst op ec[0] ec[1])
           (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "test rdx, rdx") (a (? (== op "==") "cmovnz rax, rcx" "cmovz rax, rcx")))
     (: (gen x) (push_rax) (gen y)
        (gen_cmpcore op false nil))))
; compares [x on stack, y in rax]; jump form when lbl!=nil
(= (gen_cmpjump op args lbl when)
  ec=(? (has ["==" "!="] op) (eqconst args))
  (? ec (: (gen_eqconst op ec[0] ec[1])
           (a "test rdx, rdx") (a (++ (? (== when (== op "==")) "jnz " "jz ") lbl)))
     (: (gen args[0]) (push_rax) (gen args[1])
        (gen_cmpcore op true [lbl when]))))
(= (gen_cmpcore op isjump jinfo)
  slow=(nl) done=(nl) skip=(nl)
  (a "mov rcx, [r15-8]") (a "cmp rcx, r11") (a (++ "jae " slow)) (a "cmp rax, r11") (a (++ "jae " slow))
  (a "movq xmm0, rcx") (a "movq xmm1, rax") (a "sub r15, 8")
  (sw op "<" (a "ucomisd xmm1, xmm0") "<=" (a "ucomisd xmm1, xmm0") (a "ucomisd xmm0, xmm1"))
  ordered=(has ["<" ">" "<=" ">="] op)
  cc=({"<" "a" ">" "a" "<=" "ae" ">=" "ae"}[op])
  nc=({"<" "be" ">" "be" "<=" "b" ">=" "b"}[op])
  (? isjump
     (: [lbl when]=jinfo
        (? ordered (? when (a (++ "j" cc " " lbl)) (a (++ "j" nc " " lbl)))
           (== op "==") (? when (: (a (++ "jp " skip)) (a (++ "je " lbl)) (label skip))
                                (: (a (++ "jp " lbl)) (a (++ "jne " lbl))))
           (? when (: (a (++ "jp " lbl)) (a (++ "jne " lbl)))
                   (: (a (++ "jp " skip)) (a (++ "je " lbl)) (label skip))))
        (a (++ "jmp " done)))
     (: (? ordered
           (: (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a (++ "cmov" cc " rax, rcx")))
           (: (a "sete al") (a "setnp dl") (a "movzx rax, al") (a "movzx rdx, dl") (a "and rax, rdx")
              (? (== op "!=") (a "xor rax, 1"))
              (a "lea rcx, [r11+1]") (a "add rax, rcx")))
        (a (++ "jmp " done))))
  (label slow)
  (a "mov [r15], rax") (a "add r15, 8")
  (slow2 ({"<" "lt2" ">" "gt2" "<=" "le2" ">=" "ge2" "==" "eq2" "!=" "ne2"}[op]))
  (? isjump (: [lbl when]=jinfo (a "lea rcx, [r11+2]") (a "cmp rax, rcx") (a (++ (? when "je " "jne ") lbl))))
  (label done))

(= (gen_prim op args)
  (sw op
    ["+" "-" "*" "/"] (gen_arith op args)
    ["<" ">" "<=" ">=" "==" "!="] (gen_cmpvalue op args[0] args[1])
    "!" (gen [ "not" args[0] ])
    "@" (gen_at args[0] args[1])
    "<@" (gen_put args[0] args[1] args[2])
    "#" (gen_len args[0])
    "num" (: (gen args[0]) (a "cmp rax, r11") (: ok=(nl) (a (++ "jb " ok)) (a "call .err_num") (recpos) (label ok)))
    "isundef" (: (gen args[0]) (a "lea rcx, [r11+3]") (a "cmp rax, rcx") (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "cmove rax, rcx"))
    ["%" "//" "&" "|" "^" "<<" ">>" ">>>"] (gen_intop op args[0] args[1])
    "**" (binop_slow args[0] args[1] "pow2")
    "bnot" (: (gen args[0]) (push_rax) (a "call .slow1_bnot1") (recpos))
    (gen_intrinsic op args)))

; ---- number <-> int helpers (rax holds a NaN-boxed double)
(= (num2int src dst) (af "movq xmm0, %s" src) (af "cvttsd2si %s, xmm0" dst))
(= (int2num r) (af "cvtsi2sd xmm0, %s" r) (a "movq rax, xmm0"))
(= (boolcc cc) (a "lea rax, [r11+1]") (a "lea rdx, [r11+2]") (a (++ "cmov" cc " rax, rdx")))
(= (reload_consts) (mov_imm64 11 0xFFF90000 0) (mov_imm64 10 0xFFFA0000 0))

; ---- intrinsics ($name): inline low-level operations for the runtime written in Ak
(= (gen_intrinsic op args)
  (sw op
    "$ldw" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (num2int "rax" "rdx") (a "mov rax, [rcx+rdx*8]"))
    "$stw" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (a "mov rsi, rax")
              (popr "rdx") (popr "rcx") (untag "rcx") (num2int "rdx" "rdx") (a "mov [rcx+rdx*8], rsi") (a "mov rax, rsi"))
    "$ldb" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (num2int "rax" "rdx") (a "movzx rax, byte ptr [rcx+rdx+8]") (int2num "rax"))
    "$stb" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (a "mov rdi, rax") (num2int "rax" "rsi")
              (popr "rdx") (popr "rcx") (untag "rcx") (num2int "rdx" "rdx") (a "mov byte ptr [rcx+rdx+8], sil") (a "mov rax, rdi"))
    "$type" (: (gen args[0]) (untag "rax") (a "mov rax, [rax]") (a "and rax, 255") (int2num "rax"))
    "$hlen" (: (gen args[0]) (untag "rax") (a "mov rax, [rax]") (a "shr rax, 32") (int2num "rax"))
    "$sethdr" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx")
                 (popr "rcx") (num2int "rcx" "rcx") (popr "rdi") (untag "rdi") (a "shl rdx, 32") (a "or rdx, rcx") (a "mov [rdi], rdx") (a "mov rax, r11"))
    "$new" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx")
              (popr "rsi") (num2int "rsi" "rsi") (popr "rcx") (num2int "rcx" "rcx")
              (a "mov r9, rsi") (a "test r9, r9") (: l1=(nl) (a (++ "jnz " l1)) (a "mov r9, 1") (label l1))
              (a "lea rdi, [r9*8+8]") (a "mov rax, r13") (a "add r13, rdi") (a "cmp r13, [268435464]") (a "ja .oom")
              (a "shl rdx, 32") (a "or rdx, rcx") (a "mov [rax], rdx")
              (a "mov r8, rax") (a "lea rdi, [rax+8]") (a "mov rcx, r9") (a "mov rax, r11") (a "rep stosq") (a "mov rax, r8") (a "or rax, r10"))
    "$newb" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (num2int "rax" "rdx")
               (popr "rsi") (num2int "rsi" "rsi") (popr "rcx") (num2int "rcx" "rcx")
               (a "lea rdi, [rsi+8]") (a "and rdi, -8") (a "mov r9, rdi") (a "add rdi, 8")
               (a "mov rax, r13") (a "add r13, rdi") (a "cmp r13, [268435464]") (a "ja .oom")
               (a "shl rdx, 32") (a "or rdx, rcx") (a "mov [rax], rdx")
               (a "mov r8, rax") (a "lea rdi, [rax+8]") (a "mov rcx, r9") (a "xor rax, rax") (a "rep stosb") (a "mov rax, r8") (a "or rax, r10"))
    "$addr" (: (gen args[0]) (untag "rax") (a "add rax, 8") (int2num "rax"))
    "$syscall" (: n=#args (for e args (gen e) (push_rax))
                  (for k (reverse_idx n) (popr "rcx") (num2int "rcx" ["rax" "rdi" "rsi" "rdx" "r10" "r8" "r9"][k]))
                  (a "syscall") (reload_consts) (int2num "rax"))
    ["$isptr" "$isnum" "$isnil" "$eqp" "$islist" "$isstr" "$ismap" "$issym" "$isfn"] (pred_value op args)
    "$bitshi" (: (gen args[0]) (a "shr rax, 32") (int2num "rax"))
    "$bitslo" (: (gen args[0]) (a "shl rax, 32") (a "shr rax, 32") (int2num "rax"))
    "$frombits" (: (gen args[0]) (push_rax) (gen args[1]) (num2int "rax" "rax") (popr "rcx") (num2int "rcx" "rcx") (a "shl rcx, 32") (a "or rax, rcx"))
    "$toint" (: (gen args[0]) (num2int "rax" "rax") (a "shl rax, 32") (a "sar rax, 32") (int2num "rax"))
    "$fadd" (binraw args "addsd") "$fsub" (binraw args "subsd") "$fmul" (binraw args "mulsd") "$fdiv" (binraw args "divsd")
    "$fsqrt" (: (gen args[0]) (a "movq xmm0, rax") (a "sqrtsd xmm0, xmm0") (a "movq rax, xmm0"))
    "$ffloor" (: (gen args[0]) (a "movq xmm0, rax") (a "roundsd xmm0, xmm0, 9") (a "movq rax, xmm0"))
    "$fceil" (: (gen args[0]) (a "movq xmm0, rax") (a "roundsd xmm0, xmm0, 10") (a "movq rax, xmm0"))
    "$ftrunc" (: (gen args[0]) (a "movq xmm0, rax") (a "roundsd xmm0, xmm0, 11") (a "movq rax, xmm0"))
    "$peek" (: (gen args[0]) (num2int "rax" "rcx") (a "movzx rax, byte ptr [rcx]") (int2num "rax"))
    "$poke" (: (gen args[0]) (push_rax) (gen args[1]) (num2int "rax" "rsi") (popr "rcx") (num2int "rcx" "rcx") (a "mov byte ptr [rcx], sil") (a "mov rax, r11"))
    "$argc" (: (a "mov rcx, [268435472]") (a "mov rax, [rcx]") (int2num "rax"))
    "$argv" (: (gen args[0]) (num2int "rax" "rdx") (a "mov rcx, [268435472]") (a "mov rax, [rcx+rdx*8+8]") (int2num "rax"))
    "$throw" (: (gen args[0]) (a "jmp .throw"))
    "$band" (binint args "and") "$bor" (binint args "or") "$bxor" (binint args "xor")
    "$shl" (shiftint args "shl") "$shr" (shiftint args "sar") "$ushr" (shiftint args "ushr")
    "$apply" (: (gen args[0]) (push_rax) (gen args[1]) (untag "rax")
                (a "mov rdx, [rax+8]") (a "movq xmm0, rdx") (a "cvttsd2si rdx, xmm0")
                (a "mov rsi, [rax+16]") (untag "rsi") (a "add rsi, 8") (a "mov rdi, r15") (a "mov rcx, rdx") (a "rep movsq")
                (a "mov r15, rdi") (a "mov rcx, rdx") (a "call .callclosure"))
    "$peekw" (: (gen args[0]) (num2int "rax" "rcx") (a "mov rax, [rcx]"))
    "$pokew" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (num2int "rcx" "rcx") (a "mov [rcx], rax"))
    "$ptraddr" (: (gen args[0]) (untag "rax") (int2num "rax"))
    "$mkptr" (: (gen args[0]) (num2int "rax" "rax") (a "or rax, r10"))
    "$rawcopy" (: (for e args (gen e) (push_rax)) (popr "rcx") (num2int "rcx" "rcx") (popr "rsi") (num2int "rsi" "rsi") (popr "rdi") (num2int "rdi" "rdi") (a "rep movsb") (a "mov rax, r11"))
    "$envp" (: (a "mov rcx, [268435472]") (a "mov rax, [rcx]") (a "lea rax, [rcx+rax*8+16]") (int2num "rax"))
    "$gbase" (numconst 0 GBASE)
    "$lget" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (a "mov rcx, [rcx+16]") (untag "rcx") (num2int "rax" "rdx") (a "mov rax, [rcx+rdx*8+8]"))
    "$lset" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (popr "rdx") (popr "rcx") (untag "rcx") (a "mov rcx, [rcx+16]") (untag "rcx") (num2int "rdx" "rdx") (a "mov [rcx+rdx*8+8], rax"))
    "$hslot" (: (gen args[0]) (push_rax) (gen args[1]) (a "movq xmm1, rax") (popr "rcx") (a "movq xmm0, rcx")      ; floor(frac(h*phi) * size): multiplicative (Fibonacci) hashing
                (mov_imm64 0 0x3FE3C6EF 0x372FE950) (a "movq xmm2, rax") (a "mulsd xmm0, xmm2") (a "roundsd xmm3, xmm0, 9") (a "subsd xmm0, xmm3")
                (a "mulsd xmm0, xmm1") (a "roundsd xmm0, xmm0, 9") (a "movq rax, xmm0"))
    "$sp" (: (a "mov rax, rsp") (int2num "rax"))
    "$ld16" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (num2int "rax" "rdx") (a "movzx rax, word ptr [rcx+rdx+8]") (int2num "rax"))
    "$st16" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (a "mov rdi, rax") (num2int "rax" "rsi")
               (popr "rdx") (popr "rcx") (untag "rcx") (num2int "rdx" "rdx") (a "mov byte ptr [rcx+rdx+8], sil") (a "shr rsi, 8") (a "mov byte ptr [rcx+rdx+9], sil") (a "mov rax, rdi"))
    "$ldf32" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (untag "rcx") (num2int "rax" "rdx") (a "movss xmm0, dword ptr [rcx+rdx+8]") (a "cvtss2sd xmm0, xmm0") (a "movq rax, xmm0"))
    "$stf32" (: (gen args[0]) (push_rax) (gen args[1]) (push_rax) (gen args[2]) (a "mov rdi, rax")
                (popr "rdx") (popr "rcx") (untag "rcx") (num2int "rdx" "rdx") (a "movq xmm0, rdi") (a "cvtsd2ss xmm0, xmm0") (a "movss dword ptr [rcx+rdx+8], xmm0") (a "mov rax, rdi"))
    "$gccopy" (: (for e args (gen e) (push_rax)) (popr "rdx") (num2int "rdx" "rdx") (popr "rsi") (num2int "rsi" "rsi") (popr "rdi") (num2int "rdi" "rdi") (a "call .gccopy"))
    "$strhash" (: (gen args[0]) (a "call .strhash"))
    "$streq" (: (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (a "call .streqany") (a "lea rax, [r11+1]") (a "lea rcx, [r11+2]") (a "test rdx, rdx") (a "cmovnz rax, rcx"))
    "$label" (: (lea_l 0 args[0][1]) (int2num "rax"))
    "$vtop" (: (a "mov rax, r14") (int2num "rax"))
    "$vbase" (: (a "mov rax, [268435512]") (int2num "rax"))
    "$hptr" (: (a "mov rax, r13") (int2num "rax"))
    "$heapbase" (: (a "mov rax, [268435504]") (int2num "rax"))
    "$nglob" (numconst 0 L.nglob)
    "$gcset" (: (for e args (gen e) (push_rax))
                (popr "rcx") (num2int "rcx" "rcx") (popr "rdx") (num2int "rdx" "rdx") (popr "rsi") (num2int "rsi" "rsi") (popr "r13") (num2int "r13" "r13")
                (a "mov [268435464], rdx") (a "mov [268435504], rsi") (a "mov [268435496], rcx") (a "mov rax, r11"))
    "$gclim" (: (gen args[0]) (num2int "rax" "rcx") (a "add rcx, r13") (a "mov [268435496], rcx") (a "mov rax, r11"))
    "$tracetop" (: (a "mov rax, [268435480]") (int2num "rax"))
    "$tracebase" (: (a "mov rax, [268435488]") (int2num "rax"))
    "$tracenames" (ptrconst 0 (strobj G.tracetab))
    "$void" (a "mov rax, r11")
    "$copy" (: (for e args (gen e) (push_rax))
               (popr "rcx") (num2int "rcx" "rcx") (popr "rdx") (num2int "rdx" "rdx") (popr "rsi") (untag "rsi") (popr "r8") (num2int "r8" "r8") (popr "rdi") (untag "rdi")
               (a "lea rsi, [rsi+rdx+8]") (a "lea rdi, [rdi+r8+8]") (a "rep movsb") (a "mov rax, r11"))
    (err (++ "internal: unknown primitive " op))))
; JS int32 semantics: operands are ToInt32'd (wrap to 32 bits), results are int32 (ushr: uint32)
(= (norm32) (a "shl rcx, 32") (a "sar rcx, 32"))
(= (binint args mn) (gen args[0]) (push_rax) (gen args[1]) (num2int "rax" "rdx") (popr "rcx") (num2int "rcx" "rcx")
  (af "%s rcx, rdx" mn) (norm32) (a "mov rax, rcx") (int2num "rax"))
(= (shiftint args mn) (gen args[0]) (push_rax) (gen args[1]) (num2int "rax" "rdx") (popr "rcx") (num2int "rcx" "rcx")
  (a "and rdx, 31") (a "mov rax, rcx") (a "mov rcx, rdx")
  (sw mn "ushr" (: (a "shl rax, 32") (a "shr rax, 32") (a "shr rax, cl"))
         "shl" (: (a "shl rax, 32") (a "sar rax, 32") (a "shl rax, cl") (a "shl rax, 32") (a "sar rax, 32"))
         (: (a "shl rax, 32") (a "sar rax, 32") (a "sar rax, cl")))
  (int2num "rax"))
(= (reverse_idx n) r=[] (for i n (push r n-1-i)) r)
(= (binraw args mn) (gen args[0]) (push_rax) (gen args[1]) (popr "rcx") (a "movq xmm0, rcx") (a "movq xmm1, rax") (a (++ mn " xmm0, xmm1")) (a "movq rax, xmm0"))

; ---- function code
(= (collect_inits x)
  (? (&& (is "list" x) #x>0 (is "str" x[0]))
     (: (? x[0]=="init" x[1].inited=true)
        (for y x[1..] (? (&& (is "list" y) (!= x[0] "fn")) (collect_inits y))))))
(= (box_new_nil) (alloc_const 16) (mov_imm64 1 1 T_BOX) (a "mov [rax], rcx") (a "mov [rax+8], r11") (a "or rax, r10"))
(= (gen_fn f)
  G.fn=f P=f.nparams ok=(nl)
  (label (++ ".f" f.id))
  (a "push r14") (a "mov r14, r15") (a "mov rax, rcx") (a "shl rax, 3") (a "sub r14, rax") (a "sub r14, 8")
  (? !f.rest (: (af "cmp rcx, %d" P) (a (++ "je " ok))))
  (af "mov rdx, %d" P) (a (? f.hasdef "lea rsi, [r11+3]" "mov rsi, r11")) (af "mov rdi, %d" (? f.rest 1 0)) (a "call .adjust")
  (label ok)
  (gen_poll)
  (? G.trace (trace_push f))
  nloc=f.nslots-1-P-(? f.rest 1 0)
  (for k nloc (af "mov [r15+%d], r11" 8*k))
  (? nloc>0 (af "add r15, %d" 8*nloc))
  (for v f.vars
    (? (boxed v)
       (? v.param (: (box_new_nil) (af "mov rcx, [r14+%d]" 8*v.slot) (a "mov [rax+8], rcx") (af "mov [r14+%d], rax" 8*v.slot))
          (! v.inited) (: (box_new_nil) (af "mov [r14+%d], rax" 8*v.slot)))))
  (gen f.body)
  (? G.trace (trace_pop))
  (a "mov r15, r14") (a "pop r14") (a "ret"))

; ---- runtime stubs (assembly)
(= (gen_stubs)
  (label ".oom") (a "mov rdi, 137") (a "mov rax, 231") (a "syscall")
  (label ".err_num") (ptrconst 0 (strobj "expected number")) (a "jmp .throw")
  (label ".gc")
  (mov_imm64 0 0x7FFFFFFF 0xFFFFFFFF) (a "mov [268435496], rax")
  (af "mov rsi, [%d]" (gaddr (prelude_gid "gc"))) (a "mov [r15], rsi") (a "add r15, 8") (a "mov rcx, 0") (a "call .callclosure") (a "ret")
  (label ".streqany")                                   ; rax = any value, rcx = string pointer -> rdx = 1 when rax is an equal string
  (a "cmp rax, rcx") (a "je .seq_yes")
  (a "mov rdx, rax") (a "shr rdx, 48") (a "cmp rdx, 0xFFFA") (a "jne .seq_no")
  (a "mov rsi, rax") (untag "rsi") (a "cmp byte ptr [rsi], 1") (a "jne .seq_no")
  (a "mov rdi, rcx") (untag "rdi")
  (a "mov r8, [rsi]") (a "mov r9, [rdi]") (a "shr r8, 32") (a "shr r9, 32") (a "cmp r8, r9") (a "jne .seq_no")
  (a "add rsi, 8") (a "add rdi, 8") (a "mov rcx, r8") (a "cmp rcx, rcx") (a "repe cmpsb") (a "jne .seq_no")
  (label ".seq_yes") (a "mov rdx, 1") (a "ret")
  (label ".seq_no") (a "mov rdx, 0") (a "ret")
  (label ".strhash")                                    ; rax = string/symbol pointer -> rax = 23-bit content hash (cached in the header)
  (untag "rax") (a "mov rcx, [rax]") (a "mov rdx, rcx") (a "and rdx, 256") (a "jnz .sh_cached")
  (a "mov r8, rcx") (a "shr r8, 32") (a "xor r9, r9") (a "lea rsi, [rax+8]") (a "test r8, r8") (a "jz .sh_done")
  (label ".sh_loop") (a "movzx rdi, byte ptr [rsi]") (a "imul r9, r9, 31") (a "add r9, rdi") (a "and r9, 8388607") (a "add rsi, 1") (a "sub r8, 1") (a "jnz .sh_loop")
  (label ".sh_done")
  (a "mov rdx, rcx") (a "shr rdx, 32") (a "shl rdx, 32") (a "and rcx, 255") (a "or rdx, rcx") (a "or rdx, 256") (a "mov rcx, r9") (a "shl rcx, 9") (a "or rdx, rcx") (a "mov [rax], rdx")
  (a "cvtsi2sd xmm0, r9") (a "movq rax, xmm0") (a "ret")
  (label ".sh_cached") (a "shl rcx, 32") (a "shr rcx, 41") (a "cvtsi2sd xmm0, rcx") (a "movq rax, xmm0") (a "ret")
  (label ".objinfo")                                    ; rax = header -> rdi = object size in bytes, rcx = number of value words to scan; clobbers rsi
  (a "mov rsi, rax") (a "shr rsi, 32") (a "movzx rdi, al")
  (a "cmp rdi, 1") (a "je .oi_str") (a "cmp rdi, 8") (a "je .oi_str") (a "cmp rdi, 9") (a "je .oi_str") (a "cmp rdi, 7") (a "je .oi_sym") (a "cmp rdi, 3") (a "je .oi_arr") (a "cmp rdi, 10") (a "je .oi_arr")
  (a "cmp rdi, 2") (a "je .oi_list") (a "cmp rdi, 4") (a "je .oi_map") (a "cmp rdi, 5") (a "je .oi_clo") (a "cmp rdi, 6") (a "je .oi_box")
  (a "mov rdi, 99") (a "mov rax, 231") (a "syscall")
  (label ".oi_str") (a "lea rdi, [rsi+8]") (a "and rdi, -8") (a "add rdi, 8") (a "mov rcx, 0") (a "ret")
  (label ".oi_sym") (a "lea rdi, [rsi+7]") (a "and rdi, -8") (a "add rdi, 32") (a "mov rcx, 0") (a "ret")
  (label ".oi_arr") (a "mov rcx, rsi") (a "test rcx, rcx") (a "jnz .oi_arr1") (a "mov rcx, 1") (label ".oi_arr1") (a "lea rdi, [rcx*8+8]") (a "ret")
  (label ".oi_list") (a "mov rdi, 32") (a "mov rcx, 3") (a "ret")
  (label ".oi_map") (a "mov rdi, 48") (a "mov rcx, 5") (a "ret")
  (label ".oi_clo") (a "lea rcx, [rsi+1]") (a "lea rdi, [rsi*8+16]") (a "ret")
  (label ".oi_box") (a "mov rdi, 16") (a "mov rcx, 1") (a "ret")
  (label ".fwdslot")                                    ; rbp = address of a value slot; r8/r9 = from-space [lo,hi), rbx = to-space free pointer, r10 = pointer tag
  (a "mov rax, [rbp]") (a "mov rdx, rax") (a "shr rdx, 48") (a "cmp rdx, 0xFFFA") (a "jne .fs_ret")
  (a "mov rdx, rax") (a "shl rdx, 16") (a "shr rdx, 16") (a "cmp rdx, r8") (a "jb .fs_ret") (a "cmp rdx, r9") (a "jae .fs_ret")
  (a "mov rax, [rdx]") (a "movzx rsi, al") (a "cmp rsi, 255") (a "je .fs_fwd")
  (a "call .objinfo") (a "mov rsi, rdx") (a "mov rcx, rdi") (a "mov rax, rdi") (a "mov rdi, rbx") (a "rep movsb")
  (a "mov rcx, rbx") (a "or rcx, r10") (a "add rbx, rax")
  (a "mov qword ptr [rdx], 255") (a "mov [rdx+8], rcx") (a "mov [rbp], rcx") (a "ret")
  (label ".fs_fwd") (a "mov rax, [rdx+8]") (a "mov [rbp], rax")
  (label ".fs_ret") (a "ret")
  (label ".gccopy")                                     ; rdi = to-space base, rsi = value-stack top, rdx = number of globals -> rax = new free pointer (as number)
  (a "mov [268435528], rsi") (af "lea rax, [rdx*8+%d]" GBASE) (a "mov [268435536], rax")
  (a "mov r8, [268435504]") (a "mov r9, r13") (a "mov rbx, rdi") (a "mov r12, rdi")
  (a "mov rbp, [268435512]")
  (label ".gc_r1") (a "cmp rbp, [268435528]") (a "jae .gc_r1d") (a "call .fwdslot") (a "add rbp, 8") (a "jmp .gc_r1")
  (label ".gc_r1d") (af "mov rbp, %d" GBASE)
  (label ".gc_r2") (a "cmp rbp, [268435536]") (a "jae .gc_r2d") (a "call .fwdslot") (a "add rbp, 8") (a "jmp .gc_r2")
  (label ".gc_r2d")
  (a "mov rax, [268435584]") (a "mov [268435616], rax")
  (label ".gc_i1") (a "mov rdx, [268435616]") (a "cmp rdx, [268435592]") (a "jae .gc_i1d")
  (a "mov rax, [rdx]") (a "call .objinfo") (a "mov rdx, [268435616]") (a "lea rbp, [rdx+8]") (a "add rdx, rdi") (a "mov [268435616], rdx")
  (label ".gc_i2") (a "test rcx, rcx") (a "jz .gc_i1") (a "push rcx") (a "call .fwdslot") (a "pop rcx") (a "add rbp, 8") (a "sub rcx, 1") (a "jmp .gc_i2")
  (label ".gc_i1d")
  (label ".gc_scan") (a "cmp r12, rbx") (a "jae .gc_done")
  (a "mov rax, [r12]") (a "call .objinfo") (a "push rdi") (a "lea rbp, [r12+8]")
  (label ".gc_sw") (a "test rcx, rcx") (a "jz .gc_swd") (a "push rcx") (a "call .fwdslot") (a "pop rcx") (a "add rbp, 8") (a "sub rcx, 1") (a "jmp .gc_sw")
  (label ".gc_swd") (a "pop rdi") (a "add r12, rdi") (a "jmp .gc_scan")
  (label ".gc_done") (a "cvtsi2sd xmm0, rbx") (a "movq rax, xmm0") (a "ret")
  (label ".sigprof")                                   ; SIGPROF handler (profiling): bump the sample counter of the innermost traced function
  (a "mov rax, [268435480]") (a "mov rcx, [268435488]") (a "cmp rax, rcx") (a "jbe .sigdone")
  (a "mov rax, [rax-8]") (a "and rax, 65535") (a "mov rcx, [268435520]") (a "test rcx, rcx") (a "jz .sigdone")
  (a "mov rdx, [rcx+rax*8]") (a "add rdx, 1") (a "mov [rcx+rax*8], rdx")
  (label ".sigdone") (a "ret")
  (label ".sigret") (a "mov rax, 15") (a "syscall")
  (label ".callclosure")
  (a "mov rax, rcx") (a "shl rax, 3") (a "mov rdx, r15") (a "sub rdx, rax") (a "mov rdx, [rdx-8]")
  (a "mov rax, rdx") (a "shr rax, 48") (a "cmp rax, 0xFFFA") (a "jne .notcallable")
  (a "shl rdx, 16") (a "shr rdx, 16") (a "mov rax, [rdx]") (a "and rax, 255") (a "cmp rax, 5") (a "jne .notcallable")
  (a "jmp qword ptr [rdx+8]")
  (label ".notcallable") (ptrconst 0 (strobj "not callable")) (a "jmp .throw")
  (label ".throw")
  (a "mov rcx, [268435456]") (a "test rcx, rcx") (a "jz .fatal")
  (a "mov rsp, rcx") (a "mov rcx, [rsp+16]") (a "jmp rcx")
  (label ".fatal")
  (af "mov rsi, [%d]" (gaddr (prelude_gid "fatal"))) (a "mov [r15], rsi") (a "mov [r15+8], rax") (a "add r15, 16") (a "mov rcx, 1") (a "call .callclosure")
  (a "mov rdi, 1") (a "mov rax, 231") (a "syscall")
  ; truthiness: rax -> rdx (1/0); preserves rax
  (label ".truthy")
  (a "cmp rax, r11") (a "jb .Tdbl") (a "je .Tf") (a "lea rcx, [r11+1]") (a "cmp rax, rcx") (a "je .Tf") (a "cmp rax, r10") (a "jb .Tt")
  (a "mov rcx, rax") (a "shl rcx, 16") (a "shr rcx, 16") (a "mov rdx, [rcx]") (a "and rdx, 255")
  (a "cmp rdx, 1") (a "je .Tlen") (a "cmp rdx, 2") (a "je .Tcnt") (a "cmp rdx, 4") (a "je .Tcnt") (a "jmp .Tt")
  (label ".Tlen") (a "mov rdx, [rcx]") (a "shr rdx, 32") (a "jmp .Tnz")
  (label ".Tcnt") (a "mov rdx, [rcx+8]")
  (label ".Tnz") (a "test rdx, rdx") (a "jz .Tf") (a "jmp .Tt")
  (label ".Tdbl") (a "movq xmm0, rax") (a "xorpd xmm1, xmm1") (a "ucomisd xmm0, xmm1") (a "jp .Tf") (a "je .Tf")
  (label ".Tt") (a "mov rdx, 1") (a "ret")
  (label ".Tf") (a "mov rdx, 0") (a "ret")
  ; argument adjustment: rcx=nargs rdx=P rsi=fill rdi=rest?  (r14 = frame, r15 = end of args)
  (label ".adjust")
  (a "cmp rcx, rdx") (a "jb .Afew") (a "test rdi, rdi") (a "jnz .Arest") (a "lea r15, [r14+rdx*8+8]") (a "ret")
  (label ".Afew") (a "mov [r15], rsi") (a "add r15, 8") (a "add rcx, 1") (a "cmp rcx, rdx") (a "jb .Afew")
  (a "test rdi, rdi") (a "jz .Aret") (a "mov rax, 0") (a "mov r8, r15") (a "jmp .Amk")
  (label ".Arest") (a "mov rax, rcx") (a "sub rax, rdx") (a "lea r8, [r14+rdx*8+8]")
  (label ".Amk")                                    ; build a list of the rax values at [r8]; place it at r8
  (a "mov r9, rax") (a "mov rsi, r9") (a "test rsi, rsi") (a "jnz .Amk0") (a "mov rsi, 1") (label ".Amk0") (a "shl rsi, 3") (a "add rsi, 40")
  (a "mov rdi, r13") (a "add r13, rsi") (a "cmp r13, [268435464]") (a "ja .oom")
  (a "mov rax, r9") (a "shl rax, 32") (a "or rax, 3") (a "mov [rdi], rax")
  (a "mov rdx, rdi") (a "lea rdi, [rdx+8]") (a "mov rsi, r8") (a "mov rcx, r9") (a "rep movsq")
  (a "test r9, r9") (a "jnz .Amk1") (a "mov [rdi], r11") (a "add rdi, 8") (label ".Amk1")
  (mov_imm64 0 3 2) (a "mov [rdi], rax") (a "cvtsi2sd xmm0, r9") (a "movq rax, xmm0") (a "mov [rdi+8], rax")
  (a "mov rax, rdx") (a "or rax, r10") (a "mov [rdi+16], rax") (a "mov [rdi+24], r11") (a "mov rax, rdi") (a "or rax, r10")
  (a "mov r15, r8") (a "mov [r15], rax") (a "add r15, 8")
  (label ".Aret") (a "ret")
  ; slow paths: operands on the value stack -> call the prelude function by name
  (label ".slow_put")
  (a "mov rcx, [r15-24]") (a "mov rdx, [r15-16]") (a "mov rdi, [r15-8]") (af "mov rsi, [%d]" (gaddr (prelude_gid "put")))
  (a "mov [r15-24], rsi") (a "mov [r15-16], rcx") (a "mov [r15-8], rdx") (a "mov [r15], rdi") (a "add r15, 8") (a "mov rcx, 3") (a "jmp .callclosure")
  (for nm ["add2" "sub2" "mul2" "div2" "lt2" "gt2" "le2" "ge2" "eq2" "ne2" "mod2" "fdiv2" "pow2" "band2" "bor2" "bxor2" "shl2" "shr2" "ushr2" "at"]
    (label (++ ".slow_" nm))
    (a "mov rcx, [r15-16]") (a "mov rdx, [r15-8]") (af "mov rsi, [%d]" (gaddr (prelude_gid nm)))
    (a "mov [r15-16], rsi") (a "mov [r15-8], rcx") (a "mov [r15], rdx") (a "add r15, 8") (a "mov rcx, 2") (a "jmp .callclosure"))
  (for nm ["neg1" "bnot1" "len"]
    (label (++ ".slow1_" nm))
    (a "mov rcx, [r15-8]") (af "mov rsi, [%d]" (gaddr (prelude_gid nm)))
    (a "mov [r15-8], rsi") (a "mov [r15], rcx") (a "add r15, 8") (a "mov rcx, 1") (a "jmp .callclosure")))
(= (prelude_gid nm) v=L.prelude.vars[nm] (? v==nil (err (++ "runtime function missing: " nm))) v.gid)

; ---- process entry
(= (mmap_to size reg)
  (a "mov rax, 9") (a "mov rdi, 0") (af "mov rsi, %d" size) (a "mov rdx, 3") (a "mov r10, 16418") (a "mov r8, -1") (a "mov r9, 0") (a "syscall")
  (af "mov %s, rax" reg))
(= (gen_start main)
  (label "_start")
  (a "mov [268435472], rsp")
  (mmap_to HEAP_SIZE "r13") (a "mov [268435504], r13") (a "mov rcx, r13") (af "mov rdx, %d" HEAP_SIZE) (a "add rcx, rdx") (a "mov [268435464], rcx")
  (a "mov rcx, r13") (af "mov rdx, %d" GC_FIRST) (a "add rcx, rdx") (a "mov [268435496], rcx")
  (? G.trace (: (mmap_to 1073741824 "rax") (a "mov [268435480], rax") (a "mov [268435488], rax")))
  (mmap_to 1073741824 "r15") (a "mov [268435512], r15")
  (mmap_to 1073741824 "rbx") (a "mov rdx, 1073741824") (a "add rbx, rdx") (a "mov rsp, rbx") (a "mov [268435576], rsp")
  (reload_consts)
  (af "mov rdi, %d" GBASE) (af "mov rcx, %d" L.nglob) (a "mov rax, r11") (a "rep stosq")
  (a "mov r14, r15")
  (a "mov [r15], r11") (a "add r15, 8") (a "mov rcx, 0") (a (++ "call .f" main.id))
  (af "mov rsi, [%d]" (gaddr (prelude_gid "finish"))) (a "mov [r15], rsi") (a "add r15, 8") (a "mov rcx, 0") (a "call .callclosure")
  (a "mov rdi, 0") (a "mov rax, 231") (a "syscall"))

(= (patch64 arr pos v) (for i 8 arr[pos+i]=v%256 v=v//256))
(= (patch32 arr pos v) (for i 4 arr[pos+i]=(v>>(8*i))&255))
; ---- compile-time values embedded as ordinary heap-layout objects in the data segment (used to bake a prebuilt runtime image into the compiler)
STATIC_PTR=4294574080
STATIC_NIL=4294508544
G.simg={}
(= (sv_u8 a) n=#a (dalign) addr=0x10000000+(dpos) (dword 9 n) (for b a (dbyte b)) (dbyte 0) (dalign) addr)
(= (sv_arr vals n)                   ; ARR of n words (at least one slot is always allocated)
  (dalign) addr=0x10000000+(dpos) (dword 3 n)
  (for p vals (dword p[0] p[1]))
  (? n==0 (dword 0 STATIC_NIL))
  addr)
(= (dbl_bits x) [hi lo]=(f64bits x) [lo hi])
(= (vbits v)
  (? (== v nil) [0 STATIC_NIL] (== v false) [1 STATIC_NIL] (== v true) [2 STATIC_NIL]
     (is "num" v) (dbl_bits v)
     (is "str" v) [(strobj v) STATIC_PTR]
     [(static_ptr v) STATIC_PTR]))
(= (static_ptr v)
  a=G.simg[v]
  (? a a
     (: a=(sw (ty v) "list" (sv_list v) "map" (sv_map v) "arr" (sv_u8 v) (err (++ "cannot embed a " (ty v) " in a program image")))
        G.simg[v]=a a)))
(= (sv_list l)
  n=#l vals=(~ vbits l) arr=(sv_arr vals n)
  (dalign) addr=0x10000000+(dpos)
  (dword 2 3) (dword ..(dbl_bits n)) (dword arr STATIC_PTR) (dword 0 STATIC_NIL)
  addr)
(= (hslot_ak h size) x=h*0.6180339887498949 (flr (* (- x (flr x)) size)))
(= (key_hash k) (? (is "str" k) (hash23 k) (is "num" k) k (err "image map keys must be strings or numbers")))
(= (sv_map m)
  ents=(prs m) n=#ents cap=4
  (wh cap<=n cap*=2)
  size=2*cap vals=[] idx=(~ _=>nil (0..size))
  (for i n [k v]=ents[i]
    kb=(vbits k) vb=(vbits v)
    (push vals kb) (push vals vb)
    s=(hslot_ak (key_hash k) size)
    (wh idx[s]!=nil s=(s+1)%size)
    idx[s]=i)
  (wh #vals<size (push vals [0 STATIC_NIL]))
  entaddr=(sv_arr vals size)
  idxaddr=(sv_arr (~ i=>(? i==nil [0 STATIC_NIL] (dbl_bits i)) idx) size)
  (dalign) addr=0x10000000+(dpos)
  (dword 4 5) (dword ..(dbl_bits n)) (dword entaddr STATIC_PTR) (dword idxaddr STATIC_PTR) (dword ..(dbl_bits n)) (dword 0 STATIC_NIL)
  addr)

; ---- whole-program drivers.  full: runtime + program in one go.  image: just the runtime (stubs, library, init code).
; user: only the program, linked after a prebuilt image (its code/data come first; labels, strings and variables are looked up in it).
(= (gen_begin img)
  (asm_reset)
  G.trace=(&& (!= (env "AK_TRACE") nil) (! img)) G.postab=[] G.curpos=nil G.dfix=[] G.strs={} G.lbl=0 G.fn=nil G.img=img
  G.data=[] G.dbase=0
  (? img (: A.base=#img.code A.ext=img.labels G.dbase=#img.data G.lbl=img.lbl)
     (for i 256 (dbyte 0)))
  G.tracetab=(? G.trace (join (~ f=>(++ f.id " " f.name " " f.pos) L.funcs) "\n") ""))
(= (gen_finish)
  (link)
  (dalign) simg0=0x10000000+(dpos)
  sptrs=(~ v=>(static_ptr v) L.statics)
  (dalign) simg1=0x10000000+(dpos)
  (dalign) postab=0x10000000+(dpos)
  entries=(? G.img [..G.img.postab ..G.postab] G.postab)
  (for [off pos] entries (dword off (pos//1048576)%1048576) (dword pos%1048576 pos//1099511627776))
  files=(strobj (join L.files "\n"))
  (for [off lbl] G.dfix
    t=(?? A.labels[lbl] A.ext[lbl])
    (? t==nil (err (++ "undefined label " lbl)))
    (patch32 G.data off-G.dbase CODE_BASE+t))
  data=(? G.img (bcat G.img.data (u8 G.data)) (u8 G.data))
  code=(? G.img (bcat G.img.code (u8 A.code)) (u8 A.code))
  (patch64 data 88 postab) (patch64 data 96 #entries) (patch64 data 104 files) (patch64 data 112 CODE_BASE+(here))
  (patch64 data 128 simg0) (patch64 data 136 simg1)
  (for [i a] (enum sptrs) (patch32 data 144+8*i a) (patch32 data 148+8*i STATIC_PTR))
  [code data])
(= (gen_program main)
  (gen_begin nil)
  (for f L.funcs (collect_inits f.body) (walk_ir f.body))
  (gen_start main)
  (gen_stubs)
  (for f L.funcs (gen_fn f))
  (? (env "AK_TIME") (ep "codegen done" (clock)))
  [code data]=(gen_finish)
  (elf_bytes code data 8*L.nglob A.labels["_start"]))
(= (export_vars)
  out={}
  (for [name v] L.prelude.vars
    out[name]={:name name :kind v.kind :id v.id :gid v.gid :pre true :intrinsic v.intrinsic :isfn v.isfn :arity v.arity :nsets v.nsets
               :defn (? v.defn {:id v.defn.id :free [] :static v.defn.static})})
  out)
(= (gen_image main)
  (gen_begin nil)
  (for f L.funcs (collect_inits f.body) (walk_ir f.body))
  (gen_stubs)
  (for f L.funcs (gen_fn f))
  [code data]=(gen_finish)
  {:code code :data data :labels A.labels :strs G.strs :postab G.postab :files L.files :vars (export_vars) :uid L.uid :nglob L.nglob :lbl G.lbl :initid main.id})
(= (gen_user main img)
  (gen_begin img)
  (for f L.funcs (collect_inits f.body) (walk_ir f.body))
  (gen_start main)
  (for f L.funcs (gen_fn f))
  [code data]=(gen_finish)
  (elf_bytes code data 8*L.nglob A.labels["_start"]))
