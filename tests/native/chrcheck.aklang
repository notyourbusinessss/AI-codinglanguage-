; chr rejects anything that is not an integer code point in 0..0x10FFFF, with the same message on both targets
(p (try (chr -1) e=>e) (try (chr 65.5) e=>e) (try (chr 1114112) e=>e) (try (chr "a") e=>e) (try (chr nil) e=>e))
(p (chr 65) (chr 233) (chr 8364) (chr 128512) (chr 0x10FFFF)==(chr 1114111) #(chr 0))
