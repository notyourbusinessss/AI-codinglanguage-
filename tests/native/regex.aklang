r=(re "[0-9]" "g")
(p r)
(p (match r "ab12"))
(p (match "b+" "aabbbcc"))
(p (rep "a1b22c" r "#"))
(p (match "(\\w+)@(\\w+)\\.com" "mail bob@example.com now"))
(p (match "^(a|b)*c$" "ababc") (match "^(a|b)*c$" "abd"))
(p (rep "hello world" (re "o" "g") "0") (rep "a-b-c" (re "-") "+"))
(p (rep "John Smith" (re "(\\w+) (\\w+)") "$2, $1"))
(p (split "a1b22c333d" (re "[0-9]+")))
(p (split "a, b,c" (re "\\s*,\\s*")))
(p (match "(?<y>\\d{4})-(\\d{2})" "on 2024-05-17") (match "x*?y" "xxy") (match (re "abc" "i") "xABC"))
(p (match "colou?r" "color") (match "a{2,3}" "aaaa") (match "\\bfoo\\b" "a foo b") (match "(?=a)a" "a") (match "a(?!b)" "ab ac"))
(p (match "(a)\\1" "aa") (match "[^abc]+" "abcdef") (match "." "é") (match "é+" "ééa"))
(p (rep "aaa" (re "a*?") "-") (rep "abc" (re "") "-"))
