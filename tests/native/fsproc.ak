d="/tmp/akfs_test"
(rm d)
(mkdir (++ d "/a/b/c"))
(p (isdir d) (isdir (++ d "/a/b")) (isdir (++ d "/zzz")))
(wr (++ d "/a/x.txt") "hello")
(wr (++ d "/a/y.txt") "world")
(p (ls (++ d "/a")) (ex (++ d "/a/x.txt")))
(mv (++ d "/a/x.txt") (++ d "/a/z.txt"))
(p (ls (++ d "/a")) (rd (++ d "/a/z.txt")))
(p (sh "echo hi; echo there"))
(p (trim (sh "printf 'a b c' | tr a-z A-Z")))
(p (try (sh "exit 3") e=>e))
(rm d)
(p (ex d))
