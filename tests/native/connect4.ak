; Connect Four (examples/connect4): rules, the computer player's tactics, and the HTML page
(use "../../examples/connect4/game.ak")
(= (setup cells) b=(rpt [0] 42) (for [i v] cells b[i]=v) b)
(p "lines" #WIN "through the centre cell" #AT[17])
(p "wins at" (think (setup [[35 2] [36 2] [37 2] [38 1]]) 2 3) "blocks at" (think (setup [[35 1] [28 1] [21 1] [36 2] [29 2]]) 2 3))
(p "opening" (think (rpt [0] 42) 1 6) "diagonal win" (? (won (setup [[35 1] [29 1] [23 1] [17 1]]) 17 1) "found" "missed"))
(p "score" (score (setup [[38 1] [37 2]]) 1) (score (setup [[38 1] [37 1] [36 1]]) 1))
(reset 2)
(for c [3 3 2 4 5 1 0]
  (play c))
(for r H (p (join (~ c=>($ B[r*W+c]) 0..W) "")))
(p MSG OVER LAST HL)
(reset 5)
(play 3)
(p "after one move" (- #(split (page) "<a class=col") 1) "open columns," (has (page) "class='r") (has (page) "class='y") (has (page) "Your move."))
(play 99)
(play nil)
(play 1.5)
(p "discs after three invalid moves:" (sum (~ x=>(? (== x 0) 0 1) B)))
