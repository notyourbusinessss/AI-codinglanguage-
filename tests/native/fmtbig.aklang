; %d and friends on huge, special and boundary values (agrees with the JS backend: exact below 2^53, shortest digits above)
(for v [0 1 -1 9 10 99 100 12345 -12345 999999999999999 1e15 9007199254740991 9007199254740992 1e19 4611686018427387904.0 -1e19 1e20 1e21 -1e21 1e22 1e100 1e300]
  (p (fmt "%d" v) (fmt "[%5d|%-8d|%08d]" v v v)))
(p (fmt "%d" (/ 0 1)) (++ 5 " " -7 " " 0 " " 123456789))
