; counts, slice bounds and delete positions drop their fraction (toward zero, NaN is 0) on both targets; typed arrays truncate before wrapping
nan=(sqrt -1)
(p (rpt "ab" 1.5) (rpt [1 2] 1.5) (rpt "a" 2.9) (rpt "a" nan) (rpt "a" -0.5) (#(rpt "ab" 1.5)))
(p "abcdef"[1.5..4] [1 2 3 4][1.5..3] [1 2 3 4][-1.5..] "abcdef"[..2.5] [1 2 3 4][nan..2])
(p (take 1.5 [1 2 3]) (drop 1.5 [1 2 3]) (take 1.5 "abc") (sub [1 2 3 4] 0.5 2.5) (sub "abcd" -3.5 -0.5))
(p (del [1 2 3] 1.5) (del [1 2 3] -1.5) (del [1 2 3] 5) (del [1 2 3] nan))
(p (u32 [-0.9 -65536.5 1.5 -1.5 4294967295.9]) (i32 [-0.9 -65536.5 1.5 -1.5 4294967295.9 2147483648.5]) (u32 [nan]) (i32 [nan]))
a=(u32 2)
(p (<@ a 0 -0.9) a[0] (<@ a 1 65536.5) a[1])
