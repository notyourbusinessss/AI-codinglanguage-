; Fake HTTP servers for the HTTP client tests: ak http_fake.aklang mode [n] [log] -> prints its port, then serves n connections (default 1) on 127.0.0.1.
;   inf      200 with a body that never ends          big      200 with 500000 bytes of "x" (Content-Length)
;   chunked  200 chunked, 3 chunks of 100000 bytes    proxy    an HTTP proxy: appends each request head to the file log, answers "ok", or tunnels a CONNECT
[mode n log]=(args)
l=(tcpl 0 "127.0.0.1")
(fdw 1 (++ (tcpp l) "\n"))
(= (head c) buf="" (wh (! (has buf "\r\n\r\n")) d=(fdr c 4096 5000) (? (|| (== d nil) (== d "")) (exit 1)) buf+=d) buf)
(= (tunnel c line)
  [m au]=(split line " ") hp=(split au ":") up=(tcpc hp[0] (num hp[1]))
  (fdw c "HTTP/1.1 200 Connection established\r\n\r\n")
  live=true
  (wh live
    (for fd (fdwait [c up] 5000)
      d=(fdr fd 65536 1000)
      (? (|| (== d nil) (== d "")) live=false (fdw (? (== fd c) up c) d))))
  (fdc up))
(for i (num (?? n "1"))
  c=(tcpa l)
  h=(head c)
  (sw mode
    "inf" (: (fdw c "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n") (wh true (fdw c (rpt "x" 100000))))
    "big" (fdw c (++ "HTTP/1.1 200 OK\r\nContent-Length: 500000\r\nConnection: close\r\n\r\n" (rpt "x" 500000)))
    "chunked" (fdw c (++ "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n" (join (~ i=>(++ "186a0\r\n" (rpt "y" 100000) "\r\n") 0..3) "") "0\r\n\r\n"))
    "proxy" (: line=(split h "\r\n")[0] (app log (++ h "\n--\n"))
               (? (starts line "CONNECT ") (tunnel c line)
                  (fdw c "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")))
    nil)
  (fdc c))
