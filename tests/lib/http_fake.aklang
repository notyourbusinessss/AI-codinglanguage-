; Fake HTTP servers for the HTTP client tests: ak http_fake.aklang mode [n] [log] -> prints its port, then serves n connections (default 1) on 127.0.0.1.
;   inf      200 with a body that never ends          big      200 with 500000 bytes of "x" (Content-Length)
; keep (3 requests per connection, then close) and drop (one reply per connection, kept-alive in words only) append "conn i req k" to the file log
; enc: serves the file log with Content-Encoding enc and echoes the request's Accept-Encoding line as X-Accept
; badstatus, badlen, neglen, dup (Content-Length: 2, 2), loop (302 to itself): malformed or looping replies
;   chunked  200 chunked, 3 chunks of 100000 bytes    proxy    an HTTP proxy: appends each request head to the file log, answers "ok", or tunnels a CONNECT
[mode n log enc]=(args)
l=(tcpl 0 "127.0.0.1")
(fdw 1 (++ (tcpp l) "\n"))
(= (head c) buf="" (wh (! (has buf "\r\n\r\n")) d=(fdr c 4096 5000) (? (|| (== d nil) (== d "")) (exit 1)) buf+=d) buf)
(= (tunnel c line)
  [m au]=(split line " ") hp=(split au ":") up=(tcpc hp[0] (num hp[1]))
  (fdw c "HTTP/1.1 200 Connection established\r\n\r\n")
  live=true
  (wh live
    (for fd (fdwait [c up] 5000)
      d=(fdr fd 65536 1000)
      (? (|| (== d nil) (== d "")) live=false (fdw (? (== fd c) up c) d))))
  (fdc up))
(= (head2 c) buf="" (wh (&& (!= buf nil) (! (has buf "\r\n\r\n"))) d=(fdr c 4096 3000) (? (|| (== d nil) (== d "")) buf=nil buf+=d)) buf)
(= (keep c i)                           ; keep-alive connection i: every reply is length-delimited (odd requests chunked); the third says Connection: close
  k=0 go=true
  (wh go
    h=(head2 c)
    (? (== h nil) go=false
       (: k+=1 body=(++ "r" i "." k) go=(< k 3)
          (app log (++ "conn " i " req " k "\n"))
          (fdw c (++ "HTTP/1.1 200 OK\r\n" (? go "" "Connection: close\r\n") (? (== (% k 2) 1) (++ "Transfer-Encoding: chunked\r\n\r\n" (len body) "\r\n" body "\r\n0\r\n\r\n") (++ "Content-Length: " (len body) "\r\n\r\n" body))))))))
(= (dropper c i)                        ; answers one request as if the connection stayed open, then closes it anyway
  h=(head2 c) (app log (++ "conn " i " req 1\n"))
  (fdw c (++ "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nr" i ".1")))
(for i (num (?? n "1"))
  c=(tcpa l)
  h=(? (has ["keep" "drop"] mode) "" (head c))
  (sw mode
    "keep" (keep c i)
    "drop" (dropper c i)
    "inf" (: (fdw c "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n") (wh true (fdw c (rpt "x" 100000))))
    "big" (fdw c (++ "HTTP/1.1 200 OK\r\nContent-Length: 500000\r\nConnection: close\r\n\r\n" (rpt "x" 500000)))
    "chunked" (fdw c (++ "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n" (join (~ i=>(++ "186a0\r\n" (rpt "y" 100000) "\r\n") 0..3) "") "0\r\n\r\n"))
    "badstatus" (fdw c "garbage\r\n\r\nhi")
    "badlen" (fdw c "HTTP/1.1 200 OK\r\nContent-Length: abc\r\n\r\nhi")
    "neglen" (fdw c "HTTP/1.1 200 OK\r\nContent-Length: -5\r\n\r\nhi")
    "dup" (fdw c "HTTP/1.1 200 OK\r\nContent-Length: 2, 2\r\n\r\nhiXX")
    "loop" (fdw c "HTTP/1.1 302 Found\r\nLocation: /\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    "enc" (fdw c (++ "HTTP/1.1 200 OK\r\nContent-Encoding: " enc "\r\nContent-Length: " (len (rd log)) "\r\nX-Accept: " (?? (fst (~? l=>(starts (lo l) "accept-encoding:") (split h "\r\n"))) "none") "\r\nConnection: close\r\n\r\n" (rd log)))
    "proxy" (: line=(split h "\r\n")[0] (app log (++ h "\n--\n"))
               (? (starts line "CONNECT ") (tunnel c line)
                  (fdw c "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")))
    nil)
  (fdc c))
