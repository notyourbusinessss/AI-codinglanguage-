; Child of tests/accept_timeout.test.aklang: a ticker task keeps ticking while another task waits in tcpa with a timeout (#223)
(use "../../lib/async.aklang" as a)
l=(tcpl 0 "127.0.0.1")
ticks=[] got="unset" ms=nil
(= (ticker) (for i 8 (push ticks (now)) (a.sleep 50)))
(= (waiter) t0=(now) (<- got (tcpa l 400)) (<- ms (- (now) t0)))
(a.spawn ticker) (a.spawn waiter)
a.run()
gap=0
(for i 1..#ticks gap=(max gap ticks[i]-ticks[i-1]))
(p "ticks" #ticks "gap" gap "got" (show got) "ms" ms)
