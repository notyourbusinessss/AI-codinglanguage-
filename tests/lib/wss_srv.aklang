; Test server for wss:// (lib/ws.aklang over lib/tls.aklang): ak wss_srv.aklang cert.pem key.pem n -> prints its port, then serves n connections one after the other.
; Echoes text and binary messages, "close" closes with 1000, "big" answers 70000 bytes. Prints "done" or "ERR <message>" per connection.
(use "../../lib/ws.aklang" as w)
(use "../../lib/tls.aklang" as t)
[cert key n]=(args)
cr=(t.creds {:cert (rd cert) :key (rd key)})
l=(tcpl 0 "127.0.0.1")
(fdw 1 (++ (tcpp l) "\n"))
(= (serve ws)
  m=(w.recv ws)
  (wh (!= m nil)
    (? (== m "close") (: (w.close ws 1000 "bye") m=nil)
       (: (? (== m "big") (w.send ws (rpt "x" 70000))
              (? ws.bin (w.sendb ws m) (w.send ws m)))
          m=(w.recv ws)))))
(for i (num n)
  fd=(tcpa l)
  (fdw 1 (++ (try (: cn=(t.accept fd cr)
                     ws=(w.accept {:r k=>(t.read cn k) :w s=>(t.write cn s) :c ()=>(t.close cn)} {:protocols ["echo"]})
                     (? ws (serve ws)) (try (t.close cn) e=>nil) "done")
                 e=>(++ "ERR " e)) "\n")))
