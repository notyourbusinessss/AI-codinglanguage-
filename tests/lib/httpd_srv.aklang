; Test server for lib/httpd.aklang: ak httpd_srv.aklang -> prints its port, then serves forever (the test kills it).
(use "../../lib/httpd.aklang" as s)
(use "../../lib/async.aklang" as a)
(= (hello rq) (++ "hello " (?? rq.params.id "-")))
h=(s.router [["GET" "/" (\ (rq) "root")]
             ["GET" "/user/:id" hello]
             ["POST" "/echo" (\ (rq) [201 "text/plain" (++ rq.method ":" rq.body ":" (?? rq.query.x "") ":" (?? rq.headers["x-extra"] ""))])]
             ["GET" "/q" (\ (rq) (json rq.query))]
             ["GET" "/files/*" (\ (rq) (++ "rest=" rq.params.rest))]
             ["GET" "/slow" (\ (rq) (a.sleep 300) "slow")]
             ["GET" "/boom" (\ (rq) (assert false "boom") "never")]
             ["GET" "/peer" (\ (rq) (++ rq.peer.ip ":" (> rq.peer.port 0)))]
             ["GET" "/nothing" (\ (rq) nil)]])
l=(s.listen 0 h {:maxbody 1000 :maxhead 2000 :maxreq 3})
(fdw 1 (++ (tcpp l) "\n"))
s.run()
