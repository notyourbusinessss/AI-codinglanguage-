; Test server for lib/tls.aklang's server side: ak tls_serve.aklang cert.pem key.pem n -> prints its port, then serves n connections on 127.0.0.1 and exits.
; "GET /big" answers 300000 bytes of "abcdefghij"; any other GET answers "hello <sni>"; non-HTTP input is echoed back after "echo:". One line per connection: "ok <sni>" or "ERR <message>".
(use "../../lib/tls.aklang" as t)
[cert key n]=(args)
cr=(t.creds {:cert (rd cert) :key (rd key)})
l=(tcpl 0 "127.0.0.1")
(= (say s) (fdw 1 (++ s "\n")))
(say (tcpp l))
(= (reply cn)
  d=(t.read cn)
  body=(? (starts d "GET /big") (rpt "abcdefghij" 30000) (starts d "GET ") (++ "hello " cn.sni) (++ "echo:" d))
  (t.write cn (? (starts d "GET ") (++ "HTTP/1.0 200 OK\r\nContent-Length: " #body "\r\nConnection: close\r\n\r\n" body) body)))
(for i (num n)
  fd=(tcpa l)
  (say (try (: cn=(t.accept fd cr) (reply cn) (t.close cn) (++ "ok " (?? cn.sni ""))) e=>(++ "ERR " e))))
