; lib/http :on-data (#222): the body reaches the program piece by piece while it arrives
(use "../lib/http.aklang" as h)
(use "../lib/pki.aklang" as k)
(use "lib/run.aklang" as t)
base=(+ "/tmp/akstream-" ($ (now)) "-" ($ (rand 1000000000)))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(= (waitline f) (wh (|| (! (ex f)) (! (has (rd f) "\n"))) (sleep 50)) (split (trim (rd f)) "\n"))
pids=[]
(= (finish) (sh (+ "kill " (join pids " ") " 2>/dev/null; rm -rf " base "*")))
(= (start args tag) (<- pids (+> pids (trim (sh (+ "bin/ak tests/lib/stream_srv.aklang " args " >" base tag " 2>&1 & echo $!"))))) (num (waitline (+ base tag))[0]))
; a request whose body goes to a callback: [response, [[ms-since-start piece] ..], ms until the request returned]
(= (watch url opts)
  got=[] t0=(now)
  rr=(h.get url nil (set (?? opts {}) "on-data" (\ (d) (push got [(- (now) t0) d]))))
  [rr got (- (now) t0)])
(= (check name url pieces opts)
  [rr got total]=(watch url opts)
  (is (+ name ": status") rr.status 200)
  (is (+ name ": the body is in the callback, not in :body") rr.body "")
  (is (+ name ": all the bytes arrive") (join (~ x=>x[1] got) "") pieces)
  (is (+ name ": several calls") (>= #got 3) true)
  (is (+ name ": the first piece comes before the request returns") (< got[0][0] (- total 300)) true)
  (is (+ name ": :size counts the bytes") rr.size #pieces))
r=(try (:
  p=(start "" ".o")
  u=(+ "http://127.0.0.1:" p)
  (check "chunked" (+ u "/chunked") "one\ntwo\ntre\n" nil)
  (check "content-length" (+ u "/length") "abcdefghijkl" nil)
  (check "read until close" (+ u "/close") "xxxxyyyyzzzz" nil)
  ; gzip cannot be decoded halfway: the callback gets the decoded body once
  [rr got total]=(watch (+ u "/gzip") {:gzip true})
  (is "gzip: status" rr.status 200)
  (is "gzip: decoded once" (~ x=>x[1] got) ["gzip one\ngzip two\n"])
  (is "gzip: nothing in :body" rr.body "")
  ; without :gzip the encoded bytes are passed on as they are
  [rr got total]=(watch (+ u "/gzip") nil)
  (is "no :gzip: raw bytes" (#(join (~ x=>x[1] got) "")) 35)
  ; an error reply is not streamed: its body stays in :body so the error can be read
  [rr got total]=(watch (+ u "/missing") nil)
  (is "404: status" rr.status 404)
  (is "404: body kept" rr.body "missing")
  (is "404: callback not called" #got 0)
  ; empty bodies
  [rr got total]=(watch (+ u "/empty") nil)
  (is "empty: callback not called" [rr.status #got rr.body] [200 0 ""])
  rh=(h.req "HEAD" (+ u "/chunked") nil nil {"on-data" (\ (d) (assert false "HEAD has no body"))})
  (is "HEAD" rh.status 200)
  ; the same through a proxy (the server reads the absolute URL)
  [rr got total]=(watch "http://stream.example/chunked" {:proxy u})
  (is "proxy: bytes" (join (~ x=>x[1] got) "") "one\ntwo\ntre\n")
  (is "proxy: first piece early" (< got[0][0] (- total 300)) true)
  ; :max keeps applying; raising in the callback stops the request
  e=(try (h.get (+ u "/chunked") nil {"on-data" (\ (d) nil) :max 6}) x=>x)
  (is ":max still applies" (has e "over the limit") true)
  e=(try (h.get (+ u "/chunked") nil {"on-data" (\ (d) (raise "io" "enough" nil))}) x=>x)
  (is "a callback that raises stops the request" e "enough")
  (is "an option that is not a function" (has (try (h.get (+ u "/chunked") nil {"on-data" 5}) x=>x) "on-data") true)
  ; h.eachline: one call per line (\n or \r\n), also for the last line without one
  got=[] t0=(now)
  rr=(h.eachline (+ u "/chunked") nil nil (\ (l) (push got [(- (now) t0) l])))
  (is "eachline: lines" (~ x=>x[1] got) ["one" "two" "tre"])
  (is "eachline: the first line comes early" (< got[0][0] 350) true)
  (is "eachline: the response" [rr.status rr.body] [200 ""])
  got=[] rr=(h.eachline (+ u "/length") nil nil (\ (l) (push got l)))
  (is "eachline: a last line without newline" got ["abcdefghijkl"])
  got=[] rr=(h.eachline (+ u "/missing") nil nil (\ (l) (push got l)))
  (is "eachline: an error reply is not streamed" [rr.status rr.body got] [404 "missing" []])
  ; h.sse: events with the right fields, a split line, CRLF line ends and a comment
  evs=[] t0=(now)
  rr=(h.sse (+ u "/sse") nil nil (\ (e) (push evs [(- (now) t0) e])))
  (is "sse: status" rr.status 200)
  (is "sse: events" (~ x=>x[1] evs) [{:event "tick" :data "one" :id "1" :retry nil} {:event "message" :data "two\nsecond line" :id nil :retry nil} {:event "message" :data "three" :id nil :retry nil}])
  (is "sse: the first event comes early" (< evs[0][0] 300) true)
  (is "sse: the last one comes late" (> evs[2][0] 250) true)
  ; https
  d=(+ base ".d/") (sh (+ "mkdir " d "; cd " d "; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -keyout ca.key -out ca.pem -subj /CN=ca -days 3 -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign 2>/dev/null; printf 'basicConstraints=CA:FALSE\nsubjectAltName=DNS:localhost\n' > ext; openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out s.key 2>/dev/null; openssl req -new -key s.key -subj /CN=s -out s.csr; openssl x509 -req -in s.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 3 -extfile ext -out s.pem 2>/dev/null"))
  roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (+ d "ca.pem"))))
  ps=(start (+ d "s.pem " d "s.key") ".s")
  su=(+ "https://localhost:" ps)
  (check "https chunked" (+ su "/chunked") "one\ntwo\ntre\n" {:roots roots})
  (check "https content-length" (+ su "/length") "abcdefghijkl" {:roots roots})
  [rr got total]=(watch (+ su "/gzip") {:roots roots :gzip true})
  (is "https gzip" (~ x=>x[1] got) ["gzip one\ngzip two\n"])
  true) e=>e)
(finish)
(assert (== r true) (+ "http_stream: " (show r)))
(assert (> n 14) (+ "too few checks ran: " n))
