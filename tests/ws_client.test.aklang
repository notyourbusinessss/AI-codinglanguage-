; lib/ws client: nothing is sent for an illegal header, protocol or path (#254); user:pass@ becomes Basic authentication (#273); ping and close arguments follow RFC 6455 (#282)
(use "../lib/ws.aklang" as w)
l=(tcpl 0 "127.0.0.1") port=(tcpp l)
(= (sent url opts)                      ; what a connect to url writes: [error request]
  er=(try (: (w.connect (+ "ws://" url) (set opts "rms" 300)) "connected") x=>x)
  c=(tcpa l 200) req=(? c (?? (fdr c 65536 300) "") "")
  (? c (fdc c))
  [er req])
(= (nothing name url opts)
  [e req]=(sent url opts)
  (assert (== req "") (+ name ": something was sent: " (show req)))
  (assert (has e "illegal character") (+ name ": got " (show e))))
(nothing "CRLF in a header value" (+ "127.0.0.1:" port "/a") {:headers {"X-A" "1\r\nEvil: yes"}})
(nothing "LF in a header value" (+ "127.0.0.1:" port "/a") {:headers {"X-A" "1\nEvil: yes"}})
(nothing "NUL in a header value" (+ "127.0.0.1:" port "/a") {:headers {"X-A" "1\x00"}})
(nothing "space in a header name" (+ "127.0.0.1:" port "/a") {:headers {"X A" "1"}})
(nothing "colon in a header name" (+ "127.0.0.1:" port "/a") {:headers {"X:A" "1"}})
(nothing "empty header name" (+ "127.0.0.1:" port "/a") {:headers {"" "1"}})
(nothing "CRLF in a protocol" (+ "127.0.0.1:" port "/a") {:protocols ["a\r\nInj: 2"]})
(nothing "space in a protocol" (+ "127.0.0.1:" port "/a") {:protocols ["a b"]})
(nothing "empty protocol" (+ "127.0.0.1:" port "/a") {:protocols [""]})
[e req]=(sent (+ "127.0.0.1:" port "/a") {:headers {"Origin" "http://x" "X-Custom_1" "v"} :protocols ["chat" "v2.json"]})
(assert (has req "Origin: http://x") (+ "a valid header is sent: " (show req)))
(assert (has req "Sec-WebSocket-Protocol: chat, v2.json") "valid protocols are sent")
(assert (! (has req "Authorization")) "no credentials, no Authorization")
[e req]=(sent (+ "bob:secret@127.0.0.1:" port "/chat") {})
(assert (has req "GET /chat HTTP/1.1") (show req))
(assert (has req "Authorization: Basic Ym9iOnNlY3JldA==") (+ "credentials in the URL: " (show req)))
[e req]=(sent (+ "bob:secret@127.0.0.1:" port "/chat") {:headers {"authorization" "Bearer t"}})
(assert (has req "Bearer t") (show req))
(assert (! (has req "Basic")) (+ "a header of the caller replaces the URL credentials: " (show req)))
(assert (== (# (split (lo req) "authorization:")) 2) "and is not duplicated")
; ping and close limits, against a ws made over an in-memory stream
out=[]
s={:r n=>"" :w x=>(push out x) :c ()=>nil}
ws=(w.mkws s true {})
(assert (has (try (w.ping ws (rpt "a" 126)) e=>e) "over 125 bytes") "a ping over 125 bytes raises")
(assert (== #out 0) "and sends nothing")
(w.ping ws (rpt "a" 125))
(assert (== #out 1) "a ping of 125 bytes is sent")
(for code [1005 1006 1015 999 0 "x" 1000.5 5000]
  (assert (has (try (w.close ws code "") e=>e) "must not be sent") (+ "close code " (show code) " is refused")))
(assert (has (try (w.close ws 1000 (rpt "r" 124)) e=>e) "at most 123 bytes") "a reason over 123 bytes raises")
(assert (has (try (w.close ws 1000 (frombytes [255 254])) e=>e) "valid UTF-8") "a reason that is not UTF-8 raises")
(assert (== #out 1) "nothing was sent by the refused closes")
(w.close ws 1000 (rpt "r" 123))
(assert (== #out 2) "a close with a 123-byte reason is sent")
(fdc l)
