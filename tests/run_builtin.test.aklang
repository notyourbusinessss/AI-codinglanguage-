; (run argv opts): a program without a shell, with stdin, stderr, exit code, environment and directory (#187)
(= (eq a b msg) (assert (== a b) (+ msg ": " (show a) " != " (show b))))
(eq (run ["cat"] {:in "x"}) {:code 0 :out "x" :err ""} "stdin")
(eq (run ["sh" "-c" "echo hi; echo e >&2; exit 3"]) {:code 3 :out "hi\n" :err "e\n"} "code, out and err")
(eq (run ["echo" "a b" ";" "$HOME" "'q'" "*"]).out "a b ; $HOME 'q' *\n" "arguments are passed as they are")
(eq (run ["pwd"] {:cwd "/tmp"}).out "/tmp\n" "cwd")
(eq (run ["sh" "-c" "echo $AKFOO:$HOME"] {:env {:AKFOO "bar"}}).out (+ "bar:" (env "HOME") "\n") "env adds to the environment")
(eq (run ["sh" "-c" "echo [$HOME]"] {:env {:HOME nil}}).out "[]\n" "a nil env value removes the variable")
r=(run ["cat"] {:in (rpt "0123456789" 100000)})
(eq (~ # [r.out r.err]) [1000000 0] "1 MB through stdin and stdout does not block")
r=(run ["sh" "-c" "head -c 300000 /dev/zero >&2"])
(eq #r.err 300000 "large stderr")
r=(run ["sh" "-c" "kill -9 $$"])
(eq r.code 137 "killed by a signal: 128 + number")
r=(run ["no-such-program-ak"])
(assert (&& (== r.code 127) (has r.err "no such file or directory")) (show r))
r=(run ["pwd"] {:cwd "/nonexistent"})
(assert (&& (== r.code 127) (has r.err "cannot change to /nonexistent")) (show r))
(eq (run ["sh" "-c" "exit 0"] {:in (frombytes [1 2 3])}).code 0 "byte data as input")
(for bad [[] "ls" [1] nil]
  (assert (== (try (run bad) e=>(errkind e)) "type") (+ "bad argv " (show bad))))
(assert (== (try (run ["ls"] {:env 5}) e=>(errkind e)) "type") "bad env")
(eq (sh "echo unchanged") "unchanged\n" "sh still works")
