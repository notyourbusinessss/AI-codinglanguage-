; (fdr fd) with the default size reuses one buffer: 20000 small reads cause almost no garbage collections (it was about 130 per 20000), and sizes still hold (#104)
(use "lib/run.aklang" as t)
r=(t.run "AK_GCSTATS=1 bin/ak tests/lib/pingpong.aklang" nil)
(assert (== r.code 0) (+ "pingpong failed: " r.err))
(assert (== r.out "40000\ntrue\n") (+ "pingpong output: " (show r.out)))
gcs=(num (split (trim r.err))[1])
(assert (&& ($isnum gcs) (< gcs 20)) (+ "too many collections: " (show r.err)))
r=(t.run "bin/ak tests/lib/ticks.aklang" nil)
(assert (== r.out "10 true 100000 true\n") (+ "read sizes: " (show r.out) (show r.err)))
