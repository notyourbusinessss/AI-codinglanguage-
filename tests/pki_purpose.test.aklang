; lib/pki chain rules (#154): extended key usage, pathLenConstraint and nameConstraints, with certificates made by openssl
(use "../lib/pki.aklang" as k)
(use "lib/run.aklang" as t)
d=(+ "/tmp/akpurpose-" ($ (now)) "-" ($ (rand 1000000000)))
(sh (+ "mkdir " d))
r=(t.run (+ "sh tests/lib/pki_purpose.sh " d) nil)
(assert (== r.code 0) (+ "openssl setup failed: " r.err))
ts=(flr (/ (now) 1000))
(= (der f) (fst (k.pem_certs (rd (+ d "/" f ".pem")))))
roots=[(k.cert_parse (der "root"))]
(= (check leafname host chain purpose) (try (: (k.check_chain (~ der [leafname ..chain]) host roots ts purpose) "ok") e=>e))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(is "no EKU" (check "leaf_none" "localhost" [] nil) "ok")
(is "serverAuth" (check "leaf_srv" "localhost" [] nil) "ok")
(is "anyExtendedKeyUsage" (check "leaf_any" "localhost" [] nil) "ok")
(is "codeSigning only is not a server certificate" (check "leaf_code" "localhost" [] nil) "certificate: not valid for server authentication")
(is "clientAuth only is not a server certificate" (check "leaf_cli" "localhost" [] nil) "certificate: not valid for server authentication")
(is "clientAuth as a client certificate" (check "leaf_cli" nil [] "client") "ok")
(is "serverAuth is not a client certificate" (check "leaf_srv" nil [] "client") "certificate: not valid for client authentication")
(is "pathlen 0 allows a leaf directly" (check "leaf_none" "localhost" [] nil) "ok")
(is "pathlen 0 forbids a CA below it" (check "leaf_pl0" "localhost" ["sub0" "mid0"] nil) "certificate: path length constraint violated")
(is "pathlen 1 allows one CA below" (check "leaf_pl1" "localhost" ["sub1" "mid1"] nil) "ok")
(is "names inside the constraints" (check "leaf_nc_ok" "a.example.com" ["nc"] nil) "ok")
(is "DNS name outside the permitted subtree" (check "leaf_nc_dns" "evil.test" ["nc"] nil) "certificate: name not permitted by a name constraint")
(is "excluded DNS subtree" (check "leaf_nc_bad" "x.bad.example.com" ["nc"] nil) "certificate: name excluded by a name constraint")
(is "IP outside the permitted range" (check "leaf_nc_ip" "a.example.com" ["nc"] nil) "certificate: address not permitted by a name constraint")
c=(k.cert_parse (der "nc"))
(is "parsed constraints" [c.nc.pdns c.nc.edns c.nc.pip] [["example.com"] ["bad.example.com"] [[10 0 0 0 255 0 0 0]]])
(is "parsed pathlen" [(k.cert_parse (der "mid0")).pathlen (k.cert_parse (der "mid1")).pathlen (k.cert_parse (der "root")).pathlen] [0 1 nil])
(is "dns_within" [(k.dns_within "a.example.com" "example.com") (k.dns_within "example.com" "example.com") (k.dns_within "badexample.com" "example.com") (k.dns_within "example.com" ".example.com") (k.dns_within "a.example.com" ".example.com")] [true true false false true])
(sh (+ "rm -rf " d))
