; lib/time rejects an out-of-range UTC offset and an iso year outside 0..9999 (#193)
(use "../lib/time.aklang" as t)
(= (bad f) (try (: (f) false) e=>(has e "bad time")))
(assert (bad (\ () (t.parse "2023-11-14T00:00:00+99:99"))) "offset +99:99")
(assert (bad (\ () (t.parse "2023-11-14T00:00:00+24:00"))) "offset +24:00")
(assert (bad (\ () (t.parse "2023-11-14T00:00:00-0560"))) "offset minutes 60")
(assert (bad (\ () (t.iso 1e12))) "iso year 33658")
(assert (bad (\ () (t.iso -1e11))) "iso negative year")
(assert (== (t.parse "2023-11-14T23:13:20+01:00") 1700000000) "+01:00")
(assert (== (t.parse "2023-11-14T16:43:20-0530") 1700000000) "-0530")
(assert (== (t.parse "2023-11-14T22:13:20Z") 1700000000) "Z")
(assert (== (t.iso 1700000000) "2023-11-14T22:13:20Z") "iso")
