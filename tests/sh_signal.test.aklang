; sh names the signal when its command is killed (it used to say "failed (0)"), and still reports a plain exit code (#130)
(use "lib/run.aklang" as t)
(= (ak code)                    ; run a program given as text with bin/ak
  f=(+ "/tmp/aktest-prog-" ($ (rand 1000000000)) ".aklang")
  (wr f code)
  r=(t.run (+ "bin/ak " f) nil)
  (rm f)
  r)
r=(ak "r=sh(\"kill -9 $$\")\n")
(assert (&& (== r.code 1) (has r.err "sh killed by signal 9")) (+ "kill -9: " (show r.err)))
r=(ak "p(sh(\"kill -TERM $$; sleep 1\"))")
(assert (&& (== r.code 1) (has r.err "sh killed by signal 15")) (+ "kill -TERM: " (show r.err)))
r=(ak "sh(\"exit 3\")")
(assert (&& (== r.code 1) (has r.err "sh failed (3)")) (+ "exit 3: " (show r.err)))
r=(ak "p(sh(\"echo ok\"))")
(assert (== r.out "ok\n\n") (+ "plain sh: " (show r.out)))
