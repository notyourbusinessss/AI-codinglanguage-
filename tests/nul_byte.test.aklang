; a NUL byte in a path or a run/sh argument raises instead of cutting the name there (#236)
(= (bad f) (try (: (f) false) e=>(has e "NUL byte")))
(= d "/tmp/ak-nul-test")
(sh (+ "rm -rf " d " && mkdir " d " && echo secret > " d "/a"))
(= n (+ d "/a\u{0}.txt"))
(assert (bad (\ () (rd n))) "rd")
(assert (bad (\ () (ex n))) "ex")
(assert (bad (\ () (wr (+ d "/b\u{0}c") "x"))) "wr")
(assert (bad (\ () (app (+ d "/b\u{0}c") "x"))) "app")
(assert (bad (\ () (wrx (+ d "/b\u{0}c") "x"))) "wrx")
(assert (bad (\ () (rm n))) "rm")
(assert (bad (\ () (mv n (+ d "/z")))) "mv from")
(assert (bad (\ () (mv (+ d "/a") (+ d "/z\u{0}y")))) "mv to")
(assert (bad (\ () (mkdir (+ d "/m\u{0}n")))) "mkdir")
(assert (bad (\ () (ls (+ d "\u{0}x")))) "ls")
(assert (bad (\ () (stat n))) "stat")
(assert (bad (\ () (cp n (+ d "/c")))) "cp from")
(assert (bad (\ () (cp (+ d "/a") (+ d "/c\u{0}d")))) "cp to")
(assert (bad (\ () (chmod n 420))) "chmod")
(assert (bad (\ () (chdir (+ d "\u{0}x")))) "chdir")
(assert (bad (\ () (unixl (+ d "/s\u{0}x")))) "unixl")
(assert (bad (\ () (unixc (+ d "/s\u{0}x")))) "unixc")
(assert (bad (\ () (run ["echo" "a\u{0}b"]))) "run argument")
(assert (bad (\ () (run ["ec\u{0}ho" "a"]))) "run program")
(assert (bad (\ () (run ["echo" "a"] {:env {"K" "v\u{0}w"}}))) "run env value")
(assert (bad (\ () (run ["echo" "a"] {:cwd (+ d "\u{0}x")}))) "run cwd")
(assert (bad (\ () (sh "echo a\u{0}b"))) "sh")
(assert (== (ls d) ["a"]) "nothing was created")
(assert (== (rd (+ d "/a")) "secret\n") "file untouched")
; text with other bytes still works
(= u (+ d "/caf\u{e9} \u{1f600}.txt"))
(wr u "ok") (assert (== (rd u) "ok") "non-ASCII path")
(assert (== (run ["echo" "caf\u{e9}"])[:out] "caf\u{e9}\n") "non-ASCII argument")
(sh (+ "rm -rf " d))
