; Test driver for lib/crypto.aklang: each stdin line is "cmd hex hex ..."; prints the result as hex ("nil" when open fails).
(use "../lib/crypto.aklang" as c)
(for l (split (inall) "\n")
  f=(split l " ")
  (? (&& #f>0 f[0]!="")
     (: a=(~ x=>(c.unhex x) f[1..])
        r=(sw f[0]
            "sha256" (c.sha256 a[0])
            "sha384" (c.sha384 a[0])
            "hmac256" (c.hmac "sha256" a[0] a[1])
            "hmac384" (c.hmac "sha384" a[0] a[1])
            "hkdf" (c.hkdf_expand "sha384" a[0] a[1] (num f[3]))
            "chacha-seal" (c.chacha_seal a[0] a[1] a[2] a[3])
            "chacha-open" (c.chacha_open a[0] a[1] a[2] a[3])
            "aes-seal" (c.aes_gcm_seal a[0] a[1] a[2] a[3])
            "aes-open" (c.aes_gcm_open a[0] a[1] a[2] a[3])
            "x25519" (c.x25519 a[0] a[1])
            (err (++ "bad command " f[0])))
        (p (? ($isnil r) "nil" (== r "") "empty" (c.hex r))))))
