; Runs every corpus/*.aklang and compares stdout to corpus/*.out (generated by the independent Python reference).
(use "lib/run.aklang" as t)
; these use Node modules or promises, so they run on the JS target only (tests/native_diff.js still covers them there)
JS_ONLY=["17-http.aklang" "22-async.aklang"]
n=0
(for f (sort (ls "corpus"))
  (? (&& (ends f ".aklang") !(has JS_ONLY f))
    (: (<- n n+1)
    b=(sub f 0 #f-7)
    inp=(? (ex (+ "corpus/" b ".in")) (rd (+ "corpus/" b ".in")) "")
    r=(t.run (+ "bin/ak corpus/" f) inp)
    want=(rd (+ "corpus/" b ".out"))
    (assert (&& (== r.out want) (== r.code 0)) (+ "corpus " f " differs\n--got--\n" r.out r.err "--want--\n" want)))))
(assert (> n 0) "no corpus programs found")
(p (+ n " corpus programs match the Python reference"))
