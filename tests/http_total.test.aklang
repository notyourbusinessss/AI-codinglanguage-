; lib/http :total: one deadline for a whole request, its redirects and its body (#226), against tests/lib/trickle_srv.aklang
(use "lib/run.aklang" as t)
(use "../lib/http.aklang" as h)
out=(+ "/tmp/aktotal-" ($ (now)) "-" ($ (rand 1000000000)))
pid=(trim (sh (+ "bin/ak tests/lib/trickle_srv.aklang >" out " 2>" out ".err & echo $!")))
(wh (|| (! (ex out)) (== (trim (rd out)) "")) (sleep 50))
port=(num (trim (rd out)))
(= (get p o) (h.get (+ "http://127.0.0.1:" port p) nil o))
(= (took p o) t0=(now) r=(try (get p o) e=>e) [r (- (now) t0)])
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
r=(try (:
  [r ms]=(took "/trickle" {:rms 500 :ms 500 :total 1500})
  (is "a trickling body raises request timed out" r "request timed out")
  (is "after about the total, not after the body" (&& ms>=1400 ms<4000) true)
  [r ms]=(took "/short" {:total 5000})
  (is "a request inside the total works" [r.status (len r.body)] [200 10])
  [r ms]=(took "/r1" {:total 1000})
  (is "redirects share one deadline" r "request timed out")
  [r ms]=(took "/r1" {:total 5000})
  (is "and a longer total follows all of them" [r.status r.body] [200 "ok"])
  (is "a non-number total is refused" (has (try (get "/ok" {:total "5"}) e=>e) "expected number") true)
  true) e=>e)
(sh (+ "kill " pid " 2>/dev/null; rm -f " out " " out ".err"))
(assert (== r true) (+ "http_total: " (show r)))
(assert (> n 5) (+ "too few checks ran: " n))
