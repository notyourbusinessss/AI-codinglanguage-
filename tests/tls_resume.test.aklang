; TLS 1.3 session resumption in lib/tls.aklang, client and server, against openssl (needs openssl)
(use "lib/run.aklang" as t)
r=(t.run "sh tests/lib/tls_resume.sh" nil)
lines=(split (trim r.out) "\n")
(assert (== #lines 20) (+ "tls_resume.sh printed " #lines " lines, expected 20: " (show r.out) r.err))
bad=(~? l=>(! (starts l "ok ")) lines)
(assert (== #bad 0) (+ "tls resumption checks failed:\n" (join bad "\n")))
