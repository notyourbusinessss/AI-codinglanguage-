; lib/inflate.aklang (#162): gzip made by the system gzip (fixed, dynamic and stored blocks), zlib vectors, corrupt input and the output limit
(use "../lib/inflate.aklang" as z)
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(= (err f) (try (: (f) "no error") e=>e))
d=(+ "/tmp/akinflate-" ($ (now)) "-" ($ (rand 1000000000)))
(sh (+ "mkdir " d "; cd " d "; (i=0; while [ $i -lt 4000 ]; do echo \"line $i of some text that repeats: alpha beta gamma $((i * 7919 % 1000))\"; i=$((i+1)); done) > t.txt; gzip -9 -c t.txt > t9.gz; gzip -1 -c t.txt > t1.gz; head -c 50000 /dev/urandom > r.bin; gzip -c r.bin > r.gz; printf '' | gzip -c > e.gz; printf 'abc' | gzip -c > s.gz; gzip -n -c t.txt | head -c 100 > cut.gz"))
(= (f name) (rd (+ d "/" name)))
(is "dynamic blocks, -9" (== (z.gunzip (f "t9.gz")) (f "t.txt")) true)
(is "dynamic blocks, -1" (== (z.gunzip (f "t1.gz")) (f "t.txt")) true)
(is "random data (stored or literal blocks)" (== (z.gunzip (f "r.gz")) (f "r.bin")) true)
(is "empty" (z.gunzip (f "e.gz")) "")
(is "short" (z.gunzip (f "s.gz")) "abc")
(is "crc32 vector" (z.crc32 "123456789") 3421780262)
(is "adler32 vector" (z.adler32 "Wikipedia") 300286872)
(is "zlib fixed block" (z.zlib (frombytes [120 156 203 72 205 201 201 7 0 6 44 2 21])) "hello")
(= (stored s) (++ (frombytes [120 1 1 #s 0 (- 255 #s) 255]) s (frombytes [0 0 0 0])))
(is "zlib stored block checks the checksum" (err (\ () (z.zlib (stored "abc")))) "inflate: zlib checksum mismatch")
(is "raw inflate of a stored block" (z.inflate (frombytes [1 3 0 252 255 97 98 99])) "abc")
(is "truncated gzip" (starts (err (\ () (z.gunzip (f "cut.gz")))) "inflate: ") true)
bad=(f "t9.gz") bad=(++ bad[..#bad-8] (frombytes [1 2 3 4]) bad[#bad-4..])
(is "wrong CRC" (err (\ () (z.gunzip bad))) "inflate: gzip CRC mismatch")
(is "not gzip" (err (\ () (z.gunzip "hello world, this is long enough"))) "inflate: not gzip data")
(is "output limit" (err (\ () (z.gunzip (f "t9.gz") 1000))) "inflate: output over the limit")
(is "errors are io errors" (errkind (try (z.gunzip "xxxxxxxxxxxxxxxxxxxxxxxx") e=>e)) "io")
(sh (+ "rm -rf " d))
