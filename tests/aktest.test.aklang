; ak test: discovery, per-file pass/fail, summary, exit codes.
(use "lib/run.aklang" as t)
root=(trim (sh "pwd"))
tmp=(trim (sh "mktemp -d"))
(= (shq s) (+ "'" (rep s "'" "'\\''") "'"))
(= (w n s) (sh (+ "mkdir -p $(dirname " (shq (+ tmp "/" n)) ")")) (wr (+ tmp "/" n) s))
n=0 bad=0
(= (ck name ok info) (<- n n+1) (? (! ok) (: (<- bad bad+1) (p "FAIL" name "\n  " (show info)))))
(= (akt args dir input) (t.run (+ "cd " (shq (? dir (+ tmp "/" dir) tmp)) " && " root "/bin/ak test " args) input))
(w "a.test.aklang" "(assert (== (+ 1 2) 3))\n(p \"quiet\")\n")
(w "sub/b.test.aklang" "(p \"before\")\n(assert (== 1 2) \"one is not two\")\n")
(w "sub/c.test.ak" "(assert 1)\n")
(w "sub/helper.aklang" "(err \"not a test: must not run\")\n")
(w "node_modules/x.test.aklang" "(err \"node_modules is skipped\")\n")
(w ".hidden/h.test.aklang" "(err \"hidden dirs are skipped\")\n")
(w "exit3.aklang" "(exit 3)\n")
(w "bare.aklang" "(assert false)\n")
(w "empty/readme.txt" "no tests here\n")
(w ".u/lib.aklang" "(= (sq x) x*x)\n(= (bad x) (err \"lib failure\" x))\n")
(w ".u/ok.test.aklang" "(use \"lib.aklang\" as g)\n(assert (== (g.sq 3) 9))\n")
(w ".u/fail.test.aklang" "(use \"lib.aklang\" as g)\n(= (f x) 1+(g.bad x))\n(f 1)\n")
(w ".u/stdin.test.aklang" "(assert (== (in) nil) \"a test must see an empty stdin\")\n")

r=(akt "" nil nil)
(ck "discovery: only *.test.aklang / *.test.ak, sorted, skips node_modules and dot dirs" (== r.out "PASS a.test.aklang\nFAIL sub/b.test.aklang (exit 1)\n  before\n  error: one is not two (sub/b.test.aklang:2:1)\nPASS sub/c.test.ak\n2 passed, 1 failed, 3 files\n") r)
(ck "failure: exit 1" (== r.code 1) r)
r=(akt "a.test.aklang sub/c.test.ak" nil nil)
(ck "all pass: exit 0" (&& (== r.code 0) (== r.out "PASS a.test.aklang\nPASS sub/c.test.ak\n2 passed, 0 failed, 2 files\n")) r)
r=(akt "bare.aklang" nil nil)
(ck "an explicit file runs whatever its name, assert without a message" (&& (== r.code 1) (re "^FAIL bare\\.aklang \\(exit 1\\)\n  error: assertion failed" r.out)) r)
r=(akt "exit3.aklang" nil nil)
(ck "reports the exit code" (&& (== r.code 1) (starts r.out "FAIL exit3.aklang (exit 3)\n")) r)
r=(akt "sub" nil nil)
(ck "a directory is searched" (&& (has r.out "sub/c.test.ak") (has r.out "sub/b.test.aklang") (! (has r.out "helper"))) r)
r=(akt "empty" nil nil)
(ck "zero test files is a failure, not a pass" (&& (== r.code 1) (== r.out "") (re "no test files found" r.err)) r)
r=(akt "missing.test.aklang" nil nil)
(ck "missing path: error, exit 1" (&& (== r.code 1) (re "no such file or directory: missing\\.test\\.aklang" r.err)) r)
r=(akt "" "sub" nil)
(ck "runs from a subdirectory" (&& (starts r.out "FAIL b.test.aklang (exit 1)") (has r.out "PASS c.test.ak")) r)
; use ... as with a relative path, run from a directory other than the test's own; an uncaught error inside a function shows its message and location
r=(akt ".u/ok.test.aklang" nil nil)
(ck "a test can use a library with as (relative path, run from another directory)" (&& (== r.code 0) (== r.out "PASS .u/ok.test.aklang\n1 passed, 0 failed, 1 files\n")) r)
r=(akt ".u/fail.test.aklang" nil nil)
(ck "an uncaught error inside a function: message and location in the output" (&& (== r.code 1) (re "^FAIL \\.u/fail\\.test\\.aklang \\(exit 1\\)\n  error: lib failure 1 \\(\\.u/fail\\.test\\.aklang:\\d+:\\d+\\)" r.out)) r)
; stdin: the runner must neither hang nor take the terminal's input; a test reads nothing from it
r=(akt ".u/stdin.test.aklang" nil "typed by the user\n")
(ck "stdin: does not hang, a test sees end of input" (&& (== r.code 0) (== r.out "PASS .u/stdin.test.aklang\n1 passed, 0 failed, 1 files\n")) r)
(w "q'uote.test.aklang" "(p 1)\n")
r=(akt (shq "q'uote.test.aklang") nil nil)
(ck "odd file names" (&& (== r.code 0) (starts r.out "PASS q'uote.test.aklang")) r)
(sh (+ "rm -rf " (shq tmp)))
(assert (== bad 0) (+ bad " of " n " aktest checks failed"))
(assert (>= n 13) "too few aktest checks ran")
(p (+ "aktest: " n " checks passed"))
