; wss:// (lib/ws.aklang over lib/tls.aklang): echo, subprotocol, big messages, close code, certificate checks, plain ws:// to a TLS port, and through an https:// proxy (tests/lib/wss_srv.aklang, tests/lib/tls_proxy.aklang; needs openssl)
(use "../lib/ws.aklang" as w)
(use "../lib/pki.aklang" as k)
(use "lib/run.aklang" as t)
base=(+ "/tmp/akwss-" ($ (now)) "-" ($ (rand 1000000000)))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(= (waitline f) (wh (|| (! (ex f)) (! (has (rd f) "\n"))) (sleep 50)) (split (trim (rd f)) "\n"))
pids=[]
(= (bg cmd f) (<- pids (+> pids (trim (sh (+ cmd " >" f " 2>&1 & echo $!"))))))
(= (finish) (sh (+ "kill " (join pids " ") " 2>/dev/null; rm -rf " base "*")))
(= (thrown f) (try (: (f) "no error") e=>e))
r=(try (:
  d=(+ base ".d/")
  (sh (+ "mkdir " d "; cd " d "; for n in ca other; do openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -keyout $n.key -out $n.pem -subj /CN=$n -days 3 -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign 2>/dev/null; done; printf 'basicConstraints=CA:FALSE\\nsubjectAltName=DNS:localhost\\n' > s.ext; openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out s.key 2>/dev/null; openssl req -new -key s.key -subj /CN=localhost -out s.csr; openssl x509 -req -in s.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 3 -extfile s.ext -out s.pem 2>/dev/null"))
  roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (+ d "ca.pem"))))
  other=(~ x=>(k.cert_parse x) (k.pem_certs (rd (+ d "other.pem"))))
  (bg (+ "bin/ak tests/lib/wss_srv.aklang " d "s.pem " d "s.key 4") (+ base ".w"))
  port=(num (waitline (+ base ".w"))[0])
  url=(+ "wss://localhost:" port "/chat")
  ws=(w.connect url {:roots roots :protocols ["echo"]})
  (is "subprotocol over TLS" ws.protocol "echo")
  (w.send ws "hello") (is "text echo" (w.recv ws) "hello")
  (w.sendb ws "bin\x00ary") (is "binary echo" [(w.recv ws) ws.bin] ["bin\x00ary" true])
  big=(rpt "0123456789" 20000) (w.send ws big) (is "200 KB message both ways" (w.recv ws) big)
  (w.send ws "big") (is "70000 bytes from the server" (len (w.recv ws)) 70000)
  (w.send ws "close")
  (is "close frame ends recv" (w.recv ws) nil)
  (is "close code" [ws.closed ws.code ws.reason] [true 1000 "bye"])
  ; a connection that fails before the upgrade uses up one of the server's n connections; the server must go on
  (is "wrong host name" (has (thrown (\ () (w.connect (+ "wss://127.0.0.1:" port "/") {:roots roots :ms 3000 :rms 3000}))) "does not match") true)
  (is "untrusted CA" (has (thrown (\ () (w.connect url {:roots other :ms 3000 :rms 3000}))) "trusted issuer") true)
  (is "plain ws:// to a TLS port fails" (isstr (thrown (\ () (w.connect (+ "ws://localhost:" port "/") {:ms 2000 :rms 2000})))) true)
  ; through an https proxy: CONNECT inside TLS, then TLS to the server inside that
  (bg (+ "bin/ak tests/lib/wss_srv.aklang " d "s.pem " d "s.key 1") (+ base ".w2"))
  port2=(num (waitline (+ base ".w2"))[0])
  (bg (+ "bin/ak tests/lib/tls_proxy.aklang " d "s.pem " d "s.key 1") (+ base ".p"))
  pp=(num (waitline (+ base ".p"))[0])
  ws=(w.connect (+ "wss://localhost:" port2 "/") {:roots roots :proxy (+ "https://u:pw@localhost:" pp)})
  (w.send ws "via proxy") (is "wss echo through an https proxy" (w.recv ws) "via proxy")
  (w.close ws 1000 "")
  (is "the proxy saw CONNECT" (has (rd (+ base ".p")) (+ "CONNECT localhost:" port2 "\n")) true)
  true) e=>e)
(finish)
(assert (== r true) (+ "wss: " (show r)))
(assert (> n 8) (+ "too few checks ran: " n))
