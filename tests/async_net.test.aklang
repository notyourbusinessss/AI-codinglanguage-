; lib/async.aklang: a name lookup or connect in one task does not freeze the others (#179)
(use "lib/run.aklang" as t)
u=(udpl 0 "127.0.0.1")                  ; a name server that never answers
conf=(+ t.tmpname() ".conf")
(wr conf "nameserver 127.0.0.1\noptions timeout:1 attempts:1\n")
r=(t.run (+ "AK_RESOLV=" conf " AK_DNS=127.0.0.1:" ($ (tcpp u)) " bin/ak tests/lib/async_dns.aklang") nil)
(rm conf) (fdc u)
(assert (== r.code 0) (+ "child failed: " r.err))
f=(split (trim r.out) " ")
(assert (== f[0] "ticks") (+ "child output: " (show r.out)))
ticks=(num f[1]) gap=(num f[3]) dns=(num f[5]) conn=(num f[7])
(assert (== ticks 14) (+ "the ticker should have run to the end: " (show r.out)))
(assert (< gap 400) (+ "the ticker was frozen for " gap " ms: " (show r.out)))
(assert (>= dns 900) (+ "the lookup should have waited for the name server: " (show r.out)))
(assert (< conn 1500) (+ "the connect took too long: " (show r.out)))
