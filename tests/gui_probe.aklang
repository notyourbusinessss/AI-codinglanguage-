; Test helper for tests/gui.test.js: Ak's canvas and X11 client against a real X server.
;   ak build tests/gui_probe.aklang probe ; probe canvas      drawing checks, no display needed
;   probe window                                          window round trip, then prints every event it receives until the window is closed or "q" is typed
;   probe shot WINDOWID WIDTH HEIGHT x,y x,y ...          reads pixels of ANOTHER client's window (GetImage) and prints "x,y rgb" for each point
(use "../lib/x11.aklang")
(= (check name ok) (p (? ok "ok" "FAIL") name) nil)
(= (canvas_checks)
  cv=(canvas 64 48)
  (fill cv (rgb 10 20 30))
  (check "fill" (== (px cv 5 5) (rgb 10 20 30)))
  (rect cv 8 8 16 16 (rgb 255 0 0))
  (check "rect inside" (== (px cv 10 10) (rgb 255 0 0)))
  (check "rect outside" (== (px cv 30 10) (rgb 10 20 30)))
  (rect cv 40 8 8 8 (rgb 255 255 255) 128)
  (check "rect alpha" (== (px cv 42 10) (rgb 133 138 143)))
  (circle cv 32 30 10 (rgb 0 255 0))
  (check "circle centre" (== (px cv 32 30) (rgb 0 255 0)))
  (check "circle outside" (== (px cv 32 12) (rgb 10 20 30)))
  e=(px cv 22 30) (check "circle edge is anti-aliased" (&& (!= e (rgb 0 255 0)) (!= e (rgb 10 20 30))))
  (ring cv 20 28 12 3 (rgb 0 0 255))
  (check "ring hole" (== (px cv 20 28) (rgb 10 20 30)))
  (vgrad cv 0 0 4 48 (rgb 0 0 0) (rgb 255 255 255))
  (check "gradient ends" (&& (== (px cv 1 0) (rgb 0 0 0)) (== (px cv 1 47) (rgb 255 255 255))))
  t=(canvas 120 30) (fill t 0)
  wd=(text t 2 2 "Ak 123" 22 (rgb 255 255 255))
  (check "text width" (&& (== wd (text_w "Ak 123" 22)) wd>40 wd<100))
  lit=0 (for y 30 (for x 120 (? (!= (px t x y) 0) lit+=1)))
  (check "text draws pixels" (&& lit>100 lit<2000))
  (check "text sizes grow" (&& (< (text_w "Hello" 15) (text_w "Hello" 22)) (< (text_w "Hello" 22) (text_w "Hello" 34))))
  m=(canvas 64 48) (fill m (rgb 0 0 0)) (rect m 0 0 32 48 (rgb 255 255 255))
  d=(canvas 64 48) (fill d (rgb 1 2 3)) (blit d 0 0 cv 0 0 64 48 m)
  (check "blit mask" (&& (== (px d 10 10) (rgb 255 0 0)) (== (px d 50 40) (rgb 1 2 3))))
  (save_ppm cv "/tmp/gui_probe.ppm")
  (check "ppm" (starts (rd "/tmp/gui_probe.ppm") "P6\n64 48\n255\n"))
  (rm "/tmp/gui_probe.ppm")
  nil)
(= (window_checks)
  w=(gui_open "probe window" 200 100)
  cv=(canvas 200 100)
  (vgrad cv 0 0 200 100 (rgb 255 0 0) (rgb 0 0 255))
  (rect cv 10 10 50 30 (rgb 0 255 0))
  (circle cv 150 50 20 (rgb 255 255 255))
  (text cv 70 10 "Ak" 22 (rgb 255 255 0))
  (gui_present w cv)
  s=(gui_snapshot w)
  bad=0
  (for y 100 (for x 200 (? (!= (px s x y) (px cv x y)) bad+=1)))
  (check "present and snapshot agree on every pixel" bad==0)
  ; a canvas taller than one request (262000 bytes): strips
  big=(canvas 200 100)
  (fill big (rgb 7 8 9)) (gui_present w big)
  s=(gui_snapshot w)
  (check "second present" (== (px s 199 99) (rgb 7 8 9)))
  (fdw 1 "READY\n")
  run=true
  (wh run
    ev=(gui_event w 5000)
    (? ev==nil (: (p "timeout") run=false)
       (: (p "event" (json ev)) (flush)
          (? (|| ev.type=="close" (&& ev.type=="key" ev.down ev.key=="q")) run=false))))
  (gui_close w)
  (p "closed")
  nil)
(= (shot)
  a=(args) w=(x_connect nil)
  w.id=(num a[1]) w.w=(num a[2]) w.h=(num a[3])
  s=(gui_snapshot w)
  (for q a[4..] pr=(split q ",") (p q (px s (num pr[0]) (num pr[1]))))
  nil)
(sw (fst (args)) "canvas" (canvas_checks) "shot" (shot) (window_checks))
