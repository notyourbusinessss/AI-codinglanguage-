; IPv6 TCP sockets (#56): listen and connect on ::1, a "::" listener also takes IPv4 clients. Needs an IPv6 loopback; without one the test says so and ends (it still checks that the failure is a clean io error).
(= (err f) (try (: (f) "no error") e=>e))
l=(try (tcpl 0 "::1") e=>e)
(? (isstr l)
   (: (assert (|| (has l "IPv6") (has l "cannot listen")) (+ "unexpected error without IPv6: " l))
      (assert (starts (err (\ () (tcpc "::1" 9))) "cannot connect to ::1:9 (") "connecting without IPv6 is a clean error")
      (assert (starts (err (\ () (udpto (udp) "::1" 9 "x"))) "this UDP socket is IPv4 only") "UDP to an IPv6 address without IPv6")
      (fdw 2 "ipv6.test: SKIPPED, this machine has no IPv6 loopback\n"))
   (: port=(tcpp l)
      c=(tcpc "::1" port) s=(tcpa l)
      (fdw c "ping") (assert (== (fdr s 10) "ping") "IPv6 client to server")
      (fdw s "pong") (assert (== (fdr c 10) "pong") "IPv6 server to client")
      (fdc c) (fdc s) (fdc l)
      (assert (starts (err (\ () (tcpc "::1" port))) (+ "cannot connect to ::1:" port " (")) "refused names the IPv6 host")
      l2=(tcpl 0 "::") port2=(tcpp l2)
      c4=(tcpc "127.0.0.1" port2) s4=(tcpa l2)
      (fdw c4 "v4") (assert (== (fdr s4 10) "v4") "a :: listener takes IPv4 clients")
      c6=(tcpc "::1" port2) s6=(tcpa l2)
      (fdw c6 "v6") (assert (== (fdr s6 10) "v6") "and IPv6 clients")
      (fdc c4) (fdc s4) (fdc c6) (fdc s6) (fdc l2)
      ; UDP over IPv6 (#152): an echo on ::1, a dual-stack "::" server that also hears IPv4, a client reaching a name
      u=(udpl 0 "::1") up=(tcpp u) uc=(udp)
      (udpto uc "::1" up "v6 hello")
      [d ip pt]=(udpfrom2 u 100 2000)
      (assert (&& (== d "v6 hello") (== ip (ip6 "::1")) (> pt 0)) (+ "UDP IPv6 server: " (show [d ip pt])))
      (udpto u ip pt "echo") (assert (== (udpfrom uc 100 2000) "echo") "UDP IPv6 answer")
      (udpto uc "localhost" up "by name") (assert (== (fst (udpfrom2 u 100 2000)) "by name") "UDP to a host name")
      u2=(udpl 0 "::") up2=(tcpp u2)
      (udpto uc "127.0.0.1" up2 "v4") [d ip pt]=(udpfrom2 u2 100 2000)
      (assert (&& (== d "v4") (== ip [127 0 0 1])) (+ "a :: UDP server hears IPv4: " (show [d ip pt])))
      (udpto u2 ip pt "back") (assert (== (udpfrom uc 100 2000) "back") "and answers it")
      (fdc u) (fdc uc) (fdc u2)))
