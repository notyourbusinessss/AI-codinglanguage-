; Key exchange groups (x25519, P-256, P-384) and HelloRetryRequest in lib/tls.aklang, client and server, against openssl (needs openssl)
(use "lib/run.aklang" as t)
r=(t.run "sh tests/lib/tls_groups.sh" nil)
lines=(split (trim r.out) "\n")
(assert (== #lines 13) (+ "tls_groups.sh printed " #lines " lines, expected 13: " (show r.out) r.err))
bad=(~? l=>(! (starts l "ok ")) lines)
(assert (== #bad 0) (+ "tls group checks failed:\n" (join bad "\n")))
