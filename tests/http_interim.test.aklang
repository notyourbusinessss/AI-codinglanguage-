; lib/http skips interim 1xx replies and returns the final one (#185)
(use "lib/run.aklang" as t)
(use "../lib/http.aklang" as h)
out=(+ "/tmp/akinterim-" ($ (now)) "-" ($ (rand 1000000000)))
pid=(trim (sh (+ "bin/ak tests/lib/interim_srv.aklang >" out " 2>" out ".err & echo $!")))
(wh (|| (! (ex out)) (== (trim (rd out)) "")) (sleep 50))
port=(num (trim (rd out)))
(= (get p) (h.get (+ "http://127.0.0.1:" port p) nil {:rms 3000}))
(= (fails p) (try (: (get p) nil) e=>e))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
r=(try (:
  a=(get "/103")
  (is "103 then 200" [a.status a.body] [200 "ok"])
  (is "the headers are those of the 200" [a.headers["content-length"] a.headers.link] ["2" nil])
  a=(get "/100103")
  (is "100 and 103 then 200" [a.status a.body] [200 "ok"])
  a=(get "/chunked")
  (is "1xx before a chunked reply" [a.status a.body a.headers["x-e"]] [200 "hello" nil])
  (is "1xx then a closed connection raises" (has (fails "/trunc") "closed before the response head") true)
  a=(get "/101")
  (is "101 is the final reply" [a.status a.body] [101 ""])
  (is "too many interim replies raise" (has (fails "/many") "too many interim") true)
  a=(get "/plain")
  (is "a plain reply is unchanged" [a.status a.body] [200 "ok"])
  true) e=>e)
(sh (+ "kill " pid " 2>/dev/null; rm -f " out " " out ".err"))
(assert (== r true) (+ "http_interim: " (show r)))
(assert (> n 7) (+ "too few checks ran: " n))
