; peer, sockname, shutw/shutr and sockopt (#147)
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
l=(tcpl 0 "127.0.0.1")
port=(tcpp l)
c=(tcpc "127.0.0.1" port)
s=(tcpa l)
(is "sockname of the listener" (sockname l) {:ip "127.0.0.1" :port port})
(is "peer of the client is the server" (peer c) {:ip "127.0.0.1" :port port})
(is "accepted peer is the client's own address" (peer s) (sockname c))
(is "client port is not the server's" (!= (sockname c).port port) true)
(is "peer of an unconnected listener raises" (try (: (peer l) "no error") e=>e) "getpeername failed")
(sockopt c "nodelay") (sockopt c "keepalive" true) (sockopt c "keepalive" false) (sockopt s "reuseaddr" 1)
(is "unknown option" (try (: (sockopt c "nope") "no error") e=>e) "unknown socket option: nope")
; half-close: the client says "hi", shuts its write side, and still reads the answer
(fdw c "hi")
(shutw c)
got="" d=(fdr s 100 2000) (wh (&& d (!= d "")) got+=d d=(fdr s 100 2000))
(is "server reads the request and then end-of-file" [got d] ["hi" ""])
(fdw s "bye")
(is "client still reads after shutw" (fdr c 100 2000) "bye")
(shutr c)
(is "after shutr the client reads end-of-file" (fdr c 100 500) "")
(fdc c) (fdc s) (fdc l)
(assert (> n 8) "too few checks ran")
