; Malformed input is rejected with a clear error: broken number literals and string escapes (#21, #22), unpaired JSON surrogates (#29),
; bad arguments to exit (#49), absurd sizes that must raise instead of hanging or being killed (#82), case mapping of non-ASCII text (#46),
; list builtins given non-lists (#106), socket argument checks, integer literals above 2^53 (#117).
(use "lib/run.aklang" as t)
(= (shq s) (+ "'" (rep s "'" "'\\''") "'"))
n=0 bad=0
(= (ck name ok info) (<- n n+1) (? (! ok) (: (<- bad bad+1) (p "FAIL" name "\n  " (show info)))))
(= (ev src) (t.run (+ "timeout 30 bin/ak -e " (shq src)) nil))

; number literals and escapes: a syntax error naming the problem, exit 1, nothing printed
r=(ev "(p 0x)")
(ck "rejects (p 0x)" (&& (== r.code 1) (== r.out "") (has r.err "0x needs")) r)
r=(ev "(p 0X_)")
(ck "rejects (p 0X_)" (&& (== r.code 1) (== r.out "") (has r.err "0x needs")) r)
r=(ev "(p 0b)")
(ck "rejects (p 0b)" (&& (== r.code 1) (== r.out "") (has r.err "0b needs")) r)
r=(ev "(p 0B__)")
(ck "rejects (p 0B__)" (&& (== r.code 1) (== r.out "") (has r.err "0b needs")) r)
r=(ev "(p \"\\xGG\")")
(ck "rejects (p \"\\xGG\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p \"\\xA\")")
(ck "rejects (p \"\\xA\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p \"\\x4\")")
(ck "rejects (p \"\\x4\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p \"\\uGGGG\")")
(ck "rejects (p \"\\uGGGG\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p \"\\u12\")")
(ck "rejects (p \"\\u12\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p \"\\u{41\")")
(ck "rejects (p \"\\u{41\")" (&& (== r.code 1) (== r.out "") (has r.err "missing }")) r)
r=(ev "(p \"\\u{}\")")
(ck "rejects (p \"\\u{}\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p \"\\u{zz}\")")
(ck "rejects (p \"\\u{zz}\")" (&& (== r.code 1) (== r.out "") (has r.err "bad hex")) r)
r=(ev "(p 0xFf 0b1_0 0x_1 \"\\x41\\u0042\\u{43}\\u{1F600}\")")
(ck "valid literals and escapes still work" (&& (== r.code 0) (== r.out "255 2 1 ABC😀\n")) r)
; JSON surrogates
r=(ev "(p (try (unjson \"\\\"\\\\ud83d\\\"\") e=>\"caught\"))")
(ck "unjson rejects \"\\ud83d\"" (== r.out "caught\n") r)
r=(ev "(p (try (unjson \"\\\"\\\\ude00\\\"\") e=>\"caught\"))")
(ck "unjson rejects \"\\ude00\"" (== r.out "caught\n") r)
r=(ev "(p (try (unjson \"\\\"\\\\ud83d\\\\u0041\\\"\") e=>\"caught\"))")
(ck "unjson rejects \"\\ud83d\\u0041\"" (== r.out "caught\n") r)
r=(ev "(p (try (unjson \"\\\"\\\\ud83dx\\\"\") e=>\"caught\"))")
(ck "unjson rejects \"\\ud83dx\"" (== r.out "caught\n") r)
r=(ev "(p (try (unjson \"\\\"\\\\ude00\\\\ud83d\\\"\") e=>\"caught\"))")
(ck "unjson rejects \"\\ude00\\ud83d\"" (== r.out "caught\n") r)
r=(ev "(p (unjson \"\\\"\\\\ud83d\\\\ude00 \\\\u00e9\\\"\") (unjson \"[\\\"\\\\ud83d\\\\ude00\\\"]\"))")
(ck "unjson accepts a valid pair" (== r.out "😀 é [\"😀\"]\n") r)
; exit
r=(ev "(exit \"x\")")
(ck "exit \"x\" fails" (&& (== r.code 1) (starts r.err "error: exit")) r)
r=(ev "(exit true)")
(ck "exit true fails" (&& (== r.code 1) (starts r.err "error: exit")) r)
r=(ev "(exit [1])")
(ck "exit [1] fails" (&& (== r.code 1) (starts r.err "error: exit")) r)
r=(ev "(exit 1.5)")
(ck "exit 1.5 fails" (&& (== r.code 1) (starts r.err "error: exit")) r)
r=(ev "(exit {})")
(ck "exit {} fails" (&& (== r.code 1) (starts r.err "error: exit")) r)
r=(ev "(p \"x\") (exit)")
(ck "exit status" (&& (== r.code 0) (== r.out "x\n")) r)
r=(ev "(p \"x\") (exit 0)")
(ck "exit 0 status" (&& (== r.code 0) (== r.out "x\n")) r)
r=(ev "(p \"x\") (exit 3)")
(ck "exit 3 status" (&& (== r.code 3) (== r.out "x\n")) r)
r=(ev "(p \"x\") (exit 300)")
(ck "exit 300 status" (&& (== r.code 44) (== r.out "x\n")) r)
; sizes: each must raise within the timeout, and the program must go on
r=(ev "(p 0 (try (: (rpt \"a\" 1e10) \"no error\") e=>\"caught\"))\n(p 1 (try (: (rpt \"a\" 1e300) \"no error\") e=>\"caught\"))\n(p 2 (try (: (rpt [1] 1e300) \"no error\") e=>\"caught\"))\n(p 3 (try (: (padl \"a\" 1e10) \"no error\") e=>\"caught\"))\n(p 4 (try (: (padr \"a\" 1e10) \"no error\") e=>\"caught\"))\n(p 5 (try (: (0..1e10) \"no error\") e=>\"caught\"))\n(p 6 (try (: (0..1e10 3) \"no error\") e=>\"caught\"))\n(p 7 (try (: (json [1 2 3] 1e300) \"no error\") e=>\"caught\"))\n(p \"alive\")")
(ck "huge sizes raise" (== r.out "0 caught\n1 caught\n2 caught\n3 caught\n4 caught\n5 caught\n6 caught\n7 caught\nalive\n") r)
r=(ev "(p (rpt \"\" 1e300) (rpt [] 1e300) (rpt \"ab\" 3) (json [1] 2) (padl \"7\" 3 \"0\"))")
(ck "zero-length repeats and normal sizes still work" (== r.out " [] ababab [\n  1\n] 007\n") r)
; case mapping of non-ASCII letters (simple 1:1 mappings)
r=(ev "(p (up \"àéîõüÿ ĀāĂă Łł Ωα άέ жзя ёў\") (lo \"ÀÉÎÕÜŸ ĀĂ ŁŇ ΩΑ ΆΈ ЖЗЯ ЁЎ\") (up \"日本語a\") (lo \"×÷B\"))")
(ck "up/lo map Latin-1, Latin Extended-A, Greek and Cyrillic" (== r.out "ÀÉÎÕÜŸ ĀĀĂĂ ŁŁ ΩΑ ΆΈ ЖЗЯ ЁЎ àéîõüÿ āă łň ωα άέ жзя ёў 日本語A ×÷b\n") r)
; list builtins reject non-lists with a type error (#106)
(for f ["rev" "sort" "flat" "uniq"] (for a ["5" "true"]
  r=(ev (+ "(" f " " a ")"))
  (ck (+ f " " a " raises") (&& (== r.code 1) (starts r.err "error: expected list, got ")) r)))
r=(ev "(join 5 \",\")")
(ck "join 5 raises" (&& (== r.code 1) (starts r.err "error: expected list, got num")) r)
(for f ["keys" "vals"]
  r=(ev (+ "(" f " 5)"))
  (ck (+ f " 5 raises") (&& (== r.code 1) (starts r.err (+ "error: " f " of num"))) r))
(for f ["up" "lo" "trim"]
  r=(ev (+ "(" f " 5)"))
  (ck (+ f " 5 raises") (&& (== r.code 1) (starts r.err "error: expected string, got num")) r))
r=(ev "(p (rev [1 2]) (rev \"ab\") (sort \"ba\") (join [1 2] \"-\") (flat [[1] 2]) (uniq [1 1]) (keys nil) (rev nil))")
(ck "valid list builtins still work" (== r.out "[2 1] ba [\"a\" \"b\"] 1-2 [1 2] [1] [] []\n") r)
; case mapping leaves invalid UTF-8 bytes alone (#99)
bin=(+ "/tmp/aktest-iv-" ($ (now)) ".dat")
(sh (+ "printf '\\026\\003\\001\\002\\000\\001\\000\\001\\374\\003\\003\\377\\376\\200\\101\\303\\251\\303' > " bin))
r=(ev (+ "s=(rd " (show bin) ")\n(p #(lo s) #(up s) (== (up (lo s)) (up s)))"))
(rm bin)
(ck "up/lo accept invalid UTF-8" (&& (== r.code 0) (re "^\\d+ \\d+ true\n$" r.out)) r)
; the descriptor and length checks on sockets raise instead of crashing
r=(ev "(= (t f) (try (: (f) \"no error\") e=>\"caught\"))\n(p (t ()=>(fdr 0 1e300)) (t ()=>(fdr nil 5)) (t ()=>(fdr 0 \"ab\")) (t ()=>(udpfrom 0 \"ab\")) (t ()=>(fdwait [0] \"x\")) (t ()=>(fdwait 5)))")
(ck "fdr/udpfrom/fdwait check their arguments" (== r.out "caught caught caught caught caught caught\n") r)
; integer literals above 2^53 are a syntax error (#117); 2^53, floats and exponents are fine
r=(ev "(p 9007199254740993)")
(ck "literal 9007199254740993 is rejected" (&& (== r.code 1) (== r.out "") (has r.err "integer literal exceeds 2^53")) r)
r=(ev "(p 123456789012345678901)")
(ck "literal 123456789012345678901 is rejected" (&& (== r.code 1) (== r.out "") (has r.err "integer literal exceeds 2^53")) r)
r=(ev "(p 0x20000000000001)")
(ck "literal 0x20000000000001 is rejected" (&& (== r.code 1) (== r.out "") (has r.err "integer literal exceeds 2^53")) r)
r=(ev "(p 0xFFFFFFFFFFFFFFFF)")
(ck "literal 0xFFFFFFFFFFFFFFFF is rejected" (&& (== r.code 1) (== r.out "") (has r.err "integer literal exceeds 2^53")) r)
r=(ev "(p 0b1000000000000000000000000000000000000000000000000000001)")
(ck "literal 0b1000000000000000000000000000000000000000000000000000001 is rejected" (&& (== r.code 1) (== r.out "") (has r.err "integer literal exceeds 2^53")) r)
r=(ev "(p 00009007199254740993)")
(ck "literal 00009007199254740993 is rejected" (&& (== r.code 1) (== r.out "") (has r.err "integer literal exceeds 2^53")) r)
r=(ev "(p 9007199254740992 0x20000000000000 0b100000000000000000000000000000000000000000000000000000 0009007199254740992 1e20 9007199254740993.5 12345678901234567890n)")
(ck "literals up to 2^53, floats and BigInts still work" (== r.out "9007199254740992 9007199254740992 9007199254740992 9007199254740992 100000000000000000000 9007199254740994 12345678901234567890\n") r)
(assert (== bad 0) (+ bad " of " n " input validation checks failed"))
(assert (>= n 40) (+ "only " n " checks ran"))
(p (+ n " input validation checks passed"))
