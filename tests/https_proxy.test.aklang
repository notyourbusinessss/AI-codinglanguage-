; https:// proxies (#164): TLS to the proxy, CONNECT inside it, TLS to the target inside that (tests/lib/tls_proxy.aklang, tests/lib/tls_serve.aklang)
(use "../lib/http.aklang" as h)
(use "../lib/pki.aklang" as k)
(use "../lib/ws.aklang" as w)
(use "lib/run.aklang" as t)
base=(+ "/tmp/akhp-" ($ (now)) "-" ($ (rand 1000000000)))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(= (waitline f) (wh (|| (! (ex f)) (! (has (rd f) "\n"))) (sleep 50)) (split (trim (rd f)) "\n"))
pids=[]
(= (bg cmd f) (<- pids (+> pids (trim (sh (+ cmd " >" f " 2>&1 & echo $!"))))))
(= (finish) (sh (+ "kill " (join pids " ") " 2>/dev/null; rm -rf " base "*")))
r=(try (:
  d=(+ base ".d/") (sh (+ "mkdir " d "; cd " d "; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -keyout ca.key -out ca.pem -subj /CN=ca -days 3 -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign 2>/dev/null; printf 'basicConstraints=CA:FALSE\nsubjectAltName=DNS:localhost\n' > ext; openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out s.key 2>/dev/null; openssl req -new -key s.key -subj /CN=s -out s.csr; openssl x509 -req -in s.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 3 -extfile ext -out s.pem 2>/dev/null"))
  roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (+ d "ca.pem"))))
  (bg (+ "bin/ak tests/lib/tls_serve.aklang " d "s.pem " d "s.key 1") (+ base ".t"))
  tp=(num (waitline (+ base ".t"))[0])
  (bg (+ "bin/ak tests/lib/tls_proxy.aklang " d "s.pem " d "s.key 4") (+ base ".p"))
  pp=(num (waitline (+ base ".p"))[0])
  px=(+ "https://u:pw@localhost:" pp)
  rr=(h.get (+ "https://localhost:" tp "/") nil {:roots roots :proxy px})
  (is "https through an https proxy" [rr.status (starts rr.body "hello")] [200 true])
  (is "the proxy saw CONNECT" (has (rd (+ base ".p")) (+ "CONNECT localhost:" tp "\n")) true)
  rp=(h.get "http://example.test/x" nil {:roots roots :proxy px})
  (is "http through an https proxy" [rp.status rp.body] [200 "proxied GET http://example.test/x HTTP/1.1"])
  ; WebSocket through the proxy (#166): ws:// is tunnelled with CONNECT too
  (bg "bin/ak tests/lib/ws_srv.aklang 1" (+ base ".w"))
  wp=(num (waitline (+ base ".w"))[0])
  ws=(w.connect (+ "ws://127.0.0.1:" wp "/") {:proxy px :roots roots})
  (w.send ws "hi") (is "ws echo through the proxy" (w.recv ws) "hi") (w.close ws 1000 "")
  (is "ws went through CONNECT" (has (rd (+ base ".p")) (+ "CONNECT 127.0.0.1:" wp "\n")) true)
  ; the proxy's certificate is verified: without the CA the request fails
  (is "an untrusted https proxy" (has (try (: (h.get "http://example.test/" nil {:proxy px :rms 3000}) "no error") e=>e) "tls") true)
  true) e=>e)
(finish)
(assert (== r true) (+ "https_proxy: " (show r)))
(assert (> n 3) (+ "too few checks ran: " n))
