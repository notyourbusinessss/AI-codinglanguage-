; exit codes outside 0..255 raise instead of wrapping (#231)
(use "lib/run.aklang" as t)
(= (st code) (t.run (+ "bin/ak -e '(exit " code ")'") nil)[:code])
(= (er code) (t.run (+ "bin/ak -e '(exit " code ")'") nil)[:err])
(assert (== (st "0") 0) "exit 0")
(assert (== (st "1") 1) "exit 1")
(assert (== (st "255") 255) "exit 255")
(assert (== (st "") 0) "exit")
(assert (== (st "nil") 0) "exit nil")
(assert (== (st "256") 1) "exit 256 fails")
(assert (== (st "300") 1) "exit 300 fails")
(assert (== (st "-1") 1) "exit -1 fails")
(assert (== (st "1e9") 1) "exit 1e9 fails")
(assert (has (er "256") "exit: code must be 0 to 255") "message 256")
(assert (has (er "-1") "exit: code must be 0 to 255") "message -1")
(assert (has (er "1.5") "exit: expected an integer") "1.5 still a type error")
(assert (has (er "\"x\"") "expected an integer, got str") "string still a type error")
; a caught range error does not exit
(assert (== (try (exit 256) e=>"caught") "caught") "try catches it")
