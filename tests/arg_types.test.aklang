; wr, app and sh reject values that are not text (#224): nothing is written and no shell starts
(= (bad f) (try (: (f) false) e=>(has e "expected string")))
(= f "/tmp/ak-argtypes-test.txt")
(sh (+ "rm -f " f))
(assert (bad (\ () (sh nil))) "sh nil")
(assert (bad (\ () (sh ["echo" "a b"]))) "sh list")
(assert (bad (\ () (sh 5))) "sh number")
(assert (bad (\ () (wr f ["a" "b"]))) "wr list of strings")
(assert (! (ex f)) "nothing written for a rejected wr")
(assert (bad (\ () (wr f nil))) "wr nil")
(assert (bad (\ () (wr f 42))) "wr number")
(wr f "x")
(assert (bad (\ () (app f nil))) "app nil")
(assert (== (rd f) "x") "file untouched by a rejected app")
(assert (bad (\ () (wr f [65 300]))) "wr byte out of range")
; valid inputs keep working
(wr f "text") (assert (== (rd f) "text") "wr string")
(wr f [104 105]) (assert (== (rd f) "hi") "wr byte list")
(app f "!") (assert (== (rd f) "hi!") "app string")
(app f [33]) (assert (== (rd f) "hi!!") "app byte list")
(wr f (u8 3)) (assert (== #(rd f) 3) "wr typed array")
(assert (== (trim (sh "echo ok")) "ok") "sh string")
(sh (+ "rm -f " f))
