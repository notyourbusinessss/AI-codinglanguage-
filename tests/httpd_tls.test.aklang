; lib/httpd.aklang over TLS (#165): requests from lib/http.aklang and curl, keep-alive, a client that stalls in the handshake, a plain-text client
(use "../lib/http.aklang" as h)
(use "../lib/pki.aklang" as k)
(use "lib/run.aklang" as t)
base=(+ "/tmp/akht-" ($ (now)) "-" ($ (rand 1000000000)))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(= (waitline f) (wh (|| (! (ex f)) (! (has (rd f) "\n"))) (sleep 50)) (split (trim (rd f)) "\n"))
pids=[]
(= (finish) (sh (+ "kill " (join pids " ") " 2>/dev/null; rm -rf " base "*")))
r=(try (:
  d=(+ base ".d/") (sh (+ "mkdir " d "; cd " d "; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -keyout ca.key -out ca.pem -subj /CN=ca -days 3 -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign 2>/dev/null; printf 'basicConstraints=CA:FALSE\nsubjectAltName=DNS:localhost\n' > ext; openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out s.key 2>/dev/null; openssl req -new -key s.key -subj /CN=s -out s.csr; openssl x509 -req -in s.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 3 -extfile ext -out s.pem 2>/dev/null"))
  roots=(~ x=>(k.cert_parse x) (k.pem_certs (rd (+ d "ca.pem"))))
  (<- pids (+> pids (trim (sh (+ "bin/ak tests/lib/httpd_tls_srv.aklang " d "s.pem " d "s.key >" base ".o 2>" base ".e & echo $!")))))
  p=(num (waitline (+ base ".o"))[0])
  u=(+ "https://localhost:" p "/")
  rr=(h.get u nil {:roots roots})
  (is "https GET" [rr.status rr.body] [200 "hello localhost GET:"])
  rp=(h.post u "abc" nil {:roots roots})
  (is "https POST" rp.body "hello localhost POST:abc")
  ; keep-alive: three requests on one pooled connection (:maxreq 3)
  ss=(h.session())
  (for i 3 (is "pooled request" (h.get u nil {:roots roots :pool ss}).body "hello localhost GET:"))
  (h.release ss)
  x=(t.run (+ "curl -s --cacert " d "ca.pem https://localhost:" p "/") nil)
  (is "curl" x.out "hello localhost GET:")
  x=(t.run (+ "(printf 'GET / HTTP/1.0\\r\\n\\r\\n'; sleep 0.3) | openssl s_client -connect localhost:" p " -servername localhost -CAfile " d "ca.pem -quiet 2>/dev/null") nil)
  (is "openssl s_client" (has x.out "hello localhost GET:") true)
  ; a client that never finishes the handshake does not block others and is dropped after :headms
  st=(tcpc "127.0.0.1" p) (fdw st "\x16\x03\x01")
  t0=(now)
  (is "a request while another handshake stalls" (h.get u nil {:roots roots}).body "hello localhost GET:")
  (is "...and it was not slow" (< (- (now) t0) 1400) true)
  (is "the stalled handshake is closed" (fdr st 100 4000) "")
  (fdc st)
  ; plain text to a TLS port is dropped, the server goes on
  pl=(tcpc "127.0.0.1" p) (fdw pl "GET / HTTP/1.0\r\n\r\n") (try (fdr pl 100 2000) e=>nil) (fdc pl)
  (is "still serving after garbage" (h.get u nil {:roots roots}).status 200)
  (is "handshake errors are logged" (has (rd (+ base ".e")) "tls handshake failed") true)
  true) e=>e)
(finish)
(assert (== r true) (+ "httpd_tls: " (show r)))
(assert (> n 8) (+ "too few checks ran: " n))
