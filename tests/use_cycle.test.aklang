; a circular `use` ends at once with the chain of files, never a silent hang (#202); a file used twice without a cycle still loads once
(use "lib/run.aklang" as t)
d=(+ "/tmp/aktest-cycle-" ($ (rand 1000000000)))
(mkdir d)
(= (w name code) (wr (+ d "/" name) code))
(w "a.aklang" "(use \"b.aklang\" as b)\n(p 1)\n")
(w "b.aklang" "(use \"a.aklang\" as a)\n(p 2)\n")
(w "self.aklang" "(use \"self.aklang\" as q)\n")
(w "p1.aklang" "(use \"p2.aklang\")\n(p 1)\n")
(w "p2.aklang" "(use \"./p1.aklang\")\n")
(w "top.aklang" "(use \"left\")\n(use \"right\")\n(p (+ (l) (r) (d)))\n")
(w "left.aklang" "(use \"deep.aklang\")\n(= (l) 1)\n")
(w "right.aklang" "(use \"deep.aklang\")\n(= (r) 10)\n")
(w "deep.aklang" "(= (d) 100)\n")
(w "ns.aklang" "(use \"left.aklang\" as x)\n(use \"right.aklang\" as y)\n(p (+ x.l() y.r() x.d()))\n")
(for [file chain] [["a.aklang" "a.aklang -> b.aklang -> a.aklang"] ["self.aklang" "self.aklang -> self.aklang"] ["p1.aklang" "p1.aklang -> p2.aklang -> p1.aklang"]]
  (for cmd ["" "check " "build "]
    r=(t.run (+ "timeout 20 bin/ak " cmd d "/" file (? (== cmd "build ") (+ " " d "/out") "")) nil)
    (assert (&& (== r.code 1) (has r.err (+ "use: circular import " (join (~ (\ (n) (+ d "/" n)) (split chain " -> ")) " -> "))) (== r.out "")) (+ cmd file ": " (show r.code) " " (show r.err)))))
r=(t.run (+ "timeout 20 bin/ak test " d "/a.aklang") nil)
(assert (== r.code 1) (+ "test: " (show r.code) " " (show r.err)))
r=(t.run (+ "timeout 20 bin/ak " d "/top.aklang") nil)
(assert (&& (== r.code 0) (== r.out "111\n")) (+ "diamond: " (show r.out) (show r.err)))
r=(t.run (+ "timeout 20 bin/ak " d "/ns.aklang") nil)
(assert (&& (== r.code 0) (== r.out "111\n")) (+ "diamond with aliases: " (show r.out) (show r.err)))
(sh (+ "rm -rf " d))
