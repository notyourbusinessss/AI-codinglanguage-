; TCP over loopback in one process: listen, connect, accept, then a tiny HTTP exchange and fdwait.
l=(tcpl 0 "127.0.0.1")
port=(tcpp l)
(p "port ok" port>1023)
c=(tcpc "127.0.0.1" port)
s=(tcpa l)
(fdw c "GET /hi HTTP/1.0\r\nHost: x\r\n\r\n")
rq=(fdr s)
line=(split rq "\r\n")[0]
(p "request line" line)
[m path ver]=(split line " ")
body=(json {:path path :method m})
(fdw s (++ "HTTP/1.0 200 OK\r\nContent-Length: " #body "\r\n\r\n" body))
(fdc s)
resp="" more=true
(wh more d=(fdr c 4) (? d=="" more=false resp+=d))
(p (len resp) "bytes")
(p (unjson (split resp "\r\n\r\n")[1]))
(fdc c)
; fdwait: nothing readable, then something
a=(tcpc "localhost" port)
b=(tcpa l)
(p "ready" (fdwait [b] 10))
(fdw a "ping")
(p "ready" (== (fdwait [b l] 1000) [b]))
(p (fdr b))
(fdw b [104 105])
(p (fdr a 2))
(fdc a)
(p "eof" (fdr b) (len (fdwait [b] 1000)))
(fdc b)
(fdc l)
(p (try (tcpc "127.0.0.1" port) e=>"refused"))
(p (try (tcpc "no.such.host.invalid" 80) e=>e))
(p (dotted "10.0.0.256") (dotted "1.2.3") (dotted "1.2.3.4"))
; fdwait on an fd that is not open (#172)
cl=(tcpl 0) (fdc cl)
(p (starts (try (fdwait [cl] 10) e=>e) "fdwait: bad file descriptor ") (try (fdwait [1000000] 10) e=>e))
; socket options (#173): set and read back; multicast on loopback
us=(udp)
(sockopt us "rcvbuf" 100000) (sockopt us "sndbuf" 65536)
(p (>= (getsockopt us "rcvbuf") 100000) (>= (getsockopt us "sndbuf") 65536))
tl=(tcpl 0) (sockopt tl "nodelay" true) (sockopt tl "linger" 5)
(p (getsockopt tl "nodelay") (getsockopt tl "keepalive") (getsockopt tl "linger"))
(sockopt tl "linger" false)
(p (getsockopt tl "linger") (try (sockopt tl "linger" true) e=>e) (try (sockopt tl "rcvbuf" "x") e=>e) (try (getsockopt tl "bogus") e=>e))
mr=(udpl 0 "0.0.0.0") mport=(tcpp mr) ms=(udpl 0 "0.0.0.0")
(sockopt ms "mcastttl" 1) (sockopt ms "mcastloop" true) (sockopt ms "mcastif" "127.0.0.1")
(p (getsockopt ms "mcastttl") (getsockopt ms "mcastloop"))
(mcastjoin mr "239.1.2.3" "127.0.0.1")
(udpto ms "239.1.2.3" mport "hello group")
(p (udpfrom mr 100 1000))
(mcastleave mr "239.1.2.3" "127.0.0.1")
(udpto ms "239.1.2.3" mport "left")
(p (udpfrom mr 100 300) (try (mcastjoin mr "10.0.0.1") e=>e))
