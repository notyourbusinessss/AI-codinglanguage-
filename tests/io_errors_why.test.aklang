; file errors say why (#184), mkdir "" raises (#176), sleep refuses values it cannot honour (#175)
(= (msg f) (try (: (f) "no error") e=>e))
(= (io f want)
  m=(msg f)
  (assert (has m want) (+ "wanted " (show want) ", got " (show m)))
  (assert (== (try (f) e=>(errkind e)) "io") (+ want ": kind")))
d=(+ "/tmp/aktest-why-" ($ (rand 1000000000)))
(mkdir d)
(io (\ () (rd "/nonexistent/f")) "cannot read /nonexistent/f: no such file or directory")
(io (\ () (rd d)) (+ "cannot read " d ": is a directory"))
(io (\ () (wr "/proc/nope/x" "a")) "cannot write /proc/nope/x: no such file or directory")
(wr (+ d "/file") "x")
(io (\ () (wr (+ d "/file/x") "a")) ": not a directory")
(io (\ () (mkdir (+ d "/file/x"))) "cannot create ")
(io (\ () (mkdir "/proc/x")) "cannot create /proc/x: no such file or directory")
(io (\ () (mkdir "")) "cannot create : no such file or directory")
(io (\ () (ls (+ d "/missing"))) "cannot list ")
(io (\ () (ls (+ d "/missing"))) ": no such file or directory")
(io (\ () (mv (+ d "/missing") (+ d "/other"))) ": no such file or directory")
(io (\ () (rm "/proc/version")) "cannot remove /proc/version: operation not permitted")
(mkdir (+ d "/a/b")) (mkdir (+ d "/a/b")) (assert (isdir (+ d "/a/b")) "mkdir a/b")
(sh (+ "rm -rf " d))
(for v [1e300 -1 (pow 0 -1) "a" nil 1e13]
  m=(msg (\ () (sleep v)))
  (assert (has m "invalid sleep") (+ "sleep " (show v) ": " m))
  (assert (== (try (sleep v) e=>(errkind e)) "type") "sleep kind"))
(sleep 0) (sleep 5) (sleep 0.5)
