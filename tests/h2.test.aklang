; lib/h2.aklang HPACK (RFC 7541 appendix C examples): integers, Huffman strings, the dynamic table, and the errors a decoder must report
(use "../lib/h2.aklang" as z)
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
(= (hx s) (frombytes (~ x=>(num (++ "0x" x)) (split s " "))))
(= (pairs r) (~ e=>(++ e[0] "=" e[1]) r))
(is "integer 10 in a 5-bit prefix" (bytes (z.hint 10 31 0)) [10])
(is "integer 1337 in a 5-bit prefix" (bytes (z.hint 1337 31 0)) [31 154 10])
(is "decode 1337" (z.dint (hx "1f 9a 0a") 0 31) [1337 3])
st=z.hstate()
(is "C.4.1 first request (Huffman)" (pairs (z.hdecode st (hx "82 86 84 41 8c f1 e3 c2 e5 f2 3a 6b a0 ab 90 f4 ff"))) [":method=GET" ":scheme=http" ":path=/" ":authority=www.example.com"])
(is "C.4.2 second request uses the dynamic table" (pairs (z.hdecode st (hx "82 86 84 be 58 86 a8 eb 10 64 9c bf"))) [":method=GET" ":scheme=http" ":path=/" ":authority=www.example.com" "cache-control=no-cache"])
(is "C.4.3 third request" (pairs (z.hdecode st (hx "82 87 85 bf 40 88 25 a8 49 e9 5b a9 7d 7f 89 25 a8 49 e9 5b b8 e8 b4 bf"))) [":method=GET" ":scheme=https" ":path=/index.html" ":authority=www.example.com" "custom-key=custom-value"])
(is "the dynamic table holds three entries" #st.dyn 3)
s2=z.hstate()
(is "C.3.1 without Huffman" (pairs (z.hdecode s2 (hx "82 86 84 41 0f 77 77 77 2e 65 78 61 6d 70 6c 65 2e 63 6f 6d"))) [":method=GET" ":scheme=http" ":path=/" ":authority=www.example.com"])
(is "encode then decode" (pairs (z.hdecode z.hstate() (z.hencode [["a" "b"] ["cookie" "x=1"]]))) ["a=b" "cookie=x=1"])
(is "index 0 is invalid" (try (: (z.hdecode z.hstate() (hx "80")) "no error") e=>e) "http2: bad header table index")
(is "a cut string" (try (: (z.hdecode z.hstate() (hx "40 05 61")) "no error") e=>e) "http2: header block cut short")
(is "a table size update over the limit" (try (: (z.hdecode z.hstate() (hx "3f e2 1f")) "no error") e=>e) "http2: header table size over the limit")
(is "bad Huffman padding" (try (: (z.hdecode z.hstate() (hx "00 01 61 81 00")) "no error") e=>e) "http2: bad Huffman padding")
(assert (> n 10) (+ "too few checks ran: " n))
