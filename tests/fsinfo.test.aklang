; stat, cp, chmod, cwd and chdir (#189)
(= (eq a b msg) (assert (== a b) (+ msg ": " (show a) " != " (show b))))
d=(+ "/tmp/aktest-fs-" ($ (rand 1000000000)))
(mkdir d)
s=(stat d)
(assert (&& s.dir (> s.mtime 1e12) (== (stat "/nonexistent") nil) (== (stat (+ d "/nofile/x")) nil)) (show s))
big=(rpt "0123456789abcdef" 400000)
(wr (+ d "/a") big)
(eq (stat (+ d "/a")).size 6400000 "size")
(assert (! (stat (+ d "/a")).dir) "a file is not a dir")
(chmod (+ d "/a") 416)
(eq (stat (+ d "/a")).mode 416 "chmod then stat")
(cp (+ d "/a") (+ d "/b"))
(assert (== (rd (+ d "/b")) big) "copy is identical")
(eq (stat (+ d "/b")).mode 416 "copy keeps the mode")
(wr (+ d "/c") "short")
(cp (+ d "/c") (+ d "/b"))
(eq (rd (+ d "/b")) "short" "copy replaces the target")
(sh (+ "ln -s a " d "/lnk"))
(for [x y] [[(+ d "/a") (+ d "/a")] [(+ d "/a") (+ d "/lnk")] [d (+ d "/z")] [(+ d "/nofile") (+ d "/z")] [(+ d "/a") (+ d "/nodir/z")]]
  (assert (== (try (cp x y) e=>(errkind e)) "io") (+ "cp " x " " y)))
(eq (rd (+ d "/a")) big "cp onto itself leaves the file")
(assert (has (try (cp (+ d "/a") (+ d "/lnk")) e=>e) "same file") "same file message")
(assert (== (try (chmod (+ d "/a") 99999) e=>(errkind e)) "type") "bad mode")
(assert (== (try (chmod (+ d "/missing") 420) e=>(errkind e)) "io") "chmod missing")
old=(cwd)
(chdir d)
(eq (cwd) d "chdir")
(assert (ex "a") "relative paths use the new directory")
(wr "rel.txt" "r")
(chdir old)
(eq (rd (+ d "/rel.txt")) "r" "written relative to the new directory")
(assert (== (try (chdir (+ d "/missing")) e=>(errkind e)) "io") "chdir missing")
(eq (cwd) old "failed chdir keeps the directory")
(sh (+ "rm -rf " d))
