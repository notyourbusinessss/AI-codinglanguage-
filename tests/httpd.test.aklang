; lib/httpd.aklang (#58): routing, query parsing, bodies, keep-alive, limits and malformed requests against tests/lib/httpd_srv.aklang
(use "lib/run.aklang" as t)
out=(+ "/tmp/akhttpd-" ($ (now)) "-" ($ (rand 1000000000)))
pid=(trim (sh (+ "bin/ak tests/lib/httpd_srv.aklang >" out " 2>" out ".err & echo $!")))
(= (finish) (sh (+ "kill " pid " 2>/dev/null; rm -f " out)))
(= (portof) (wh (! (ex out)) (sleep 50)) (wh (== (trim (rd out)) "") (sleep 50)) (num (trim (rd out))))
port=(portof)
(= (raw req ms=2000)                    ; send req, read until the server closes the connection or ms pass
  c=(tcpc "127.0.0.1" port) (fdw c req) got="" end=(+ (now) ms)
  (wh (> end (now))
    d=(fdr c 65536 (- end (now)))
    (? (|| (== d nil) (== d "")) end=0 got+=d))
  (fdc c) got)
(= (body r) k=(idx r "\r\n\r\n") (? k>=0 r[k+4..] ""))
(= (head1 r) (fst (split r "\r\n")))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
r=(try (: 
  (is "route with a parameter" (body (raw "GET /user/42 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "hello 42")
  (is "status line" (head1 (raw "GET / HTTP/1.1\r\nConnection: close\r\n\r\n")) "HTTP/1.1 200 OK")
  (is "query decoding" (body (raw "GET /q?a=1&b=x%20y+z&a=3 HTTP/1.1\r\nConnection: close\r\n\r\n")) "{\"a\":\"3\",\"b\":\"x y z\"}")
  (is "POST body, query and header" (body (raw "POST /echo?x=9 HTTP/1.1\r\nX-Extra: 7\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")) "POST:abc:9:7")
  (is "POST status" (head1 (raw "POST /echo HTTP/1.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) "HTTP/1.1 201 Created")
  (is "chunked request body" (body (raw "POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n2;ext=1\r\nde\r\n0\r\n\r\n")) "POST:abcde::")
  (is "rest of path" (body (raw "GET /files/a/b/c HTTP/1.1\r\nConnection: close\r\n\r\n")) "rest=a/b/c")
  (is "404" (head1 (raw "GET /nope HTTP/1.1\r\nConnection: close\r\n\r\n")) "HTTP/1.1 404 Not Found")
  (is "405 with Allow" (has (raw "DELETE /echo HTTP/1.1\r\nConnection: close\r\n\r\n") "allow: POST") true)
  (is "405 status" (head1 (raw "DELETE /echo HTTP/1.1\r\nConnection: close\r\n\r\n")) "HTTP/1.1 405 Method Not Allowed")
  (is "HEAD has no body" (body (raw "HEAD /user/1 HTTP/1.1\r\nConnection: close\r\n\r\n")) "")
  (is "HEAD keeps Content-Length" (has (raw "HEAD /user/1 HTTP/1.1\r\nConnection: close\r\n\r\n") "content-length: 7") true)
  (is "a handler error is a 500" (head1 (raw "GET /boom HTTP/1.1\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "the server survived it" (body (raw "GET /user/7 HTTP/1.1\r\nConnection: close\r\n\r\n")) "hello 7")
  (is "a handler returning nil is a 500" (head1 (raw "GET /nothing HTTP/1.1\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "bad request line" (head1 (raw "GARBAGE\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "bad header line" (head1 (raw "GET / HTTP/1.1\r\nno colon here\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "target must start with /" (head1 (raw "GET foo HTTP/1.1\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "HTTP/2 is refused" (head1 (raw "GET / HTTP/2.0\r\n\r\n")) "HTTP/1.1 505 HTTP Version Not Supported")
  (is "bad Content-Length" (head1 (raw "POST /echo HTTP/1.1\r\nContent-Length: abc\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "body over the limit" (head1 (raw "POST /echo HTTP/1.1\r\nContent-Length: 5000\r\n\r\n")) "HTTP/1.1 413 Payload Too Large")
  (is "head over the limit" (head1 (raw (+ "GET / HTTP/1.1\r\nX-Big: " (rpt "a" 3000) "\r\n\r\n"))) "HTTP/1.1 431 Request Header Fields Too Large")
  (is "head never finished" (head1 (raw (+ "GET / HTTP/1.1\r\nX-Big: " (rpt "a" 3000)))) "HTTP/1.1 431 Request Header Fields Too Large")
  (is "100-continue" (has (raw "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 1\r\nConnection: close\r\n\r\nx") "100 Continue") true)
  ; keep-alive: two requests on one connection, then the server closes after the second asks for it
  two=(raw "GET /user/1 HTTP/1.1\r\n\r\nGET /user/2 HTTP/1.1\r\nConnection: close\r\n\r\n")
  (is "keep-alive serves both" (len (split two "HTTP/1.1 200 OK")) 3)
  (is "keep-alive replies in order" (&& (has two "hello 1") (has two "hello 2") (< (idx two "hello 1") (idx two "hello 2"))) true)
  ; --maxreq 3: the third response closes the connection
  three=(raw "GET /user/1 HTTP/1.1\r\n\r\nGET /user/2 HTTP/1.1\r\n\r\nGET /user/3 HTTP/1.1\r\n\r\nGET /user/4 HTTP/1.1\r\n\r\n")
  (is "maxreq closes the connection" (&& (has three "hello 3") (! (has three "hello 4")) (has three "connection: close")) true)
  (is "HTTP/1.0 closes" (has (raw "GET / HTTP/1.0\r\n\r\n") "connection: close") true)
  ; two connections at once: a slow handler does not hold up the other one
  c1=(tcpc "127.0.0.1" port) (fdw c1 "GET /slow HTTP/1.1\r\nConnection: close\r\n\r\n")
  t0=(now) fast=(raw "GET / HTTP/1.1\r\nConnection: close\r\n\r\n") dt=(- (now) t0)
  (is "slow handler does not block others" (&& (has fast "root") (< dt 250)) true)
  late="" end=(+ (now) 3000)
  (wh (&& (! (has late "slow")) (> end (now))) d=(fdr c1 65536 (- end (now))) (? (|| (== d nil) (== d "")) end=0 late+=d))
  (is "the slow reply still arrives" (has late "slow") true)
  true) e=>e)
errs=(? (ex (+ out ".err")) (rd (+ out ".err")) "")
(finish)
(sh (+ "rm -f " out ".err"))
(assert (== r true) (+ "httpd: " (show r) " " (show errs)))
(assert (> n 25) (+ "too few checks ran: " n))
