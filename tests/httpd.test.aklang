; lib/httpd.aklang (#58): routing, query parsing, bodies, keep-alive, limits and malformed requests against tests/lib/httpd_srv.aklang
(use "lib/run.aklang" as t)
out=(+ "/tmp/akhttpd-" ($ (now)) "-" ($ (rand 1000000000)))
pid=(trim (sh (+ "bin/ak tests/lib/httpd_srv.aklang >" out " 2>" out ".err & echo $!")))
(= (finish) (sh (+ "kill " pid " 2>/dev/null; rm -f " out)))
(= (portof) (wh (! (ex out)) (sleep 50)) (wh (== (trim (rd out)) "") (sleep 50)) (num (trim (rd out))))
port=(portof)
(= (raw req ms=2000)                    ; send req, read until the server closes the connection or ms pass
  c=(tcpc "127.0.0.1" port) (fdw c req) got="" end=(+ (now) ms)
  (wh (> end (now))
    d=(fdr c 65536 (- end (now)))
    (? (|| (== d nil) (== d "")) end=0 got+=d))
  (fdc c) got)
(= (body r) k=(idx r "\r\n\r\n") (? k>=0 r[k+4..] ""))
(= (head1 r) (fst (split r "\r\n")))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
r=(try (: 
  (is "route with a parameter" (body (raw "GET /user/42 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "hello 42")
  (is "client address (#147)" (body (raw "GET /peer HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "127.0.0.1:true")
  (is "status line" (head1 (raw "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 200 OK")
  (is "query decoding" (body (raw "GET /q?a=1&b=x%20y+z&a=3 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "{\"a\":\"3\",\"b\":\"x y z\"}")
  (is "POST body, query and header" (body (raw "POST /echo?x=9 HTTP/1.1\r\nHost: x\r\nX-Extra: 7\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")) "POST:abc:9:7")
  (is "POST status" (head1 (raw "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")) "HTTP/1.1 201 Created")
  (is "chunked request body" (body (raw "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n2;ext=1\r\nde\r\n0\r\n\r\n")) "POST:abcde::")
  (is "rest of path" (body (raw "GET /files/a/b/c HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "rest=a/b/c")
  (is "404" (head1 (raw "GET /nope HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 404 Not Found")
  (is "405 with Allow" (has (raw "DELETE /echo HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") "allow: POST") true)
  (is "405 status" (head1 (raw "DELETE /echo HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 405 Method Not Allowed")
  (is "HEAD has no body" (body (raw "HEAD /user/1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "")
  (is "HEAD keeps Content-Length" (has (raw "HEAD /user/1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") "content-length: 7") true)
  (is "a handler error is a 500" (head1 (raw "GET /boom HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "the server survived it" (body (raw "GET /user/7 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "hello 7")
  (is "a handler returning nil is a 500" (head1 (raw "GET /nothing HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "bad request line" (head1 (raw "GARBAGE\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "bad header line" (head1 (raw "GET / HTTP/1.1\r\nHost: x\r\nno colon here\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "target must start with /" (head1 (raw "GET foo HTTP/1.1\r\nHost: x\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "HTTP/2 is refused" (head1 (raw "GET / HTTP/2.0\r\n\r\n")) "HTTP/1.1 505 HTTP Version Not Supported")
  (is "bad Content-Length" (head1 (raw "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "body over the limit" (head1 (raw "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 5000\r\n\r\n")) "HTTP/1.1 413 Payload Too Large")
  (is "head over the limit" (head1 (raw (+ "GET / HTTP/1.1\r\nHost: x\r\nX-Big: " (rpt "a" 3000) "\r\n\r\n"))) "HTTP/1.1 431 Request Header Fields Too Large")
  (is "head never finished" (head1 (raw (+ "GET / HTTP/1.1\r\nHost: x\r\nX-Big: " (rpt "a" 3000)))) "HTTP/1.1 431 Request Header Fields Too Large")
  (is "100-continue" (has (raw "POST /echo HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 1\r\nConnection: close\r\n\r\nx") "100 Continue") true)
  ; framing (#171): both lengths, an unknown coding, and a missing or repeated Host are 400 and the connection closes
  sm=(raw "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET /user/9 HTTP/1.1\r\nHost: x\r\n\r\n")
  (is "Content-Length with Transfer-Encoding is 400 and closes" [(head1 sm) (has sm "hello 9") (has sm "connection: close")] ["HTTP/1.1 400 Bad Request" false true])
  (is "Transfer-Encoding other than chunked" (head1 (raw "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip, chunked\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "HTTP/1.1 without Host" (head1 (raw "GET / HTTP/1.1\r\nConnection: close\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "two Host headers" (head1 (raw "GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\nConnection: close\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  (is "HTTP/1.0 without Host still works" (head1 (raw "GET / HTTP/1.0\r\n\r\n")) "HTTP/1.1 200 OK")
  (is "repeated Content-Length that differs" (head1 (raw "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")) "HTTP/1.1 400 Bad Request")
  ; paths (#191): dot segments are resolved before decoding, %2F stays inside a segment, %00 is refused
  (is "dot segments, also encoded, are resolved" (body (raw "GET /seen/a%20b/%2e%2e/c?x=1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "/seen/c|[\"seen\",\"c\"]")
  (is "/../ cannot climb out of the root" (body (raw "GET /%2e%2e/%2e%2e/seen/etc/passwd HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "/seen/etc/passwd|[\"seen\",\"etc\",\"passwd\"]")
  (is "no .. segment in req.path whatever the encoding" (has (split (fst (split (body (raw "GET /seen/%2e%2E/%2E./a%2f..%2fb/.%2e HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "|")) "/") "..") false)
  (is "%2F stays inside one segment" (body (raw "GET /user/a%2Fb HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "hello a/b")
  (is "req.path writes it as %2F" (body (raw "GET /seen/a%2fb/c HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "/seen/a%2Fb/c|[\"seen\",\"a/b\",\"c\"]")
  (is "a trailing dot segment leaves a slash" (body (raw "GET /seen/a/b/.. HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "/seen/a/|[\"seen\",\"a\",\"\"]")
  (is "encoded NUL in the path is 400" (head1 (raw "GET /seen/a%00b HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 400 Bad Request")
  ; response checks (#190): CR/LF/NUL in headers and a bad status are a 500 without the injected line
  inj=(raw "GET /inj HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
  (is "CR/LF in a header value is a 500 without the injected header" [(head1 inj) (has inj "Set-Cookie") (has inj "set-cookie")] ["HTTP/1.1 500 Internal Server Error" false false])
  (is "a space in a header name is a 500" (head1 (raw "GET /injname HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "status 99999 is a 500" (head1 (raw "GET /badcode HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "a text status is a 500" (head1 (raw "GET /strcode HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "HTTP/1.1 500 Internal Server Error")
  (is "a number as a header value still works" (has (raw "GET /numhdr HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") "x-n: 5") true)
  (is "the server survived them" (body (raw "GET /user/7 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) "hello 7")
  errs0=(rd (+ out ".err"))
  (is "the refused response is reported on stderr" [(has errs0 "bad value for header") (has errs0 "bad status code")] [true true])
  ; keep-alive: two requests on one connection, then the server closes after the second asks for it
  two=(raw "GET /user/1 HTTP/1.1\r\nHost: x\r\n\r\nGET /user/2 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
  (is "keep-alive serves both" (len (split two "HTTP/1.1 200 OK")) 3)
  (is "keep-alive replies in order" (&& (has two "hello 1") (has two "hello 2") (< (idx two "hello 1") (idx two "hello 2"))) true)
  ; --maxreq 3: the third response closes the connection
  three=(raw "GET /user/1 HTTP/1.1\r\nHost: x\r\n\r\nGET /user/2 HTTP/1.1\r\nHost: x\r\n\r\nGET /user/3 HTTP/1.1\r\nHost: x\r\n\r\nGET /user/4 HTTP/1.1\r\nHost: x\r\n\r\n")
  (is "maxreq closes the connection" (&& (has three "hello 3") (! (has three "hello 4")) (has three "connection: close")) true)
  (is "HTTP/1.0 closes" (has (raw "GET / HTTP/1.0\r\n\r\n") "connection: close") true)
  ; two connections at once: a slow handler does not hold up the other one
  c1=(tcpc "127.0.0.1" port) (fdw c1 "GET /slow HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
  t0=(now) fast=(raw "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") dt=(- (now) t0)
  (is "slow handler does not block others" (&& (has fast "root") (< dt 250)) true)
  late="" end=(+ (now) 3000)
  (wh (&& (! (has late "slow")) (> end (now))) d=(fdr c1 65536 (- end (now))) (? (|| (== d nil) (== d "")) end=0 late+=d))
  (is "the slow reply still arrives" (has late "slow") true)
  ; timeouts (#153): the test server uses headms 1000, idlems 1500, bodyms 1000
  t0=(now) half=(raw "GET / HTTP/1.1\r\nHost: x\r\n" 4000) dt=(- (now) t0)
  (is "a half-sent head gets 408 and a close after headms" [(head1 half) (&& (> dt 800) (< dt 3500))] ["HTTP/1.1 408 Request Timeout" true])
  t0=(now) quiet=(raw "" 4000) dt=(- (now) t0)
  (is "a silent connection is closed without an answer" [quiet (&& (> dt 800) (< dt 3500))] ["" true])
  t0=(now) hb=(raw "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\nabc" 4000) dt=(- (now) t0)
  (is "a half-sent body gets 408" [(head1 hb) (&& (> dt 800) (< dt 3500))] ["HTTP/1.1 408 Request Timeout" true])
  ; keep-alive survives a pause shorter than idlems, then the idle connection is closed quietly
  c=(tcpc "127.0.0.1" port) (fdw c "GET /user/1 HTTP/1.1\r\nHost: x\r\n\r\n") got=(fdr c 65536 2000)
  (sleep 700) (fdw c "GET /user/2 HTTP/1.1\r\nHost: x\r\n\r\n") got2=(fdr c 65536 2000)
  (is "keep-alive across a short pause" [(has got "hello 1") (has got2 "hello 2")] [true true])
  t0=(now) rest=(fdr c 65536 4000)
  (is "then the idle connection is closed with nothing sent" [rest (< (- (now) t0) 3500)] ["" true])
  (fdc c)
  ; maxconn: a second server that holds at most 2 connections
  pid2=(trim (sh (+ "bin/ak tests/lib/httpd_srv.aklang 2 >" out "2 2>/dev/null & echo $!")))
  (wh (|| (! (ex (+ out "2"))) (== (trim (rd (+ out "2"))) "")) (sleep 50))
  p2=(num (trim (rd (+ out "2"))))
  a1=(tcpc "127.0.0.1" p2) a2=(tcpc "127.0.0.1" p2) (sleep 200)
  a3=(tcpc "127.0.0.1" p2) over=(fdr a3 65536 2000)
  (is "maxconn: the third connection gets 503" (head1 over) "HTTP/1.1 503 Service Unavailable")
  (fdc a1) (sleep 200) a4=(tcpc "127.0.0.1" p2) (fdw a4 "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
  (is "and a freed slot is usable again" (has (fdr a4 65536 2000) "root") true)
  (fdc a2) (fdc a3) (fdc a4) (sh (+ "kill " pid2 " 2>/dev/null; rm -f " out "2"))
  true) e=>e)
errs=(? (ex (+ out ".err")) (rd (+ out ".err")) "")
(finish)
(sh (+ "rm -f " out ".err"))
(assert (== r true) (+ "httpd: " (show r) " " (show errs)))
(assert (> n 33) (+ "too few checks ran: " n))
