; lib/tls.aklang's TLS 1.2 client against openssl s_server: all six cipher suites, a 300 KB download, ALPN, a client certificate, refusals, and TLS 1.3 still preferred (needs openssl)
(use "lib/run.aklang" as t)
r=(t.run "sh tests/lib/tls12.sh" nil)
lines=(split (trim r.out) "\n")
(assert (== #lines 15) (+ "tls12.sh printed " #lines " lines, expected 15: " (show r.out) r.err))
bad=(~? l=>(! (starts l "ok ")) lines)
(assert (== #bad 0) (+ "tls 1.2 checks failed:\n" (join bad "\n")))
