; lib/ws.aklang (#60): handshake, text/binary/fragmented/ping/big messages, violations, subprotocols and a Unix socket server, against tests/lib/ws_srv.aklang
(use "../lib/ws.aklang" as w)
base=(+ "/tmp/akws-" ($ (now)) "-" ($ (rand 1000000000)))
(= (start n arg out) (trim (sh (+ "bin/ak tests/lib/ws_srv.aklang " n " " arg " >" out " 2>&1 & echo $!"))))
(= (waitline f) (wh (|| (! (ex f)) (! (has (rd f) "\n"))) (sleep 50)) (split (trim (rd f)) "\n"))
n=0
(= (is name got want) (<- n n+1) (assert (== got want) (+ name ": got " (show got) " want " (show want))))
pid=(start 5 "" (+ base ".out"))
pid2=(start 1 (+ base ".sock") (+ base ".u.out"))
(= (finish) (sh (+ "kill " pid " " pid2 " 2>/dev/null; rm -f " base ".out " base ".u.out " base ".sock")))
r=(try (:
  port=(num (waitline (+ base ".out"))[0])
  (is "RFC 6455 accept key" (w.accept_key "dGhlIHNhbXBsZSBub25jZQ==") "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
  ws=(w.connect (+ "ws://127.0.0.1:" port "/chat") {:protocols ["echo"]})
  (is "subprotocol" ws.protocol "echo")
  (w.send ws "hello") (is "echo" (w.recv ws) "hello")
  (is "text is not binary" ws.bin false)
  (w.sendb ws "bin\x00ary") (is "binary echo" (w.recv ws) "bin\x00ary") (is "binary flag" ws.bin true)
  (w.send ws "") (is "empty message" (w.recv ws) "")
  big=(rpt "0123456789" 20000) (w.send ws big) (is "200 KB message both ways (masked, 8-byte length)" (w.recv ws) big)
  (w.send ws (rpt "y" 300)) (is "16-bit length" (len (w.recv ws)) 300)
  (w.send ws "frag") (is "fragments are joined" (w.recv ws) "abcdef")
  (w.send ws "ping") (is "ping is answered, then the next message" (w.recv ws) "pong-ok")
  (w.send ws "big") (is "70000 bytes from the server" (len (w.recv ws)) 70000)
  (w.send ws "close")
  (is "close frame ends recv" (w.recv ws) nil)
  (is "close code" [ws.closed ws.code ws.reason] [true 1000 "bye"])
  (is "recv after close" (w.recv ws) nil)
  ; a client frame that is not masked is a protocol error
  ws=(w.connect (+ "ws://127.0.0.1:" port "/") nil)
  ws.s.w((frombytes [129 4 111 111 112 115]))
  (is "unmasked client frame: server closes with 1002" (w.recv ws) nil)
  (is "  code" ws.code 1002)
  ; not an upgrade request at all
  c=(tcpc "127.0.0.1" port) (fdw c "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
  got="" d=(fdr c 1000 2000) (wh (&& d (!= d "")) got+=d d=(fdr c 1000 2000))
  (fdc c)
  (is "plain GET gets a 400" (fst (split got "\r\n")) "HTTP/1.1 400 Bad Request")
  ; a protocol the server does not know: none is chosen
  ws=(w.connect (+ "ws://127.0.0.1:" port "/") {:protocols ["nope"]})
  (is "no common subprotocol" ws.protocol nil)
  (w.close ws)
  ; the Unix socket server
  (wh (! (ex (+ base ".sock"))) (sleep 50))
  s=(unixc (+ base ".sock"))
  ws=(w.client (w.fdstream s) "localhost" "/" nil)
  (w.send ws "over unix") (is "Unix socket echo" (w.recv ws) "over unix")
  (w.close ws)
  true) e=>e)
lines=(? (ex (+ base ".out")) (split (trim (rd (+ base ".out"))) "\n") [])
ulines=(? (ex (+ base ".u.out")) (split (trim (rd (+ base ".u.out"))) "\n") [])
(sh "sleep 0.3")
lines=(split (trim (rd (+ base ".out"))) "\n")
(finish)
(assert (== r true) (+ "ws: " (show r)))
(assert (== lines[1..] ["done" "ERR websocket: unmasked frame from the client" "done" "done"]) (+ "server log: " (show lines)))
(assert (> n 14) (+ "too few checks ran: " n))
