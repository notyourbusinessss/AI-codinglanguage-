; An HTTP/1.1 server library (native only): one task per connection on lib/async.aklang, so handlers are plain sequential code and may wait (a.sleep, other sockets).
;   (use "lib/httpd.aklang" as s)
;   (s.serve 8080 handler)               listen on 127.0.0.1:8080 and serve until the process is stopped
;   (s.listen port handler opts)         start serving and return the listening fd (tcpp gives the port); s.run() to run the tasks
; handler: (req) -> a string (200 text/plain), [status type body], or {:status 200 :headers {"Content-Type" ".."} :body ".."}.
; req: {:method "GET" :target "/a/b?x=1" :path "/a/b" :query {"x" "1"} :headers {"host" ".."} (lower-case names) :body ".." :version "1.1" :peer {:ip "127.0.0.1" :port 51234} (the client)}.
; Options (map): :host ("127.0.0.1"), :maxhead (16384 bytes of request line + headers, else 431), :maxbody (1048576 bytes, else 413), :maxreq (100 requests per connection).
; A malformed request gets 400 (also: Content-Length together with Transfer-Encoding, a Transfer-Encoding other than chunked, an HTTP/1.1 request without exactly one Host), an unsupported version 505, a handler that raises 500 (the error goes to stderr); none of them stops the server.
; Persistent connections work for HTTP/1.1 (and HTTP/1.0 with Keep-Alive); request bodies may be Content-Length or chunked; "Expect: 100-continue" is answered.
; (s.router routes) builds a handler from [[method pattern handler] ..]: patterns like "/user/:id" put the segment in req.params, a trailing "/*" puts the rest in req.params.rest; 404 for no path match, 405 (with Allow) for a wrong method.
; Timeouts (ms): :headms (30000: a request head must be complete this long after its first byte, and a connection must send its first byte this fast), :idlems (60000: a keep-alive connection may stay quiet), :bodyms (30000: the whole body); a half-sent request gets 408 and the connection closes, an idle one closes quietly. :maxconn limits open connections (503 beyond it).
; https: :tls {:cert chain_pem :key key_pem} (or the result of t.creds, e.g. several names with SNI) serves TLS; the handshake runs on the connection's task and :headms covers it, but the crypto itself takes about 0.2 s of CPU per new connection (0.4 s with an RSA key) during which other tasks wait; req.sni is the client's server name; a failed handshake is logged to stderr.
; Not supported: HTTP/2, Upgrade (see lib/ws.aklang for WebSocket).
(use "async.aklang" as a)
(use "tls.aklang" as t)
(= (reason c)
  (sw c 100 "Continue" 200 "OK" 201 "Created" 202 "Accepted" 204 "No Content" 301 "Moved Permanently" 302 "Found" 303 "See Other" 304 "Not Modified" 307 "Temporary Redirect" 308 "Permanent Redirect"
        400 "Bad Request" 401 "Unauthorized" 403 "Forbidden" 404 "Not Found" 405 "Method Not Allowed" 408 "Request Timeout" 409 "Conflict" 411 "Length Required" 413 "Payload Too Large" 414 "URI Too Long"
        415 "Unsupported Media Type" 422 "Unprocessable Entity" 429 "Too Many Requests" 431 "Request Header Fields Too Large" 500 "Internal Server Error" 501 "Not Implemented" 503 "Service Unavailable" 505 "HTTP Version Not Supported" ""))
(= (urldec s plus=false)                ; %XX escapes (and + as a space when plus) -> bytes
  out=[] d=(bytes s) i=0
  (wh i<#d
    c=d[i] v=(? (&& c==37 i+2<#d) (num (++ "0x" s[i+1..i+3])) nil)
    (? (isnum v) (: (push out v) i+=3) (: (push out (? (&& plus c==43) 32 c)) i+=1)))
  (frombytes out))
(= (parsequery q)                       ; "a=1&b=x%20y&a=3" -> {"a" "3" "b" "x y"} (the last value of a repeated name wins)
  m={} (for kv (split q "&") (? (!= kv "") (: j=(idx kv "=") m[(urldec (? j>=0 kv[..j] kv) true)]=(? j>=0 (urldec kv[j+1..] true) ""))))
  m)
(= (parsehead h)                        ; request line + headers (without the blank line) -> a request map, or [status message]
  lines=(split h "\r\n") rl=(split lines[0] " ")
  (? (|| (!= #rl 3) (== rl[0] "") (== rl[1] "")) [400 "bad request line"]
     (! (starts rl[2] "HTTP/")) [400 "bad request line"]
     (! (has ["HTTP/1.0" "HTTP/1.1"] rl[2])) [505 "only HTTP/1.0 and HTTP/1.1"]
     (: hd={} ok=true nh=0
        (for l lines[1..]
          k=(idx l ":")
          (? (|| k<=0 (has l[..k] " ")) ok=false
             (: n=(lo l[..k]) v=(trim l[k+1..]) (? (== n "host") nh+=1) hd[n]=(? hd[n] (++ hd[n] ", " v) v))))
        t=rl[1] i=(idx t "?") f=(idx t "#") t=(? f>=0 t[..f] t) i=(idx t "?")
        (? (! ok) [400 "bad header line"]
           (! (starts t "/")) [400 "request target must start with /"]
           (&& hd["transfer-encoding"] hd["content-length"]) [400 "Content-Length with Transfer-Encoding"]
           (&& hd["transfer-encoding"] (!= (lo hd["transfer-encoding"]) "chunked")) [400 "unsupported Transfer-Encoding"]
           (&& (== rl[2] "HTTP/1.1") (!= nh 1)) [400 "HTTP/1.1 needs exactly one Host header"]
           {:method rl[0] :target t :path (urldec (? i>=0 t[..i] t)) :query (parsequery (? i>=0 t[i+1..] "")) :headers hd :version rl[2][5..] :body ""}))))
(= (more c buf)                           ; more bytes from c after the ones in buf, or nil when the peer hung up
  (? c.cn (: d=(try (t.read c.cn 65536) e=>"") (? d=="" nil (++ buf d)))
     (: (a.wait c.fd) d=(fdr c.fd 65536) (? d=="" nil (++ buf d)))))
(= (cwrite c s) (? c.cn (t.write c.cn s) (a.write c.fd s)))
(= (cclose c) (? c.cn (try (t.close c.cn) e=>(fdc c.fd)) (fdc c.fd)))
(= (cstream fd)                           ; TLS over fd that waits for the socket cooperatively
  {:r n=>(: (a.wait fd) (fdr fd n 0)) :w s=>(a.write fd s) :c ()=>(fdc fd)})
(= (readbody c rq buf lim)              ; [body rest], or [status message]
  te=(lo (?? rq.headers["transfer-encoding"] "")) cl=rq.headers["content-length"] err=nil
  (? (has te "chunked")
     (: out="" done=false
        (wh (&& (! done) (! err))
          (wh (&& (! err) (! (has buf "\r\n"))) b=(more c buf) (? (== b nil) err=[400 "truncated chunked body"] buf=b))
          (? (! err)
             (: k=(idx buf "\r\n") n=(num (++ "0x" (trim (split buf[..k] ";")[0]))) buf=buf[k+2..]
                (? (! (&& (isnum n) n>=0)) err=[400 "bad chunk size"] (> (+ #out n) lim) err=[413 "body too large"]
                   (: (wh (&& (! err) #buf<n+2) b=(more c buf) (? (== b nil) err=[400 "truncated chunked body"] buf=b))
                      (? (! err) (: out+=buf[..n] buf=buf[n+2..] (? n==0 done=true))))))))
        (? err err [out buf]))
     cl (: n=(? (&& (all (\ (x) (&& x>=48 x<=57)) (bytes cl)) #cl<10) (num cl) -1)
           (? (< n 0) [400 "bad Content-Length"] (> n lim) [413 "body too large"]
              (: (wh (&& (! err) #buf<n) b=(more c buf) (? (== b nil) err=[400 "truncated body"] buf=b))
                 (? err err [buf[..n] buf[n..]]))))
     ["" buf]))
(= (response code headers body head)    ; the bytes of a response (no body for HEAD, 1xx, 204, 304)
  nob=(|| head (has [204 304] code) (&& code>=100 code<200))
  hs={} (for [k v] headers hs[(lo k)]=v)
  (? (! (has (keys hs) "content-length")) hs["content-length"]=#body)
  (? (has [204 304] code) hs=(del hs "content-length"))
  (++ "HTTP/1.1 " code " " (reason code) "\r\n" (join (~ k=>(++ k ": " hs[k]) (keys hs)) "\r\n") "\r\n\r\n" (? nob "" body)))
(= (normalize r)                        ; a handler's result -> {:status :headers :body}
  (? (isstr r) {:status 200 :headers {"content-type" "text/plain; charset=utf-8"} :body r}
     (islist r) {:status r[0] :headers {"content-type" r[1]} :body (tostr (?? r[2] ""))}
     (ismap r) {:status (?? r.status 200) :headers (?? r.headers {}) :body (tostr (?? r.body ""))}
     {:status 500 :headers {"content-type" "text/plain"} :body "handler returned nothing usable"}))
(= (step c handler opts buf n st)           ; handle the request at the start of buf; the bytes left over to carry on with, or nil to close the connection
  k=(idx buf "\r\n\r\n")
  (? (|| k<0 k>opts.maxhead) (: (cwrite c (response 431 {"connection" "close"} "request head too large" false)) nil)
     (: rq=(parsehead buf[..k])
        (? (islist rq) (: (cwrite c (response rq[0] {"connection" "close"} rq[1] false)) nil)
           (: (? (== (lo (?? rq.headers["expect"] "")) "100-continue") (cwrite c "HTTP/1.1 100 Continue\r\n\r\n"))
              st.deadline=(+ (now) opts.bodyms)
              bd=(readbody c rq buf[k+4..] opts.maxbody)
              st.deadline=nil
              (? (isnum bd[0]) (: (cwrite c (response bd[0] {"connection" "close"} bd[1] false)) nil)
                 (: rq=(set (set rq "body" bd[0]) "peer" (try (peer c.fd) e=>nil)) rq=(set rq "sni" (? c.cn c.cn.sni nil))
                    res=(normalize (try (handler rq) e=>(: (fdw 2 (++ "httpd: handler error: " e "\n")) {:status 500 :headers {"content-type" "text/plain"} :body "internal server error"})))
                    cn=(lo (?? rq.headers.connection "")) rc=(lo (?? res.headers["connection"] ""))
                    keep=(&& (? (== rq.version "1.1") (!= cn "close") (== cn "keep-alive")) (!= rc "close") n+1<opts.maxreq)
                    (cwrite c (response res.status (set res.headers "connection" (? keep "keep-alive" "close")) res.body (== rq.method "HEAD")))
                    (? keep bd[1] nil))))))))
(= (watch c st)                         ; per connection: when the deadline passes, answer 408 if a request was half-sent, and end the read side so the connection loop finishes
  (wh st.live
    (? (&& st.deadline (> (now) st.deadline))
       (: (? st.partial (: r=(response 408 {"connection" "close"} "request timeout" false) (try (cwrite c r) e=>nil)))
          st.live=false (try (shutr c.fd) e=>nil))
       (a.sleep (? st.deadline (max 20 (- st.deadline (now))) 1000)))))
(= (conn fd handler opts)               ; serve one connection until it closes
  buf="" n=0 st={:live true :deadline (+ (now) opts.headms) :partial false} c={:fd fd :cn nil}
  (a.spawn watch c st)
  (? opts.tls (: c.cn=(try (t.accept fd opts.tls (cstream fd)) e=>(: (fdw 2 (++ "httpd: tls handshake failed: " e "\n")) nil))
                 (? (! c.cn) st.live=false)))
  (wh (&& (!= buf nil) (< n opts.maxreq) st.live)
    st.deadline=(+ (now) (? n==0 opts.headms opts.idlems)) st.partial=false
    (wh (&& (!= buf nil) (! (has buf "\r\n\r\n")) (<= #buf opts.maxhead) st.live)
      was=#buf buf=(more c buf)
      (? (&& (!= buf nil) (== was 0) (> #buf 0)) (: st.partial=true st.deadline=(+ (now) opts.headms))))
    (? (&& (!= buf nil) st.live) (: buf=(step c handler opts buf n st) n+=1)))
  st.live=false
  (? (|| c.cn (! opts.tls)) (cclose c)))
(= (guarded c handler opts)
  (try (conn c handler opts) e=>(: (fdw 2 (++ "httpd: connection error: " e "\n")) (try (fdc c) x=>nil)))
  opts.active=(- opts.active 1))
(= (listen port handler opts=nil)
  opts=(?? opts {}) o={:host (?? opts.host "127.0.0.1") :maxhead (?? opts.maxhead 16384) :maxbody (?? opts.maxbody 1048576) :maxreq (?? opts.maxreq 100) :headms (?? opts.headms 30000) :idlems (?? opts.idlems 60000) :bodyms (?? opts.bodyms 30000) :maxconn opts.maxconn :active 0 :tls (? opts.tls (t.creds opts.tls) nil)}
  l=(tcpl port o.host)
  (a.spawn ()=>(wh true (a.wait l)
    fd=(tcpa l)
    (? (&& o.maxconn (>= o.active o.maxconn))
       (: r=(response 503 {"connection" "close"} "too many connections" false) (try (fdwp fd r 0 (len r)) e=>nil) (fdc fd))
       (: o.active=(+ o.active 1) (a.spawn guarded fd handler o)))))
  l)
(= (run) a.run())                       ; run the tasks of this library (use this, not another copy of async.aklang's run: each use of that file keeps its own task queue)
(= (serve port handler opts=nil) l=(listen port handler opts) a.run() l)
(= (matchroute pat segs)                ; params map, or nil
  ps=(split pat "/")[1..] ps=(? (&& #ps (== ps[#ps-1] "")) ps[..-1] ps) m={} ok=true i=0
  (for p ps
    (? (! ok) nil (== p "*") (: m["rest"]=(join segs[i..] "/") i=#segs)
       (starts p ":") (? i<#segs (: m[p[1..]]=segs[i] i+=1) ok=false)
       (&& i<#segs (== segs[i] p)) i+=1
       ok=false))
  (? (&& ok i==#segs) m nil))
(= (router routes)
  (\ (rq)
    segs=(split rq.path "/")[1..] segs=(? (&& #segs (== segs[#segs-1] "")) segs[..-1] segs)
    allowed=[] hit=nil
    (for r routes
      m=(matchroute r[1] segs)
      (? (!= m nil) (: (push allowed r[0]) (? (&& (! hit) (|| (== r[0] rq.method) (&& (== r[0] "GET") (== rq.method "HEAD")))) hit=[r[2] m]))))
    (? hit ((hit[0]) (set rq "params" hit[1]))
       (> #allowed 0) {:status 405 :headers {"allow" (join allowed ", ")} :body "method not allowed"}
       [404 "text/plain" "not found"])))
