; Cooperative tasks on coroutines (native only): many things in flight in one process, written as plain sequential code.
;   (use "lib/async.aklang" as a)
;   a.spawn f args..   start a task          a.sleep ms   wait ms milliseconds        a.pause   let the other tasks run
;   a.wait fd          wait until fd is readable (a connection to accept, bytes to read, end of stream)
;   a.write fd s       write all of s to fd, letting the other tasks run while its buffer is full (fdw would block the whole process)
;   a.chan   a.send ch v   a.recv ch (waits for a value)   a.close ch (receivers then get nil)
;   While run() works, tcpc, dns, hostips and a read with a timeout (fdr, fdline, udpfrom ..) let the other tasks run instead of freezing them (they poll every 1 to 20 ms).
;   a.run              run the tasks until none is left that can still make progress; an uncaught error in a task ends it
READY=[]
TIMERS=[]
WAITS={}
WAITW={}
CURRENT=nil
(= (spawn f ..args) t=(co ()=>(f ..args)) (push READY t) t)
(= (pause) (yield ["ready"]))
(= (sleep ms) (yield ["sleep" now()+ms]))
(= (wait fd) (yield ["fd" fd]))
(= (write fd s)
  d=(? (is "list" s) (frombytes s) (istyped s) s (tostr s)) n=($hlen d) k=0
  (wh k<n r=(fdwp fd d k n-k) (? r>0 k+=r (yield ["fdw" fd])))
  nil)
(= (wake t) (push READY t))
(= (chan) {:q [] :w [] :open true})
(= (send ch v) (assert ch.open "send on a closed channel") (push ch.q v) (a_wake1 ch))
(= (a_wake1 ch) (? ch.w (: t=ch.w[0] ch.w=ch.w[1..] (wake t))))
(= (recv ch)
  (wh (&& (! ch.q) ch.open) (push ch.w CURRENT) (yield ["park"]))
  (? ch.q (: v=ch.q[0] ch.q=ch.q[1..] v) nil))
(= (close ch) ch.open=false (wh ch.w (: t=ch.w[0] ch.w=ch.w[1..] (wake t))))
(= (park_on r t)
  (sw r[0] "sleep" (push TIMERS [r[1] t]) "fd" (: k=(tostr r[1]) l=(?? WAITS[k] []) (push l t) WAITS[k]=l) "fdw" (: k=(tostr r[1]) l=(?? WAITW[k] []) (push l t) WAITW[k]=l) "park" nil (push READY t)))
(= (due)
  t=now() keep=[] due=[]
  (for x TIMERS (? x[0]<=t (push due x) (push keep x)))
  (<- TIMERS keep)
  (for x (sort (x=>x[0]) due) (push READY x[1])))
(= (nhook fd wr ms)                     ; installed in the runtime while run() works: a wait of tcpc, dns or fdr with a timeout lets the other tasks run (polls, 1 to 20 ms apart)
  end=(? ms>=0 now()+ms nil) d=1 done=false ok=false
  (wh (! done)
    [r w]=(fdpoll (? wr [] [fd]) (? wr [fd] []) 0)
    (? (|| (has r fd) (has w fd)) (: ok=true done=true)
       (&& end now()>=end) done=true
       (: (yield ["sleep" now()+d]) d=(min 20 d*2))))
  ok)
(= (run)
  (nethook nhook)
  (wh (|| READY TIMERS WAITS WAITW)
    q=READY (<- READY [])
    (for t q
      (<- CURRENT t)
      r=(try (resume t) e=>(: (ep "task error:" e) nil))
      (? (alive t) (park_on (? (is "list" r) r ["ready"]) t)))
    (<- CURRENT nil)
    (due)
    (? (! READY)
       (: tmo=(? TIMERS (max 0 (- (min ..(~ x=>x[0] TIMERS)) now())) -1)
          fds=(~ num (keys WAITS)) wfds=(~ num (keys WAITW))
          (? (|| fds wfds TIMERS)
             (: [rd wr]=(fdpoll fds wfds tmo)
                (for fd rd k=(tostr fd) (for t WAITS[k] (push READY t)) (<- WAITS (del WAITS k)))
                (for fd wr k=(tostr fd) (for t WAITW[k] (push READY t)) (<- WAITW (del WAITW k)))
                (due))))))
  (nethook nil))
