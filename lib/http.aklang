; A small HTTP/1.1 client (native only): http:// and https:// (TLS 1.3 through lib/tls.aklang; the server certificate is verified against the system CA bundle).
;   (use "lib/http.aklang" as h)
;   (h.get url)   (h.post url body)   (h.req method url body headers)  ->  {:status 200 :headers {"content-type" ..} :body "..."}
; Header names in the result are lower case; a repeated header is joined with ", " (set-cookie with "\n"), and Content-Length values that differ raise. Content-Length, chunked and read-until-close bodies work; 301/302/303/307/308 are followed (at most 5).
; An error (kind "io") is raised for unresolvable hosts, refused connections, certificate or handshake failures and truncated replies.
;   (h.download url path)  streams a 2xx body into the file path ({:status .. :size n}); other statuses keep their body in :body
; Request, header and URL text with CR, LF or NUL is refused (no request injection). A body over :max bytes (default 64 MiB, 1 TiB with download) or a head over 1 MiB raises.
; Proxies: HTTP_PROXY / HTTPS_PROXY (and lower case) are used unless NO_PROXY lists the host (names, .suffix, *) or it is loopback; opts :proxy "http://[user:pass@]host:port" forces one, :proxy false none. https goes through CONNECT; the proxy itself may be http:// or https:// (TLS to the proxy, verified like any server).
; Compression: {:gzip true} sends Accept-Encoding: gzip, deflate and decodes gzip / deflate bodies (lib/inflate.aklang; :max also limits the decoded size). Not applied to h.download.
; Interim 1xx replies (100 Continue, 103 Early Hints; up to 8) are skipped and the final reply is returned; 101 is final.
; Connection reuse: s=h.session() then {:pool s} in the options keeps keep-alive connections for the next request to the same host and port (a reply of unknown length or with Connection: close ends the connection); (h.release s) closes them.
; HTTP/2: {:h2 true} offers h2 by ALPN on https:// (lib/h2.aklang, one request per connection, no pooling); a server that picks http/1.1 is served as usual. The reply has the same shape.
; Options (last argument of req/get/post, a map): :roots = CA certificates to trust instead of the system bundle, :ms = connect timeout in milliseconds, :rms / :wms = how long a read / write may stall before it raises (default 60000).
(use "tls.aklang" as t)
(use "inflate.aklang" as z)
(use "h2.aklang" as x2)
(= (b64 s)                              ; base64 of a string (for Basic authentication)
  al="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" d=(bytes s) out=""
  i=0
  (wh i<#d
    n=#d-i x=d[i]*65536+(? n>1 d[i+1]*256 0)+(? n>2 d[i+2] 0)
    out+=(++ al[(// x 262144)] al[(% (// x 4096) 64)] (? n>1 al[(% (// x 64) 64)] "=") (? n>2 al[(% x 64)] "=")) i+=3)
  out)
(= (pctdec s)                           ; %XX escapes of userinfo -> bytes
  out=[] d=(bytes s) i=0
  (wh i<#d
    (? (&& d[i]==37 i+2<#d) (: v=(num (++ "0x" s[i+1..i+3])) (? (isnum v) (: (push out v) i+=3) (: (push out 37) i+=1)))
       (: (push out d[i]) i+=1)))
  (frombytes out))
(= (parseurl u)                         ; "http(s)://[user:pass@]host[:port][/path][?q][#frag]" -> [secure host port path userinfo]; the fragment is dropped, an IPv6 host comes without brackets
  i=(idx u "://") sch=(? i>=0 (lo u[..i]) "")
  (? (! (has ["http" "https"] sch)) (netfail (++ "unsupported URL: " u)))
  sec=(== sch "https") rest=u[i+3..]
  f=(idx rest "#") rest=(? f>=0 rest[..f] rest)
  a=(idx rest "/") q=(idx rest "?") e=(? (&& a>=0 q>=0) (min a q) a>=0 a q>=0 q #rest)
  auth=rest[..e] tail=rest[e..]
  path=(? (== tail "") "/" (starts tail "?") (++ "/" tail) tail)
  parts=(split auth "@") hp=parts[#parts-1] user=(? #parts>1 (pctdec (join parts[..-1] "@")) nil)
  (? (starts hp "[")
     (: k=(idx hp "]") (? k<0 (netfail (++ "bad host in URL: " u)))
        host=hp[1..k] ps=hp[k+1..] (? (&& (!= ps "") (! (starts ps ":"))) (netfail (++ "bad host in URL: " u)))
        ps=(? (== ps "") "" ps[1..]))
     (: j=(idx hp ":") host=(? j>=0 hp[..j] hp) ps=(? j>=0 hp[j+1..] "")))
  (? (== host "") (netfail (++ "no host in URL: " u)))
  port=(? (== ps "") (? sec 443 80)
         (: ok=(all (\ (c) (&& c>=48 c<=57)) (bytes ps)) v=(? (&& ok #ps<6) (num ps) nil)
            (? (&& v v>=1 v<=65535) v (netfail (++ "bad port in URL: " u)))))
  [sec host port path user])
(= (hostpart host) (? (has host ":") (++ "[" host "]") host))   ; as written in a URL or a Host header
(= (chk what s bad)                     ; s itself, or an error when it holds CR, LF, NUL or a character of bad (request injection)
  (? (|| (has s "\r") (has s "\n") (has s "\x00") (any c=>(has s c) bad)) (netfail (++ "illegal character in the " what)) s))
(= (tlsstream host port opts rms)       ; opts.stream = a stream to run TLS over (a CONNECT tunnel)
  cn=(t.connect host port (set (? opts.h2 (set opts "alpn" ["h2" "http/1.1"]) opts) "rms" rms)) {:r n=>(t.read cn n) :w s=>(t.write cn s) :c ()=>(t.close cn) :alpn cn.alpn})
(= (open sec host port opts)            ; a stream: {:r (n)=>bytes :w s=>nil :c ()=>nil}; a read or write that stalls for opts.rms / opts.wms ms (default 60000) raises
  rms=(?? opts.rms 60000) wms=(?? opts.wms 60000)
  (? sec (tlsstream host port opts rms)
     (: fd=(tcpc host port opts.ms) {:r n=>(: d=(fdr fd n rms) (? (== d nil) (netfail "read timed out") d)) :w s=>(fdw fd s wms) :c ()=>(fdc fd)})))
(= (noproxy host)                       ; is host listed in NO_PROXY (names, .suffixes, *), or a loopback address?
  lh=(lo host)
  es=(~ (\ (e) (: e=(trim (lo e)) e=(? (starts e "*.") e[2..] (starts e ".") e[1..] e) (? (&& (has e ":") (! (starts e "["))) (split e ":")[0] e)))
        (split (?? (env "NO_PROXY") (?? (env "no_proxy") "")) ","))
  (|| (== lh "localhost") (starts lh "127.") (== lh "::1") (ends lh ".localhost")
      (any (\ (e) (|| (== e "*") (== e lh) (ends lh (++ "." e)))) es)))
(= (proxyfor sec host opts)             ; the proxy URL for a request: opts.proxy (false = none), else HTTPS_PROXY / HTTP_PROXY unless NO_PROXY or loopback; nil = direct
  p=(? (!= opts.proxy nil) opts.proxy
       (noproxy host) nil
       sec (?? (env "HTTPS_PROXY") (env "https_proxy")) (?? (env "HTTP_PROXY") (env "http_proxy")))
  (? (|| (== p nil) (== p false) (== p "")) nil p))
(= (tunnel px host port opts sec=true)  ; CONNECT through the proxy px (a URL, http:// or https://), then TLS inside when sec: a stream
  [psec phost pport ppath puser]=(parseurl px)
  rms=(?? opts.rms 60000) pc=(open psec phost pport opts) au=(++ (hostpart host) ":" port) buf="" k=-1
  (try (pc.w (++ "CONNECT " au " HTTP/1.1\r\nHost: " au "\r\n" (? puser (++ "Proxy-Authorization: Basic " (b64 puser) "\r\n") "") "\r\n")) e=>(: pc.c() (raise "io" e nil)))
  (wh k<0
    d=(try (pc.r 4096) e=>(: pc.c() (raise "io" e nil)))
    (? (|| (== d nil) (== d "")) (: pc.c() (netfail "proxy closed the connection during CONNECT")))
    buf+=d k=(idx buf "\r\n\r\n")
    (? (&& k<0 #buf>65536) (: pc.c() (netfail "proxy reply too long"))))
  st=(split (split buf "\r\n")[0] " ")
  (? (!= (?? st[1] "") "200") (: pc.c() (netfail (++ "proxy refused CONNECT: " (split buf "\r\n")[0]))))
  (? sec (tlsstream host port (set opts "stream" pc) rms) pc))
(= (dial sec host port opts)            ; a stream to host:port, through the proxy of the environment or opts.proxy (CONNECT) when there is one (WebSocket and other raw protocols)
  px=(proxyfor sec host opts)
  (? px (tunnel px host port opts sec) (open sec host port opts)))
(= (statusof line)                      ; "HTTP/1.1 200 OK" -> 200, or nil when it is not a status line
  f=(split line " ") v=(? (&& #f>=2 (starts f[0] "HTTP/1.") #f[0]==8 (all (\ (x) (&& x>=48 x<=57)) (bytes f[1])) #f[1]==3) (num f[1]) nil)
  (? (&& (isnum v) v>=100) v nil))
(= (clen v)                             ; a Content-Length value -> its number (a repeated, agreeing "5, 5" is fine), or nil
  ps=(~ x=>(trim x) (split v ","))
  (? (&& (all (\ (x) (== x ps[0])) ps) (> #ps[0] 0) #ps[0]<16 (all (\ (x) (&& x>=48 x<=57)) (bytes ps[0]))) (num ps[0]) nil))
(= (addhd hd k v)                       ; a repeated header is kept: values joined with ", " (set-cookie with "\n", since its values hold commas)
  hd[k]=(? (== hd[k] nil) v (++ hd[k] (? (== k "set-cookie") "\n" ", ") v)))
(= (readhead c buf="")                  ; bytes up to and including the blank line (buf holds what was read already), plus anything read after it
  k=(idx buf "\r\n\r\n")
  (wh k<0
    d=c.r(65536)
    (? d=="" (netfail "connection closed before the response head"))
    buf+=d k=(idx buf "\r\n\r\n")
    (? (&& k<0 #buf>1048576) (netfail "response head over 1 MiB")))
  [buf[..k] buf[k+4..]])
(= (feed bs d)                          ; one piece of body: counted against bs.max, then handed to bs.sink
  bs.n=bs.n+#d
  (? bs.n>bs.max (netfail (++ "response body over the limit of " bs.max " bytes (option :max)")))
  (bs.sink d) nil)
(= (readn c have n bs)                  ; n body bytes: have first, then more from c
  (? n>bs.max (netfail (++ "response body over the limit of " bs.max " bytes (option :max)")))
  (feed bs have[..n]) got=(min #have n) bs.rest=(? #have>n have[n..] "")
  (wh got<n d=c.r(65536) (? d=="" (netfail "response body truncated")) (? #d>n-got bs.rest=d[n-got..]) d=d[..n-got] (feed bs d) got+=#d))
(= (readall c have bs) d=nil bs.rest=nil (? have!="" (feed bs have)) (wh d!="" d=c.r(65536) (? d!="" (feed bs d))))
(= (readchunks c have bs)               ; chunks until the last one, then the trailer lines; whatever follows is left in bs.rest
  n=-1
  (wh n!=0
    (wh (! (has have "\r\n")) d=c.r(65536) (? d=="" (netfail "chunked body truncated")) have+=d)
    k=(idx have "\r\n") n=(num (++ "0x" (trim (split have[..k] ";")[0]))) have=have[k+2..]
    (? (! (&& (isnum n) n>=0)) (netfail "bad chunk size"))
    (? bs.n+n>bs.max (netfail (++ "response body over the limit of " bs.max " bytes (option :max)")))
    (? n>0 (: (wh #have<n+2 d=c.r(65536) (? d=="" (netfail "chunked body truncated")) have+=d) (feed bs have[..n]) have=have[n+2..])))
  fin=false
  (wh (! fin)
    (wh (! (has have "\r\n")) d=c.r(65536) (? d=="" (netfail "chunked body truncated")) have+=d)
    k=(idx have "\r\n") fin=(== k 0) have=have[k+2..])
  bs.rest=have)
(= (resolve sec host port path loc)     ; a Location value -> an absolute URL: absolute as is, //host/p, /p, or relative to the directory of path
  origin=(++ (? sec "https://" "http://") (hostpart host) (? port==(? sec 443 80) "" (++ ":" port)))
  dir=(join (split (split path "?")[0] "/")[..-1] "/")
  (? (|| (starts loc "http://") (starts loc "https://")) loc
     (starts loc "//") (++ (? sec "https:" "http:") loc)
     (starts loc "/") (++ origin loc)
     (++ origin dir "/" loc)))
(= (fresh px pp sec host port opts)     ; a new stream to the host, directly or through the proxy px (parsed pp)
  (? (&& px sec) (tunnel px host port opts) px (open pp[0] pp[1] pp[2] opts) (open sec host port opts)))
(= (session) {:conns {}})                ; a connection pool for the :pool option: keep-alive connections wait in it for the next request to the same host
(= (release pool) (for k (keys pool.conns) (try pool.conns[k].c() e=>nil)) pool.conns={} nil)
(= (exchange c head body)               ; send a request, read the reply head: [head rest]
  c.w((++ head (?? body "")))
  r=(readhead c) n=0 st=(statusof (fst (split r[0] "\r\n")))
  (wh (&& st st>=100 st<200 st!=101)   ; an interim reply (100 Continue, 103 Early Hints) is skipped: the real one follows on the same connection
    (? (>= n 8) (netfail "too many interim responses"))
    r=(readhead c r[1]) n+=1 st=(statusof (fst (split r[0] "\r\n"))))
  r)
(= (done method sec host port path st hd out bs to body headers opts hops)   ; decode the body, follow a redirect, shape the result
  ce=(lo (trim (?? hd["content-encoding"] "")))
  (? (&& opts.gzip (! to) (> #out 0) (has ["gzip" "x-gzip" "deflate"] ce))
     out=(? (== ce "deflate") (try (z.zlib out bs.max) e=>(z.inflate out bs.max)) (z.gunzip out bs.max)))
  (? (&& (has [301 302 303 307 308] st) hd.location hops>=5) (netfail "too many redirects"))
  (? (&& (has [301 302 303 307 308] st) hd.location)
     (: next=(resolve sec host port path hd.location) [nsec nhost nport npath nuser]=(parseurl next)
        ; credentials stay with the host they were meant for
        hs=(? (&& (== (lo nhost) (lo host)) nport==port) headers (: o={} (for [k v] (?? headers {}) (? (! (has ["authorization" "cookie" "proxy-authorization"] (lo k))) o[k]=v)) o))
        (req (? (&& (has [301 302 303] st) method!="HEAD") "GET" method) next (? st>=307 body) hs opts hops+1))
     (? to {:status st :headers hd :body "" :size bs.n} {:status st :headers hd :body out})))
(= (sinkfor bs opts st)                 ; where the body goes once the status is known: the file opts.to for a 2xx reply, else bs.out
  to=(? (&& opts.to st>=200 st<300) opts.to nil)
  (? to (wr to ""))
  bs.sink=(? to d=>(app to d) d=>(: bs.out=(++ bs.out d)))
  to)
(= (h2req c method sec host port path auth h body headers opts hops)   ; the request over HTTP/2 on c (ALPN picked h2), then the common end
  bs={:n 0 :rest "" :max (?? opts.max (? opts.to 1099511627776 67108864)) :out "" :sink nil :to nil}
  lh={} (for k (keys h) lh[(lo k)]=h[k])
  hooks={:head (\ (st hd) bs.to=(sinkfor bs opts st)) :data (\ (d) (feed bs d))}
  r=(try (x2.request c method (? sec "https" "http") auth path lh body hooks) e=>(: (try c.c() x=>nil) (netfail e)))
  c.c()
  st=r.status hd=r.headers cl=(? hd["content-length"] (clen hd["content-length"]) nil)
  (? (&& hd["content-length"] (== cl nil)) (netfail "bad Content-Length in the response"))
  (? (&& cl!=nil (! (|| (== (up method) "HEAD") st==204 st==304)) bs.n!=cl) (netfail "response body truncated"))
  (done method sec host port path st hd bs.out bs bs.to body headers opts hops))
(= (req method url body=nil headers=nil opts=nil hops=0)
  [sec host port path user]=(parseurl url) opts=(?? opts {})
  (chk "method" method " :/") (chk "URL" url "") (chk "host" host "")
  px=(proxyfor sec host opts)
  pp=(? px (parseurl px) nil)
  auth=(? port==(? sec 443 80) (hostpart host) (++ (hostpart host) ":" port))
  pool=opts.pool key=(++ (? sec "https" "http") "://" auth (? px (++ " via " px) ""))
  h={:Host auth :Connection (? pool "keep-alive" "close") "User-Agent" "ak"}
  (? opts.gzip h["Accept-Encoding"]="gzip, deflate")
  (? user h.Authorization=(++ "Basic " (b64 user)))
  (? (&& px (! sec) pp[4]) h["Proxy-Authorization"]=(++ "Basic " (b64 pp[4])))
  (? body (: h["Content-Length"]=#body))
  (for [k v] (?? headers {}) (: (chk "header name" k " :") (chk "header value" (tostr v) "") h[k]=v))
  head=(++ method " " (? (&& px (! sec)) (++ "http://" auth path) path) " HTTP/1.1\r\n" (join (~ k=>(++ k ": " h[k]) (keys h)) "\r\n") "\r\n\r\n")
  old=(? pool pool.conns[key] nil)
  (? old pool.conns=(del pool.conns key))
  c=(?? old (fresh px pp sec host port opts))
  (? (== c.alpn "h2") (h2req c method sec host port path auth h body headers opts hops) (:
  ; a pooled connection the server has since closed fails before any reply byte: once more on a new one
  [rh rest]=(? old (try (exchange c head body) e=>(? (has ["read timed out" "write timed out"] e) (raise "io" e nil) (: (try c.c() e=>nil) c=(fresh px pp sec host port opts) (exchange c head body)))) (exchange c head body))
  lines=(split rh "\r\n") st=(statusof lines[0])
  (? (== st nil) (: c.c() (netfail "bad status line in the response")))
  hd={} (for l lines[1..] k=(idx l ":") (? k>0 (addhd hd (lo l[..k]) (trim l[k+1..]))))
  cl=(? hd["content-length"] (clen hd["content-length"]) nil)
  (? (&& hd["content-length"] (== cl nil)) (: c.c() (netfail "bad Content-Length in the response")))
  bs={:n 0 :rest rest :max (?? opts.max (? opts.to 1099511627776 67108864)) :out "" :sink nil}
  to=(? (&& opts.to st>=200 st<300) opts.to nil)
  (? to (wr to ""))
  bs.sink=(? to d=>(app to d) d=>(: bs.out=(++ bs.out d)))
  (? (|| (== (up method) "HEAD") st==204 st==304 (&& st>=100 st<200)) nil        ; these replies have no body, whatever Content-Length says
     (has (lo (?? hd["transfer-encoding"] "")) "chunked") (readchunks c rest bs)
     (!= cl nil) (readn c rest cl bs)
     (readall c rest bs))
  out=bs.out
  nobody=(|| (== (up method) "HEAD") (has [204 304] st) (&& st>=100 st<200))
  keep=(&& pool st!=101 (starts lines[0] "HTTP/1.1") (! (has (lo (?? hd.connection "")) "close")) (|| nobody (!= cl nil) (has (lo (?? hd["transfer-encoding"] "")) "chunked")) (== bs.rest ""))
  (? keep (: pool.conns[key]=c) c.c())
  (done method sec host port path st hd out bs to body headers opts hops))))
(= (get url headers=nil opts=nil) (req "GET" url nil headers opts))
(= (post url body headers=nil opts=nil) (req "POST" url body headers opts))
(= (download url path opts=nil) (req "GET" url nil nil (set (?? opts {}) "to" path))) ; body of a 2xx reply -> file path, not held in memory; :size = bytes written
