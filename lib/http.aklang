; A small HTTP/1.1 client (native only): plain http://, no TLS yet.
;   (use "lib/http.aklang" as h)
;   (h.get url)   (h.post url body)   (h.req method url body headers)  ->  {:status 200 :headers {"content-type" ..} :body "..."}
; Header names in the result are lower case. Content-Length, chunked and read-until-close bodies work; 301/302/303/307/308 are followed (at most 5).
; An error (kind "io") is raised for https:// URLs, unresolvable hosts, refused connections and truncated replies.
(= (parseurl u)                         ; "http://host:port/path?q" -> [host port path]
  (? (starts u "https://") (netfail "https needs TLS, which native Ak does not have yet")
     (! (starts u "http://")) (netfail (++ "unsupported URL: " u)))
  rest=u[7..] i=(idx rest "/")
  hp=(? i>=0 rest[..i] rest) path=(? i>=0 rest[i..] "/")
  j=(idx hp ":")
  [(? j>=0 hp[..j] hp) (? j>=0 (num hp[j+1..]) 80) path])
(= (readhead c)                         ; bytes up to and including the blank line, plus anything read after it
  buf="" k=-1
  (wh k<0
    d=(fdr c)
    (? d=="" (netfail "connection closed before the response head"))
    buf+=d k=(idx buf "\r\n\r\n"))
  [buf[..k] buf[k+4..]])
(= (readn c have n)                     ; have + more until n bytes
  (wh #have<n d=(fdr c) (? d=="" (netfail "response body truncated")) have+=d)
  have[..n])
(= (readall c have) d=nil (wh d!="" d=(fdr c) have+=d) have)
(= (readchunks c have)
  out="" n=-1
  (wh n!=0
    (wh (! (has have "\r\n")) d=(fdr c) (? d=="" (netfail "chunked body truncated")) have+=d)
    k=(idx have "\r\n") n=(num (++ "0x" (trim (split have[..k] ";")[0]))) have=have[k+2..]
    (? (! (&& (isnum n) n>=0)) (netfail "bad chunk size"))
    (? n>0 (: (wh #have<n+2 d=(fdr c) (? d=="" (netfail "chunked body truncated")) have+=d) out+=have[..n] have=have[n+2..])))
  out)
(= (req method url body=nil headers=nil hops=0)
  [host port path]=(parseurl url)
  c=(tcpc host port)
  h={:Host (? port==80 host (++ host ":" port)) :Connection "close" "User-Agent" "ak"}
  (? body (: h["Content-Length"]=#body))
  (for [k v] (?? headers {}) h[k]=v)
  head=(++ method " " path " HTTP/1.1\r\n" (join (~ k=>(++ k ": " h[k]) (keys h)) "\r\n") "\r\n\r\n")
  (fdw c (++ head (?? body "")))
  [rh rest]=(readhead c)
  lines=(split rh "\r\n") st=(num (split lines[0] " ")[1])
  hd={} (for l lines[1..] k=(idx l ":") (? k>0 hd[(lo l[..k])]=(trim l[k+1..])))
  out=(? (has (lo (?? hd["transfer-encoding"] "")) "chunked") (readchunks c rest)
        hd["content-length"] (readn c rest (num hd["content-length"]))
        (readall c rest))
  (fdc c)
  (? (&& (has [301 302 303 307 308] st) hd.location hops<5)
     (req (? (&& (has [301 302 303] st) method!="HEAD") "GET" method) (? (starts hd.location "http") hd.location (++ "http://" host (? port==80 "" (++ ":" port)) hd.location)) (? st>=307 body) headers hops+1)
     {:status st :headers hd :body out}))
(= (get url headers=nil) (req "GET" url nil headers))
(= (post url body headers=nil) (req "POST" url body headers))
