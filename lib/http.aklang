; A small HTTP/1.1 client (native only): http:// and https:// (TLS 1.3 through lib/tls.aklang; the server certificate is verified against the system CA bundle).
;   (use "lib/http.aklang" as h)
;   (h.get url)   (h.post url body)   (h.req method url body headers)  ->  {:status 200 :headers {"content-type" ..} :body "..."}
; Header names in the result are lower case. Content-Length, chunked and read-until-close bodies work; 301/302/303/307/308 are followed (at most 5).
; An error (kind "io") is raised for unresolvable hosts, refused connections, certificate or handshake failures and truncated replies.
; Options (last argument of req/get/post, a map): :roots = CA certificates to trust instead of the system bundle, :ms = connect timeout in milliseconds.
(use "tls.aklang" as t)
(= (parseurl u)                         ; "http(s)://host:port/path?q" -> [secure host port path]
  sec=(starts u "https://")
  (? (! (|| sec (starts u "http://"))) (netfail (++ "unsupported URL: " u)))
  rest=u[(? sec 8 7)..] i=(idx rest "/")
  hp=(? i>=0 rest[..i] rest) path=(? i>=0 rest[i..] "/")
  j=(idx hp ":")
  [sec (? j>=0 hp[..j] hp) (? j>=0 (num hp[j+1..]) (? sec 443 80)) path])
(= (open sec host port opts)            ; a stream: {:r (n)=>bytes :w s=>nil :c ()=>nil}
  (? sec (: cn=(t.connect host port opts) {:r n=>(t.read cn n) :w s=>(t.write cn s) :c ()=>(t.close cn)})
     (: fd=(tcpc host port opts.ms) {:r n=>(fdr fd n) :w s=>(fdw fd s) :c ()=>(fdc fd)})))
(= (readhead c)                         ; bytes up to and including the blank line, plus anything read after it
  buf="" k=-1
  (wh k<0
    d=c.r(65536)
    (? d=="" (netfail "connection closed before the response head"))
    buf+=d k=(idx buf "\r\n\r\n"))
  [buf[..k] buf[k+4..]])
(= (readn c have n)                     ; have + more until n bytes
  (wh #have<n d=c.r(65536) (? d=="" (netfail "response body truncated")) have+=d)
  have[..n])
(= (readall c have) d=nil (wh d!="" d=c.r(65536) have+=d) have)
(= (readchunks c have)
  out="" n=-1
  (wh n!=0
    (wh (! (has have "\r\n")) d=c.r(65536) (? d=="" (netfail "chunked body truncated")) have+=d)
    k=(idx have "\r\n") n=(num (++ "0x" (trim (split have[..k] ";")[0]))) have=have[k+2..]
    (? (! (&& (isnum n) n>=0)) (netfail "bad chunk size"))
    (? n>0 (: (wh #have<n+2 d=c.r(65536) (? d=="" (netfail "chunked body truncated")) have+=d) out+=have[..n] have=have[n+2..])))
  out)
(= (resolve sec host port path loc)     ; a Location value -> an absolute URL: absolute as is, //host/p, /p, or relative to the directory of path
  origin=(++ (? sec "https://" "http://") host (? port==(? sec 443 80) "" (++ ":" port)))
  dir=(join (split (split path "?")[0] "/")[..-1] "/")
  (? (|| (starts loc "http://") (starts loc "https://")) loc
     (starts loc "//") (++ (? sec "https:" "http:") loc)
     (starts loc "/") (++ origin loc)
     (++ origin dir "/" loc)))
(= (req method url body=nil headers=nil opts=nil hops=0)
  [sec host port path]=(parseurl url) opts=(?? opts {})
  c=(open sec host port opts)
  h={:Host (? port==(? sec 443 80) host (++ host ":" port)) :Connection "close" "User-Agent" "ak"}
  (? body (: h["Content-Length"]=#body))
  (for [k v] (?? headers {}) h[k]=v)
  head=(++ method " " path " HTTP/1.1\r\n" (join (~ k=>(++ k ": " h[k]) (keys h)) "\r\n") "\r\n\r\n")
  c.w((++ head (?? body "")))
  [rh rest]=(readhead c)
  lines=(split rh "\r\n") st=(num (split lines[0] " ")[1])
  hd={} (for l lines[1..] k=(idx l ":") (? k>0 hd[(lo l[..k])]=(trim l[k+1..])))
  out=(? (|| (== (up method) "HEAD") st==204 st==304 (&& st>=100 st<200)) ""        ; these replies have no body, whatever Content-Length says
        (has (lo (?? hd["transfer-encoding"] "")) "chunked") (readchunks c rest)
        hd["content-length"] (readn c rest (num hd["content-length"]))
        (readall c rest))
  c.c()
  (? (&& (has [301 302 303 307 308] st) hd.location hops<5)
     (: next=(resolve sec host port path hd.location) [nsec nhost nport npath]=(parseurl next)
        ; credentials stay with the host they were meant for
        hs=(? (&& (== (lo nhost) (lo host)) nport==port) headers (: o={} (for [k v] (?? headers {}) (? (! (has ["authorization" "cookie" "proxy-authorization"] (lo k))) o[k]=v)) o))
        (req (? (&& (has [301 302 303] st) method!="HEAD") "GET" method) next (? st>=307 body) hs opts hops+1))
     {:status st :headers hd :body out}))
(= (get url headers=nil opts=nil) (req "GET" url nil headers opts))
(= (post url body headers=nil opts=nil) (req "POST" url body headers opts))
