; Dates and times (UTC, proleptic Gregorian calendar). Pure arithmetic: native and JS target. Time is seconds since 1970-01-01 (what `now` gives).
;   (use "lib/time.aklang" as t)
;   (t.civil 1700000000)         -> {:y 2023 :mo 11 :d 14 :h 22 :mi 13 :s 20 :ms 0 :wd 2 :yd 318}     (wd: 0 = Sunday, yd: day of the year from 1)
;   (t.epoch 2023 11 14 22 13 20) -> 1700000000                                                         (h mi s default to 0; d may overflow the month)
;   (t.iso 1700000000)           -> "2023-11-14T22:13:20Z"                 (".fff" is added when the time has milliseconds; years 0..9999)
;   (t.parse "2023-11-14T23:13:20+01:00") -> 1700000000                    (also "2023-11-14", "2023-11-14 22:13", fractions, Z, +hh:mm, +hhmm; raises on anything else)
;   (t.fmtdur 3723) -> "1h2m3s"   (t.pardur "1d2h") -> 93600              (units d h m s)
(= (days y mo d)                        ; days since 1970-01-01 of a calendar date
  y-=(? mo<=2 1 0) era=(y//400) yoe=y-era*400
  doy=(153*(mo+(? mo>2 -3 9))+2)//5+d-1
  era*146097+yoe*365+yoe//4-yoe//100+doy-719468)
(= (epoch y mo d=1 h=0 mi=0 s=0) (days y mo d)*86400+h*3600+mi*60+s)
(= (civil t)
  sec=(flr t) ms=(rnd (t-sec)*1000)
  (? ms>=1000 (: sec+=1 ms=0))
  z=sec//86400+719468 rem=sec-(sec//86400)*86400
  era=(z//146097) doe=z-era*146097
  yoe=(doe-doe//1460+doe//36524-doe//146096)//365
  doy=doe-(365*yoe+yoe//4-yoe//100) mp=(5*doy+2)//153
  d=doy-(153*mp+2)//5+1 mo=(? mp<10 mp+3 mp-9) y=yoe+era*400+(? mo<=2 1 0)
  {:y y :mo mo :d d :h rem//3600 :mi rem%3600//60 :s rem%60 :ms ms :wd ((sec//86400)+4)%7 :yd (days y mo d)-(days y 1 1)+1})
(= (iso t)
  c=(civil t)
  (fmt "%04d-%02d-%02dT%02d:%02d:%02d%sZ" c.y c.mo c.d c.h c.mi c.s (? c.ms>0 (fmt ".%03d" c.ms) "")))
(= (bad s) (err (++ "bad time: " (show s))))
(= (digits s a b) (? (match (re "^\\d+$") s[a..b]) (num s[a..b]) (bad s)))
(= (parse s)
  (? (! (is "str" s)) (bad s))
  (? (! (match (re "^\\d{4}-\\d\\d-\\d\\d([T ]\\d\\d:\\d\\d(:\\d\\d(\\.\\d+)?)?)?(Z|[+-]\\d\\d:?\\d\\d)?$") s)) (bad s))
  y=(digits s 0 4) mo=(digits s 5 7) d=(digits s 8 10) h=0 mi=0 sec=0 frac=0 off=0 i=10
  (? (&& mo>=1 mo<=12 d>=1 d<=31) nil (bad s))
  (? (&& #s>i (has "T " s[i])) (: h=(digits s i+1 i+3) mi=(digits s i+4 i+6) i+=6
       (? (&& #s>i s[i]==":") (: sec=(digits s i+1 i+3) i+=3
         (? (&& #s>i s[i]==".") (: j=i+1 (wh (&& j<#s (match (re "^\\d$") s[j])) j+=1) frac=(num (++ "0." s[i+1..j])) i=j))))))
  (? (&& h<=23 mi<=59 sec<=59) nil (bad s))
  (? (&& #s>i s[i]!="Z") (: sg=(? s[i]=="-" -1 1) hh=(digits s i+1 i+3) mm=(digits s #s-2 #s) off=sg*(hh*3600+mm*60)))
  (epoch y mo d h mi sec)-off+frac)
(= (fmtdur n)                           ; seconds -> "1d2h3m4s" (zero units are left out, 0 is "0s")
  n=(flr n) r="" (? n<0 (: r="-" n=-n))
  (for [u k] [["d" 86400] ["h" 3600] ["m" 60] ["s" 1]] (? n>=k (: r+=(++ (n//k) u) n=n%k)))
  (? (== r "") "0s" (== r "-") "0s" r))
(= (pardur s)                           ; "1d2h3m4s" -> seconds (an optional leading -)
  neg=(starts s "-") s=(? neg s[1..] s) tot=0
  (? (! (match (re "^(\\d+[dhms])+$") s)) (bad s))
  i=0
  (wh i<#s
    j=i (wh (&& j<#s (match (re "^\\d$") s[j])) j+=1)
    tot+=(num s[i..j])*(sw s[j] "d" 86400 "h" 3600 "m" 60 1) i=j+1)
  (? neg -tot tot))
