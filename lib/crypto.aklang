; Cryptographic primitives written in Ak (native target): hashes, HMAC, HKDF, AEAD ciphers, X25519. Used by lib/tls.aklang.
;   (use "lib/crypto.aklang" as c)
; All byte data is a string (bytes) in and out. Not constant-time: do not use it to protect secrets from a local attacker.
;   c.sha1 s   c.sha256 s   c.sha384 s   c.hmac hash key msg ("sha256"|"sha384")   c.hkdf_extract hash salt ikm   c.hkdf_expand hash prk info n
;   c.chacha_seal key nonce aad plain -> cipher+tag    c.chacha_open key nonce aad data -> plain or nil
;   c.aes_gcm_seal key nonce aad plain / c.aes_gcm_open key nonce aad data (16-byte key)
;   c.x25519 scalar point   c.x25519_base scalar   c.hex s   c.unhex h   c.random n
K256=[0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5 0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174 0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da 0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967 0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85 0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070 0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3 0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2]
H256=[0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19]
K512H=[0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5 0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174 0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da 0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967 0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85 0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070 0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3 0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2 0xca273ece 0xd186b8c7 0xeada7dd6 0xf57d4f7f 0x06f067aa 0x0a637dc5 0x113f9804 0x1b710b35 0x28db77f5 0x32caab7b 0x3c9ebe0a 0x431d67c4 0x4cc5d4be 0x597f299c 0x5fcb6fab 0x6c44198c]
K512L=[0xd728ae22 0x23ef65cd 0xec4d3b2f 0x8189dbbc 0xf348b538 0xb605d019 0xaf194f9b 0xda6d8118 0xa3030242 0x45706fbe 0x4ee4b28c 0xd5ffb4e2 0xf27b896f 0x3b1696b1 0x25c71235 0xcf692694 0x9ef14ad2 0x384f25e3 0x8b8cd5b5 0x77ac9c65 0x592b0275 0x6ea6e483 0xbd41fbd4 0x831153b5 0xee66dfab 0x2db43210 0x98fb213f 0xbeef0ee4 0x3da88fc2 0x930aa725 0xe003826f 0x0a0e6e70 0x46d22ffc 0x5c26c926 0x5ac42aed 0x9d95b3df 0x8baf63de 0x3c77b2a8 0x47edaee6 0x1482353b 0x4cf10364 0xbc423001 0xd0f89791 0x0654be30 0xd6ef5218 0x5565a910 0x5771202a 0x32bbd1b8 0xb8d2d0c8 0x5141ab53 0xdf8eeb99 0xe19b48a8 0xc5c95a63 0xe3418acb 0x7763e373 0xd6b2b8a3 0x5defb2fc 0x43172f60 0xa1f0ab72 0x1a6439ec 0x23631e28 0xde82bde9 0xb2c67915 0xe372532b 0xea26619c 0x21c0c207 0xcde0eb1e 0xee6ed178 0x72176fba 0xa2c898a6 0xbef90dae 0x131c471b 0x23047d84 0x40c72493 0x15c9bebc 0x9c100d4c 0xcb3e42b6 0xfc657e2a 0x3ad6faec 0x4a475817]
H384H=[0xcbbb9d5d 0x629a292a 0x9159015a 0x152fecd8 0x67332667 0x8eb44a87 0xdb0c2e0d 0x47b5481d]
H384L=[0xc1059ed8 0x367cd507 0x3070dd17 0xf70e5939 0xffc00b31 0x68581511 0x64f98fa7 0xbefa4fa4]
(= (hex s) (join (~ b=>(fmt "%02x" b) (bytes s)) ""))
(= (unhex h) (frombytes (~ i=>(num (++ "0x" h[2*i..2*i+2])) 0..#h//2)))
(= (random n) b=($newb 1 n n) ($syscall 318 ($addr b) n 0) (strslice b 0 n))
(= (xor a b) (frombytes (~ i=>(^ ($ldb a i) ($ldb b i)) 0..#a)))
(= (be32 s i) (>>> (| (| (<< ($ldb s i) 24) (<< ($ldb s i+1) 16)) (| (<< ($ldb s i+2) 8) ($ldb s i+3))) 0))
(= (le32 s i) (>>> (| (| (<< ($ldb s i+3) 24) (<< ($ldb s i+2) 16)) (| (<< ($ldb s i+1) 8) ($ldb s i))) 0))
(= (padmd m n big)                      ; Merkle-Damgard padding: m is the byte list of a message of n bytes; block 64 or 128 bytes
  blk=(? big 128 64) lenb=(? big 16 8)
  (push m 128) (wh (% #m blk)!=blk-lenb (push m 0))
  bits=n*8 tail=(rpt [0] lenb)
  (for i lenb tail[lenb-1-i]=(% bits 256) bits=(flr (/ bits 256)))
  (for b tail (push m b))
  m)
; ---- SHA-1 (only for protocols that still need it, e.g. the WebSocket handshake; not for security)
(= (sha1 s)
  m=(frombytes (padmd (bytes s) #s false)) h=[1732584193 4023233417 2562383102 271733878 3285377520] w=(u32 80) i=0
  (wh i<#m
    (for t 16 w[t]=(be32 m i+4*t))
    (for t 16..80 w[t]=(rotl (w[t-3]^w[t-8]^w[t-14]^w[t-16]) 1))
    [a b c d e]=h
    (for t 80
      f=(? t<20 ((b&c)|((bnot b)&d)) t<40 (b^c^d) t<60 ((b&c)|(b&d)|(c&d)) (b^c^d))
      k=(? t<20 1518500249 t<40 1859775393 t<60 2400959708 3395469782)
      tmp=(>>> (+ (rotl a 5) f e k w[t]) 0)
      e=d d=c c=(rotl b 30) b=a a=tmp)
    v=[a b c d e]
    h=(~ k=>(>>> h[k]+v[k] 0) 0..5)
    i+=64)
  (frombytes (~~ x=>[(>>> x 24) (>>> x 16)&255 (>>> x 8)&255 x&255] h)))
; ---- SHA-256
(= (rotr x n) (>>> (| (>>> x n) (<< x (- 32 n))) 0))
(= (sha256 s)
  m=(frombytes (padmd (bytes s) #s false)) h=(~ x=>x H256) w=(u32 64) i=0
  (wh i<#m
    (for t 16 w[t]=(be32 m i+4*t))
    (for t 16..64
      a=w[t-15] b=w[t-2]
      w[t]=w[t-16]+w[t-7]+((rotr a 7)^(rotr a 18)^(>>> a 3))+((rotr b 17)^(rotr b 19)^(>>> b 10)))
    [a b c d e f g hh]=h
    (for t 64
      t1=hh+((rotr e 6)^(rotr e 11)^(rotr e 25))+((e&f)^((bnot e)&g))+K256[t]+w[t]
      t2=((rotr a 2)^(rotr a 13)^(rotr a 22))+((a&b)^(a&c)^(b&c))
      hh=g g=f f=e e=(>>> d+t1 0) d=c c=b b=a a=(>>> t1+t2 0))
    v=[a b c d e f g hh]
    h=(~ k=>(>>> h[k]+v[k] 0) 0..8)
    i+=64)
  (frombytes (~~ x=>[(>>> x 24) (>>> x 16)&255 (>>> x 8)&255 x&255] h)))
; ---- SHA-384 (SHA-512 with other start values), on 32-bit halves
(= (rh h l n) (? n==32 l n>32 (rh l h n-32) (>>> (| (>>> h n) (<< l (- 32 n))) 0)))   ; high half of a 64-bit rotate right
(= (shl h l n) (>>> (| (>>> l n) (<< h (- 32 n))) 0))                                ; low half of a 64-bit shift right by n<32
(= (sha384 s)
  m=(frombytes (padmd (bytes s) #s true)) hh=(~ x=>x H384H) hl=(~ x=>x H384L) wh_=(u32 80) wl=(u32 80) i=0
  (wh i<#m
    (for t 16 wh_[t]=(be32 m i+8*t) wl[t]=(be32 m i+8*t+4))
    (for t 16..80
      ah=wh_[t-15] al=wl[t-15] bh=wh_[t-2] bl=wl[t-2]
      s0h=(rh ah al 1)^(rh ah al 8)^(>>> ah 7)
      s0l=(rh al ah 1)^(rh al ah 8)^(shl ah al 7)
      s1h=(rh bh bl 19)^(rh bh bl 61)^(>>> bh 6)
      s1l=(rh bl bh 19)^(rh bl bh 61)^(shl bh bl 6)
      lo=wl[t-16]+wl[t-7]+(>>> s0l 0)+(>>> s1l 0)
      wl[t]=lo
      wh_[t]=wh_[t-16]+wh_[t-7]+(>>> s0h 0)+(>>> s1h 0)+(flr (/ lo 4294967296)))
    ah=hh[0] al=hl[0] bh=hh[1] bl=hl[1] ch=hh[2] cl=hl[2] dh=hh[3] dl=hl[3]
    eh=hh[4] el=hl[4] fh=hh[5] fl=hl[5] gh=hh[6] gl=hl[6] h_h=hh[7] h_l=hl[7]
    (for t 80
      S1h=(rh eh el 14)^(rh eh el 18)^(rh eh el 41) S1l=(rh el eh 14)^(rh el eh 18)^(rh el eh 41)
      chh=(eh&fh)^((bnot eh)&gh) chl=(el&fl)^((bnot el)&gl)
      lo=h_l+(>>> S1l 0)+(>>> chl 0)+K512L[t]+wl[t]
      t1l=lo%4294967296
      t1h=h_h+(>>> S1h 0)+(>>> chh 0)+K512H[t]+wh_[t]+(flr (/ lo 4294967296))
      S0h=(rh ah al 28)^(rh ah al 34)^(rh ah al 39) S0l=(rh al ah 28)^(rh al ah 34)^(rh al ah 39)
      mjh=(ah&bh)^(ah&ch)^(bh&ch) mjl=(al&bl)^(al&cl)^(bl&cl)
      lo2=(>>> S0l 0)+(>>> mjl 0)
      t2l=lo2%4294967296
      t2h=(>>> S0h 0)+(>>> mjh 0)+(flr (/ lo2 4294967296))
      h_h=gh h_l=gl gh=fh gl=fl fh=eh fl=el
      lo3=dl+t1l
      el=lo3%4294967296 eh=(>>> dh+t1h+(flr (/ lo3 4294967296)) 0)
      dh=ch dl=cl ch=bh cl=bl bh=ah bl=al
      lo4=t1l+t2l
      al=lo4%4294967296 ah=(>>> t1h+t2h+(flr (/ lo4 4294967296)) 0))
    vh=[ah bh ch dh eh fh gh h_h] vl=[al bl cl dl el fl gl h_l]
    (for k 8
      lo=hl[k]+vl[k]
      hl[k]=lo%4294967296
      hh[k]=(>>> hh[k]+vh[k]+(flr (/ lo 4294967296)) 0))
    i+=128)
  (frombytes (~~ k=>(let (x hh[k] y hl[k]) [(>>> x 24) (>>> x 16)&255 (>>> x 8)&255 x&255 (>>> y 24) (>>> y 16)&255 (>>> y 8)&255 y&255]) 0..6)))
(= (hashfn name) (? name=="sha256" sha256 name=="sha384" sha384 (err "unknown hash")))
(= (hashlen name) (? name=="sha256" 32 48))
(= (hmac name key msg)
  f=(hashfn name) blk=(? name=="sha256" 64 128)
  key=(? #key>blk (f key) key) key=(++ key (rpt "\0" (- blk #key)))
  (f (++ (xor key (rpt "\\" blk)) (f (++ (xor key (rpt "6" blk)) msg)))))
(= (hkdf_extract name salt ikm) (hmac name (? #salt salt (rpt "\0" (hashlen name))) ikm))
(= (hkdf_expand name prk info n)
  out="" t="" i=1
  (wh #out<n t=(hmac name prk (++ t info (chr i))) out+=t i+=1)
  out[..n])
; ---- big numbers <-> bytes (uses the runtime's limb lists: base 2^24, little endian)
(= (bn limbs) (wh (&& #limbs>0 limbs[#limbs-1]==0) (pop limbs)) (bigwrap 0 limbs))
(= (bn_le s)                            ; little-endian bytes -> BigInt
  limbs=[] i=0 n=#s
  (wh i<n (push limbs ($ldb s i)+256*(? i+1<n ($ldb s i+1) 0)+65536*(? i+2<n ($ldb s i+2) 0)) i+=3)
  (bn limbs))
(= (bn_be s) (bn_le (frombytes (rev (bytes s)))))
(= (bn_bytes_le x n) l=(bigunwrap x) (frombytes (~ k=>(? k//3<#l (& (>>> l[k//3] 8*(k%3)) 255) 0) 0..n)))
(= (bn_bytes_be x n) (frombytes (rev (bytes (bn_bytes_le x n)))))
(= (mpow b e m)                         ; b**e mod m by square and multiply, e a BigInt
  r=1n b=(% b m) l=(bigunwrap e) i=#l-1
  (wh i>=0
    k=23
    (wh k>=0
      r=(% (* r r) m)
      (? (& (>>> l[i] k) 1) r=(% (* r b) m))
      k-=1)
    i-=1)
  r)
; ---- X25519 (RFC 7748) on BigInts
P25519=(- (** 2n 255n) 19n)
(= (x25519 k u)                         ; k: 32-byte scalar, u: 32-byte point -> 32-byte shared value
  kb=(bytes k) (do_clamp kb)
  kn=(bn_le (frombytes kb))
  ub=(bytes u) ub[31]=(& ub[31] 127)
  x1=(% (bn_le (frombytes ub)) P25519)
  x2=1n z2=0n x3=x1 z3=1n swap=0
  (for i 0..255
    t=254-i
    kt=(& (>>> kb[t//8] t%8) 1)
    (? swap!=kt (: [x2 x3]=[x3 x2] [z2 z3]=[z3 z2]))
    swap=kt
    a=(% (+ x2 z2) P25519) aa=(% (* a a) P25519)
    b=(% (+ (- x2 z2) P25519) P25519) bb=(% (* b b) P25519)
    e=(% (+ (- aa bb) P25519) P25519)
    c=(% (+ x3 z3) P25519) d=(% (+ (- x3 z3) P25519) P25519)
    da=(% (* d a) P25519) cb=(% (* c b) P25519)
    s1=(% (+ da cb) P25519) s2=(% (+ (- da cb) P25519) P25519)
    x3=(% (* s1 s1) P25519) z3=(% (* x1 (% (* s2 s2) P25519)) P25519)
    x2=(% (* aa bb) P25519) z2=(% (* e (+ aa (% (* 121665n e) P25519))) P25519))
  (? swap!=0 (: [x2 x3]=[x3 x2] [z2 z3]=[z3 z2]))
  (bn_bytes_le (% (* x2 (mpow z2 (- P25519 2n) P25519)) P25519) 32))
(= (do_clamp kb) kb[0]=(& kb[0] 248) kb[31]=(| (& kb[31] 127) 64) kb)
(= (x25519_base k) (x25519 k (++ "\x09" (rpt "\0" 31))))
; ---- ChaCha20-Poly1305 (RFC 8439)
(= (rotl x n) (>>> (| (<< x n) (>>> x (- 32 n))) 0))
(= (qr s a b c d)
  s[a]=(>>> s[a]+s[b] 0) s[d]=(rotl s[d]^s[a] 16)
  s[c]=(>>> s[c]+s[d] 0) s[b]=(rotl s[b]^s[c] 12)
  s[a]=(>>> s[a]+s[b] 0) s[d]=(rotl s[d]^s[a] 8)
  s[c]=(>>> s[c]+s[d] 0) s[b]=(rotl s[b]^s[c] 7))
(= (chacha_block key nonce ctr)         ; 64 keystream bytes
  s=(u32 16)
  s[0]=0x61707865 s[1]=0x3320646e s[2]=0x79622d32 s[3]=0x6b206574
  (for i 8 s[4+i]=(le32 key 4*i))
  s[12]=ctr
  (for i 3 s[13+i]=(le32 nonce 4*i))
  w=(u32 16) (for i 16 w[i]=s[i])
  (for 10
    (qr w 0 4 8 12) (qr w 1 5 9 13) (qr w 2 6 10 14) (qr w 3 7 11 15)
    (qr w 0 5 10 15) (qr w 1 6 11 12) (qr w 2 7 8 13) (qr w 3 4 9 14))
  (frombytes (~~ i=>(let (x (>>> w[i]+s[i] 0)) [x&255 (>>> x 8)&255 (>>> x 16)&255 (>>> x 24)&255]) 0..16)))
(= (chacha_xor key nonce ctr data)
  n=#data out=[] i=0
  (wh i<n
    ks=(chacha_block key nonce ctr)
    (for k 0..(min 64 n-i) (push out (^ ($ldb data i+k) ($ldb ks k))))
    ctr+=1 i+=64)
  (frombytes out))
P1305=(- (** 2n 130n) 5n)
(= (poly1305 key msg)
  rb=(bytes key[..16])
  (for i [3 7 11 15] rb[i]=(& rb[i] 15))
  (for i [4 8 12] rb[i]=(& rb[i] 252))
  r=(bn_le (frombytes rb)) acc=0n i=0 n=#msg
  (wh i<n
    blk=msg[i..(min i+16 n)]
    nn=(+ (bn_le blk) (** 256n (bigfromnum #blk)))
    acc=(% (* (+ acc nn) r) P1305)
    i+=16)
  (bn_bytes_le (+ acc (bn_le key[16..32])) 16))
(= (le64 n) (frombytes [n&255 (>>> n 8)&255 (>>> n 16)&255 (>>> n 24)&255 0 0 0 0]))
(= (pad16 s) (rpt "\0" (% (- 16 (% #s 16)) 16)))
(= (aead_mac otk aad ct) (poly1305 otk (++ aad (pad16 aad) ct (pad16 ct) (le64 #aad) (le64 #ct))))
(= (chacha_seal key nonce aad plain)
  otk=(chacha_block key nonce 0)[..32]
  ct=(chacha_xor key nonce 1 plain)
  (++ ct (aead_mac otk aad ct)))
(= (chacha_open key nonce aad data)     ; the plain text, or nil when the tag does not match
  n=#data-16 ct=data[..n]
  otk=(chacha_block key nonce 0)[..32]
  (? (ct_eq (aead_mac otk aad ct) data[n..]) (chacha_xor key nonce 1 ct) nil))
(= (ct_eq a b) (? #a!=#b false (: d=0 (for i #a d=(| d (^ ($ldb a i) ($ldb b i)))) d==0)))
; ---- AES-128/256-GCM (FIPS 197, SP 800-38D)
(= (xtime x) (& (^ (<< x 1) (? x>=128 27 0)) 255))
(= (mksbox)
  sb=(u8 256) p=1 q=1 go=true
  (wh go
    p=(& (^ (^ p (<< p 1)) (? p>=128 27 0)) 255)
    q=(& (^ q (<< q 1)) 255) q=(& (^ q (<< q 2)) 255) q=(& (^ q (<< q 4)) 255)
    q=(? q>=128 (^ q 9) q)
    r1=(& (| (<< q 1) (>>> q 7)) 255) r2=(& (| (<< q 2) (>>> q 6)) 255) r3=(& (| (<< q 3) (>>> q 5)) 255) r4=(& (| (<< q 4) (>>> q 4)) 255)
    sb[p]=(^ (^ (^ (^ q r1) (^ r2 r3)) r4) 99)
    go=p!=1)
  sb[0]=99
  sb)
SBOX=(mksbox)
(= (aes_keys key)                       ; expanded round keys: a list of 16-byte lists
  nk=#key//4 nr=nk+6 w=(bytes key) rc=1
  (for i nk..4*(nr+1)
    t=w[4*(i-1)..4*i]
    (? i%nk==0 (: t=[SBOX[t[1]]^rc SBOX[t[2]] SBOX[t[3]] SBOX[t[0]]] rc=(xtime rc))
       (&& nk>6 i%nk==4) t=(~ b=>SBOX[b] t))
    (for k 4 (push w (^ w[4*(i-nk)+k] t[k]))))
  (~ r=>w[16*r..16*r+16] 0..nr+1))
(= (aes_block rk blk)                   ; encrypt one 16-byte list with expanded keys
  s=(~ k=>(^ blk[k] rk[0][k]) 0..16) nr=#rk-1
  (for r 1..nr+1
    s=(~ k=>SBOX[s[k]] 0..16)
    s=(~ k=>s[(k%4)+4*(((k//4)+(k%4))%4)] 0..16)         ; ShiftRows
    (? r<nr
       (: t=[] (for c 4
           a0=s[4*c] a1=s[4*c+1] a2=s[4*c+2] a3=s[4*c+3]
           (push t (^ (^ (xtime a0) (^ (xtime a1) a1)) (^ a2 a3)))
           (push t (^ (^ a0 (xtime a1)) (^ (^ (xtime a2) a2) a3)))
           (push t (^ (^ a0 a1) (^ (xtime a2) (^ (xtime a3) a3))))
           (push t (^ (^ (^ (xtime a0) a0) a1) (^ a2 (xtime a3)))))
          s=t))
    s=(~ k=>(^ s[k] rk[r][k]) 0..16))
  s)
(= (gmul x y)                           ; GF(2^128) product of two 4-word big-endian blocks (NIST bit order)
  z=[0 0 0 0] v=[..y]
  (for i 128
    (? (& (>>> x[i//32] 31-(i%32)) 1) z=(~ k=>(^ z[k] v[k]) 0..4))
    lsb=v[3]&1
    v=[(>>> v[0] 1) (>>> (| (>>> v[1] 1) (<< v[0] 31)) 0) (>>> (| (>>> v[2] 1) (<< v[1] 31)) 0) (>>> (| (>>> v[3] 1) (<< v[2] 31)) 0)]
    (? lsb v[0]=(>>> (^ v[0] 0xe1000000) 0)))
  (~ w=>(>>> w 0) z))
(= (words s) (~ k=>(be32 s 4*k) 0..#s//4))
(= (ghash h data)                       ; data: a multiple of 16 bytes
  y=[0 0 0 0] w=(words data)
  (for b 0..#w//4
    y=(gmul (~ k=>(^ y[k] w[4*b+k]) 0..4) h))
  y)
(= (gcm_crypt rk iv ctr0 data)
  out=[] i=0 n=#data ctr=ctr0
  (wh i<n
    cb=(++ iv (frombytes [(>>> ctr 24)&255 (>>> ctr 16)&255 (>>> ctr 8)&255 ctr&255]))
    ks=(aes_block rk (bytes cb))
    (for k 0..(min 16 n-i) (push out (^ ($ldb data i+k) ks[k])))
    ctr+=1 i+=16)
  (frombytes out))
(= (gcm_tag rk iv aad ct)
  h=(words (frombytes (aes_block rk (rpt [0] 16))))
  g=(ghash h (++ aad (pad16 aad) ct (pad16 ct) (be64 #aad*8) (be64 #ct*8)))
  ek=(gcm_crypt rk iv 1 (rpt "\0" 16))
  (xor ek (frombytes (~~ w=>[(>>> w 24) (>>> w 16)&255 (>>> w 8)&255 w&255] g))))
(= (be64 n) (frombytes [0 0 0 0 (>>> n 24)&255 (>>> n 16)&255 (>>> n 8)&255 n&255]))
(= (aes_gcm_seal key nonce aad plain)
  rk=(aes_keys key) ct=(gcm_crypt rk nonce 2 plain)
  (++ ct (gcm_tag rk nonce aad ct)))
(= (aes_gcm_open key nonce aad data)
  rk=(aes_keys key) n=#data-16 ct=data[..n]
  (? (ct_eq (gcm_tag rk nonce aad ct) data[n..]) (gcm_crypt rk nonce 2 ct) nil))
