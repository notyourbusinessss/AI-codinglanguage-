; A TLS 1.3 and 1.2 client and TLS 1.3 server in Ak (native target), built on crypto.aklang and pki.aklang.
;   (use "lib/tls.aklang" as t)
;   conn=(t.connect host port)            TCP connect + handshake; verifies the server certificate chain and host name, raises on any failure
;   conn=(t.connect host port {:roots roots :ms 5000})   :roots = parsed CA certificates to trust instead of the system bundle; :ms = TCP connect timeout
;   (t.read conn n=16384)                 up to n plain bytes; "" at end of stream (close_notify or the peer closed)
;   (t.write conn s)  (t.close conn)  (t.fd conn)   (t.fd is the socket, for fdwait)
; (t.read) returns "" at the end; conn.truncated is true when the peer hung up without close_notify (many servers do), so data without its own length framing may be cut short.
; opts also take :alpn ["h2" "http/1.1"] (offered protocols; conn.alpn is the one the server chose, or nil) and :cert/:key (PEM; a client certificate for servers that ask for one, see t.creds). conn.peer is the other side's verified certificate (parsed) after mutual TLS.
; TLS 1.3 and TLS 1.2 (client only; ECDHE x25519 with AES-GCM or ChaCha20-Poly1305, RSA or ECDSA certificates, extended master secret), x25519 key exchange, TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384 and TLS_CHACHA20_POLY1305_SHA256; no session resumption, no 0-RTT.
; Server side: cr=(t.creds {:cert chain_pem :key key_pem})   load a certificate chain (leaf first) and its unencrypted private key once (RSA, or EC P-256/P-384)
;   conn=(t.accept fd cr)   handshake on a socket from (tcpa l); cr may also be the {:cert :key} map itself. Same conn as t.connect (read, write, close, fd), plus conn.sni (the client's server name, or nil).
;   On failure it closes fd and raises. Signs with rsa_pss_rsae or ECDSA, picking what the client offered.
;   cr options: :alpn ["h2" "http/1.1"] (server preference; conn.alpn is the pick, nil if the client offered none; no overlap is an error)
;     :clientca PEM text of trusted CA certificates: ask the client for a certificate and verify it against them (conn.peer is its parsed leaf); with :optional true a client may send none (conn.peer nil)
(use "crypto.aklang" as c)
(use "pki.aklang" as k)
(= (be n w) (? w>4 (++ (be (flr (/ n 4294967296)) w-4) (be (% n 4294967296) 4)) (frombytes (~ i=>(& (>>> n (* 8 (- w 1 i))) 255) 0..w))))
(= (alert_text n)
  (++ "alert " (tostr n)
      (sw n 10 " (unexpected_message)" 20 " (bad_record_mac)" 40 " (handshake_failure)" 42 " (bad_certificate)" 43 " (unsupported_certificate)" 44 " (certificate_revoked)" 45 " (certificate_expired)" 46 " (certificate_unknown)" 47 " (illegal_parameter)" 48 " (unknown_ca)" 50 " (decode_error)" 51 " (decrypt_error)"
          70 " (protocol_version): the server does not support TLS 1.3" 71 " (insufficient_security)" 80 " (internal_error)" 109 " (missing_extension)" 112 " (unrecognized_name)" 116 " (certificate_required)" 120 " (no_application_protocol)" "")))
(= (tfail msg) (raise "io" (++ "tls: " msg) nil))
(= (rdn conn n eof_ok=false)            ; exactly n bytes from the socket; nil if the peer closed cleanly before the first byte and eof_ok is set
  buf=conn.inbuf eof=false
  (wh (&& #buf<n (! eof)) d=(fdr conn.fd 65536) (? d=="" eof=true buf+=d))
  (? eof (? (&& eof_ok #buf==0) nil (tfail "connection closed during the handshake or in the middle of a record"))
     (: conn.inbuf=buf[n..] buf[..n])))
(= (rec_send conn type body)            ; one record, encrypted when keys are installed
  (? (&& conn.wkey conn.v12)
     (: hdr=(++ (be conn.wseq 8) (frombytes [type]) "\x03\x03" (be #body 2))
        ex=(? (== conn.suite "aes") (be conn.wseq 8) "")
        ct=(? (== conn.suite "aes") (c.aes_gcm_seal conn.wkey (++ conn.wiv ex) hdr body) (c.chacha_seal conn.wkey (nonce conn.wiv conn.wseq) hdr body))
        conn.wseq=conn.wseq+1
        (fdw conn.fd (++ (frombytes [type]) "\x03\x03" (be (+ #ex #ct) 2) ex ct)))
  conn.wkey
     (: inner=(++ body (frombytes [type]))
        hdr=(++ "\x17\x03\x03" (be #inner+16 2))
        ct=(aead_seal conn conn.wkey conn.wiv conn.wseq hdr inner)
        conn.wseq=conn.wseq+1
        (fdw conn.fd (++ hdr ct)))
     (fdw conn.fd (++ (frombytes [type]) (? (&& (== type 22) (! conn.v12)) "\x03\x01" "\x03\x03") (be #body 2) body))))
(= (nonce iv seq) (c.xor iv (++ (rpt "\0" 4) (be seq 8))))
(= (aead_seal conn key iv seq aad data)
  n=(nonce iv seq)
  (? (== conn.suite "aes") (c.aes_gcm_seal key n aad data) (c.chacha_seal key n aad data)))
(= (aead_open conn key iv seq aad data)
  n=(nonce iv seq)
  (? (== conn.suite "aes") (c.aes_gcm_open key n aad data) (c.chacha_open key n aad data)))
(= (rec_recv conn)                      ; [type body] of the next record (decrypted when keys are installed)
  h=(rdn conn 5 conn.open)
  (? ($isnil h) [0 ""] (rec_body conn h)))
(= (rec_body conn h)
  type=($ldb h 0) len=256*($ldb h 3)+($ldb h 4)
  (? len>16640 (tfail "record too large"))
  body=(rdn conn len)
  (? (&& conn.rkey conn.v12 (!= type 20))
     (: ex=(? (== conn.suite "aes") body[..8] "") ct=body[#ex..]
        (? #ct<16 (tfail "record too short"))
        hdr=(++ (be conn.rseq 8) (frombytes [type]) "\x03\x03" (be #ct-16 2))
        pt=(? (== conn.suite "aes") (c.aes_gcm_open conn.rkey (++ conn.riv ex) hdr ct) (c.chacha_open conn.rkey (nonce conn.riv conn.rseq) hdr ct))
        (? ($isnil pt) (tfail "bad record MAC"))
        conn.rseq=conn.rseq+1
        [type pt])
  (&& conn.rkey (== type 23))
     (: pt=(aead_open conn conn.rkey conn.riv conn.rseq h body)
        (? ($isnil pt) (tfail "bad record MAC"))
        conn.rseq=conn.rseq+1
        j=#pt-1 (wh (&& j>=0 ($ldb pt j)==0) j-=1)
        (? j<0 (tfail "empty record"))
        [($ldb pt j) pt[..j]])
     [type body]))
; ---- key schedule
(= (label hash lab ctx n) (++ (be n 2) (frombytes [6+#lab]) "tls13 " lab (frombytes [#ctx]) ctx))
(= (expand_label hash secret lab ctx n) (c.hkdf_expand hash secret (label hash lab ctx n) n))
(= (derive hash secret lab th) (expand_label hash secret lab th (c.hashlen hash)))
(= (traffic conn hash secret)           ; -> [key iv]
  [(expand_label hash secret "key" "" conn.klen) (expand_label hash secret "iv" "" 12)])
(= (install_read conn secret) kv=(traffic conn conn.hash secret) conn.rkey=kv[0] conn.riv=kv[1] conn.rseq=0 conn.rsecret=secret)
(= (install_write conn secret) kv=(traffic conn conn.hash secret) conn.wkey=kv[0] conn.wiv=kv[1] conn.wseq=0 conn.wsecret=secret)
; ---- handshake messages
(= (ext type body) (++ (be type 2) (be #body 2) body))
(= (alpn_ext names) (? #names (ext 16 (let (l (join (~ n=>(++ (frombytes [#n]) n) names) "")) (++ (be #l 2) l))) ""))
(= (client_hello host ks random sid alpn cookie)   ; ks: the key_share entry (group, length, key)
  exts=(++
    (? (dotted host) "" (ext 0 (let (nm (++ "\x00" (be #host 2) host)) (++ (be #nm 2) nm))))
    (ext 10 "\x00\x06\x00\x1d\x00\x17\x00\x18")   ; x25519 first; P-256 and P-384 are listed so servers accept ECDSA certificates on those curves
    (ext 13 (let (sa (c.unhex "0804080508060403050306030401050106010201")) (++ (be #sa 2) sa)))
    (ext 43 "\x04\x03\x04\x03\x03")
    (ext 11 "\x01\x00") (ext 23 "") (ext 65281 "\x00")
    (alpn_ext alpn)
    (ext 51 (++ (be #ks 2) ks))
    (? cookie (ext 44 (++ (be #cookie 2) cookie)) ""))
  suites=(c.unhex "130113021303c02bc02fc02cc030cca9cca8")
  body=(++ "\x03\x03" random (frombytes [#sid]) sid (be #suites 2) suites "\x01\x00" (be #exts 2) exts)
  (++ "\x01" (be #body 3) body))
(= (set_suite13 conn n)
  (sw n
    4865 (: conn.hash="sha256" conn.klen=16 conn.suite="aes")
    4866 (: conn.hash="sha384" conn.klen=32 conn.suite="aes")
    4867 (: conn.hash="sha256" conn.klen=32 conn.suite="chacha")
    (tfail "server chose a cipher suite that was not offered")))
(= HRR_RANDOM (c.unhex "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c"))
(= (is_hrr m) (== m[6..38] HRR_RANDOM))
(= (ext_of s t) (k.first (~? e=>e[0]==t s.exts)))
(= (parse_server_hello conn m sent)     ; -> the server's key share for the group we sent
  (? ($ldb m 0)!=2 (tfail "expected ServerHello"))
  s=(sh_parse m) v=(ext_of s 43) ks=(ext_of s 51)
  (? (|| ($isnil v) (!= (by2 v[1] 0) 772)) (tfail "server did not negotiate TLS 1.3"))
  (? ($isnil ks) (tfail "no key share in ServerHello"))
  g=(by2 ks[1] 0) kl=(by2 ks[1] 2)
  (? (!= g sent) (tfail "the server picked a key exchange group that was not offered"))
  (? (!= kl (sw g 29 32 23 65 24 97 0)) (tfail "bad key share length"))
  (set_suite13 conn s.suite)
  ks[1][4..4+kl])
(= (parse_hrr conn m)                   ; HelloRetryRequest -> {:group (nil = keep ours) :cookie}
  s=(sh_parse m) v=(ext_of s 43) g=(ext_of s 51) ck=(ext_of s 44)
  (? (|| ($isnil v) (!= (by2 v[1] 0) 772)) (tfail "server did not negotiate TLS 1.3"))
  (? (&& ($isnil g) ($isnil ck)) (tfail "HelloRetryRequest that changes nothing"))
  (set_suite13 conn s.suite)
  {:group (? g (by2 g[1] 0) nil) :cookie (? ck ck[1][2..2+(by2 ck[1] 0)] nil)})
(= (hs_next conn)                       ; next whole handshake message (header included); also adds it to the transcript when keep is set
  (wh (< #conn.hsbuf 4)
    r=(rec_recv conn)
    (? r[0]==20 nil
       r[0]==21 (tfail (alert_text ($ldb r[1] 1)))
       r[0]==22 conn.hsbuf+=r[1]
       (tfail "unexpected record during the handshake")))
  n=4+65536*($ldb conn.hsbuf 1)+256*($ldb conn.hsbuf 2)+($ldb conn.hsbuf 3)
  (wh (< #conn.hsbuf n)
    r=(rec_recv conn)
    (? r[0]==22 conn.hsbuf+=r[1] (tfail "unexpected record inside a handshake message")))
  m=conn.hsbuf[..n] conn.hsbuf=conn.hsbuf[n..]
  m)
(= (parse_certs m)                      ; Certificate message -> list of DER strings
  body=m[4..] ctxlen=($ldb body 0) i=1+ctxlen
  total=65536*($ldb body i)+256*($ldb body i+1)+($ldb body i+2) i+=3
  out=[] end=i+total
  (wh i<end
    cl=65536*($ldb body i)+256*($ldb body i+1)+($ldb body i+2)
    (push out body[i+3..i+3+cl])
    el=256*($ldb body i+3+cl)+($ldb body i+4+cl)
    i+=5+cl+el)
  out)
(= (sigalg_of v)
  (sw v 2052 "rsa_pss_sha256" 2053 "rsa_pss_sha384" 1027 "ecdsa_sha256" 1283 "ecdsa_sha384" nil))
(= (connect host port opts=nil)
  opts=(?? opts {})
  fd=(tcpc host port opts.ms)
  conn={:fd fd :inbuf "" :hsbuf "" :plain "" :eof false :rkey nil :wkey nil :rseq 0 :wseq 0}
  (try (handshake conn host opts) e=>(: (fdc fd) (raise "io" e nil)))
  conn)
(= (handshake conn host opts)
  priv=(c.random 32) pub=(c.x25519_base priv) sid=(c.random 32) rnd=(c.random 32)
  cc=(? opts.ders opts (? opts.cert (creds opts) nil))
  ch=(client_hello host (++ "\x00\x1d\x00\x20" pub) rnd sid opts.alpn nil)
  (rec_send conn 22 ch)
  sh=(hs_next conn)
  (? (any e=>e[0]==43 (sh_parse sh).exts) (hs13 conn host opts cc ch sh priv [host rnd sid opts.alpn]) (hs12 conn host opts cc ch sh priv pub)))
(= (hs13 conn host opts cc ch sh priv ctx)
  (rec_send conn 20 "\x01")             ; compatibility ChangeCipherSpec
  conn.hash="sha256"
  hist=ch kx=[29 priv]
  (? (is_hrr sh)
     (: hr=(parse_hrr conn sh) g=(?? hr.group 29)
        ks=(++ "\x00\x1d\x00\x20" (c.x25519_base priv))
        (? (&& g==29 ($isnil hr.cookie)) (tfail "the server asked for a key exchange group that is not supported"))
        (? g!=29
           (: cvc=(k.curve_by_id g)
              (? ($isnil cvc) (tfail "the server asked for a key exchange group that is not supported"))
              pr=(k.ecdh_pair cvc) pk=pr[1]
              kx=[g pr[0]] ks=(++ (be g 2) (be #pk 2) pk)))
        ch2=(client_hello ctx[0] ks ctx[1] ctx[2] ctx[3] hr.cookie)
        (rec_send conn 22 ch2)
        hist=(++ (frombytes [254 0 0 (c.hashlen conn.hash)]) ((c.hashfn conn.hash) ch) sh ch2)
        sh=(hs_next conn)
        (? (is_hrr sh) (tfail "the server sent a second HelloRetryRequest"))))
  share=(parse_server_hello conn sh kx[0])
  hash=conn.hash
  shared=(? kx[0]==29 (c.x25519 kx[1] share) (try (k.ecdh (k.curve_by_id kx[0]) kx[1] share) e=>(tfail e)))
  (? (== shared (rpt "\0" 32)) (tfail "bad key share"))
  th=(++ hist sh)
  zeros=(rpt "\0" (c.hashlen hash))
  early=(c.hkdf_extract hash "" zeros)
  hs=(c.hkdf_extract hash (derive hash early "derived" ((c.hashfn hash) "")) shared)
  chs=(derive hash hs "c hs traffic" ((c.hashfn hash) th))
  shs=(derive hash hs "s hs traffic" ((c.hashfn hash) th))
  (install_read conn shs) (install_write conn chs)
  hf=(c.hashfn hash)
  m=(hs_next conn)
  (? ($ldb m 0)!=8 (tfail "expected EncryptedExtensions"))
  (parse_ee conn m opts.alpn)
  th+=m
  m=(hs_next conn)
  req=nil
  (? ($ldb m 0)==13 (: req=m th+=m m=(hs_next conn)))
  (? ($ldb m 0)!=11 (tfail "expected Certificate"))
  th+=m
  ders=(parse_certs m)
  (? (! #ders) (tfail "the server sent no certificate"))
  leaf=(try (k.check_chain ders host (?? opts.roots k.trust_roots()) (flr (/ (now) 1000))) e=>(tfail e))
  conn.peer=leaf
  tcv=(hf th)
  m=(hs_next conn)
  (? ($ldb m 0)!=15 (tfail "expected CertificateVerify"))
  alg=(sigalg_of 256*($ldb m 4)+($ldb m 5))
  (? ($isnil alg) (tfail "unsupported signature algorithm in CertificateVerify"))
  sl=256*($ldb m 6)+($ldb m 7) sig=m[8..8+sl]
  signed=(++ (rpt " " 64) "TLS 1.3, server CertificateVerify\x00" tcv)
  (? (! (k.verify_sig leaf.key alg signed sig)) (tfail "server signature (CertificateVerify) is invalid"))
  th+=m
  fin_key=(expand_label hash shs "finished" "" (c.hashlen hash))
  want=(c.hmac hash fin_key (hf th))
  m=(hs_next conn)
  (? ($ldb m 0)!=20 (tfail "expected Finished"))
  (? (! (c.ct_eq m[4..] want)) (tfail "server Finished does not verify"))
  th+=m
  ap_th=(hf th)
  cap=(derive hash (c.hkdf_extract hash (derive hash hs "derived" (hf "")) zeros) "c ap traffic" ap_th)
  sap=(derive hash (c.hkdf_extract hash (derive hash hs "derived" (hf "")) zeros) "s ap traffic" ap_th)
  cfk=(expand_label hash chs "finished" "" (c.hashlen hash))
  (? req th+=(client_cert conn req cc hf th))
  cf=(c.hmac hash cfk (hf th))
  (rec_send conn 22 (++ "\x14" (be #cf 3) cf))
  (install_write conn cap) (install_read conn sap)
  conn.open=true
  conn)
(= (read conn n=16384)
  (wh (&& (== #conn.plain 0) (! conn.eof))
    r=(rec_recv conn)
    (sw r[0]
      23 conn.plain=r[1]
      21 (? (&& #r[1]>=2 ($ldb r[1] 1)==0) conn.eof=true (tfail (alert_text ($ldb r[1] 1))))
      22 (? (! conn.v12) (post_handshake conn r[1]))
      20 nil
      0 (: conn.eof=true conn.truncated=true)
      (tfail "unexpected record type")))
  d=conn.plain[..n] conn.plain=conn.plain[#d..]
  d)
(= (post_handshake conn body)           ; NewSessionTicket is ignored; KeyUpdate re-keys
  i=0
  (wh i+4<=#body
    ty=($ldb body i) l=65536*($ldb body i+1)+256*($ldb body i+2)+($ldb body i+3)
    (? ty==24
       (: conn.rsecret=(expand_label conn.hash conn.rsecret "traffic upd" "" (c.hashlen conn.hash))
          (install_read conn conn.rsecret)
          (? ($ldb body i+4)==1
             (: (rec_send conn 22 "\x18\x00\x00\x01\x00")
                conn.wsecret=(expand_label conn.hash conn.wsecret "traffic upd" "" (c.hashlen conn.hash))
                (install_write conn conn.wsecret)))))
    i+=4+l))
(= (write conn s)
  s=(? (islist s) (frombytes s) (tostr s)) i=0
  (wh i<#s (rec_send conn 23 s[i..(min i+16384 #s)]) i+=16384)
  nil)
(= (close conn)
  (try (rec_send conn 21 "\x01\x00") e=>nil)
  (fdc conn.fd) nil)
(= (fd conn) conn.fd)
; ---- ALPN and client certificates (client side)
(= (parse_ee conn m offered)
  b=m[4..] end=2+(by2 b 0) i=2
  (wh i<end
    et=(by2 b i) el=(by2 b i+2) eb=b[i+4..i+4+el]
    (? et==16 (: conn.alpn=eb[3..3+(by1 eb 2)] (? (! (has (?? offered []) conn.alpn)) (tfail "the server chose an ALPN protocol that was not offered"))))
    i+=4+el))
(= (client_cert conn req cc hf th)      ; answer a CertificateRequest with our chain and signature, or an empty Certificate; sends it, returns the bytes
  b=req[4..] cl=(by1 b 0) ctx=b[1..1+cl]
  algs=[] i=1+cl end=i+2+(by2 b i) i+=2
  (wh i<end (? (by2 b i)==13 algs=(by2s b i+6 (by2 b i+4))) i+=4+(by2 b i+2))
  alg=(? cc (k.first (~? x=>(has algs x) cc.algs)) nil)
  list=(? alg (join (~ d=>(++ (be #d 3) d "\x00\x00") cc.ders) "") "")
  cm=(hmsg 11 (++ (frombytes [cl]) ctx (be #list 3) list))
  out=cm
  (? alg (: sig=(k.sign cc.key (sigalg_of alg) (++ (rpt " " 64) "TLS 1.3, client CertificateVerify\x00" (hf (++ th cm))))
            out=(++ cm (hmsg 15 (++ (be alg 2) (be #sig 2) sig)))))
  (rec_send conn 22 out)
  out)
; ---- server side
(= (by1 s i) (? (|| i<0 i>=#s) (tfail "malformed message") ($ldb s i)))
(= (by2 s i) 256*(by1 s i)+(by1 s i+1))
(= (by2s s i n) (~ j=>(by2 s i+2*j) 0..n//2))
(= (hmsg ty body) (++ (frombytes [ty]) (be #body 3) body))
(= (sfail conn n msg) (try (rec_send conn 21 (frombytes [2 n])) e=>nil) (tfail msg))
(= (creds opts)
  (? opts.ders opts
     (: (? (|| ($isnil opts.cert) ($isnil opts.key)) (tfail "accept needs :cert (PEM chain) and :key (PEM private key)"))
        ders=(k.pem_certs opts.cert)
        (? (! #ders) (tfail "no certificate in :cert"))
        key=(try (k.priv_parse opts.key) e=>(tfail e))
        leaf=(k.cert_parse ders[0])
        (? (! (k.key_matches key leaf.key)) (tfail "the private key does not match the first certificate"))
        cas=(? opts.clientca (~ d=>(k.cert_parse d) (k.pem_certs opts.clientca)) nil)
        (? (&& opts.clientca (! #cas)) (tfail "no certificate in :clientca"))
        {:ders ders :key key :algs (? (== key.type "rsa") [2052 2053] (== key.curve.name "P-256") [1027] [1283]) :alpn opts.alpn :cas cas :optional opts.optional})))
(= (parse_client_hello m)
  b=m[4..] i=34
  sid=b[i+1..i+1+(by1 b i)] i+=1+(by1 b i)
  cl=(by2 b i) suites=(by2s b i+2 cl) i+=2+cl
  i+=1+(by1 b i)
  end=i+2+(by2 b i) i+=2
  (? end>#b (tfail "malformed ClientHello"))
  h={:sid sid :suites suites :versions [] :sigs [] :groups [] :shares [] :sni nil :alpn nil}
  (wh i<end
    et=(by2 b i) el=(by2 b i+2) eb=b[i+4..i+4+el]
    (? #eb<el (tfail "malformed ClientHello"))
    (? et==0 (: nl=(by2 eb 3) h.sni=eb[5..5+nl]))
    (? et==16 (: h.alpn=[] j=2 (wh j<#eb nl=(by1 eb j) (push h.alpn eb[j+1..j+1+nl]) j+=1+nl)))
    (? et==43 h.versions=(by2s eb 1 (by1 eb 0)))
    (? et==13 h.sigs=(by2s eb 2 (by2 eb 0)))
    (? et==51
       (: j=2 (wh j<#eb kl=(by2 eb j+2) (push h.shares [(by2 eb j) eb[j+4..j+4+kl]]) j+=4+kl)))
    (? et==10 h.groups=(by2s eb 2 (by2 eb 0)))
    i+=4+el)
  h)
(= (accept fd opts)
  cr=(creds opts)
  conn={:fd fd :inbuf "" :hsbuf "" :plain "" :eof false :rkey nil :wkey nil :rseq 0 :wseq 0}
  (try (srv_handshake conn cr) e=>(: (fdc fd) (raise "io" e nil)))
  conn)
(= (pick_share h)                       ; [group key] of the first usable key share (x25519, then P-256, then P-384), or nil
  (k.first (~? x=>(has [29 23 24] x[0]) (~? x=>(== #x[1] (sw x[0] 29 32 23 65 24 97 0)) (sort_by_pref h.shares)))))
(= (sort_by_pref shares) (~ g=>(k.first (~? x=>x[0]==g shares)) (~? g=>(has (~ x=>x[0] shares) g) [29 23 24])))
(= (srv_handshake conn cr)
  ch=(hs_next conn)
  (? ($ldb ch 0)!=1 (tfail "expected ClientHello"))
  h=(parse_client_hello ch)
  (? (! (has h.versions 772)) (sfail conn 70 "the client does not support TLS 1.3"))
  suite=(k.first (~? x=>(has [4865 4866 4867] x) h.suites))
  (? ($isnil suite) (sfail conn 40 "no cipher suite in common"))
  alg=(k.first (~? x=>(has h.sigs x) cr.algs))
  (? ($isnil alg) (sfail conn 40 "no signature algorithm in common"))
  (sw suite
    4865 (: conn.hash="sha256" conn.klen=16 conn.suite="aes")
    4866 (: conn.hash="sha384" conn.klen=32 conn.suite="aes")
    (: conn.hash="sha256" conn.klen=32 conn.suite="chacha"))
  hash=conn.hash hf=(c.hashfn hash) hl=(c.hashlen hash)
  sel=(pick_share h) hist=ch ccs=false
  (? ($isnil sel)
     (: g=(k.first (~? x=>(has h.groups x) [29 23 24]))
        (? ($isnil g) (sfail conn 40 "no key exchange group in common"))
        x=(++ (ext 43 "\x03\x04") (ext 51 (be g 2)))
        hrr=(hmsg 2 (++ "\x03\x03" HRR_RANDOM (frombytes [#h.sid]) h.sid (be suite 2) "\x00" (be #x 2) x))
        (rec_send conn 22 hrr) (rec_send conn 20 "\x01")
        ch2=(hs_next conn)
        (? ($ldb ch2 0)!=1 (tfail "expected the second ClientHello"))
        h=(parse_client_hello ch2) sel=(pick_share h) ccs=true
        (? (|| ($isnil sel) (!= sel[0] g)) (sfail conn 47 "the second ClientHello has no key share for the requested group"))
        hist=(++ (frombytes [254 0 0 hl]) (hf ch) hrr ch2)))
  (? (== sel[0] 29)
     (: priv=(c.random 32) pub=(c.x25519_base priv) shared=(c.x25519 priv sel[1])
        (? (== shared (rpt "\0" 32)) (sfail conn 47 "bad key share")))
     (: pr=(k.ecdh_pair (k.curve_by_id sel[0])) pub=pr[1]
        shared=(try (k.ecdh (k.curve_by_id sel[0]) pr[0] sel[1]) e=>(sfail conn 47 e))))
  exts=(++ (ext 43 "\x03\x04") (ext 51 (++ (be sel[0] 2) (be #pub 2) pub)))
  sbody=(++ "\x03\x03" (c.random 32) (frombytes [#h.sid]) h.sid (be suite 2) "\x00" (be #exts 2) exts)
  sh=(hmsg 2 sbody)
  (rec_send conn 22 sh)
  (? (! ccs) (rec_send conn 20 "\x01"))
  zeros=(rpt "\0" hl)
  hs=(c.hkdf_extract hash (derive hash (c.hkdf_extract hash "" zeros) "derived" (hf "")) shared)
  chs=(derive hash hs "c hs traffic" (hf (++ hist sh))) shs=(derive hash hs "s hs traffic" (hf (++ hist sh)))
  (install_write conn shs) (install_read conn chs)
  th=(++ hist sh)
  pick=(? h.alpn (k.first (~? x=>(has h.alpn x) (?? cr.alpn []))) nil)
  (? (&& cr.alpn h.alpn ($isnil pick)) (sfail conn 120 "no ALPN protocol in common"))
  conn.alpn=pick
  ee=(hmsg 8 (let (x (alpn_ext (? pick [pick] []))) (++ (be #x 2) x)))
  creq=(? cr.cas (hmsg 13 (let (x (ext 13 (let (sa (c.unhex "0804080504030503")) (++ (be #sa 2) sa)))) (++ "\x00" (be #x 2) x))) "")
  cl=(join (~ d=>(++ (be #d 3) d "\x00\x00") cr.ders) "")
  cm=(hmsg 11 (++ "\x00" (be #cl 3) cl))
  th+=(++ ee creq cm)
  sig=(k.sign cr.key (sigalg_of alg) (++ (rpt " " 64) "TLS 1.3, server CertificateVerify\x00" (hf th)))
  cv=(hmsg 15 (++ (be alg 2) (be #sig 2) sig))
  th+=cv
  fin=(hmsg 20 (c.hmac hash (expand_label hash shs "finished" "" hl) (hf th)))
  th+=fin
  flight=(++ ee creq cm cv fin) i=0
  (wh i<#flight (rec_send conn 22 flight[i..(min i+16384 #flight)]) i+=16384)
  master=(c.hkdf_extract hash (derive hash hs "derived" (hf "")) zeros)
  sap=(derive hash master "s ap traffic" (hf th)) cap=(derive hash master "c ap traffic" (hf th))
  (install_write conn sap)
  m=(hs_next conn)
  (? cr.cas
     (: (? ($ldb m 0)!=11 (tfail "expected the client Certificate"))
        th+=m ders=(parse_certs m)
        (? #ders
           (: leaf=(try (k.check_chain ders nil cr.cas (flr (/ (now) 1000))) e=>(sfail conn 42 (++ "client " e)))
              hf0=(hf th)
              m=(hs_next conn)
              (? ($ldb m 0)!=15 (tfail "expected the client CertificateVerify"))
              a=(sigalg_of (by2 m 4))
              (? (|| ($isnil a) (! (k.verify_sig leaf.key a (++ (rpt " " 64) "TLS 1.3, client CertificateVerify\x00" hf0) m[8..8+(by2 m 6)]))) (sfail conn 51 "client signature (CertificateVerify) is invalid"))
              th+=m conn.peer=leaf
              m=(hs_next conn))
           (: (? (! cr.optional) (sfail conn 116 "the client sent no certificate"))
              m=(hs_next conn)))))
  (? ($ldb m 0)!=20 (tfail "expected the client Finished"))
  (? (! (c.ct_eq m[4..] (c.hmac hash (expand_label hash chs "finished" "" hl) (hf th)))) (sfail conn 51 "client Finished does not verify"))
  (install_read conn cap)
  conn.sni=h.sni conn.open=true
  conn)
; ---- TLS 1.2 client
(= (sh_parse m)                         ; ServerHello -> {:random :suite :exts [[type body] ..]}
  b=m[4..] i=35+(by1 b 34)
  suite=(by2 b i) i+=3
  exts=[]
  (? i<#b (: end=i+2+(by2 b i) i+=2 (wh i<end (push exts [(by2 b i) b[i+4..i+4+(by2 b i+2)]]) i+=4+(by2 b i+2))))
  {:random b[2..34] :suite suite :exts exts})
(= (suite12 n)                          ; -> [aead key-length iv-length prf-hash key-type]
  (sw n 49195 ["aes" 16 4 "sha256" "ec"] 49196 ["aes" 32 4 "sha384" "ec"] 49199 ["aes" 16 4 "sha256" "rsa"] 49200 ["aes" 32 4 "sha384" "rsa"]
        52393 ["chacha" 32 12 "sha256" "ec"] 52392 ["chacha" 32 12 "sha256" "rsa"] nil))
(= (sigalg12_of v)
  (sw v 1025 "rsa_pkcs1_sha256" 1281 "rsa_pkcs1_sha384" 2052 "rsa_pss_sha256" 2053 "rsa_pss_sha384" 1027 "ecdsa_sha256" 1283 "ecdsa_sha384" nil))
(= (prf hname secret label seed n)
  sd=(++ label seed) a=sd out=""
  (wh #out<n a=(c.hmac hname secret a) out+=(c.hmac hname secret (++ a sd)))
  out[..n])
(= (parse_certs12 m)                    ; Certificate message -> list of DER strings
  b=m[4..] total=65536*(by1 b 0)+(by2 b 1) i=3 out=[]
  (? total+3>#b (tfail "malformed Certificate"))
  (wh i<total+3 cl=65536*(by1 b i)+(by2 b i+1) (push out b[i+3..i+3+cl]) i+=3+cl)
  out)
(= (snd conn x) (rec_send conn 22 x) x)
(= (hs12 conn host opts cc ch sh priv pub)
  s=(sh_parse sh)
  (? (has ["DOWNGRD\x01" "DOWNGRD\x00"] s.random[24..]) (tfail "downgrade attack detected: the server supports TLS 1.3 but answered with 1.2"))
  su=(suite12 s.suite)
  (? ($isnil su) (tfail "server chose a cipher suite that was not offered"))
  [aead klen ivlen hname ktype]=su
  conn.v12=true
  hf=(c.hashfn hname) cr=ch[6..38]
  ems=(any e=>e[0]==23 s.exts)
  alpn=(k.first (~? e=>e[0]==16 s.exts))
  (? alpn (: conn.alpn=alpn[1][3..3+(by1 alpn[1] 2)] (? (! (has (?? opts.alpn []) conn.alpn)) (tfail "the server chose an ALPN protocol that was not offered"))))
  th=(++ ch sh)
  m=(hs_next conn)
  (? ($ldb m 0)!=11 (tfail "expected Certificate"))
  th+=m ders=(parse_certs12 m)
  (? (! #ders) (tfail "the server sent no certificate"))
  leaf=(try (k.check_chain ders host (?? opts.roots k.trust_roots()) (flr (/ (now) 1000))) e=>(tfail e))
  conn.peer=leaf
  (? (!= leaf.key.type ktype) (tfail "the certificate key does not fit the cipher suite"))
  m=(hs_next conn)
  (? ($ldb m 0)!=12 (tfail "expected ServerKeyExchange"))
  th+=m b=m[4..]
  grp=(by2 b 1) pl=(by1 b 3) cvc=(k.curve_by_id grp)
  (? (|| (!= (by1 b 0) 3) (&& (!= grp 29) ($isnil cvc)) (!= pl (? (== grp 29) 32 1+2*(?? cvc.bytes 0)))) (tfail "unsupported key exchange group"))
  point=b[4..4+pl] alg=(sigalg12_of (by2 b 4+pl))
  (? (|| ($isnil alg) (!= (starts alg "ecdsa") (== ktype "ec"))) (tfail "unsupported signature algorithm in ServerKeyExchange"))
  (? (! (k.verify_sig leaf.key alg (++ cr s.random b[..4+pl]) b[8+pl..8+pl+(by2 b 6+pl)])) (tfail "server signature (ServerKeyExchange) is invalid"))
  m=(hs_next conn)
  req=nil
  (? ($ldb m 0)==13 (: req=m th+=m m=(hs_next conn)))
  (? ($ldb m 0)!=14 (tfail "expected ServerHelloDone"))
  th+=m
  mine=pub pms=nil
  (? (== grp 29)
     (: pms=(c.x25519 priv point)
        (? (== pms (rpt "\0" 32)) (tfail "bad key share")))
     (: pr=(k.ecdh_pair cvc) mine=pr[1] pms=(try (k.ecdh cvc pr[0] point) e=>(tfail e))))
  (? req
     (: rb=req[4..] tl=(by1 rb 0) ralgs=(by2s rb 3+tl (by2 rb 1+tl))
        alg=(? cc (k.first (~? x=>(has ralgs x) cc.algs)) nil)
        list=(? alg (join (~ d=>(++ (be #d 3) d) cc.ders) "") "")
        th+=(snd conn (hmsg 11 (++ (be #list 3) list)))))
  th+=(snd conn (hmsg 16 (++ (frombytes [#mine]) mine)))
  master=(prf hname pms (? ems "extended master secret" "master secret") (? ems (hf th) (++ cr s.random)) 48)
  (? (&& req alg)
     (: sig=(k.sign cc.key (sigalg12_of alg) th)
        th+=(snd conn (hmsg 15 (++ (be alg 2) (be #sig 2) sig)))))
  kb=(prf hname master "key expansion" (++ s.random cr) 2*klen+2*ivlen)
  (rec_send conn 20 "\x01")
  conn.suite=aead
  conn.wkey=kb[..klen] conn.wiv=kb[2*klen..2*klen+ivlen] conn.wseq=0
  th+=(snd conn (hmsg 20 (prf hname master "client finished" (hf th) 12)))
  r=(rec_recv conn)
  (? r[0]==21 (tfail (alert_text ($ldb r[1] 1))))
  (? r[0]!=20 (tfail "expected ChangeCipherSpec"))
  conn.rkey=kb[klen..2*klen] conn.riv=kb[2*klen+ivlen..2*klen+2*ivlen] conn.rseq=0
  m=(hs_next conn)
  (? ($ldb m 0)!=20 (tfail "expected Finished"))
  (? (! (c.ct_eq m[4..] (prf hname master "server finished" (hf th) 12))) (tfail "server Finished does not verify"))
  conn.open=true
  conn)
