; A TLS 1.3 client in Ak (native target), built on crypto.aklang and pki.aklang.
;   (use "lib/tls.aklang" as t)
;   conn=(t.connect host port)            TCP connect + handshake; verifies the server certificate chain and host name, raises on any failure
;   conn=(t.connect host port {:roots roots :ms 5000})   :roots = parsed CA certificates to trust instead of the system bundle; :ms = TCP connect timeout
;   (t.read conn n=16384)                 up to n plain bytes; "" at end of stream (close_notify or the peer closed)
;   (t.write conn s)  (t.close conn)  (t.fd conn)   (t.fd is the socket, for fdwait)
; (t.read) returns "" at the end; conn.truncated is true when the peer hung up without close_notify (many servers do), so data without its own length framing may be cut short.
; TLS 1.3 only, x25519 key exchange, TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384 and TLS_CHACHA20_POLY1305_SHA256; no client certificates, no session resumption, no 0-RTT.
(use "crypto.aklang" as c)
(use "pki.aklang" as k)
(= (be n w) (? w>4 (++ (be (flr (/ n 4294967296)) w-4) (be (% n 4294967296) 4)) (frombytes (~ i=>(& (>>> n (* 8 (- w 1 i))) 255) 0..w))))
(= (alert_text n)
  (++ "alert " (tostr n)
      (sw n 10 " (unexpected_message)" 20 " (bad_record_mac)" 40 " (handshake_failure)" 42 " (bad_certificate)" 43 " (unsupported_certificate)" 44 " (certificate_revoked)" 45 " (certificate_expired)" 46 " (certificate_unknown)" 47 " (illegal_parameter)" 48 " (unknown_ca)" 50 " (decode_error)" 51 " (decrypt_error)"
          70 " (protocol_version): the server does not support TLS 1.3" 71 " (insufficient_security)" 80 " (internal_error)" 109 " (missing_extension)" 112 " (unrecognized_name)" 116 " (certificate_required)" 120 " (no_application_protocol)" "")))
(= (tfail msg) (raise "io" (++ "tls: " msg) nil))
(= (rdn conn n eof_ok=false)            ; exactly n bytes from the socket; nil if the peer closed cleanly before the first byte and eof_ok is set
  buf=conn.inbuf eof=false
  (wh (&& #buf<n (! eof)) d=(fdr conn.fd 65536) (? d=="" eof=true buf+=d))
  (? eof (? (&& eof_ok #buf==0) nil (tfail "connection closed during the handshake or in the middle of a record"))
     (: conn.inbuf=buf[n..] buf[..n])))
(= (rec_send conn type body)            ; one record, encrypted when keys are installed
  (? conn.wkey
     (: inner=(++ body (frombytes [type]))
        hdr=(++ "\x17\x03\x03" (be #inner+16 2))
        ct=(aead_seal conn conn.wkey conn.wiv conn.wseq hdr inner)
        conn.wseq=conn.wseq+1
        (fdw conn.fd (++ hdr ct)))
     (fdw conn.fd (++ (frombytes [type]) (? (== type 22) "\x03\x01" "\x03\x03") (be #body 2) body))))
(= (nonce iv seq) (c.xor iv (++ (rpt "\0" 4) (be seq 8))))
(= (aead_seal conn key iv seq aad data)
  n=(nonce iv seq)
  (? (== conn.suite "aes") (c.aes_gcm_seal key n aad data) (c.chacha_seal key n aad data)))
(= (aead_open conn key iv seq aad data)
  n=(nonce iv seq)
  (? (== conn.suite "aes") (c.aes_gcm_open key n aad data) (c.chacha_open key n aad data)))
(= (rec_recv conn)                      ; [type body] of the next record (decrypted when keys are installed)
  h=(rdn conn 5 conn.open)
  (? ($isnil h) [0 ""] (rec_body conn h)))
(= (rec_body conn h)
  type=($ldb h 0) len=256*($ldb h 3)+($ldb h 4)
  (? len>16640 (tfail "record too large"))
  body=(rdn conn len)
  (? (&& conn.rkey (== type 23))
     (: pt=(aead_open conn conn.rkey conn.riv conn.rseq h body)
        (? ($isnil pt) (tfail "bad record MAC"))
        conn.rseq=conn.rseq+1
        j=#pt-1 (wh (&& j>=0 ($ldb pt j)==0) j-=1)
        (? j<0 (tfail "empty record"))
        [($ldb pt j) pt[..j]])
     [type body]))
; ---- key schedule
(= (label hash lab ctx n) (++ (be n 2) (frombytes [6+#lab]) "tls13 " lab (frombytes [#ctx]) ctx))
(= (expand_label hash secret lab ctx n) (c.hkdf_expand hash secret (label hash lab ctx n) n))
(= (derive hash secret lab th) (expand_label hash secret lab th (c.hashlen hash)))
(= (traffic conn hash secret)           ; -> [key iv]
  [(expand_label hash secret "key" "" conn.klen) (expand_label hash secret "iv" "" 12)])
(= (install_read conn secret) kv=(traffic conn conn.hash secret) conn.rkey=kv[0] conn.riv=kv[1] conn.rseq=0 conn.rsecret=secret)
(= (install_write conn secret) kv=(traffic conn conn.hash secret) conn.wkey=kv[0] conn.wiv=kv[1] conn.wseq=0 conn.wsecret=secret)
; ---- handshake messages
(= (ext type body) (++ (be type 2) (be #body 2) body))
(= (client_hello host pub random sid)
  exts=(++
    (? (dotted host) "" (ext 0 (let (nm (++ "\x00" (be #host 2) host)) (++ (be #nm 2) nm))))
    (ext 10 (++ "\x00\x02\x00\x1d"))
    (ext 13 (let (sa (c.unhex "0804080508060403050306030401050106010201")) (++ (be #sa 2) sa)))
    (ext 43 "\x02\x03\x04")
    (ext 51 (let (ks (++ "\x00\x1d\x00\x20" pub)) (++ (be #ks 2) ks))))
  suites=(c.unhex "130113021303")
  body=(++ "\x03\x03" random (frombytes [#sid]) sid (be #suites 2) suites "\x01\x00" (be #exts 2) exts)
  (++ "\x01" (be #body 3) body))
(= (parse_server_hello conn m)
  (? ($ldb m 0)!=2 (tfail "expected ServerHello"))
  body=m[4..] i=2+32
  sidlen=($ldb body i) i+=1+sidlen
  suite=256*($ldb body i)+($ldb body i+1) i+=3
  extlen=256*($ldb body i)+($ldb body i+1) i+=2
  (? (== body[2..34] (c.unhex "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c")) (tfail "server asked for a different key exchange group (HelloRetryRequest), which is not supported"))
  share=nil ver=nil end=i+extlen
  (wh i<end
    et=256*($ldb body i)+($ldb body i+1) el=256*($ldb body i+2)+($ldb body i+3) eb=body[i+4..i+4+el]
    (? et==51 (: (? (!= 256*($ldb eb 0)+($ldb eb 1) 29) (tfail "unsupported key exchange group")) share=eb[4..36]))
    (? et==43 ver=256*($ldb eb 0)+($ldb eb 1))
    i+=4+el)
  (? (!= ver 772) (tfail "server did not negotiate TLS 1.3"))
  (? ($isnil share) (tfail "no key share in ServerHello"))
  (sw suite
    4865 (: conn.hash="sha256" conn.klen=16 conn.suite="aes")
    4866 (: conn.hash="sha384" conn.klen=32 conn.suite="aes")
    4867 (: conn.hash="sha256" conn.klen=32 conn.suite="chacha")
    (tfail "server chose a cipher suite that was not offered"))
  share)
(= (hs_next conn)                       ; next whole handshake message (header included); also adds it to the transcript when keep is set
  (wh (< #conn.hsbuf 4)
    r=(rec_recv conn)
    (? r[0]==20 nil
       r[0]==21 (tfail (alert_text ($ldb r[1] 1)))
       r[0]==22 conn.hsbuf+=r[1]
       (tfail "unexpected record during the handshake")))
  n=4+65536*($ldb conn.hsbuf 1)+256*($ldb conn.hsbuf 2)+($ldb conn.hsbuf 3)
  (wh (< #conn.hsbuf n)
    r=(rec_recv conn)
    (? r[0]==22 conn.hsbuf+=r[1] (tfail "unexpected record inside a handshake message")))
  m=conn.hsbuf[..n] conn.hsbuf=conn.hsbuf[n..]
  m)
(= (parse_certs m)                      ; Certificate message -> list of DER strings
  body=m[4..] ctxlen=($ldb body 0) i=1+ctxlen
  total=65536*($ldb body i)+256*($ldb body i+1)+($ldb body i+2) i+=3
  out=[] end=i+total
  (wh i<end
    cl=65536*($ldb body i)+256*($ldb body i+1)+($ldb body i+2)
    (push out body[i+3..i+3+cl])
    el=256*($ldb body i+3+cl)+($ldb body i+4+cl)
    i+=5+cl+el)
  out)
(= (sigalg_of v)
  (sw v 2052 "rsa_pss_sha256" 2053 "rsa_pss_sha384" 1027 "ecdsa_sha256" 1283 "ecdsa_sha384" nil))
(= (connect host port opts=nil)
  opts=(?? opts {})
  fd=(tcpc host port opts.ms)
  conn={:fd fd :inbuf "" :hsbuf "" :plain "" :eof false :rkey nil :wkey nil :rseq 0 :wseq 0}
  (try (handshake conn host opts) e=>(: (fdc fd) (raise "io" e nil)))
  conn)
(= (handshake conn host opts)
  priv=(c.random 32) pub=(c.x25519_base priv) sid=(c.random 32)
  ch=(client_hello host pub (c.random 32) sid)
  (rec_send conn 22 ch)
  (rec_send conn 20 "\x01")             ; compatibility ChangeCipherSpec
  conn.hash="sha256"
  sh=(hs_next conn)
  share=(parse_server_hello conn sh)
  hash=conn.hash
  shared=(c.x25519 priv share)
  (? (== shared (rpt "\0" 32)) (tfail "bad key share"))
  th=(++ ch sh)
  zeros=(rpt "\0" (c.hashlen hash))
  early=(c.hkdf_extract hash "" zeros)
  hs=(c.hkdf_extract hash (derive hash early "derived" ((c.hashfn hash) "")) shared)
  chs=(derive hash hs "c hs traffic" ((c.hashfn hash) th))
  shs=(derive hash hs "s hs traffic" ((c.hashfn hash) th))
  (install_read conn shs) (install_write conn chs)
  hf=(c.hashfn hash)
  m=(hs_next conn)
  (? ($ldb m 0)!=8 (tfail "expected EncryptedExtensions"))
  th+=m
  m=(hs_next conn)
  (? ($ldb m 0)==13 (tfail "the server asks for a client certificate, which is not supported"))
  (? ($ldb m 0)!=11 (tfail "expected Certificate"))
  th+=m
  ders=(parse_certs m)
  (? (! #ders) (tfail "the server sent no certificate"))
  leaf=(try (k.check_chain ders host (?? opts.roots k.trust_roots()) (flr (/ (now) 1000))) e=>(tfail e))
  tcv=(hf th)
  m=(hs_next conn)
  (? ($ldb m 0)!=15 (tfail "expected CertificateVerify"))
  alg=(sigalg_of 256*($ldb m 4)+($ldb m 5))
  (? ($isnil alg) (tfail "unsupported signature algorithm in CertificateVerify"))
  sl=256*($ldb m 6)+($ldb m 7) sig=m[8..8+sl]
  signed=(++ (rpt " " 64) "TLS 1.3, server CertificateVerify\x00" tcv)
  (? (! (k.verify_sig leaf.key alg signed sig)) (tfail "server signature (CertificateVerify) is invalid"))
  th+=m
  fin_key=(expand_label hash shs "finished" "" (c.hashlen hash))
  want=(c.hmac hash fin_key (hf th))
  m=(hs_next conn)
  (? ($ldb m 0)!=20 (tfail "expected Finished"))
  (? (! (c.ct_eq m[4..] want)) (tfail "server Finished does not verify"))
  th+=m
  ap_th=(hf th)
  cap=(derive hash (c.hkdf_extract hash (derive hash hs "derived" (hf "")) zeros) "c ap traffic" ap_th)
  sap=(derive hash (c.hkdf_extract hash (derive hash hs "derived" (hf "")) zeros) "s ap traffic" ap_th)
  cfk=(expand_label hash chs "finished" "" (c.hashlen hash))
  cf=(c.hmac hash cfk (hf th))
  (rec_send conn 22 (++ "\x14" (be #cf 3) cf))
  (install_write conn cap) (install_read conn sap)
  conn.open=true
  conn)
(= (read conn n=16384)
  (wh (&& (== #conn.plain 0) (! conn.eof))
    r=(rec_recv conn)
    (sw r[0]
      23 conn.plain=r[1]
      21 (? (&& #r[1]>=2 ($ldb r[1] 1)==0) conn.eof=true (tfail (alert_text ($ldb r[1] 1))))
      22 (post_handshake conn r[1])
      20 nil
      0 (: conn.eof=true conn.truncated=true)
      (tfail "unexpected record type")))
  d=conn.plain[..n] conn.plain=conn.plain[#d..]
  d)
(= (post_handshake conn body)           ; NewSessionTicket is ignored; KeyUpdate re-keys
  i=0
  (wh i+4<=#body
    ty=($ldb body i) l=65536*($ldb body i+1)+256*($ldb body i+2)+($ldb body i+3)
    (? ty==24
       (: conn.rsecret=(expand_label conn.hash conn.rsecret "traffic upd" "" (c.hashlen conn.hash))
          (install_read conn conn.rsecret)
          (? ($ldb body i+4)==1
             (: (rec_send conn 22 "\x18\x00\x00\x01\x00")
                conn.wsecret=(expand_label conn.hash conn.wsecret "traffic upd" "" (c.hashlen conn.hash))
                (install_write conn conn.wsecret)))))
    i+=4+l))
(= (write conn s)
  s=(? (islist s) (frombytes s) (tostr s)) i=0
  (wh i<#s (rec_send conn 23 s[i..(min i+16384 #s)]) i+=16384)
  nil)
(= (close conn)
  (try (rec_send conn 21 "\x01\x00") e=>nil)
  (fdc conn.fd) nil)
(= (fd conn) conn.fd)
