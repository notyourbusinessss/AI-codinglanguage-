lcs a b = n=#a m=#b t=(~ i=>rpt([0] m+1) 0..=n) (for i 1..=n (for j 1..=m t[i j]=(? a[i-1]==b[j-1] 1+t[i-1 j-1] max(t[i-1 j] t[i j-1])))) t[n m]
edit a b =
 p=0..=#b
 for i 1..=#a c=[i] (for j 1..=#b push(c min(1+p[j] 1+c[j-1] p[j-1]+(a[i-1]!=b[j-1])))) p=c
 lst p
p lcs("AGGTAB" "GXTXAYB") edit("kitten" "sitting")
