(= (gcd a b) (? (== b 0) a (gcd b (% a b))))
(= (prime? n)
  (& (>= n 2)
     (let (i 2 ok T)
       (wh (& ok (<= (* i i) n))
         (? (== 0 (% n i)) (<- ok F))
         (<- i (+ i 1)))
       ok)))
(p (gcd 48 18) (gcd 17 5))
(p (join (~? prime? (.. 2 50)) " "))
(p (sum (~? prime? (.. 2 1000))))
