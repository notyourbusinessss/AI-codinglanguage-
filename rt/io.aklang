; Native runtime part 5: files, process, time. Linux x86-64 syscalls via $syscall.
(= (cstr s) (? (! (isstr s)) ($throwk 3 (strcat2 "path must be a string, got " (ty s)))) n=($hlen s) r=(strnew n+1) ($copy r 0 s 0 n) r)
(= (cpeek addr) n=0 (wh (> ($peek addr+n) 0) n+=1)
  r=(strnew n) (for i n ($stb r i ($peek addr+i))) r)
(= (readfd2 fd)                     ; the whole input as a string, or the negative errno of a failed read (EINTR is retried; only 0 is end of file)
  cap=65536 buf=(strnew cap) len=0 done=false err=0
  (wh (! done)
    (? len==cap (: nb=(strnew cap*2) ($copy nb 0 buf 0 len) buf=nb cap*=2))
    r=($syscall 0 fd ($addr buf)+len cap-len)
    (? r==-4 nil r==0 done=true r<0 (: err=r done=true) len+=r))
  (? err<0 err (strslice buf 0 len)))
(= (readfd fd) s=(readfd2 fd) (? ($isnum s) ($throwk 4 (strcat2 "read failed, errno " (fmtint 0-s))) s))
(= (rd f)
  fd=($syscall 2 ($addr (cstr f)) 0 0)
  (? fd<0 ($throwk 4 (strcat2 "cannot read " f)))
  s=(readfd2 fd) ($syscall 3 fd)
  (? ($isnum s) ($throwk 4 (strcat2 (strcat2 "cannot read " f) (strcat2 ", errno " (fmtint 0-s))))) s)
(= (wrfile f s flags mode)
  fd=($syscall 2 ($addr (cstr f)) flags mode)
  (? fd<0 ($throwk 4 (strcat2 "cannot write " f)))
  d=(? (islist s) (frombytes s) (istyped s) s (tostr s))
  e=(rawwrite fd d ($hlen d)) ($syscall 3 fd)
  (? e<0 ($throwk 4 (strcat2 (strcat2 "cannot write " f) (strcat2 ", errno " (fmtint 0-e))))) s)
(= (wr f s) (wrfile f s 577 420))
(= (app f s) (wrfile f s 1089 420))
(= (wrx f s) (wrfile f s 577 493) ($syscall 90 ($addr (cstr f)) 493) s)
(= (ex f) (== ($syscall 21 ($addr (cstr f)) 0) 0))
(= (ls d=nil)
  d=(?? d ".") fd=($syscall 2 ($addr (cstr d)) 65536 0)
  (? fd<0 ($throwk 4 (strcat2 "cannot list " d)))
  buf=($newb 8 32768 32768) r=(mklist 16) done=false
  (wh (! done)
    n=($syscall 217 fd ($addr buf) 32768)
    (? n<=0 done=true
       (: o=0
          (wh o<n
            reclen=(($ldb buf o+16)+256*($ldb buf o+17)) e=o+19 m=0
            (wh (> ($ldb buf e+m) 0) m+=1)
            name=(strnew m) ($copy name 0 buf e m)
            (? (&& (! (streq name ".")) (! (streq name ".."))) (lpush r name))
            o+=reclen))))
  ($syscall 3 fd) (sort r))
(= (args) n=($argc) r=(mklist n) (for i 1..n (lpush r (cpeek ($argv i)))) r)
(= (env k)
  (? ($isnil k)
     (: m=(map) i=(+ ($argc) 1) (wh (> ($argv i) 0) kv=(cpeek ($argv i)) j=(strfind kv "=" 0) (? j>0 (mapset m (strslice kv 0 j) (strslice kv j+1 #kv))) i+=1) m)
     (: k=(tostr k) i=(+ ($argc) 1) pre=(strcat2 k "=") n=#pre r=nil
        (wh (&& ($isnil r) (> ($argv i) 0))
          a=($argv i) (? (envmatch a pre n) (: kv=(cpeek a) r=(strslice kv n #kv))) i+=1)         ; compare in place; only the matching entry is copied
        r)))
(= (envmatch a pre n) i=0 (wh (&& i<n (== ($peek a+i) ($ldb pre i))) i+=1) i==n)
(= (ru64 buf w) (+ (* ($bitshi ($ldw buf w)) 4294967296) ($bitslo ($ldw buf w))))
(= (now) buf=($newb 8 16 16) ($syscall 228 0 ($addr buf))
  (+ (* (ru64 buf 1) 1000) ($ffloor ($fdiv (ru64 buf 2) 1000000))))
(= (clock) buf=($newb 8 16 16) ($syscall 228 1 ($addr buf))
  (+ (* (ru64 buf 1) 1000) ($fdiv (ru64 buf 2) 1000000)))
(= (sleep ms) buf=($newb 8 16 16)
  ($stw buf 1 ($frombits 0 ($ffloor ($fdiv ms 1000)))) ($stw buf 2 ($frombits 0 (* (% ms 1000) 1000000)))
  ($syscall 35 ($addr buf) 0) nil)
; stdin: buffered line reader
IBUF=nil
IPOS=0
IEOF=false
(= (infill) (flush)
  b=($newb 1 65536 65536) r=($syscall 0 0 ($addr b) 65536)
  (? r<=0 (<- IEOF true)
     (: rest=(? ($isnil IBUF) "" (strslice IBUF IPOS #IBUF)) (<- IBUF (strcat2 rest (strslice b 0 r))) (<- IPOS 0))))
(= (in) (flush)
  (? ($isnil IBUF) (<- IBUF ""))
  line=nil
  (wh (&& ($isnil line))
    j=(strfind IBUF "\n" IPOS)
    (? j>=0 (: line=(strslice IBUF IPOS j) (<- IPOS j+1))
       IEOF (: (? IPOS<#IBUF (: line=(strslice IBUF IPOS #IBUF) (<- IPOS #IBUF)) line=false))
       (infill)))
  (? (== line false) nil
     (: n=#line (? (&& n>0 (== ($ldb line n-1) 13)) (strslice line 0 n-1) line))))
(= (inall) (flush)
  rest=(? ($isnil IBUF) "" (strslice IBUF IPOS #IBUF))
  s=(? IEOF rest (? ($hlen rest)==0 (readfd 0) (strcat2 rest (readfd 0))))      ; one doubling read loop (appending 64 KB chunks one by one copied the whole input each time)
  (<- IEOF true) (<- IBUF "") (<- IPOS 0) s)

; ---- runx: run an executable image (string or byte list) with arguments; replaces this process (memfd + execve, no temp files)
(= (scratch) ($syscall 9 0 1048576 3 16418 -1 0))
(= (putstr mem off s) (for i #s ($poke mem+off+i ($ldb s i))) ($poke mem+off+#s 0) off+#s+1)
(= (put64 addr n) hi=($ffloor ($fdiv n 4294967296)) ($pokew addr ($frombits hi ($fsub n ($fmul hi 4294967296)))))
(= (runx bytes args)
  bytes=(? (islist bytes) (frombytes bytes) bytes)
  fd=($syscall 319 ($addr (cstr "ak")) 0)
  (? fd<0 ($throwk 4 "memfd_create failed"))
  (? (rawwrite fd bytes ($hlen bytes))<0 ($throwk 4 "runx: writing the image failed"))
  mem=(scratch) n=#args+1 off=8*(n+1)
  path=(++ "/proc/self/fd/" fd)
  pathoff=off off=(putstr mem off path)
  ptrs=[pathoff]
  (for a args (push ptrs off) off=(putstr mem off a))
  (for i #ptrs (put64 mem+8*i mem+ptrs[i]))
  (put64 mem+8*#ptrs 0)
  (flush)
  ($syscall 59 mem+pathoff mem ($envp))
  ($throwk 4 "exec failed"))

; ---- file system helpers (rm mkdir mv isdir) and subprocesses (sh)
(= (statmode path)                     ; st_mode of path, or -1
  buf=(scratch)
  (? (< ($syscall 4 ($addr (cstr path)) buf) 0) -1
     (+ ($peek buf+24) (* 256 ($peek buf+25)) (* 65536 ($peek buf+26)))))
(= (isdir p) m=(statmode p) (&& (>= m 0) (== ($band m 61440) 16384)))
(= (rm p)
  m=(statmode p)
  (? (< m 0) nil
     (: (? (== ($band m 61440) 16384)
           (: (for f (ls p) (rm (strcat2 (strcat2 p "/") f)))
              ($syscall 84 ($addr (cstr p))))
           ($syscall 87 ($addr (cstr p))))
        nil)))
(= (mkdir p)
  (? (isdir p) nil
     (: i=1 n=#p
        (wh i<=n
          (? (|| i==n (== ($ldb p i) 47))
             (: q=(strslice p 0 i) (? (&& (> #q 0) (! (isdir q))) ($syscall 83 ($addr (cstr q)) 493))))
          i+=1)
        nil)))
(= (mv a b) (? (< ($syscall 82 ($addr (cstr a)) ($addr (cstr b))) 0) ($throwk 4 (strcat2 (strcat2 (strcat2 "cannot rename " a) " to ") b))) nil)
(= (selfexe) buf=(scratch) n=($syscall 89 ($addr (cstr "/proc/self/exe")) buf 4096) (? n<=0 ($throwk 4 "cannot find the ak executable"))
  s=(strnew n) (for i n ($stb s i ($peek buf+i))) s)
(= (sh cmd)
  (flush)
  mem=(scratch) cmd=(tostr cmd)
  o1=(putstr mem 2048 "/bin/sh") o2=(putstr mem o1 "sh") o3=(putstr mem o2 "-c") o4=(putstr mem o3 cmd)
  (put64 mem+256 mem+o1) (put64 mem+264 mem+o2) (put64 mem+272 mem+o3) (put64 mem+280 0)
  ($syscall 293 mem+512 0)
  rfd=(+ ($peek mem+512) (* 256 ($peek mem+513))) wfd=(+ ($peek mem+516) (* 256 ($peek mem+517)))
  pid=($syscall 57)
  (? pid==0 (: ($syscall 33 wfd 1) ($syscall 3 rfd) ($syscall 3 wfd)
               ($syscall 59 mem+2048 mem+256 ($envp)) ($syscall 231 127)))
  ($syscall 3 wfd)
  out=(readfd rfd) ($syscall 3 rfd)
  ($syscall 61 pid mem+520 0 0)
  st=(+ ($peek mem+520) (* 256 ($peek mem+521)))
  code=($band ($ushr st 8) 255)
  (? (|| (!= code 0) (!= ($band st 127) 0)) ($throwk 4 (strcat2 (strcat2 (strcat2 (strcat2 "sh failed (" (fmtint code)) "): ") cmd) "")))
  out)
