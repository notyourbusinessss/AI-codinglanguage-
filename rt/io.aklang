; Native runtime part 5: files, process, time. Linux x86-64 syscalls via $syscall.
(= (cstr s) (? (! (isstr s)) ($throwk 3 (strcat2 "path must be a string, got " (ty s)))) n=($hlen s) r=(strnew n+1) ($copy r 0 s 0 n) r)
(= (errtext n)                      ; short reason for a positive errno
  (? n==2 "no such file or directory" n==13 "permission denied" n==21 "is a directory" n==20 "not a directory" n==17 "file exists"
     n==28 "no space left on device" n==30 "read-only file system" n==39 "directory not empty" n==1 "operation not permitted"
     n==36 "file name too long" n==24 "too many open files" n==40 "too many levels of symbolic links" n==18 "cross-device link" n==5 "input/output error"
     (strcat2 "errno " (fmtint n))))
(= (ioerr what p r) ($throwk 4 (strcat2 (strcat2 (strcat2 what " ") p) (strcat2 ": " (errtext 0-r)))))      ; "cannot read /x: no such file or directory" (r = the negative errno of the failed syscall)
(= (cpeek addr) n=0 (wh (> ($peek addr+n) 0) n+=1)
  r=(strnew n) (for i n ($stb r i ($peek addr+i))) r)
(= (readfd2 fd)                     ; the whole input as a string, or the negative errno of a failed read (EINTR is retried; only 0 is end of file)
  cap=65536 buf=(strnew cap) len=0 done=false err=0
  (wh (! done)
    (? len==cap (: nb=(strnew cap*2) ($copy nb 0 buf 0 len) buf=nb cap*=2))
    r=($syscall 0 fd ($addr buf)+len cap-len)
    (? r==-4 nil r==0 done=true r<0 (: err=r done=true) len+=r))
  (? err<0 err (strslice buf 0 len)))
(= (readfd fd) s=(readfd2 fd) (? ($isnum s) ($throwk 4 (strcat2 "read failed, errno " (fmtint 0-s))) s))
(= (rd f)
  fd=($syscall 2 ($addr (cstr f)) 524288 0)
  (? fd<0 (ioerr "cannot read" f fd))
  s=(readfd2 fd) ($syscall 3 fd)
  (? ($isnum s) (ioerr "cannot read" f s)) s)
(= (wrfile f s flags mode)
  fd=($syscall 2 ($addr (cstr f)) flags+524288 mode)
  (? fd<0 (ioerr "cannot write" f fd))
  d=(? (islist s) (frombytes s) (istyped s) s (tostr s))
  e=(rawwrite fd d ($hlen d)) ($syscall 3 fd)
  (? e<0 (ioerr "cannot write" f e)) s)
(= (wr f s) (wrfile f s 577 420))
(= (app f s) (wrfile f s 1089 420))
(= (wrx f s) (wrfile f s 577 493) ($syscall 90 ($addr (cstr f)) 493) s)
(= (ex f) (== ($syscall 21 ($addr (cstr f)) 0) 0))
(= (ls d=nil)
  d=(?? d ".") fd=($syscall 2 ($addr (cstr d)) 589824 0)
  (? fd<0 (ioerr "cannot list" d fd))
  buf=($newb 8 32768 32768) r=(mklist 16) done=false
  (wh (! done)
    n=($syscall 217 fd ($addr buf) 32768)
    (? n<=0 done=true
       (: o=0
          (wh o<n
            reclen=(($ldb buf o+16)+256*($ldb buf o+17)) e=o+19 m=0
            (wh (> ($ldb buf e+m) 0) m+=1)
            name=(strnew m) ($copy name 0 buf e m)
            (? (&& (! (streq name ".")) (! (streq name ".."))) (lpush r name))
            o+=reclen))))
  ($syscall 3 fd) (sort r))
(= (args) n=($argc) r=(mklist n) (for i 1..n (lpush r (cpeek ($argv i)))) r)
(= (env k)
  (? ($isnil k)
     (: m=(map) i=(+ ($argc) 1) (wh (> ($argv i) 0) kv=(cpeek ($argv i)) j=(strfind kv "=" 0) (? j>0 (mapset m (strslice kv 0 j) (strslice kv j+1 #kv))) i+=1) m)
     (: k=(tostr k) i=(+ ($argc) 1) pre=(strcat2 k "=") n=#pre r=nil
        (wh (&& ($isnil r) (> ($argv i) 0))
          a=($argv i) (? (envmatch a pre n) (: kv=(cpeek a) r=(strslice kv n #kv))) i+=1)         ; compare in place; only the matching entry is copied
        r)))
(= (envmatch a pre n) i=0 (wh (&& i<n (== ($peek a+i) ($ldb pre i))) i+=1) i==n)
(= (ru64 buf w) (+ (* ($bitshi ($ldw buf w)) 4294967296) ($bitslo ($ldw buf w))))
(= (now) buf=($newb 8 16 16) ($syscall 228 0 ($addr buf))
  (+ (* (ru64 buf 1) 1000) ($ffloor ($fdiv (ru64 buf 2) 1000000))))
(= (clock) buf=($newb 8 16 16) ($syscall 228 1 ($addr buf))
  (+ (* (ru64 buf 1) 1000) ($fdiv (ru64 buf 2) 1000000)))
(= (sleep ms)
  (? (! (&& ($isnum ms) (>= ms 0) (<= ms 1099511627776))) ($throwk 3 (strcat2 "invalid sleep: " (show ms))))      ; NaN, negative, infinite and over 2^40 ms (about 35 years) are refused
  buf=($newb 8 32 32)
  ($stw buf 1 ($frombits 0 ($ffloor ($fdiv ms 1000)))) ($stw buf 2 ($frombits 0 (* (% ms 1000) 1000000)))
  (wh (== ($syscall 35 ($addr buf) ($addr buf)+16) -4)           ; a signal interrupted the sleep: go on with the time that is left
    ($stw buf 1 ($ldw buf 3)) ($stw buf 2 ($ldw buf 4)))
  nil)
; stdin: buffered line reader
IBUF=nil
IPOS=0
IEOF=false
(= (infill) (flush)
  b=($newb 1 65536 65536) r=($syscall 0 0 ($addr b) 65536)
  (? r<=0 (<- IEOF true)
     (: rest=(? ($isnil IBUF) "" (strslice IBUF IPOS #IBUF)) (<- IBUF (strcat2 rest (strslice b 0 r))) (<- IPOS 0))))
(= (in) (flush)
  (? ($isnil IBUF) (<- IBUF ""))
  line=nil
  (wh (&& ($isnil line))
    j=(strfind IBUF "\n" IPOS)
    (? j>=0 (: line=(strslice IBUF IPOS j) (<- IPOS j+1))
       IEOF (: (? IPOS<#IBUF (: line=(strslice IBUF IPOS #IBUF) (<- IPOS #IBUF)) line=false))
       (infill)))
  (? (== line false) nil
     (: n=#line (? (&& n>0 (== ($ldb line n-1) 13)) (strslice line 0 n-1) line))))
(= (inall) (flush)
  rest=(? ($isnil IBUF) "" (strslice IBUF IPOS #IBUF))
  s=(? IEOF rest (? ($hlen rest)==0 (readfd 0) (strcat2 rest (readfd 0))))      ; one doubling read loop (appending 64 KB chunks one by one copied the whole input each time)
  (<- IEOF true) (<- IBUF "") (<- IPOS 0) s)

; ---- runx: run an executable image (string or byte list) with arguments; replaces this process (memfd + execve, no temp files)
(= (scratch) ($syscall 9 0 1048576 3 16418 -1 0))
(= (putstr mem off s) (for i #s ($poke mem+off+i ($ldb s i))) ($poke mem+off+#s 0) off+#s+1)
(= (put64 addr n) hi=($ffloor ($fdiv n 4294967296)) ($pokew addr ($frombits hi ($fsub n ($fmul hi 4294967296)))))
(= (runx bytes args)
  bytes=(? (islist bytes) (frombytes bytes) bytes)
  fd=($syscall 319 ($addr (cstr "ak")) 0)
  (? fd<0 ($throwk 4 "memfd_create failed"))
  (? (rawwrite fd bytes ($hlen bytes))<0 ($throwk 4 "runx: writing the image failed"))
  mem=(scratch) n=#args+1 off=8*(n+1)
  path=(++ "/proc/self/fd/" fd)
  pathoff=off off=(putstr mem off path)
  ptrs=[pathoff]
  (for a args (push ptrs off) off=(putstr mem off a))
  (for i #ptrs (put64 mem+8*i mem+ptrs[i]))
  (put64 mem+8*#ptrs 0)
  (flush)
  ($syscall 59 mem+pathoff mem ($envp))
  ($throwk 4 "exec failed"))

; ---- file system helpers (rm mkdir mv isdir) and subprocesses (sh)
(= (statmode path follow=true)         ; st_mode of path (of the link itself when follow is false), or -1
  buf=(scratch)
  (? (< ($syscall (? follow 4 6) ($addr (cstr path)) buf) 0) -1
     (+ ($peek buf+24) (* 256 ($peek buf+25)) (* 65536 ($peek buf+26)))))
(= (isdir p) m=(statmode p) (&& (>= m 0) (== ($band m 61440) 16384)))
(= (rm p)                              ; a symbolic link is removed itself, never followed into its target
  m=(statmode p false)
  (? (< m 0) nil
     (: r=(? (== ($band m 61440) 16384)
             (: (for f (ls p) (rm (strcat2 (strcat2 p "/") f)))
                ($syscall 84 ($addr (cstr p))))
             ($syscall 87 ($addr (cstr p))))
        (? r<0 (ioerr "cannot remove" p r))
        nil)))
(= (mkdir p)
  (? (isdir p) nil                     ; first: isdir rejects a non-string
     (== #p 0) (ioerr "cannot create" p -2)
     (: i=1 n=#p
        (wh i<=n
          (? (|| i==n (== ($ldb p i) 47))
             (: q=(strslice p 0 i)
                (? (&& (> #q 0) (! (isdir q)))
                   (: r=($syscall 83 ($addr (cstr q)) 493) (? (&& (< r 0) (! (isdir q))) (ioerr "cannot create" p (? r==-17 -20 r)))))))
          i+=1)
        nil)))
(= (mv a b)
  r=($syscall 82 ($addr (cstr a)) ($addr (cstr b)))
  (? r<0 ($throwk 4 (strcat2 (strcat2 (strcat2 (strcat2 "cannot rename " a) " to ") b) (strcat2 ": " (errtext 0-r))))) nil)
(= (selfexe) buf=(scratch) n=($syscall 89 ($addr (cstr "/proc/self/exe")) buf 4096) (? n<=0 ($throwk 4 "cannot find the ak executable"))
  s=(strnew n) (for i n ($stb s i ($peek buf+i))) s)
(= (sh cmd)
  (flush)
  mem=(scratch) cmd=(tostr cmd)
  o1=(putstr mem 2048 "/bin/sh") o2=(putstr mem o1 "sh") o3=(putstr mem o2 "-c") o4=(putstr mem o3 cmd)
  (put64 mem+256 mem+o1) (put64 mem+264 mem+o2) (put64 mem+272 mem+o3) (put64 mem+280 0)
  ($syscall 293 mem+512 0)
  rfd=(+ ($peek mem+512) (* 256 ($peek mem+513))) wfd=(+ ($peek mem+516) (* 256 ($peek mem+517)))
  pid=($syscall 57)
  (? pid==0 (: ($syscall 33 wfd 1) ($syscall 3 rfd) ($syscall 3 wfd)
               ($syscall 59 mem+2048 mem+256 ($envp)) ($syscall 231 127)))
  ($syscall 3 wfd)
  out=(readfd rfd) ($syscall 3 rfd)
  ($syscall 61 pid mem+520 0 0)
  st=(+ ($peek mem+520) (* 256 ($peek mem+521)))
  code=($band ($ushr st 8) 255)
  sig=($band st 127)
  (? (!= sig 0) ($throwk 4 (strcat2 (strcat2 (strcat2 (strcat2 "sh killed by signal " (fmtint sig)) ": ") cmd) ""))
     (!= code 0) ($throwk 4 (strcat2 (strcat2 (strcat2 (strcat2 "sh failed (" (fmtint code)) "): ") cmd) "")))
  out)

; ---- run: a program without a shell, with stdin, stderr, exit code, environment and directory
(= (runmem) fd=($syscall 319 ($addr (cstr "run")) 0) (? fd<0 ($throwk 4 "run: cannot create a buffer")) fd)
(= (runread fd)                     ; everything a child wrote into the memfd
  ($syscall 8 fd 0 0) s=(readfd2 fd) ($syscall 3 fd)
  (? ($isnum s) ($throwk 4 (strcat2 "run: read failed, errno " (fmtint 0-s)))) s)
(= (runenv e)                       ; ["K=V" ..]: the current environment with the entries of e added (a nil value removes one)
  m=(env nil)
  (for [k v] e (? ($isnil v) (mapdel m (tostr k)) (mapset m (tostr k) (tostr v))))
  r=(mklist 32) (for [k v] m (lpush r (strcat2 (strcat2 k "=") v))) r)
(= (run argv opts=nil)
  (? (! (&& (islist argv) #argv>0 (all isstr argv))) ($throwk 3 "run: argv must be a non-empty list of strings"))
  opts=(?? opts (map))
  (? (! (ismap opts)) ($throwk 3 "run: options must be a map"))
  inp=(mapget opts "in") cwd=(mapget opts "cwd") ev=(mapget opts "env")
  (? (&& (! ($isnil inp)) (! (isstr inp)) (! (islist inp)) (! (istyped inp))) ($throwk 3 (strcat2 "run: :in must be a string, got " (ty inp))))
  (? (&& (! ($isnil cwd)) (! (isstr cwd))) ($throwk 3 "run: :cwd must be a string"))
  (? (&& (! ($isnil ev)) (! (ismap ev))) ($throwk 3 "run: :env must be a map"))
  envl=(runenv (?? ev (map)))
  mem=(scratch) n=#argv ne=#envl
  argvoff=0 envoff=8*(n+1) off=envoff+8*(ne+1)
  ptrs=[] eptrs=[]
  (for a argv (lpush ptrs off) off=(putstr mem off a))
  (for a envl (lpush eptrs off) off=(putstr mem off a))
  (? off>900000 ($throwk 3 "run: arguments and environment are too large"))
  (for i n (put64 mem+argvoff+8*i mem+ptrs[i])) (put64 mem+argvoff+8*n 0)
  (for i ne (put64 mem+envoff+8*i mem+eptrs[i])) (put64 mem+envoff+8*ne 0)
  name=argv[0]
  cands=(? (has name "/") [name] (~ d=>(strcat2 (strcat2 d "/") name) (~? d=>#d>0 (split (?? (env "PATH") "/usr/local/bin:/usr/bin:/bin") ":"))))
  cdir=(? cwd (cstr cwd) nil)
  infd=-1
  (? (! ($isnil inp))
     (: infd=(runmem) d=(? (islist inp) (frombytes inp) (istyped inp) inp inp)
        e=(rawwrite infd d ($hlen d)) (? e<0 (ioerr "run: cannot buffer the input" "" e))
        ($syscall 8 infd 0 0)))
  outfd=(runmem) errfd=(runmem)
  (flush)
  pid=($syscall 57)
  (? pid<0 ($throwk 4 "run: cannot start the program"))
  (? pid==0
     (: (? infd>=0 (: ($syscall 33 infd 0) ($syscall 3 infd)))
        ($syscall 33 outfd 1) ($syscall 33 errfd 2) ($syscall 3 outfd) ($syscall 3 errfd)
        (? (&& cdir (< ($syscall 80 ($addr cdir)) 0)) (: m=(strcat2 (strcat2 "run: cannot change to " cwd) "\n") (rawwrite 2 m ($hlen m)) ($syscall 231 127)))
        why=2
        (for c cands
          co=off off=(putstr mem off c)
          r=($syscall 59 mem+co mem+argvoff mem+envoff)
          (? (&& r!=-2 r!=-20 (|| (has name "/") r!=-13)) why=0-r))      ; a PATH directory that cannot be searched is not the reason
        m=(strcat2 (strcat2 (strcat2 (strcat2 "run: cannot execute " name) ": ") (errtext why)) "\n")
        (rawwrite 2 m ($hlen m)) ($syscall 231 127)))
  (? infd>=0 ($syscall 3 infd))
  stb=($newb 8 16 16)
  r=($syscall 61 pid ($addr stb) 0 0)
  (wh r==-4 r=($syscall 61 pid ($addr stb) 0 0))
  st=(+ ($peek ($addr stb)) (* 256 ($peek ($addr stb)+1)))
  code=(? ($band st 127)!=0 128+($band st 127) ($band ($ushr st 8) 255))      ; killed by a signal: 128 + its number, like a shell
  res=(map) (mapset res "code" code) (mapset res "out" (runread outfd)) (mapset res "err" (runread errfd))
  res)

; ---- stat cp chmod cwd chdir
(= (peek64 addr) v=0 (for i 8 v=v*256+($peek addr+7-i)) v)
(= (stat p)                         ; {size mtime(ms) mode dir}, nil when the path does not exist
  buf=(scratch) r=($syscall 4 ($addr (cstr p)) buf)
  (? (|| r==-2 r==-20) nil
     r<0 (ioerr "cannot stat" p r)
     (: m=(+ ($peek buf+24) (* 256 ($peek buf+25)) (* 65536 ($peek buf+26)))
        res=(map) (mapset res "size" (peek64 buf+48)) (mapset res "mtime" (+ (* (peek64 buf+88) 1000) ($ffloor ($fdiv (peek64 buf+96) 1000000))))
        (mapset res "mode" ($band m 4095)) (mapset res "dir" (== ($band m 61440) 16384)) res)))
(= (chmod p mode)
  (? (! (&& ($isnum mode) (isint mode) mode>=0 mode<=4095)) ($throwk 3 (strcat2 "chmod: invalid mode " (show mode))))
  r=($syscall 90 ($addr (cstr p)) mode) (? r<0 (ioerr "cannot chmod" p r)) nil)
(= (cwd) buf=(scratch) n=($syscall 79 buf 4096) (? n<=0 ($throwk 4 "cannot find the current directory"))
  s=(strnew n-1) (for i n-1 ($stb s i ($peek buf+i))) s)
(= (chdir p) r=($syscall 80 ($addr (cstr p))) (? r<0 (ioerr "cannot change to" p r)) nil)
(= (cp a b)                         ; copies the contents and the permission bits in 64 KB pieces; raises when both names are the same file
  buf=(scratch) sfd=($syscall 2 ($addr (cstr a)) 524288 0)
  (? sfd<0 (ioerr "cannot read" a sfd))
  ($syscall 5 sfd buf)
  mode=($band (+ ($peek buf+24) (* 256 ($peek buf+25))) 4095) kind=($band (+ ($peek buf+24) (* 256 ($peek buf+25))) 61440)
  sdev=(peek64 buf) sino=(peek64 buf+8)
  (? (== kind 16384) (: ($syscall 3 sfd) ($throwk 4 (strcat2 (strcat2 "cannot read " a) ": is a directory"))))
  (? (&& (== ($syscall 4 ($addr (cstr b)) buf) 0) (== (peek64 buf) sdev) (== (peek64 buf+8) sino)) (: ($syscall 3 sfd) ($throwk 4 (strcat2 (strcat2 (strcat2 (strcat2 "cannot copy " a) " to ") b) ": same file"))))
  dfd=($syscall 2 ($addr (cstr b)) 524865 mode)
  (? dfd<0 (: ($syscall 3 sfd) (ioerr "cannot write" b dfd)))
  chunk=($newb 1 65536 65536) done=false err=0
  (wh (! done)
    r=($syscall 0 sfd ($addr chunk) 65536)
    (? r==-4 nil r==0 done=true r<0 (: err=r done=true)
       (: e=(rawwrite dfd chunk r) (? e<0 (: err=e done=true)))))
  ($syscall 3 sfd) ($syscall 3 dfd)
  (? err<0 (ioerr "cannot copy" (strcat2 (strcat2 a " to ") b) err)) nil)
