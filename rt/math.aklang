     (: z=(1-x)*0.5 s=(sqrt z) df=(setlo s 0) c=(z-df*df)/(s+df) pq=(aspq z) r=pq[0]/pq[1] w=r*s+c 2*(df+w))))

; ---- pow and friends
(= (scalbn x n)                  ; x * 2^n for a normal finite x (as used by pow)
  hx=(hw x) k=($band ($ushr hx 20) 2047) k=k+n
  (? k>2046 (* (? (isneg hx) -1 1) INF)
