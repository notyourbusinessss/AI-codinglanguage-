        iy>=1072693248
          (: k=($shr iy 20)-1023
             (? k>20 (: sh=52-k j=($ffloor ($fdiv ly (** 2 sh))) (? (== (* j (** 2 sh)) ly) yisint=2-($band j 1)))
                (== ly 0) (: sh=20-k j=($ffloor ($fdiv iy (** 2 sh))) (? (== (* j (** 2 sh)) iy) yisint=2-($band j 1)))))))
  (? (&& ($isnil res) (== ly 0))
     (? (== iy 2146435072) res=(? (== (+ (- ix 1072693248) lx) 0) NANV (>= ix 1072693248) (? (>= hy 0) y 0) (? (< hy 0) (- y) 0))
        (== iy 1072693248) res=(? (< hy 0) (? (== x 0) (? (< hx 0) (- INF) INF) 1/x) x)
        (== hy 1073741824) res=x*x
        (&& (== hy 1071644672) (>= hx 0)) res=(sqrt x)))
  ax=(abs x)
  (? (&& ($isnil res) (== lx 0) (|| (== ix 2146435072) (== ix 0) (== ix 1072693248)))
     (: z=ax (? (< hy 0) z=(? (== z 0) INF 1/z))
        (? (< hx 0) (? (&& (== ix 1072693248) (== yisint 0)) z=NANV (== yisint 1) z=(- z)))
        res=z))
  (? (&& ($isnil res) (< hx 0) (== yisint 0)) res=NANV)
  (? (&& (< hx 0) (== yisint 1)) s=-1)
  (? ($isnil res)
     (? iy>1105199104
