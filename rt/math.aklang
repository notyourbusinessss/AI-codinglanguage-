; Native runtime: elementary functions, ports of fdlibm (the algorithms behind V8's Math.*).
INF=($fdiv 1 0)
NANV=($fsub INF INF)
(= (hw x) ($bitshi x))                       ; high word (unsigned 32-bit)
(= (lw x) ($bitslo x))
(= (sethi x hi) ($frombits hi ($bitslo x)))
(= (setlo x lo) ($frombits ($bitshi x) lo))
(= (iabs hx) (? hx>=2147483648 hx-2147483648 hx))     ; |high word| (clears the sign bit)
(= (isneg hx) (>= hx 2147483648))

; ---- exp
(= (exp x)
  x=(tonum x) hx=(hw x) xsb=(isneg hx) hx=(iabs hx)
  (? x==1 2.718281828459045                                   ; V8 special-cases exp(1) too: the algorithm below is one bit off there
     hx>=2146435072 (? (|| (> hx 2146435072) (!= (lw x) 0)) (+ x x) (? xsb 0 x))
     x>709.782712893383973096 INF
     x<-745.13321910194110842 0
     (: k=0 hi=0 lo=0 small=false
        (? hx>1071001154
             (: (? hx<1072734898
                   (? xsb (: hi=x+6.93147180369123816490e-01 lo=-1.90821492927058770002e-10 k=-1)
                          (: hi=x-6.93147180369123816490e-01 lo=1.90821492927058770002e-10 k=1))
                   (: k=($ftrunc (+ (* 1.44269504088896338700 x) (? xsb -0.5 0.5)))
                      hi=x-k*6.93147180369123816490e-01 lo=k*1.90821492927058770002e-10))
                x=hi-lo)
           hx<1043333120 small=true)
        (? small 1+x
           (: t=x*x
              c=x-t*(1.66666666666666019037e-01+t*(-2.77777777770155933842e-03+t*(6.61375632143793436117e-05+t*(-1.65339022054652515390e-06+t*4.13813679705723846039e-08))))
              (? k==0 1-((x*c)/(c-2)-x)
                 (: y=1-((lo-(x*c)/(2-c))-hi)
                    (? k>=-1021 (sethi y (+ (hw y) (* k 1048576)))
                       (* (sethi y (+ (hw y) (* (+ k 1000) 1048576))) 9.33263618503218878990e-302)))))))))

; ---- log
(= (log x)
  x=(tonum x) hx=(hw x) lx=(lw x) k=0
  (? (isneg hx) (? (== (+ (iabs hx) lx) 0) (- INF) NANV)
     (: (? hx<1048576
           (? (== (+ hx lx) 0) k=-99999 (: k=-54 x=x*1.80143985094819840000e+16 hx=(hw x))))
        (? k==-99999 (- INF)
           hx>=2146435072 x+x
           (: k=k+(($ushr hx 20)-1023)
              hx=($band hx 1048575)
              i=($band hx+614244 1048576)
              x=(sethi x ($bor hx ($bxor i 1072693248)))
              k=k+($ushr i 20)
              f=x-1
              (? ($band 2+hx 1048575)<3
                 (? (== f 0) (? k==0 0 (: dk=k dk*6.93147180369123816490e-01+dk*1.90821492927058770002e-10))
                    (: r=f*f*(0.5-0.33333333333333333*f)
                       (? k==0 f-r (: dk=k dk*6.93147180369123816490e-01-((r-dk*1.90821492927058770002e-10)-f)))))
                 (: s=f/(2+f) dk=k z=s*s i=hx-398458 w=z*z j=440401-hx
                    t1=w*(3.999999999940941908e-01+w*(2.222219843214978396e-01+w*1.531383769920937332e-01))
                    t2=z*(6.666666666666735130e-01+w*(2.857142874366239149e-01+w*(1.818357216161805012e-01+w*1.479819860511658591e-01)))
                    i=($bor i j) r=t2+t1
                    (? i>0
                       (: hfsq=0.5*f*f
                          (? k==0 f-(hfsq-s*(hfsq+r))
                             dk*6.93147180369123816490e-01-((hfsq-(s*(hfsq+r)+dk*1.90821492927058770002e-10))-f)))
                       (? k==0 f-s*(f-r)
                          dk*6.93147180369123816490e-01-((s*(f-r)-dk*1.90821492927058770002e-10)-f))))))))))
(= (logscale x)                  ; x > 0 -> [k x'] with x = 2^k * x', x' in [1,2) or [0.5,1) as in e_log10 / e_log2
  hx=(hw x) k=0
  (? hx<1048576 (: k=-54 x=x*1.80143985094819840000e+16))
  (list k x))
(= (log10 x)
  x=(tonum x) hx=(hw x) lx=(lw x)
  (? (isneg hx) (? (== (+ (iabs hx) lx) 0) (- INF) NANV)
     (== (+ hx lx) 0) (- INF)
     (: k=0 (? hx<1048576 (: k=-54 x=x*1.80143985094819840000e+16 hx=(hw x) lx=(lw x)))
        (? hx>=2146435072 x+x
           (&& (== hx 1072693248) (== lx 0)) 0
           (: k=k+(($ushr hx 20)-1023) i=(? k<0 1 0)
              hx=($bor ($band hx 1048575) (* (- 1023 i) 1048576)) y=k+i
              x=($frombits hx lx)
              z=y*3.69423907715893078616e-13+4.34294481903251816668e-01*(log x)
              z+y*3.01029995663611771306e-01)))))
(= (klog1p f)
  s=f/(2+f) z=s*s w=z*z
  t1=w*(3.999999999940941908e-01+w*(2.222219843214978396e-01+w*1.531383769920937332e-01))
  t2=z*(6.666666666666735130e-01+w*(2.857142874366239149e-01+w*(1.818357216161805012e-01+w*1.479819860511658591e-01)))
  r=t2+t1 hfsq=0.5*f*f
  s*(hfsq+r))
(= (log2 x)
  x=(tonum x) hx=(hw x) lx=(lw x)
  (? (isneg hx) (? (== (+ (iabs hx) lx) 0) (- INF) NANV)
     (== (+ hx lx) 0) (- INF)
     (: k=0 (? hx<1048576 (: k=-54 x=x*1.80143985094819840000e+16 hx=(hw x) lx=(lw x)))
        (? hx>=2146435072 x+x
           (&& (== hx 1072693248) (== lx 0)) 0
           (: k=k+(($ushr hx 20)-1023) hx=($band hx 1048575)
              i=($band hx+614244 1048576)
              x=($frombits ($bor hx ($bxor i 1072693248)) lx)
              k=k+($ushr i 20)
              y=k f=x-1 hfsq=0.5*f*f r=(klog1p f)
              hi=(setlo f-hfsq 0)
              lo=(f-hi)-hfsq+r
              vhi=hi*1.44269504072144627571 vlo=(lo+hi)*1.67517131648865118353e-10+lo*1.44269504072144627571
              w=y+vhi vlo=vlo+((y-w)+vhi) vhi=w
              vlo+vhi)))))

; ---- sin / cos / tan (arguments up to about 8e5 are reduced with the three-part pi/2; larger ones need a bignum reduction)
(= (ksin x y iy)
  ix=(iabs (hw x))
  (? (&& ix<1044381696 (== ($toint x) 0)) x
     (: z=x*x v=z*x
        r=-1.98412698298579493134e-04+z*(2.75573137070700676789e-06+z*(-2.50507602534068634195e-08+z*1.58969099521155010221e-10))
        r=8.33333333332248946124e-03+z*r
        (? iy==0 x+v*(-1.66666666666666324348e-01+z*r)
           x-((z*(0.5*y-v*r)-y)-v*(-1.66666666666666324348e-01))))))
(= (kcos x y)
  ix=(iabs (hw x))
  (? (&& ix<1044381696 (== ($toint x) 0)) 1
     (: z=x*x
        r=z*(4.16666666666666019037e-02+z*(-1.38888888888741095749e-03+z*(2.48015872894767294178e-05+z*(-2.75573143513906633035e-07+z*(2.08757232129817482790e-09+z*-1.13596475577881948265e-11)))))
        (? ix<1070805811 1-(0.5*z-(z*r-x*y))
           (: qx=(? ix>1072234496 0.28125 ($frombits (- ix 2097152) 0))
              hz=0.5*z-qx a=1-qx
              a-(hz-(z*r-x*y)))))))
(= (rempio2 x)                    ; -> [n y0 y1] with x = n*pi/2 + y0 + y1
  hx=(hw x) ix=(iabs hx) neg=(isneg hx)
  (? ix<=1072243195 (list 0 x 0)
     ix<1073928572
       (? (! neg)
          (: z=x-1.57079632673412561417
             (? ix!=1073291771 (: y0=z-6.07710050650619224932e-11 (list 1 y0 ((z-y0)-6.07710050650619224932e-11)))
                (: z=z-6.07710050630396597660e-11 y0=z-2.02226624879595063154e-21 (list 1 y0 ((z-y0)-2.02226624879595063154e-21)))))
          (: z=x+1.57079632673412561417
             (? ix!=1073291771 (: y0=z+6.07710050650619224932e-11 (list -1 y0 ((z-y0)+6.07710050650619224932e-11)))
                (: z=z+6.07710050630396597660e-11 y0=z+2.02226624879595063154e-21 (list -1 y0 ((z-y0)+2.02226624879595063154e-21))))))
     ix<=1094263291
       (: t=(abs x) n=($ftrunc t*6.36619772367581382433e-01+0.5) fn=n
          r=t-fn*1.57079632673412561417 w=fn*6.07710050650619224932e-11
          j=($ushr ix 20) y0=r-w
          i=j-($band ($ushr (hw y0) 20) 2047)
          (? i>16 (: t=r w=fn*6.07710050630396597660e-11 r=t-w w=fn*2.02226624879595063154e-21-((t-r)-w) y0=r-w
                     i=j-($band ($ushr (hw y0) 20) 2047)
                     (? i>49 (: t=r w=fn*2.02226624871116645580e-21 r=t-w w=fn*8.47842766036889956997e-32-((t-r)-w) y0=r-w))))
          y1=(r-y0)-w
          (? neg (list (- n) (- y0) (- y1)) (list n y0 y1)))
     (rempio2_big x)))
(= (sin x)
  x=(tonum x) ix=(iabs (hw x))
  (? ix<=1072243195 (ksin x 0 0)
     ix>=2146435072 NANV
     (: r=(rempio2 x) n=($band r[0] 3)
        (sw n 0 (ksin r[1] r[2] 1) 1 (kcos r[1] r[2]) 2 (- (ksin r[1] r[2] 1)) (- (kcos r[1] r[2]))))))
(= (cos x)
  x=(tonum x) ix=(iabs (hw x))
  (? ix<=1072243195 (kcos x 0)
     ix>=2146435072 NANV
     (: r=(rempio2 x) n=($band r[0] 3)
        (sw n 0 (kcos r[1] r[2]) 1 (- (ksin r[1] r[2] 1)) 2 (- (kcos r[1] r[2])) (ksin r[1] r[2] 1)))))
(= (ktan x y iy)
  hx=(hw x) ix=(iabs hx)
  (? (&& ix<1043333120 (== ($toint x) 0))
     (? (== (+ ix (lw x) (+ iy 1)) 0) (/ 1 (abs x))
        iy==1 x
        (: w=x+y z=(setlo w 0) v=y-(z-x) a=-1/w t=(setlo a 0) s=1+t*z t+a*(s+t*v)))
     (: big=(>= ix 1072010280)
        (? (&& big (isneg hx)) (: x=(- x) y=(- y)))
        (? big (: z=7.85398163397448278999e-01-x w=3.06161699786838301793e-17-y x=z+w y=0))
        z=x*x w=z*z
        r=1.33333333333201242699e-01+w*(2.18694882948595424599e-02+w*(3.59207910759131235356e-03+w*(5.88041240820264096874e-04+w*(7.81794442939557092300e-05+w*-1.85586374855275456654e-05))))
        v=z*(5.39682539762260521377e-02+w*(8.86323982359930005737e-03+w*(1.45620945432529025516e-03+w*(2.46463134818469906812e-04+w*(7.14072491382608190305e-05+w*2.59073051863633712884e-05)))))
        s=z*x
        r=y+z*(s*(r+v)+y)
        r=r+3.33333333333334091986e-01*s
        w=x+r
        (? big (: v=iy (* (- 1 (* 2 (? (isneg hx) 1 0))) (- v (* 2 (- x (- (/ (* w w) (+ w v)) r))))))
           iy==1 w
           (: z=(setlo w 0) v=r-(z-x) a=-1/w t=(setlo a 0) s=1+t*z t+a*(s+t*v))))))
(= (tan x)
  x=(tonum x) ix=(iabs (hw x))
  (? ix<=1072243195 (ktan x 0 1)
     ix>=2146435072 NANV
     (: r=(rempio2 x) (ktan r[1] r[2] (- 1 (* 2 ($band r[0] 1)))))))

; ---- atan / atan2 / asin / acos
(= (atan x)
  x=(tonum x) hx=(hw x) ix=(iabs hx) id=-1 res=nil
  (? ix>=1141899264
     (? (|| (> ix 2146435072) (&& (== ix 2146435072) (!= (lw x) 0))) (+ x x)
        (? (isneg hx) (- (+ 1.57079632679489655800e+00 6.12323399573676603587e-17)) (+ 1.57079632679489655800e+00 6.12323399573676603587e-17)))
     (: (? ix<1071382528
           (? ix<1042284544 res=x)
           (: x=(abs x)
              (? ix<1072889856
                   (? ix<1072037888 (: id=0 x=(2*x-1)/(2+x)) (: id=1 x=(x-1)/(x+1)))
                   (? ix<1073971200 (: id=2 x=(x-1.5)/(1+1.5*x)) (: id=3 x=-1/x)))))
        (? res res
           (: z=x*x w=z*z
              s1=z*(3.33333333333329318027e-01+w*(1.42857142725034663711e-01+w*(9.09088713343650656196e-02+w*(6.66107313738753120669e-02+w*(4.97687799461593236017e-02+w*1.62858201153657823623e-02)))))
              s2=w*(-1.99999999998764832476e-01+w*(-1.11111104054623557880e-01+w*(-7.69187620504482999495e-02+w*(-5.83357013379057348645e-02+w*-3.65315727442169155270e-02))))
              (? id<0 x-x*(s1+s2)
                 (: ah=(sw id 0 4.63647609000806093515e-01 1 7.85398163397448278999e-01 2 9.82793723247329054082e-01 1.57079632679489655800e+00)
                    al=(sw id 0 2.26987774529616870924e-17 1 3.06161699786838301793e-17 2 1.39033110312309984516e-17 6.12323399573676603587e-17)
                    z=ah-((x*(s1+s2)-al)-x)
                    (? (isneg hx) (- z) z))))))))
(= (atan2 y x)
  y=(tonum y) x=(tonum x)
  hx=(hw x) ix=(iabs hx) lx=(lw x) hy=(hw y) iy=(iabs hy) ly=(lw y)
  (? (|| (> ix 2146435072) (&& (== ix 2146435072) (!= lx 0)) (> iy 2146435072) (&& (== iy 2146435072) (!= ly 0))) (+ x y)
     (&& (== hx 1072693248) (== lx 0)) (atan y)
     (: m=(+ (? (isneg hy) 1 0) (? (isneg hx) 2 0))
        (? (== (+ iy ly) 0)
             (sw m 0 y 1 y 2 3.14159265358979311600 (- 3.14159265358979311600))
           (== (+ ix lx) 0) (? (isneg hy) (- 1.57079632679489655800) 1.57079632679489655800)
           (== ix 2146435072)
             (? (== iy 2146435072)
                (sw m 0 7.85398163397448278999e-01 1 (- 7.85398163397448278999e-01) 2 3*7.85398163397448278999e-01 (- (* 3 7.85398163397448278999e-01)))
                (sw m 0 0 1 -0 2 3.14159265358979311600 (- 3.14159265358979311600)))
           (== iy 2146435072) (? (isneg hy) (- 1.57079632679489655800) 1.57079632679489655800)
           (: k=($ffloor ($fdiv (- iy ix) 1048576))
              z=(? k>60 1.57079632679489655800+0.5*1.2246467991473531772e-16
                   (&& (isneg hx) k<-60) 0
                   (atan (abs y/x)))
              (sw m 0 z 1 (- z) 2 3.14159265358979311600-(z-1.2246467991473531772e-16) (z-1.2246467991473531772e-16)-3.14159265358979311600))))))
(= (aspq t)       ; p/q rational approximation shared by asin and acos
  p=t*(1.66666666666666657415e-01+t*(-3.25565818622400915405e-01+t*(2.01212532134862925881e-01+t*(-4.00555345006794114027e-02+t*(7.91534994289814532176e-04+t*3.47933107596021167570e-05)))))
  q=1+t*(-2.40339491173441421878+t*(2.02094576023350569471+t*(-6.88283971605453293030e-01+t*7.70381505559019352791e-02)))
  (list p q))
(= (asin x)
  x=(tonum x) hx=(hw x) ix=(iabs hx)
  (? ix>=1072693248
       (? (&& (== ix 1072693248) (== (lw x) 0)) (+ (* x 1.57079632679489655800) (* x 6.12323399573676603587e-17)) NANV)
