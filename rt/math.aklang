             j=($band ix 1048575) ix=($bor j 1072693248) k=0
             (? j<=235662 k=0 j<767610 k=1 (: k=0 n=n+1 ix=ix-1048576))
             ax=(sethi ax ix)
             bk=(? k==1 1.5 1)
