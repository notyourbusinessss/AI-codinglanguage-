           (: w=p/q t=1.57079632679489655800-(2*(s+s*w)-6.12323399573676603587e-17) (? (isneg hx) (- t) t))
           (: w=(setlo s 0) c=(t-w*w)/(s+w) r=p/q p=2*s*r-(6.12323399573676603587e-17-2*c) q=7.85398163397448278999e-01-2*w
              t=7.85398163397448278999e-01-(p-q) (? (isneg hx) (- t) t))))))
(= (acos x)
  x=(tonum x) hx=(hw x) ix=(iabs hx)
  (? ix>=1072693248
       (? (&& (== ix 1072693248) (== (lw x) 0)) (? (isneg hx) (+ 3.14159265358979311600 (* 2 6.12323399573676603587e-17)) 0) NANV)
     ix<1071644672
