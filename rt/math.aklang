              (: t=($frombits 1129316352 0) t=t*x high=(iabs (hw t)) t=($frombits (+ sign (+ ($ffloor ($fdiv high 3)) 696219795)) 0)))
           t=($frombits (+ sign (+ ($ffloor ($fdiv hx 3)) 715094163)) 0))
