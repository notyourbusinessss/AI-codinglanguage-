; Native runtime: arbitrary-precision integers (BigInt, literals like 10n). Object: type 10 = [hdr][sign (0/1)][limbs, base 2^24, little endian]
(= (bigwrap sign limbs)
  n=#limbs o=($new 10 n+1 n+1) ($stw o 1 (? (&& sign n>0) 1 0)) (for i n ($stw o i+2 (lget limbs i))) o)
(= (bigunwrap x) n=($hlen x)-1 r=(mklist n) (for i n (lpush r ($ldw x i+2))) r)
(= (bigsign x) ($ldw x 1))
(= (bigiszero x) (== ($hlen x) 1))
(= (bigfrom s)                 ; decimal literal text (optional leading -)
  neg=(starts s "-") t=(? neg (slice s 1 nil) s)
  (bigwrap neg (bigfromdigits t)))
(= (bigfromnum n)              ; integral number
  neg=n<0 n=(abs n)
  (? n<9007199254740992 (bigwrap neg (bn_small n))
     (: d=(decomp n) (bigwrap neg (bn_shl (bn_small d[0]) d[1])))))
(= (bigtonum x)
  r=0 limbs=(bigunwrap x) i=#limbs-1
  (wh i>=0 r=($fadd ($fmul r BNB) (lget limbs i)) i-=1)
  (? (== (bigsign x) 1) ($fsub 0 r) r))
(= (bigstr x) (strcat2 (? (== (bigsign x) 1) "-" "") (bn_tostr (bigunwrap x))))
(= (bigneg a) (bigwrap (? (== (bigsign a) 0) 1 0) (bigunwrap a)))
(= (bigadd a b)
  sa=(bigsign a) sb=(bigsign b) la=(bigunwrap a) lb=(bigunwrap b)
  (? (== sa sb) (bigwrap sa (bn_add la lb))
     (: c=(bn_cmp la lb)
        (? c==0 (bigwrap 0 [])
           c>0 (bigwrap sa (bn_sub la lb))
           (bigwrap sb (bn_sub lb la))))))
(= (bigsub a b) (bigadd a (bigneg b)))
(= (bigmul a b) (bigwrap (? (== (bigsign a) (bigsign b)) 0 1) (bn_mul_big (bigunwrap a) (bigunwrap b))))
(= (bigdivmod a b)             ; truncated division -> [q r]
  (? (bigiszero b) ($throwk 2 "division by zero"))
  sa=(bigsign a) sb=(bigsign b)
  qr=(bn_divmod (bigunwrap a) (bigunwrap b))
  (list (bigwrap (? (== sa sb) 0 1) (lget qr 0)) (bigwrap sa (lget qr 1))))
(= (bigcmp a b)
  sa=(bigsign a) sb=(bigsign b)
  (? (&& (bigiszero a) (bigiszero b)) 0
     (!= sa sb) (? sa==1 -1 1)
     (: c=(bn_cmp (bigunwrap a) (bigunwrap b)) (? sa==1 (- c) c))))
(= (bigcmpany a b)             ; either may be a number
  (? (&& (isbig a) (isbig b)) (bigcmp a b)
     (isbig a) (? (== b ($ffloor b)) (bigcmp a (bigfromnum b)) (: c=(bigcmp a (bigfromnum ($ffloor b))) (? c>0 1 -1)))
     (? (== a ($ffloor a)) (bigcmp (bigfromnum a) b) (: c=(bigcmp (bigfromnum ($ffloor a)) b) (? c>=0 1 -1)))))
(= (bigpow a n)
  (? (! (isbig n)) ($throwk 3 "unsupported exponent"))
  (? (== (bigsign n) 1) ($throw "exponent must be non-negative"))
  e=(bigtonum n) r=(bigfromnum 1) base=a
  (wh e>0 (? (== (% e 2) 1) r=(bigmul r base)) (? e>1 base=(bigmul base base)) e=($ffloor ($fdiv e 2)))
  r)
(= (bigop op a b)              ; op: + - * / // % **
  (? (! (&& (isbig a) (isbig b))) ($throwk 3 "Cannot mix BigInt and other types, use explicit conversions"))
  (sw op
    "+" (bigadd a b)
    "-" (bigsub a b)
    "*" (bigmul a b)
    "/" (lget (bigdivmod a b) 0)
    "//" (: qr=(bigdivmod a b) (? (&& (! (bigiszero (lget qr 1))) (!= (bigsign a) (bigsign b))) (bigsub (lget qr 0) (bigfromnum 1)) (lget qr 0)))
    "%" (: qr=(bigdivmod a b) r=(lget qr 1) (? (&& (! (bigiszero r)) (!= (bigsign r) (bigsign b))) (bigadd r b) r))
    "**" (bigpow a b)))
