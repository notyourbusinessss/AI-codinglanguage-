; Native runtime, written in Ak. Uses $-intrinsics (low-level, inline) and the compiler's value model:
; object header word = type | length<<32; STR bytes follow the header.
; type codes: 1 STR, 2 LIST, 3 ARR, 4 MAP, 5 CLOSURE, 6 BOX, 7 SYM, 8 BYTES.  typeof: 100 num, 101 nil, 102 bool
MAXI=9007199254740992
UNDEF=($frombits 4294508544 3)
(= (typeof x) (? ($isptr x) ($type x) ($isnum x) 100 ($isnil x) 101 102))
(= (isstr x) (&& ($isptr x) (== ($type x) 1)))
(= (islist x) (&& ($isptr x) (== ($type x) 2)))
(= (ismap x) (&& ($isptr x) (== ($type x) 4)))
(= (issym x) (&& ($isptr x) (== ($type x) 7)))
(= (isbytes x) (&& ($isptr x) (== ($type x) 8)))
(= (isfn x) (&& ($isptr x) (== ($type x) 5)))
(= (isbig x) (&& ($isptr x) (== ($type x) 10)))
(= (isbool x) (|| ($eqp x true) ($eqp x false)))
(= (ty x) t=(typeof x)
  (? (|| t==100 t==10) "num" t==101 "nil" t==102 "bool" t==1 "str" t==2 "list" t==4 "map" t==5 "fn" t==7 "sym" (|| t==8 t==9) "arr" "obj"))
(= (is t x) (streq t (ty x)))
(= (isnum x) ($isnum x))

; ---- output buffer (flushed when full, at exit, before stderr writes and reads)
OBUF=nil
OBN=0
(= (rawwrite fd s n) (wh n>0 r=($syscall 1 fd ($addr s) n) (? r<=0 n=0 (: s=(substr s r n) n-=r))))
(= (substr s a n) r=($newb 1 n n) ($copy r 0 s a n) r)
(= (flush) (? OBN>0 (: n=OBN (<- OBN 0) (rawwrite 1 OBUF n))))
(= (out s) n=($hlen s)
  (? OBUF==nil (<- OBUF ($newb 1 65536 65536)))
  (? OBN+n>65536 (flush))
  (? n>65536 (rawwrite 1 s n)
     (: ($copy OBUF OBN s 0 n) (<- OBN OBN+n))))
(= (eout s) (flush) (rawwrite 2 s ($hlen s)))
(= (finish) (flush) (? PROFH (profdump)) (? (env "AK_GCSTATS") (eout (strcat2 (strcat2 "gc: " (fmtint GCCOUNT)) " collections\n"))))
(= (exit code) (flush) (? PROFH (profdump)) ($syscall 231 (? ($isnil code) 0 code)))
INFATAL=false
(= (hdrw addr) w=($peekw addr) (+ (* ($bitshi w) 4294967296) ($bitslo w)))
(= (srcpos)         ; "file:line:col" of the innermost user call site on the machine stack, or nil
  n=(hdrw 268435552)
  (? n==0 nil
     (: tab=(hdrw 268435544) cend=(hdrw 268435568) top=(hdrw 268435576) a=($sp) found=nil
        (wh (&& ($isnil found) a<top)
          w=($peekw a)
          (? (&& (== ($bitshi w) 0) (>= ($bitslo w) 4198400) (< ($bitslo w) cend))
             (: e=(posfind tab n ($bitslo w)-4198400) (? (&& e (> (lget e 3) 0)) found=e)))
          a+=8)
        (? found
           (: files=(split ($peekstr (+ (hdrw 268435560) 8)) "\n")
              (strcat2 (strcat2 (strcat2 (strcat2 (lget files (lget found 3)) ":") (fmtint (lget found 1))) ":") (fmtint (lget found 2))))))))
(= ($peekstr p) n=0 (wh (> ($peek p+n) 0) n+=1) r=(strnew n) (for i n ($stb r i ($peek p+i))) r)
(= (posfind tab n off)   ; binary search in the call-site table: [offset line col fid] or nil
  lo=0 hi=n-1 r=nil
  (wh (&& ($isnil r) lo<=hi)
    m=($ffloor ($fdiv (+ lo hi) 2)) w=($peekw tab+16*m) o=($bitslo w)
    (? o==off (: w2=($peekw tab+16*m+8) r=(list o ($bitshi w) ($bitslo w2) ($bitshi w2)))
       o<off lo=m+1
       hi=m-1))
  r)
(= (fatal msg) (? INFATAL ($syscall 231 1)) (<- INFATAL true) (flush) (eout "error: ") (eout (? (isstr msg) msg "runtime error"))
  p=(srcpos) (? p (eout (strcat2 (strcat2 " (" p) ")"))) (eout "\n") (tracedump) ($syscall 231 1))
(= (tracedump)
  base=($tracebase) top=($tracetop)
  (? top>base
     (: names=(split ($tracenames) "\n") tab=(map)
        (for l names sp=(split l " ") (mapset tab (num sp[0]) l))
        a=top-8
        (wh (&& a>=base a>=top-8*40)
          id=(+ ($peek a) (* 256 ($peek a+1)) (* 65536 ($peek a+2)))
          (eout (strcat2 (strcat2 "  at " (or2 (mapget tab id) (fmtint id))) "\n"))
          a-=8))))
(= (or2 a b) (? ($isnil a) b a))
(= (bad x) ($throw (strcat2 "expected number, got " (ty x))))

; ---- strict arithmetic slow paths (called by compiled code when an operand is not a double or the result leaves 2^53)
(= (isint x) (== ($ffloor x) x))
(= (ovf r a b) (? (&& (> (? (< r 0) (- r) r) MAXI) (isint a) (isint b) (<= (? (< a 0) (- a) a) MAXI) (<= (? (< b 0) (- b) b) MAXI))
                  ($throw "integer overflow: exceeds 2^53 (use BigInt, e.g. 10n)") r))
(= (tonum x) (? ($isnum x) x ($eqp x true) 1 ($eqp x false) 0 (bad x)))
(= (add2 a b)
  (? (&& ($isnum a) ($isnum b)) (ovf ($fadd a b) a b)
     (&& (isbig a) (isbig b)) (bigop "+" a b)
     (isstr a) (strcat2 a (tostr b))
     (isstr b) (strcat2 (tostr a) b)
     (&& (islist a) (islist b)) (concat a b)
     (&& (|| ($isnum a) (isbool a)) (|| ($isnum b) (isbool b))) (add2 (tonum a) (tonum b))
     ($throw (strcat2 (strcat2 (strcat2 "cannot add " (ty a)) " and ") (ty b)))))
(= (sub2 a b) (? (|| (isbig a) (isbig b)) (bigop "-" a b) (: a=(tonum a) b=(tonum b) (ovf ($fsub a b) a b))))
(= (mul2 a b) (? (|| (isbig a) (isbig b)) (bigop "*" a b) (: a=(tonum a) b=(tonum b) (ovf ($fmul a b) a b))))
(= (div2 a b) (? (|| (isbig a) (isbig b)) (bigop "/" a b) (: a=(tonum a) b=(tonum b) (? (== b 0) ($throw "division by zero") ($fdiv a b)))))
(= (neg1 a) (? (isbig a) (bigneg a) (: a=(tonum a) ($fsub -0 a))))
(= (lt2 a b) (? (&& ($isnum a) ($isnum b)) (< a b) (< (cmp2 a b) 0)))
(= (gt2 a b) (? (&& ($isnum a) ($isnum b)) (> a b) (> (cmp2 a b) 0)))
(= (le2 a b) (? (&& ($isnum a) ($isnum b)) (<= a b) (<= (cmp2 a b) 0)))
(= (ge2 a b) (? (&& ($isnum a) ($isnum b)) (>= a b) (>= (cmp2 a b) 0)))
(= (fdiv2 a b) (? (|| (isbig a) (isbig b)) (bigop "//" a b) (: a=(tonum a) b=(tonum b) (? (== b 0) ($throw "division by zero") ($ffloor ($fdiv a b))))))
(= (mod2 a b) (? (|| (isbig a) (isbig b)) (bigop "%" a b) (: a=(tonum a) b=(tonum b) (? (== b 0) ($throw "division by zero") (: q=($ffloor ($fdiv a b)) ($fsub a ($fmul b q)))))))
(= (pow2 a b) (? (|| (isbig a) (isbig b)) (bigop "**" a b) (pow2n a b)))
(= (pow2n a b) a=(tonum a) b=(tonum b)
  (? (&& (isint b) (>= b 0)) (: r=1 (wh (> b 0) (? (== (mod2 b 2) 1) r=(mul2 r a)) (? b>1 a=(mul2 a a)) b=($ffloor ($fdiv b 2))) r)
     (fpow a b)))
(= (band2 a b) a=(tonum a) b=(tonum b) ($band a b))
(= (bor2 a b) a=(tonum a) b=(tonum b) ($bor a b))
(= (bxor2 a b) a=(tonum a) b=(tonum b) ($bxor a b))
(= (shl2 a b) a=(tonum a) b=(tonum b) ($shl a b))
(= (shr2 a b) a=(tonum a) b=(tonum b) ($shr a b))
(= (ushr2 a b) a=(tonum a) b=(tonum b) ($ushr a b))
(= (bnot1 a) a=(tonum a) ($bxor a -1))

; ---- structural equality and ordering
(= (eq2 a b)
  (? ($isnum a) (&& ($isnum b) (== a b))
     (! ($isptr a)) ($eqp a b)
     (! ($isptr b)) false
     ($eqp a b) true
     (: ta=($type a)
        (? (!= ta ($type b)) false
           ta==1 ($streq a b)
           ta==7 (streq a b)
           ta==2 (listeq a b)
           ta==4 (mapeq a b)
           ta==8 (streq a b)
           ta==9 (listeq (toarr a) (toarr b))
           ta==10 (== (bigcmp a b) 0)
           false))))
(= (ne2 a b) (! (eq2 a b)))
(= (listeq a b) n=($ldw a 1)
  (? (!= n ($ldw b 1)) false
     (: i=0 (wh (&& (< i n) (eq2 (lget a i) (lget b i))) i+=1) (== i n))))
(= (cmp2 a b)
  (? (&& ($isnum a) ($isnum b)) (? (< a b) -1 (> a b) 1 0)
     (&& (|| (isbig a) (isbig b)) (|| ($isnum a) (isbig a)) (|| ($isnum b) (isbig b))) (bigcmpany a b)
     (&& (isstr a) (isstr b)) (strcmp a b)
     (&& (islist a) (islist b))
       (: n=(? ($ldw a 1)<($ldw b 1) ($ldw a 1) ($ldw b 1)) i=0 c=0
          (wh (&& (< i n) (== c 0)) c=(cmp2 (lget a i) (lget b i)) i+=1)
          (? (!= c 0) c (- ($ldw a 1) ($ldw b 1))))
     ($throw (strcat2 (strcat2 (strcat2 (strcat2 "cannot compare " (ty a)) " and ") (ty b)) (strcat2 (strcat2 " (" (show a)) (strcat2 " " (strcat2 (show b) ")")))))))
; total order used by sort: like cmp2 but never throws (falls back to comparing printed forms)
(= (cmp a b)
  (? (&& ($isnum a) ($isnum b)) (? (< a b) -1 (> a b) 1 0)
     (&& (isstr a) (isstr b)) (strcmp a b)
     (&& (islist a) (islist b))
       (: n=(? ($ldw a 1)<($ldw b 1) ($ldw a 1) ($ldw b 1)) i=0 c=0
          (wh (&& (< i n) (== c 0)) c=(cmp (lget a i) (lget b i)) i+=1)
          (? (!= c 0) c (- ($ldw a 1) ($ldw b 1))))
     (strcmp (show a) (show b))))

; ---- operator functions as values
(= (+ ..a) (? #a==0 0 (: r=a[0] (for i 1..#a r=(add2 r a[i])) r)))
(= (- ..a) (? #a==0 0 #a==1 (neg1 a[0]) (: r=(tonum a[0]) (for i 1..#a r=(sub2 r a[i])) r)))
(= (* ..a) (: r=1 (for i #a r=(mul2 r a[i])) r))
(= (/ ..a) (? #a==1 (div2 1 a[0]) (: r=a[0] (for i 1..#a r=(div2 r a[i])) r)))
(= (chain f a) (: ok=true (for i 0..#a-1 (? ok (? (! (f a[i] a[i+1])) ok=false))) ok))
(= (< ..a) (chain lt2 a))
(= (> ..a) (chain gt2 a))
(= (<= ..a) (chain le2 a))
(= (>= ..a) (chain ge2 a))
(= (== a b) (eq2 a b))
(= (!= a b) (ne2 a b))
(= (% a b) (mod2 a b))
(= (// a b) (fdiv2 a b))
(= (** a b) (pow2 a b))
(= (! a) (? a false true))
(= (& ..a) (: r=(tonum a[0]) (for i 1..#a r=(band2 r a[i])) r))
(= (| ..a) (: r=(tonum a[0]) (for i 1..#a r=(bor2 r a[i])) r))
(= (^ ..a) (: r=(tonum a[0]) (for i 1..#a r=(bxor2 r a[i])) r))
(= (<< a b) (shl2 a b))
(= (>> a b) (shr2 a b))
(= (>>> a b) (ushr2 a b))
(= (bnot a) (bnot1 a))
