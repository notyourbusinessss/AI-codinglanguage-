; Native runtime, written in Ak. Uses $-intrinsics (low-level, inline) and the compiler's value model:
; object header word = type | length<<32; STR bytes follow the header.
MAXI=9007199254740992
(= (strlen s) ($hlen s))
(= (write fd s) ($syscall 1 fd ($addr s) ($hlen s)))
(= (fatal msg) (write 2 "error: ") (write 2 (? ($isptr msg) msg "runtime error")) (write 2 "\n") ($syscall 231 1))

; ---- strict arithmetic slow paths (called by compiled code when an operand is not a double or the result leaves 2^53)
(= (isint x) (== ($ffloor x) x))
(= (ovf r a b) (? (&& (> (? (< r 0) (- r) r) MAXI) (isint a) (isint b) (<= (? (< a 0) (- a) a) MAXI) (<= (? (< b 0) (- b) b) MAXI))
                  ($throw "integer overflow: exceeds 2^53 (use BigInt, e.g. 10n)") r))
(= (needn a b) (? !($isnum a) ($throw "expected number") !($isnum b) ($throw "expected number")))
(= (add2 a b) (? (&& ($isnum a) ($isnum b)) (ovf ($fadd a b) a b) ($throw "cannot add")))
(= (sub2 a b) (needn a b) (ovf ($fsub a b) a b))
(= (mul2 a b) (needn a b) (ovf ($fmul a b) a b))
(= (div2 a b) (needn a b) (? (== b 0) ($throw "division by zero") ($fdiv a b)))
(= (neg1 a) (? !($isnum a) ($throw "expected number") ($fsub -0 a)))
(= (lt2 a b) (? (&& ($isnum a) ($isnum b)) (< a b) ($throw "cannot compare")))
(= (gt2 a b) (? (&& ($isnum a) ($isnum b)) (> a b) ($throw "cannot compare")))
(= (le2 a b) (? (&& ($isnum a) ($isnum b)) (<= a b) ($throw "cannot compare")))
(= (ge2 a b) (? (&& ($isnum a) ($isnum b)) (>= a b) ($throw "cannot compare")))
(= (eq2 a b) (? (&& ($isnum a) ($isnum b)) (== a b) ($eqp a b)))
(= (ne2 a b) (! (eq2 a b)))
(= (fdiv2 a b) (needn a b) (? (== b 0) ($throw "division by zero") ($ffloor ($fdiv a b))))
(= (mod2 a b) (needn a b) (? (== b 0) ($throw "division by zero") (: q=($ffloor ($fdiv a b)) ($fsub a ($fmul b q)))))
(= (pow2 a b) (needn a b) (? (&& (isint b) (>= b 0)) (: r=1 (wh (> b 0) (? (== (mod2 b 2) 1) r=(mul2 r a)) a=(mul2 a a) b=($ffloor ($fdiv b 2))) r) ($throw "unsupported exponent")))
(= (band2 a b) (needn a b) ($toint ($frombits 0 0)))
(= (bor2 a b) (needn a b) 0)
(= (bxor2 a b) (needn a b) 0)
(= (shl2 a b) (needn a b) 0)
(= (shr2 a b) (needn a b) 0)
(= (ushr2 a b) (needn a b) 0)
(= (bnot1 a) 0)

; ---- operator functions as values
(= (+ ..a) (? #a==0 0 (: r=a[0] (for i 1..#a r=(add2 r a[i])) r)))
(= (- ..a) 0)
(= (* ..a) 1)
(= (/ ..a) 0)
(= (< a b) (lt2 a b))
(= (> a b) (gt2 a b))
(= (<= a b) (le2 a b))
(= (>= a b) (ge2 a b))
(= (== a b) (eq2 a b))
(= (!= a b) (ne2 a b))
(= (% a b) (mod2 a b))
(= (// a b) (fdiv2 a b))
(= (** a b) (pow2 a b))
(= (! a) (? a false true))
(= (& ..a) 0)
(= (| ..a) 0)
(= (^ ..a) 0)
(= (<< a b) (shl2 a b))
(= (>> a b) (shr2 a b))
(= (>>> a b) (ushr2 a b))
(= (bnot a) (bnot1 a))

(= (# x) (len x))
(= (.. a b step) ($throw "range: not yet"))
; ---- lists (minimal for now): rest-parameter lists are built by the call machinery
(= (list ..a) a)
(= (map ..a) ($throw "maps: not yet"))
(= (at l i) ($ldw ($ldw l 2) (+ i 1)))
(= (len l) (? ($isnum l) l ($ldw l 1)))
(= (slice l a b) ($throw "slice: not yet"))
(= (toarr x) x)
(= (concat ..a) ($throw "concat: not yet"))
(= (iter x) (? ($isnum x) nil x))
(= (isnum x) ($isnum x))
(= (apply f l) ($throw "apply: not yet"))
(= (put a b c) ($throw "put: not yet"))
(= (dot a b) ($throw "dot: not yet"))
(= (setdot a b c) ($throw "setdot: not yet"))
(= (sym s) s)

; ---- printing
(= (itoa n)
  neg=(< n 0) m=(? neg (- n) n)
  d=1 t=m (wh (>= t 10) t=($ffloor ($fdiv t 10)) d+=1)
  n2=(? neg d+1 d)
  s=($newb 1 n2 n2)
  i=n2-1
  (wh (>= i (? neg 1 0)) ($stb s i (+ (mod2 m 10) 48)) m=($ffloor ($fdiv m 10)) i-=1)
  (? neg ($stb s 0 45))
  s)
(= (p1 x)
  (? ($isnum x) (write 1 (itoa x))
     ($isnil x) (write 1 "nil")
     ($eqp x true) (write 1 "true")
     ($eqp x false) (write 1 "false")
     ($isptr x) (write 1 x)))
(= (p ..xs)
  (for i #xs (? i>0 (write 1 " ")) (p1 xs[i]))
  (write 1 "\n") nil)
