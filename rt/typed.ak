; Native runtime: typed arrays (u8 i8 u16 i16 u32 i32 f32 f64). Object: [hdr: type 9 | kind<<8 | byte length<<32][bytes...]
;   kind: 0 u8, 1 i8, 2 u16, 3 i16, 4 u32, 5 i32, 6 f32, 7 f64
(= (istyped x) (&& ($isptr x) (== ($type x) 9)))
(= (tkind x) ($band ($ushr ($bitslo ($ldw x 0)) 8) 255))
(= (tsize kind) (sw kind 0 1 1 1 2 2 3 2 4 4 5 4 6 4 8))
(= (tlen x) ($ffloor ($fdiv ($hlen x) (tsize (tkind x)))))
(= (tnew kind n)
  bytes=n*(tsize kind) x=($newb 9 bytes bytes)
  ($stw x 0 ($frombits ($bitshi ($ldw x 0)) ($fadd ($band ($bitslo ($ldw x 0)) 255) (* kind 256)))) x)
(= (tget x i)         ; i: valid index
  k=(tkind x)
  (sw k
    0 ($ldb x i)
    1 (: v=($ldb x i) (? v>=128 v-256 v))
    2 ($ld16 x 2*i)
    3 (: v=($ld16 x 2*i) (? v>=32768 v-65536 v))
    4 (+ ($ld16 x 4*i) (* 65536 ($ld16 x 4*i+2)))
    5 (: v=(+ ($ld16 x 4*i) (* 65536 ($ld16 x 4*i+2))) (? v>=2147483648 v-4294967296 v))
    6 ($ldf32 x 4*i)
    ($ldw x i+1)))
(= (tput x i v)
  k=(tkind x) v=(tonum v)
  (sw k
    [0 1] ($stb x i v)
    [2 3] ($st16 x 2*i v)
    [4 5] (: ($st16 x 4*i v) ($st16 x 4*i+2 ($ffloor ($fdiv v 65536))))
    6 ($stf32 x 4*i v)
    ($stw x i+1 v))
  v)
(= (tarr kind a)      ; constructor: a is a length or a list/typed array/string
  (? ($isnum a) (tnew kind a)
     (: l=(toarr a) n=#l x=(tnew kind n) (for i n (tput x i (lget l i))) x)))
(= (u8 a) (tarr 0 a))
(= (i8 a) (tarr 1 a))
(= (u16 a) (tarr 2 a))
(= (i16 a) (tarr 3 a))
(= (u32 a) (tarr 4 a))
(= (i32 a) (tarr 5 a))
(= (f32 a) (tarr 6 a))
(= (f64 a) (tarr 7 a))
(= (typed_list x) n=(tlen x) r=(mklist n) (for i n (lpush r (tget x i))) r)
(= (@! c i) (at c i))
(= (<@! c i v) (put c i v))
(= (blen p) (? (istyped p) ($hlen p) (islist p) #p ($throw "bcat: expected a list or u8 array")))
(= (bcat ..parts)
  total=0 (for p parts total+=(blen p))
  r=(u8 total) off=0
  (for p parts
    (? (istyped p) ($copy r off p 0 ($hlen p))
       (for i #p ($stb r off+i (lget p i))))
    off+=(blen p))
  r)
