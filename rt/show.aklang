; Native runtime part 4: printing, number formatting/parsing, fmt, json, IO.
(= (fmtint x)                  ; integral x; any magnitude (see the last branch)
  neg=x<0 x=(? neg ($fsub 0 x) x)
  (? x<10 (? neg (strcat2 "-" (lget CHARS 48+x)) (lget CHARS 48+x))        ; one digit: the shared 1-char strings
     x<9007199254740992 (: n=($ndig x) len=(? neg n+1 n) s=(strnew len)
                           ($utoa s len x)
                           (? neg ($stb s 0 45))
                           s)
     (fmtnum (? neg ($fsub 0 x) x))))                                       ; beyond 2^53 (or inf/nan): shortest digits like show and the JS target
(= (digits_unused m)                  ; m: integral double < 1e17 -> decimal digit string
  (? m<9007199254740992 (fmtint m)
     (: hi=($ffloor ($fdiv m 100000000)) lo=($fsub m ($fmul hi 100000000))
        (? lo<0 (: hi=($fsub hi 1) lo=($fadd lo 100000000)))
        (strcat2 (fmtint hi) (padl (fmtint lo) 8 "0")))))
P10=nil
(= (pow10 k)                   ; 10^k, exact for 0 <= k <= 22
  (? ($isnil P10) (: l=(mklist 23) v=1 (for i 23 (lpush l v) v=($fmul v 10)) (<- P10 l)))
  (lget P10 k))
(= (scale10 m e)               ; m * 10^e with a single rounding when |e| <= 22
  (? e==0 m
     e>0 (: (wh e>22 m=($fmul m 1e22) e-=22) ($fmul m (pow10 e)))
     (: e=($fsub 0 e) (wh e>22 m=($fdiv m 1e22) e-=22) ($fdiv m (pow10 e)))))
(= (fmtflt x)
  neg=x<0 ax=(abs x) r=(shortest ax) ds=r[0] n=r[1] k=#ds
  s=(? (&& k<=n n<=21) (strcat2 ds (rpt "0" n-k))
       (&& 0<n n<=21) (strcat2 (strcat2 (strslice ds 0 n) ".") (strslice ds n k))
       (&& -6<n n<=0) (strcat2 (strcat2 "0." (rpt "0" (- n))) ds)
       (: e=n-1 es=(strcat2 (? e<0 "-" "+") (fmtint (abs e)))
          (? k==1 (strcat2 (strcat2 ds "e") es)
             (strcat2 (strcat2 (strcat2 (strslice ds 0 1) ".") (strslice ds 1 k)) (strcat2 "e" es)))))
  (? neg (strcat2 "-" s) s))
(= (fmtnum x)
  (? (&& (== x ($ffloor x)) (< x 9007199254740992) (> x -9007199254740992)) (fmtint x)       ; integers first: by far the most common
     (!= x x) "NaN"
     (== x 0) "0"
     (> x 1.7976931348623157e308) "Infinity"
     (< x -1.7976931348623157e308) "-Infinity"
     (&& (== x ($ffloor x)) (< (abs x) 9007199254740992)) (fmtint x)
     (fmtflt x)))

; ---- show: printable form (strings quoted)
(= (jquote s)
  n=($hlen s) extra=0
  (for i n c=($ldb s i) (? (|| c==34 c==92) extra+=1 c<32 extra+=(? (|| c==8 c==9 c==10 c==12 c==13) 1 5)))
  r=(strnew n+extra+2) o=0 ($stb r 0 34) o=1
  (for i n c=($ldb s i)
    (? (|| c==34 c==92) (: ($stb r o 92) ($stb r o+1 c) o+=2)
       c<32 (? (== c 8) (: ($stb r o 92) ($stb r o+1 98) o+=2)
                (== c 9) (: ($stb r o 92) ($stb r o+1 116) o+=2)
                (== c 10) (: ($stb r o 92) ($stb r o+1 110) o+=2)
                (== c 12) (: ($stb r o 92) ($stb r o+1 102) o+=2)
                (== c 13) (: ($stb r o 92) ($stb r o+1 114) o+=2)
                (: ($stb r o 92) ($stb r o+1 117) ($stb r o+2 48) ($stb r o+3 48)
                   ($stb r o+4 (+ 48 (>> c 4))) ($stb r o+5 (? (< (& c 15) 10) (+ 48 (& c 15)) (+ 87 (& c 15)))) o+=6))
       (: ($stb r o c) o+=1)))
  ($stb r o 34) r)
(= (show x)
  (? ($isnum x) (fmtnum x)
     ($isnil x) "nil"
     ($eqp x true) "true"
     ($eqp x false) "false"
     (: t=($type x)
        (? t==1 (jquote x)
           t==7 (symstr x)
           t==2 (: (<- SD SD+1) (? SD>10000 (cyclic)) parts=(mklist ($ldw x 1)) (for i ($ldw x 1) (lpush parts (show (lget x i)))) (<- SD SD-1) (strcat2 (strcat2 "[" (join parts " ")) "]"))
           (&& t==4 (isre x)) (strcat2 (strcat2 (strcat2 "/" x.src) "/") x.flags)
           t==4 (: (<- SD SD+1) (? SD>10000 (cyclic)) parts=(mklist ($ldw x 1)) ent=($ldw x 2)
                   (for e ($ldw x 4) k=($ldw ent 2*e+1)
                     (? (! ($eqp k UNDEF)) (lpush parts (strcat2 (strcat2 (show k) " ") (show ($ldw ent 2*e+2))))))
                   (<- SD SD-1) (strcat2 (strcat2 "{" (join parts " ")) "}"))
           t==5 "<fn>"
           t==8 (strcat2 (strcat2 "[" (join (bytes x) " ")) "]")
           t==10 (strcat2 (bigstr x) "n")
           t==9 (strcat2 (strcat2 "[" (join (~ show (typed_list x)) " ")) "]")
           "<obj>"))))

; ---- printing
(= (p ..a) n=#a (for i n (? i>0 (out " ")) (out (tostr (lget a i)))) (out "\n") (? n (lget a n-1) nil))
(= (p1 x) (out (tostr x)) (out "\n") x)
(= (pr ..a) n=#a (for i n (? i>0 (out " ")) (out (tostr (lget a i)))) (? n (lget a n-1) nil))
(= (ep ..a) (eout (strcat2 (join a " ") "\n")) (? #a (lget a #a-1) nil))

; ---- number parsing
(= (isdig c) (&& c>=48 c<=57))
(= (digitval c) (? (&& c>=48 c<=57) c-48 (&& c>=97 c<=122) c-87 (&& c>=65 c<=90) c-55 99))
(= (parseradix s start n radix)
  (? start>=n nil
     (: v=0 ok=true i=start
        (wh (&& ok i<n) d=(digitval ($ldb s i)) (? d>=radix ok=false (: v=($fadd ($fmul v radix) d) i+=1)))
        (? ok v nil))))
(= (parsedec s i n)
  i0=i (wh (&& i<n (isdig ($ldb s i))) i+=1) i1=i j0=i j1=i
  (? (&& i<n (== ($ldb s i) 46)) (: i+=1 j0=i (wh (&& i<n (isdig ($ldb s i))) i+=1) j1=i))
  (? (== (+ (- i1 i0) (- j1 j0)) 0) nil
     (: ex=0 ok=true
        (? (&& i<n (|| (== ($ldb s i) 101) (== ($ldb s i) 69)))
           (: i+=1 eneg=false
              (? (&& i<n (|| (== ($ldb s i) 43) (== ($ldb s i) 45))) (: eneg=(== ($ldb s i) 45) i+=1))
              ed=0 (wh (&& i<n (isdig ($ldb s i))) (? ex<100000000 ex=($fadd ($fmul ex 10) (- ($ldb s i) 48))) i+=1 ed+=1)
              (? ed==0 ok=false)
              (? eneg ex=($fsub 0 ex))))
        (? (&& ok i==n)
           (: dg=(strcat2 (strslice s i0 i1) (strslice s j0 j1)) e10=ex-(j1-j0) a=0
              (wh (&& a<#dg (== ($ldb dg a) 48)) a+=1)
              b=#dg (wh (&& b>a (== ($ldb dg b-1) 48)) b-=1)
              (? a==b 0
                 e10+#dg-b+(b-a)<-400 0
                 e10+#dg-b+(b-a)>400 ($fdiv 1 0)
                 (strtod (strslice dg a b) e10+(#dg-b))))
           nil))))
(= (num s) r=(num0 s) (? (&& (! ($isnil r)) (== (absn r) ($fdiv 1 0))) nil r))      ; Infinity and out-of-range text are not numbers
(= (num0 s)
  (? ($isnum s) s
     (! (isstr s)) nil
     (: s=(trim s) n=($hlen s)
        (? n==0 nil
           (: c=($ldb s 0)
              (? (&& n>2 c==48 (|| (== ($ldb s 1) 120) (== ($ldb s 1) 88))) (parseradix s 2 n 16)
                 (&& n>2 c==48 (|| (== ($ldb s 1) 98) (== ($ldb s 1) 66))) (parseradix s 2 n 2)
                 (&& n>2 c==48 (|| (== ($ldb s 1) 111) (== ($ldb s 1) 79))) (parseradix s 2 n 8)
                 (: neg=false i=0
                    (? (|| c==43 c==45) (: neg=(c==45) i=1))
                    v=(? (streq (strslice s i n) "Infinity") ($fdiv 1 0) (parsedec s i n))
                    (? (&& (! ($isnil v)) neg) ($fsub 0 v) v))))))))

; ---- fmt: %[-][0][width][.prec](s|d|f|x|X|b|o|%)
(= (toradix_big x radix)                 ; exact digits of a huge integral double (>= 2^53), like the JS target
  a=(bigunwrap (bigfromnum x)) buf=(strnew 1100) i=1100
  (wh #a>0 qr=(bn_divmod_small a radix) d=qr[1] i-=1 ($stb buf i (? d<10 48+d 87+d)) a=qr[0])
  (strslice buf i 1100))
(= (toradix x radix)
  neg=x<0 x=(abs ($ftrunc x))
  (? x==0 "0"
     (!= x x) "NaN"
     (== x ($fdiv 1 0)) (strcat2 (? neg "-" "") "Infinity")
     x>=9007199254740992 (strcat2 (? neg "-" "") (toradix_big x radix))
     (: buf=(strnew 64) i=64
        (wh x>0 q=($ffloor ($fdiv x radix)) d=($fsub x ($fmul q radix)) i-=1 ($stb buf i (? d<10 48+d 87+d)) x=q)
        (? neg (: i-=1 ($stb buf i 45)))
        (strslice buf i 64))))
(= (rneint ax k)                        ; round-half-even(ax * 10^k) as a digit string (k may be negative); ax is a finite number >= 0
  d=(? ax==0 (list 0 0) (decomp ax)) mz=d[0] ez=d[1]
  num=(bn_mul_big (bn_small mz) (bn_pow10 (? k>0 k 0))) num=(? ez>0 (bn_shl num ez) num)
  den=(bn_mul_big (bn_pow10 (? k<0 0-k 0)) (bn_pow2 (? ez<0 0-ez 0)))
  qr=(bn_divmod num den) q=qr[0] r2=(bn_mul_small qr[1] 2) c=(bn_cmp r2 den)
  (? (|| c>0 (&& c==0 (== (% (? #q>0 q[0] 0) 2) 1))) q=(bn_add q [1]))
  (bn_tostr (bn_norm q)))
(= (fixeddigits ax k)                   ; ax with k decimals, correctly rounded half to even (%f of C)
  ds=(rneint ax k) ds=(? (<= #ds k) (strcat2 (rpt "0" k+1-#ds) ds) ds)
  (? k==0 ds (strcat2 (strcat2 (strslice ds 0 #ds-k) ".") (strslice ds #ds-k #ds))))
(= (expform ax p)                       ; [digits exponent] of ax in scientific form with p decimals: "1234" 3 for p=3, ax=1234.4
  e=(? ax==0 0 ($ffloor (log10 ax))) ds="" tries=0
  (? ax==0 ds=(rpt "0" p+1)
     (wh (&& tries<4 #ds!=p+1)
       ds=(rneint ax p-e)
       (? #ds>p+1 e+=1 #ds<p+1 e-=1) tries+=1))
  [ds e])
(= (fmt_e x p up)                       ; %e: d.ddde+XX
  ax=(abs x) r=(expform ax p) ds=r[0] e=r[1]
  (strcat2 (strcat2 (strslice ds 0 1) (? p>0 (strcat2 "." (strslice ds 1 p+1)) "")) (strcat2 (? up "E" "e") (strcat2 (? e<0 "-" "+") (padzero (fmtint (abs e)) 2)))))
(= (fmtfloat x prec kind up)
  (? (|| (!= x x) (> (abs x) 1.7976931348623157e308)) (fmtnum x)
     (strcat2 (? x<0 "-" "") (? kind==0 (fmt_e (abs x) prec up) (fmt_g (abs x) prec up)))))
(= (padzero s n) (? (< #s n) (strcat2 (rpt "0" n-#s) s) s))
(= (stripzeros s)                       ; "1.500" -> "1.5", "2.000" -> "2" (%g without the # flag)
  (? (< (strfind s "." 0) 0) s
     (: n=#s (wh (== ($ldb s n-1) 48) n-=1) (? (== ($ldb s n-1) 46) n-=1) (strslice s 0 n))))
(= (fmt_g x p up)                       ; %g: shortest of %e and %f for the precision, trailing zeros removed
  p=(? p==0 1 p) ax=(abs x) x10=(expform ax p-1) e=x10[1]
  (? (&& e>=-4 e<p) (stripzeros (fixeddigits ax p-1-e))
     (: m=(fmt_e ax p-1 up) i=(strfind m (? up "E" "e") 0)
        (strcat2 (stripzeros (strslice m 0 i)) (strslice m i #m)))))
(= (fmt f ..a)
  r=(mklist 8) n=#f i=0 ai=0
  (wh i<n
    c=($ldb f i)
    (? (!= c 37) (: j=i (wh (&& j<n (!= ($ldb f j) 37)) j+=1) (lpush r (strslice f i j)) i=j)
       (: i+=1 left=false zero=false w=0 prec=nil sg=0
          (wh (&& i<n (|| (== ($ldb f i) 45) (== ($ldb f i) 48) (== ($ldb f i) 43) (== ($ldb f i) 32)))
            c=($ldb f i) (? c==45 left=true c==48 zero=true c==43 sg=43 (? sg==0 sg=32)) i+=1)
          (wh (&& i<n (isdig ($ldb f i))) w=w*10+(($ldb f i)-48) i+=1)
          (? (&& i<n (== ($ldb f i) 46)) (: i+=1 prec=0 (wh (&& i<n (isdig ($ldb f i))) prec=prec*10+(($ldb f i)-48) i+=1)))
          (? i>=n ($throwk 0 "fmt: incomplete format"))
          t=($ldb f i) i+=1
          (? t==37 (lpush r "%")
             (: (? ai>=#a ($throwk 0 (strcat2 "fmt: missing argument for %" (chr t)))) v=(lget a ai) ai+=1
                s=(sw t
                    115 (: s=(tostr v) (? (! ($isnil prec)) (strslice s 0 (? prec<#s prec #s)) s))
                    100 (? (isbig v) (bigstr v) (fmtint ($ftrunc (tonum v))))
                    102 (tofixed (tonum v) (?? prec 6))
                    120 (toradix (tonum v) 16)
                    88 (up (toradix (tonum v) 16))
                    98 (toradix (tonum v) 2)
                    111 (toradix (tonum v) 8)
                    101 (fmtfloat (tonum v) (?? prec 6) 0 false)
                    69 (fmtfloat (tonum v) (?? prec 6) 0 true)
                    103 (fmtfloat (tonum v) (?? prec 6) 1 false)
                    71 (fmtfloat (tonum v) (?? prec 6) 1 true)
                    99 (chr (tonum v))
                    ($throwk 0 (strcat2 "fmt: unknown specifier %" (chr t))))
                numeric=(has [100 102 101 69 103 71] t)
                s=(? (&& sg!=0 numeric (!= ($ldb s 0) 45)) (strcat2 (chr sg) s) s)
                pad=w-#s
                (lpush r (? pad<=0 s left (strcat2 s (rpt " " pad))
                            zero (? (&& #s>0 (|| (== ($ldb s 0) 45) (&& sg!=0 numeric))) (strcat2 (strslice s 0 1) (strcat2 (rpt "0" pad) (strslice s 1 #s))) (strcat2 (rpt "0" pad) s))
                            (strcat2 (rpt " " pad) s))))))))
  (? ai<#a ($throwk 0 "fmt: too many arguments"))
  (join r ""))

; ---- json (encoder appends into one growing buffer)
JB=""
JN=0
(= (jroom k)
  (? JN+k>($hlen JB) (: m=($hlen JB)*2 nb=(strnew (? m>JN+k m JN+k+64)) ($copy nb 0 JB 0 JN) (<- JB nb))))
(= (jcat s) n=($hlen s) (jroom n) ($copy JB JN s 0 n) (<- JN JN+n) nil)
(= (jbyte c) (jroom 1) ($stb JB JN c) (<- JN JN+1) nil)
(= (jqput s)
  n=($hlen s) i=0 hi=false
  (wh (&& i<n (>= ($ldb s i) 32) (!= ($ldb s i) 34) (!= ($ldb s i) 92)) (? (>= ($ldb s i) 128) hi=true) i+=1)
  (? (&& (|| hi i<n) (>= (utf8bad s) 0)) ($throwk 3 "json: string is not valid UTF-8; encode binary data as hex or base64 first"))
  (? i==n (: (jroom n+2) ($stb JB JN 34) ($copy JB JN+1 s 0 n) ($stb JB JN+n+1 34) (<- JN JN+n+2))
     (jcat (jquote s)))
  nil)
(= (jnl ind lvl)
  (? ind (: k=ind*lvl (jroom k+1) ($stb JB JN 10) (<- JN JN+1)
            (for i k ($stb JB JN+i 32)) (<- JN JN+k))))
(= (jenc x ind lvl)
  (? ($isnil x) (jcat "null")
     ($isnum x) (? (|| (!= x x) (> (abs x) 1.7976931348623157e308)) ($throwk 2 (strcat2 "json: cannot write " (fmtnum x))) (jcat (fmtnum x)))
     (isbig x) (jcat (bigstr x))
     (isbool x) (jcat (? x "true" "false"))
     (isstr x) (jqput x)
     (issym x) (jqput (symstr x))
     (istyped x) (jenc (typed_list x) ind lvl)
     (&& (> lvl 10000) (|| (islist x) (ismap x))) (cyclic)
     (islist x) (? ($ldw x 1)==0 (jcat "[]")
                   (: (jbyte 91) n=($ldw x 1)
                      (for i n (? i>0 (jbyte 44)) (jnl ind lvl+1) (jenc (lget x i) ind lvl+1))
                      (jnl ind lvl) (jbyte 93)))
     (ismap x) (? ($ldw x 1)==0 (jcat "{}")
                  (: (jbyte 123) first=true ent=($ldw x 2) used=($ldw x 4)
                     (for e used k=($ldw ent 2*e+1)
                       (? (! ($eqp k UNDEF))
                          (: (? first first=false (jbyte 44)) (jnl ind lvl+1)
                             (jqput (tostr k)) (jbyte 58) (? ind (jbyte 32))
                             (jenc ($ldw ent 2*e+2) ind lvl+1))))
                     (jnl ind lvl) (jbyte 125)))
     (jcat "null")))
(= (json x ind=nil)
  (? (&& ($isnum ind) (> ind 100)) ($throwk 2 (strcat2 "invalid length: " (tostr ind))))
  (<- JB (strnew 256)) (<- JN 0)
  (jenc x ind 0)
  r=(strslice JB 0 JN) (<- JB "") r)
