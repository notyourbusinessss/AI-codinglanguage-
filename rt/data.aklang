; Native runtime part 2: strings, lists, symbols, library. Object layouts (word 0 is the header = type | length<<32):
;   STR/SYM/BYTES: [hdr][bytes...]     SYM additionally has [line][col] words after the padded name
;   LIST: [hdr][len (double)][arr][hash id]     ARR: [hdr][cap words]
;   MAP: [hdr][count][entries ARR k,v interleaved][index ARR][used][hash id]

; ---- strings (UTF-8 byte strings)
(= (strnew n) ($newb 1 n n))
CHARS=nil
(= (chr1 b) (? ($isnil CHARS) (: s=(strnew 1) ($stb s 0 b) s) (lget CHARS b)))
(= (chars_init) l=(mklist 256) (for b 256 s=(strnew 1) ($stb s 0 b) (lpush l s)) (<- CHARS l))
(= (strcat2 a b) la=($hlen a) lb=($hlen b) s=(strnew la+lb) ($copy s 0 a 0 la) ($copy s la b 0 lb) s)
(= (strslice s a b) n=b-a r=(strnew n) ($copy r 0 s a n) r)
(= (streq a b) n=($hlen a)
  (? ($eqp a b) true (!= n ($hlen b)) false
     (: i=0 (wh (&& (< i n) (== ($ldb a i) ($ldb b i))) i+=1) (== i n))))
(= (strcmp a b) na=($hlen a) nb=($hlen b) m=(? na<nb na nb) i=0
  (wh (&& (< i m) (== ($ldb a i) ($ldb b i))) i+=1)
  (? i<m (? (< ($ldb a i) ($ldb b i)) -1 1) (? na<nb -1 na>nb 1 0)))
(= (needstr s) (? (! (isstr s)) ($throwk 3 (strcat2 "expected string, got " (ty s)))) s)
(= (strfind s p from)             ; index of p in s at or after from, or -1 (the search itself is the assembly stub .strfind)
  n=($hlen s) m=($hlen p)
  (? m==0 (? from<=n from -1) ($find s p (? from<0 0 from))))
(= (idx c x)
  (? (isstr c) (strfind c (needstr x) 0)
     (: l=(toarr c) r=-1 i=0 n=#l
        (? ($isnum x) (wh (&& r<0 i<n) e=(lget l i) (? (&& ($isnum e) (== e x)) r=i) i+=1)           ; scalars compare inline; only lists/maps/bigs need eq2
           (isstr x) (wh (&& r<0 i<n) e=(lget l i) (? ($streq x e) r=i) i+=1)
           (! ($isptr x)) (wh (&& r<0 i<n) e=(lget l i) (? ($eqp e x) r=i) i+=1)
           (wh (&& r<0 i<n) (? (eq2 (lget l i) x) r=i) i+=1))
        r)))
(= (has c x)
  (? ($isnil c) false
     (isstr c) (>= (strfind c (needstr x) 0) 0)
     (ismap c) (maphas c x)
     (>= (idx c x) 0)))
(= (starts s p) (needstr s) (needstr p) n=($hlen p)
  (? n>($hlen s) false (: i=0 (wh (&& (< i n) (== ($ldb s i) ($ldb p i))) i+=1) (== i n))))
(= (ends s p) (needstr s) (needstr p) n=($hlen p) m=($hlen s)
  (? n>m false (: i=0 (wh (&& (< i n) (== ($ldb s m-n+i) ($ldb p i))) i+=1) (== i n))))
(= (isspace b) (|| b==32 (&& b>=9 b<=13)))
(= (trim s) (needstr s) n=($hlen s) a=0 b=n
  (wh (&& (< a b) (isspace ($ldb s a))) a+=1)
  (wh (&& (> b a) (isspace ($ldb s b-1))) b-=1)
  (? (&& a==0 b==n) s (strslice s a b)))
(= (cuc c)                              ; simple upper-case mapping of one code point: ASCII, Latin-1, Latin Extended-A, Greek, Cyrillic
  (? c<128 (? (&& c>=97 c<=122) c-32 c)
     (&& c>=224 c<=254 c!=247) c-32
     c==255 376 c==181 924
     (&& c>=256 c<=303) (? (== (c&1) 1) c-1 c)
     (&& c>=306 c<=311) (? (== (c&1) 1) c-1 c)
     (&& c>=314 c<=328) (? (== (c&1) 0) c-1 c)
     (&& c>=330 c<=375) (? (== (c&1) 1) c-1 c)
     (&& c>=378 c<=382) (? (== (c&1) 0) c-1 c)
     c==383 83
     c==940 902 (&& c>=941 c<=943) c-37 c==972 908 (&& c>=973 c<=974) c-63 c==962 931
     (&& c>=945 c<=971) c-32
     (&& c>=1072 c<=1103) c-32
     (&& c>=1104 c<=1119) c-80
     c))
(= (clo c)                              ; simple lower-case mapping of one code point
  (? c<128 (? (&& c>=65 c<=90) c+32 c)
     (&& c>=192 c<=222 c!=215) c+32
     c==376 255
     (&& c>=256 c<=303) (? (== (c&1) 0) c+1 c)
     (&& c>=306 c<=311) (? (== (c&1) 0) c+1 c)
     (&& c>=313 c<=327) (? (== (c&1) 1) c+1 c)
     (&& c>=330 c<=375) (? (== (c&1) 0) c+1 c)
     (&& c>=377 c<=381) (? (== (c&1) 1) c+1 c)
     c==902 940 (&& c>=904 c<=906) c+37 c==908 972 (&& c>=910 c<=911) c+63
     (&& c>=913 c<=939 c!=930) c+32
     (&& c>=1040 c<=1071) c+32
     (&& c>=1024 c<=1039) c+80
     c))
(= (recase s f) n=($hlen s) parts=(mklist 16) i=0
  (wh i<n b=($ldb s i) k=(? (&& b>=194 b<224 i+1<n (== ($band ($ldb s i+1) 192) 128)) 2 1)
    (lpush parts (? b<128 (chr (f b)) k==1 (strslice s i i+1) (chr (f (ord (strslice s i i+2))))))
    i+=k)
  (join parts ""))
(= (hasnonascii s) n=($hlen s) i=0 (wh (&& i<n (< ($ldb s i) 128)) i+=1) i<n)
(= (up s) (needstr s) n=($hlen s)
  (? (hasnonascii s) (recase s cuc)
     (: r=(strnew n) (for i n b=($ldb s i) ($stb r i (? (&& b>=97 b<=122) b-32 b))) r)))
(= (lo s) (needstr s) n=($hlen s)
  (? (hasnonascii s) (recase s clo)
     (: r=(strnew n) (for i n b=($ldb s i) ($stb r i (? (&& b>=65 b<=90) b+32 b))) r)))
(= (split s d=nil)
  (needstr s) r=(mklist 8) n=($hlen s)
  (? (isre d) (rxsplit s d)
     ($isnil d)
     (: i=0
        (wh i<n
          (wh (&& (< i n) (<= ($ldb s i) 32) (isspace ($ldb s i))) i=($fadd i 1))
          (? i<n (: j=i (wh (&& (< j n) (? (> ($ldb s j) 32) true (! (isspace ($ldb s j))))) j=($fadd j 1)) (lpush r (strslice s i j)) i=j)))
        r)
     (: (needstr d) dl=($hlen d)
        (? dl==0 (: (for i n (lpush r (chr1 ($ldb s i)))) r)
           (: a=0
              (wh a>=0
                b=(strfind s d a)
                (? b<0 (: (lpush r (strslice s a n)) a=-1) (: (lpush r (strslice s a b)) a=b+dl)))
              r)))))
(= (needcoll x) (? (|| (islist x) ($isnil x) (isstr x) (ismap x) (istyped x)) x ($throwk 3 (strcat2 "expected list, got " (ty x)))))
(= (join l d=nil)
  l=(toarr (needcoll l)) d=(tostr (?? d "")) n=#l parts=(mklist n) pa=($ldw parts 2) total=0
  (for i n x=(lget l i) s=(? (isstr x) x (tostr x)) ($stw pa ($fadd i 1) s) total=($fadd total ($hlen s)))
  ($stw parts 1 n)
  total+=($hlen d)*(? n>0 n-1 0)
  r=(strnew total) off=0 dl=($hlen d)
  (for i n s=(lget parts i) sl=($hlen s) ($copy r off s 0 sl) off=($fadd off sl)
    (? (&& i<n-1 dl>0) (: ($copy r off d 0 dl) off=($fadd off dl))))
  r)
(= (toint x) (? ($isnum x) (? (== x x) ($ftrunc x) 0) x))          ; counts and slice bounds drop their fraction like the JS target (NaN is 0); anything else is left for the caller to reject
(= (rpt x k)
  k=(toint (tonum k)) k=(? k<0 0 k)
  (? (isstr x) (: n=($hlen x) (? n==0 k=0) (needlen n*k 2147483647) r=(strnew n*k) (for i k ($copy r i*n x 0 n)) r)
     (: r=(mklist 8) l=(toarr x) (? #l==0 k=0) (needlen #l*k 134217728) (for i k (for y l (lpush r y))) r)))
(= (rep s a b)
  (needstr s)
  (? (isre a) (rxreplace s a b)
     (: (needstr a) b=(tostr b)
        (? ($hlen a)==0 s
           (: parts=(split s a) (join parts b))))))
(= (padl s n c=nil) s=(tostr s) c=(?? c " ") m=n-($hlen s)
  (? m<=0 s (strcat2 (rpt c m) s)))
(= (padr s n c=nil) s=(tostr s) c=(?? c " ") m=n-($hlen s)
  (? m<=0 s (strcat2 s (rpt c m))))
(= (chr n)
  (? (|| (! ($isnum n)) (! (isint n)) n<0 n>1114111 (&& n>=55296 n<=57343)) ($throw (strcat2 "chr: invalid code point " (show n))))
  (? n<128 (chr1 n)
     n<2048 (: r=(strnew 2) ($stb r 0 192+(n>>6)) ($stb r 1 128+(n&63)) r)
     n<65536 (: r=(strnew 3) ($stb r 0 224+(n>>12)) ($stb r 1 128+((n>>6)&63)) ($stb r 2 128+(n&63)) r)
     (: r=(strnew 4) ($stb r 0 240+(n>>18)) ($stb r 1 128+((n>>12)&63)) ($stb r 2 128+((n>>6)&63)) ($stb r 3 128+(n&63)) r)))
(= (ord s) (needstr s) n=($hlen s)
  (? n==0 nil
     (: b=($ldb s 0)
        (? (|| b<128 n<2) b
           b<224 ((b&31)<<6)+(($ldb s 1)&63)
           b<240 ((b&15)<<12)+((($ldb s 1)&63)<<6)+(($ldb s 2)&63)
           ((b&7)<<18)+((($ldb s 1)&63)<<12)+((($ldb s 2)&63)<<6)+(($ldb s 3)&63)))))
(= (bytes s) (needstr s) n=($hlen s) r=(mklist n) (for i n (lpush r ($ldb s i))) r)
; list of byte values -> string (used by wr)
(= (frombytes l) n=#l r=(strnew n) (for i n ($stb r i (lget l i))) r)

; ---- symbols: interned by name (sym); mksym makes a fresh positioned one
(= (symnew s line col) n=($hlen s) pad=(($hlen s)+7)&-8 r=($newb 7 pad+16 n) ($copy r 0 s 0 n)
  ($stw r 1+pad/8 line) ($stw r 2+pad/8 col) r)
SYMTAB=nil
(= (sym s)
  (? (issym s) s
     (: (needstr s)
        (? ($isnil SYMTAB) (<- SYMTAB (map)))
        (? (maphas SYMTAB s) (mapget SYMTAB s)
           (: r=(symnew s 0 0) (mapset SYMTAB s r) r)))))
(= (mksym s line col) (symnew (tostr s) line col))
(= (symline s) (? (issym s) ($ldw s 1+(($hlen s)+7)/8) 0))
(= (symcol s) (? (issym s) ($ldw s 2+(($hlen s)+7)/8) 0))
(= (symstr s) n=($hlen s) r=(strnew n) ($copy r 0 s 0 n) r)

; ---- lists
(= (mklist cap) arr=($new 3 cap cap) l=($new 2 3 3) ($stw l 1 0) ($stw l 2 arr) l)
(= (lgrow arr n) cap=(? ($hlen arr)<4 4 ($hlen arr)*2) a2=($new 3 cap cap) ($copy a2 0 arr 0 n*8) a2)
(= (lpush l x) n=($ldw l 1) arr=($ldw l 2)
  (? n>=($hlen arr) (: arr=(lgrow arr n) ($stw l 2 arr)))
  ($stw arr n+1 x) ($stw l 1 n+1) x)
(= (lget l i) ($ldw ($ldw l 2) i+1))
(= (lset l i x) ($stw ($ldw l 2) i+1 x))
(= (lat l i) n=($ldw l 1) (? i<0 i=n+i) (? (&& i>=0 i<n) (lget l i) nil))
(= (needlist l) (? (! (islist l)) ($throwk 3 (strcat2 "expected list, got " (ty l)))) l)
(= (destr x) (? (|| (islist x) ($isnil x)) (toarr x) (needlist x)))   ; destructuring source: a list, or nil (all nils)
(= (push l ..xs) (needlist l) (for x xs (lpush l x)) l)
(= (push1 l x) (? (! (islist l)) (needlist l)) (lpush l x) l)         ; (push l x) with exactly one value: called directly, no rest list
(= (max2 a b) (? (&& ($isnum a) ($isnum b)) (? b>a b a) (|| (isbig a) (isbig b)) (? (gt2 b a) b a) (: a=(tonum a) b=(tonum b) (? b>a b a))))
(= (min2 a b) (? (&& ($isnum a) ($isnum b)) (? b<a b a) (|| (isbig a) (isbig b)) (? (lt2 b a) b a) (: a=(tonum a) b=(tonum b) (? b<a b a))))
(= (append1 l x) (needlist l) n=($ldw l 1) r=(mklist n+1) arr=($ldw r 2) ($copy arr 0 ($ldw l 2) 0 n*8) ($stw arr n+1 x) ($stw r 1 n+1) r)
(= (pop l) (needlist l) n=($ldw l 1)
  (? n==0 nil (: arr=($ldw l 2) x=($ldw arr n) ($stw arr n nil) ($stw l 1 n-1) x)))
(= (list ..a) a)
(= (copylist l) n=($ldw l 1) r=(mklist n) ($copy ($ldw r 2) 0 ($ldw l 2) 0 n*8) ($stw r 1 n) r)
(= (+> l ..x) (needlist l) (concat l x))
(= (concat ..ls) total=0 (for l ls total+=($ldw l 1))
  r=(mklist total) arr=($ldw r 2) off=0
  (for l ls n=($ldw l 1) ($copy arr off*8 ($ldw l 2) 0 n*8) off+=n)
  ($stw r 1 total) r)
(= (.. a b=nil s=nil)
  (? ($isnil b) (: b=a a=0)) s=(?? s 1)
  (? s==0 ($throw "..: zero step"))
  (? (&& s==1 ($isnum a) ($isnum b) (isint a) a<4503599627370496 a>-4503599627370496 b-a<134217728)
     (: n=(? b>a ($fceil ($fsub b a)) 0) r=(mklist n) arr=($ldw r 2) (for i n ($stw arr i+1 a+i)) ($stw r 1 n) r)
     (: (? (&& ($isnum a) ($isnum b) ($isnum s) (> (/ (- b a) s) 134217728)) ($throwk 2 (strcat2 "invalid length: " (tostr (/ (- b a) s)))))
        r=(mklist 8)
        (? s>0 (: i=a (wh i<b (lpush r i) i+=s)) (: i=a (wh i>b (lpush r i) i+=s)))
        r)))
(= (rev l)
  (? (isstr l) (: n=($hlen l) r=(strnew n) (for i n ($stb r i ($ldb l n-1-i))) r)
     (: l=(toarr (needcoll l)) n=#l r=(mklist n) arr=($ldw r 2) (for i n ($stw arr i+1 (lget l n-1-i))) ($stw r 1 n) r)))
(= (enum l) l=(toarr l) n=#l r=(mklist n) arr=($ldw r 2)
  (for i n pa=($new 3 2 2) ($stw pa 1 i) ($stw pa 2 (lget l i)) pl=($new 2 3 3) ($stw pl 1 2) ($stw pl 2 pa) ($stw arr ($fadd i 1) pl))
  ($stw r 1 n) r)
(= (fst l) (? (|| ($isnil l) (== (len l) 0)) nil (at l 0)))
(= (lst l) (? (|| ($isnil l) (== (len l) 0)) nil (at l -1)))
(= (take n l) (slice l 0 n))
(= (drop n l) (slice l n nil))
(= (sub c a b) (slice c a b))
(= (flat l) l=(toarr (needcoll l)) r=(mklist 8) (for x l (? (islist x) (for y x (lpush r y)) (lpush r x))) r)
(= (zip ..ls) ls=(~ toarr ls) m=-1 (for l ls (? (|| m<0 #l<m) m=#l)) m=(? m<0 0 m)
  r=(mklist m) (for i m (lpush r (~ l=>(lget l i) ls))) r)
(= (fnv f)
  (? (isfn f) f
     (|| (islist f) (ismap f) (isstr f)) (x=>(at f x))
     ($throwk 3 (strcat2 "not callable: " (show f)))))
(= (~ f l ..more)
  f=(fnv f) l=(toarr l) n=#l
  (? #more==0 (: r=(mklist n) arr=($ldw r 2) (for i n ($stw arr i+1 (f (lget l i)))) ($stw r 1 n) r)
     (: ls=(~ toarr more) m=n (for x ls (? #x<m m=#x))
        r=(mklist m)
        (for i m (lpush r (apply f (concat [(lget l i)] (~ x=>(lget x i) ls))))) r)))
(= (map1 f l)
  f=(fnv f) l=(toarr l) n=#l r=(mklist n) arr=($ldw r 2) (for i n ($stw arr i+1 (f (lget l i)))) ($stw r 1 n) r)
(= (~? f l) f=(fnv f) l=(toarr l) r=(mklist 8) (for x l (? (f x) (lpush r x))) r)
(= (~~ f l) f=(fnv f) l=(toarr l) r=(mklist 8)
  (for x l y=(f x) (? (islist y) (for z y (lpush r z)) (lpush r y))) r)
(= (~/ f a b=nil)
  f=(fnv f)
  (? ($isnil b)
     (: l=(toarr a) (? #l==0 nil (: r=(lget l 0) (for i 1..#l r=(f r (lget l i))) r)))
     (: l=(toarr b) r=a (for x l r=(f r x)) r)))
(= (any f l) f=(fnv f) l=(toarr l) r=false i=0 n=#l (wh (&& (! r) i<n) (? (f (lget l i)) r=true) i+=1) r)
(= (all f l) f=(fnv f) l=(toarr l) r=true i=0 n=#l (wh (&& r i<n) (? (! (f (lget l i))) r=false) i+=1) r)
(= (ap f l) (apply (fnv f) (toarr l)))
(= (uniq l) l=(toarr (needcoll l)) r=(mklist 8) seen=(map)
  (for x l
    (? (|| (islist x) (ismap x))
       (? (! (any y=>(eq2 x y) r)) (lpush r x))
       (? (! (maphas seen x)) (: (mapset seen x true) (lpush r x)))))
  r)
(= (grp f l) f=(fnv f) m=(map)
  (for x (toarr l) k=(f x) g=(mapget m k) (? g (lpush g x) (mapset m k (list x)))) m)

; ---- sorting (stable merge sort on a copy; runs of 8 by insertion sort, then bottom-up merges between two buffers)
;   K: ARR of sort keys, V: ARR of items moving with them (hasv=false: the keys are the items). mode: 0 all numbers, 1 all strings, 2 anything else
(= (sortmode K n)
  m=(? n>0 (? ($isnum ($ldw K 1)) 0 (isstr ($ldw K 1)) 1 2) 0) i=0
  (wh (&& m<2 i<n) x=($ldw K i+1) (? (? m==0 (! ($isnum x)) (! (isstr x))) m=2) i+=1)
  m)
(= (gtany mode a b) (? mode==1 (> (strcmp a b) 0) (> (cmp a b) 0)))
(= (msortn K n)                 ; numbers only, no items: tight loops (raw index arithmetic, no mode/hasv tests)
  b=0
  (wh b<n
    e=(? b+8<n b+8 n) i=b+1
    (wh i<e
      x=($ldw K i+1) j=i-1
      (wh (&& j>=b (> ($ldw K j+1) x)) ($stw K j+2 ($ldw K j+1)) j=($fsub j 1))
      ($stw K j+2 x)
      i=($fadd i 1))
    b=($fadd b 8))
  K2=($new 3 n n) w=8
  (wh w<n
    lo=0 w2=($fadd w w)
    (wh lo<n
      mid=(? lo+w<n lo+w n) hi=(? lo+w2<n lo+w2 n) i=($fadd lo 1) j=($fadd mid 1) k=i ie=($fadd mid 1) je=($fadd hi 1)
      (wh (&& i<ie j<je)
        x=($ldw K i) y=($ldw K j)
        (? (> x y) (: ($stw K2 k y) j=($fadd j 1))
                   (: ($stw K2 k x) i=($fadd i 1)))
        k=($fadd k 1))
      (? i<ie (: ($copy K2 (k-1)*8 K (i-1)*8 (ie-i)*8) k=($fadd k (ie-i))))
      (? j<je ($copy K2 (k-1)*8 K (j-1)*8 (je-j)*8))
      lo=($fadd lo w2))
    t=K K=K2 K2=t
    w=w2)
  K)
(= (msort2 K V hasv n mode)     ; -> the sorted ARR (items if hasv, else keys)
  (? (&& mode==0 (! hasv)) (msortn K n) (msort2g K V hasv n mode)))
(= (msort2g K V hasv n mode)
  b=0
  (wh b<n
    e=(? b+8<n b+8 n) i=b+1
    (wh i<e
      x=($ldw K i+1) v=(? hasv ($ldw V i+1) nil) j=i-1
      (wh (&& j>=b (? mode==0 (> ($ldw K j+1) x) (gtany mode ($ldw K j+1) x)))
        ($stw K j+2 ($ldw K j+1)) (? hasv ($stw V j+2 ($ldw V j+1))) j=($fsub j 1))
      ($stw K j+2 x) (? hasv ($stw V j+2 v))
      i=($fadd i 1))
    b=($fadd b 8))
  K2=($new 3 n n) V2=(? hasv ($new 3 n n) nil) w=8
  (wh w<n
    lo=0 w2=($fadd w w)
    (wh lo<n
      mid=(? lo+w<n lo+w n) hi=(? lo+w2<n lo+w2 n) i=($fadd lo 1) j=($fadd mid 1) k=i ie=($fadd mid 1) je=($fadd hi 1)
      (wh (&& i<ie j<je)
        x=($ldw K i) y=($ldw K j)
        (? (? mode==0 (> x y) (gtany mode x y))
           (: ($stw K2 k y) (? hasv ($stw V2 k ($ldw V j))) j=($fadd j 1))
           (: ($stw K2 k x) (? hasv ($stw V2 k ($ldw V i))) i=($fadd i 1)))
        k=($fadd k 1))
      (? i<ie (: ($copy K2 (k-1)*8 K (i-1)*8 (ie-i)*8) (? hasv ($copy V2 (k-1)*8 V (i-1)*8 (ie-i)*8)) k=($fadd k (ie-i))))
      (? j<je (: ($copy K2 (k-1)*8 K (j-1)*8 (je-j)*8) (? hasv ($copy V2 (k-1)*8 V (j-1)*8 (je-j)*8))))
      lo=($fadd lo w2))
    t=K K=K2 K2=t
    (? hasv (: t=V V=V2 V2=t))
    w=w2)
  (? hasv V K))
(= (sortlist src keys hasv)     ; src: LIST of items, keys: ARR (a private copy) of their keys
  n=($ldw src 1) mode=(sortmode keys n)
  V=(? hasv (: v=($new 3 n n) ($copy v 0 ($ldw src 2) 0 n*8) v) nil)
  arr=(msort2 keys V hasv n mode)
  r=(mklist 0) ($stw r 2 arr) ($stw r 1 n) r)
(= (sort a b=nil)
  (? ($isnil b) (: l=(toarr (needcoll a)) n=#l K=($new 3 n n) ($copy K 0 ($ldw l 2) 0 n*8) (sortlist l K false))
     (: f=(fnv a) l=(toarr b) n=#l K=($new 3 n n) (for i n ($stw K i+1 (f (lget l i)))) (sortlist l K true))))

; ---- generic container access
(= (len x)
  (? ($isptr x) (: t=($type x) (? (|| t==1 t==7 t==8) ($hlen x) (|| t==2 t==4) ($ldw x 1) t==9 (tlen x) ($throwk 3 (strcat2 "len of " (ty x)))))
     ($isnil x) 0
     ($throwk 3 (strcat2 "len of " (ty x)))))
(= (# x) (len x))
(= (chkidx i)                       ; a list, string or typed-array index must be a whole number: a fractional one would be truncated by the raw load/store
  (? (! (isint i)) ($throwk 5 (strcat2 "@: index must be an integer, got " (show i)))))
(= (at x i j=nil)
  (? (ismap x) (mapget x i)
     (islist x) (? (! ($isnum i)) ($throwk 5 (strcat2 "@: index must be a number, got " (show i))) (: (chkidx i) (lat x i)))
     (isstr x) (? (! ($isnum i)) ($throwk 5 (strcat2 "@: index must be a number, got " (show i)))
                    (: (chkidx i) n=($hlen x) (? i<0 i=n+i) (? (&& i>=0 i<n) (chr1 ($ldb x i)) nil)))
     (ismap x) (mapget x i)
     ($isnil x) nil
     (istyped x) (: (chkidx i) n=(tlen x) (? i<0 i=n+i) (? (&& i>=0 i<n) (tget x i) nil))
     ($throwk 5 (strcat2 "cannot index " (ty x)))))
(= (slice x a b=nil)
  (? ($isnil x) nil
     (: n=(len x) a=(toint (?? a 0)) b=(toint (?? b n))
        (? (! ($isnum a)) ($throwk 5 (strcat2 "@: index must be a number, got " (show a))))
        (? (! ($isnum b)) ($throwk 5 (strcat2 "@: index must be a number, got " (show b))))
        (? a<0 a=n+a) (? b<0 b=n+b) (? a<0 a=0) (? b>n b=n) (? b<a b=a)
        (? (isstr x) (strslice x a b)
           (islist x) (: m=b-a r=(mklist m) ($copy ($ldw r 2) 0 ($ldw x 2) a*8 m*8) ($stw r 1 m) r)
           ($throwk 3 (strcat2 "cannot slice " (ty x)))))))
(= (toarr x)
  (? (islist x) x
     ($isnil x) (mklist 0)
     (isstr x) (: n=($hlen x) r=(mklist n) arr=($ldw r 2) (for i n ($stw arr i+1 (lget CHARS ($ldb x i)))) ($stw r 1 n) r)
     (ismap x) (mapentries x)
     (istyped x) (typed_list x)
     (list x)))
(= (iter x) (? ($isnum x) nil (toarr x)))
(= (put x i v)
  (? (islist x) (: (chkidx i) n=($ldw x 1) (? i<0 i=n+i) (? (&& i>=0 i<n) (lset x i v) (&& i>=0 i<134217728) (: (wh (< ($ldw x 1) i) (lpush x nil)) (lpush x v)) ($throwk 5 "index out of range")) v)
     (ismap x) (mapset x i v)
     (istyped x) (: (chkidx i) n=(tlen x) (? i<0 i=n+i) (? (&& i>=0 i<n) (tput x i v)) v)
     ($throwk 3 (strcat2 "cannot assign into " (ty x)))))
(= (dot o k)
  (? (ismap o) (mapget o k)
     ($isnil o) nil
     (&& (isstr k) (streq k "length") (|| (islist o) (isstr o))) (len o)
     nil))
(= (setdot o k v)
  (? (ismap o) (mapset o k v) ($throwk 3 (strcat2 "cannot set field on " (ty o)))))
(= (set c k v)
  (? (ismap c) (: m=(mapcopy c) (mapset m k v) m)
     (islist c) (: l=(copylist c) (put l k v) l)
     ($throwk 3 (strcat2 "cannot set on " (ty c)))))
(= (del c k)
  (? (ismap c) (: m=(mapcopy c) (mapdel m k) m)
     (islist c) (: l=(copylist c) n=#l k=(toint k) (? k<0 k=n+k) r=(mklist n) (for i n (? i!=k (lpush r (lget l i)))) r)
     ($throwk 3 (strcat2 "cannot delete from " (ty c)))))
(= (keys m) (? (ismap m) (mapkeys m) ($isnil m) (mklist 0) ($throwk 3 (strcat2 "keys of " (ty m)))))
(= (vals m) (? (ismap m) (mapvals m) ($isnil m) (mklist 0) ($throwk 3 (strcat2 "vals of " (ty m)))))
(= (prs m) (? (ismap m) (mapentries m) ($isnil m) (mklist 0) ($throwk 3 (strcat2 "prs of " (ty m)))))

; ---- math
(= (abs x) (? (isbig x) (? (== (bigsign x) 1) (bigneg x) x) (absn x)))
(= (absn x) x=(tonum x) (? (< x 0) ($fsub -0 x) (== x 0) 0 x))      ; abs(-0) is +0 like Math.abs
(= (sqrt x) ($fsqrt (tonum x)))
(= (flr x) (? (isbig x) x ($ffloor (tonum x))))      ; a BigInt is already whole
(= (cel x) (? (isbig x) x ($fceil (tonum x))))
(= (rnd x) x=(tonum x) f=($ffloor x) (? (>= ($fsub x f) 0.5) ($fadd f 1) f))        ; ties go up like Math.round; x+0.5 itself would round up 0.49999999999999994 and odd integers above 2^52
(= (int x) (? (isbig x) x ($ftrunc (tonum x))))
(= (minmax sign a)
  (: l=(? (&& #a==1 (|| (islist a[0]) (ismap a[0]))) (toarr a[0]) a) r=nil first=true
     (for x l x=(? (isbig x) x (tonum x)) (? (|| first (? sign<0 (lt2 x r) (gt2 x r))) r=x) first=false) r))
(= (min ..a) (minmax -1 a))
(= (max ..a) (minmax 1 a))
(= (sum l) l=(toarr l) s=(? (&& #l>0 (isbig l[0])) (bigfromnum 0) 0)
  (for x l (? (&& ($isnum x) ($isnum s)) (: t=($fadd s x) (? (&& t<MAXI t>-MAXI) s=t s=(add2 s x))) s=(add2 s (? (isbig x) x (tonum x)))))      ; |sum| < 2^53 cannot overflow: no check needed
  s)
RNGI=nil
(= (rand n=nil)
  (? (&& (! ($isnil n)) (! ($isnum n))) ($throwk 3 (strcat2 "expected number, got " (ty n))))
  (? (&& ($isnum n) (! (> n 0))) ($throwk 3 "rand: expected a positive number"))
  (? ($isnil RNGI) (<- RNGI (+ 1 (% (now) 2147483646))))
  (<- RNGI (% (* RNGI 16807) 2147483647))
  r=RNGI/2147483647
  (? ($isnil n) r ($ffloor ($fmul r n))))

(= (apply f l) ($apply f l))
(= (tostr x) (? (isstr x) x ($isnum x) (fmtnum x) (issym x) (symstr x) (isbig x) (bigstr x) (show x)))
(= (++ ..a)
  n=#a
  (? (&& n>0 (islist a[0]))
       (: total=0 (for l a total+=(len l)) r=(mklist total) arr=($ldw r 2) off=0
          (for l a m=(len l) ($copy arr off*8 ($ldw l 2) 0 m*8) off+=m) ($stw r 1 total) r)
     (: total=0 (for i n s=(tostr (lget a i)) (lset a i s) total+=($hlen s))
        r=(strnew total) off=0 (for i n s=(lget a i) ($copy r off s 0 ($hlen s)) off+=($hlen s)) r)))
(= (cat2 a b) (? (isstr a) (strcat2 a (tostr b)) (islist a) (concat a b) (strcat2 (tostr a) (tostr b))))       ; (++ a b) without building the rest list
(= ($ x) (tostr x))
(= (err ..a) ($throwk 0 (join a " ")))
(= (assert c ..a) (? c nil ($throwk 1 (? #a (join a " ") "assertion failed"))))
UKIND="error"
UDATA=nil
(= (raise k m d=nil) (<- UKIND k) (<- UDATA d) ($throwk 255 (join [m] " ")))
(= (errkind e) k=($errkind) (? k==255 UKIND (@ ["error" "assert" "arith" "type" "io" "index"] k)))
(= (errdata e) (? ($errkind)==255 UDATA nil))
(= (f64bits x) (list ($bitshi x) ($bitslo x)))
