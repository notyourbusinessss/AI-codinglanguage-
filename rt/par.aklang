; Native runtime part 9: parallel workers and shared memory. Native target only.
;   (cores)           the number of CPUs this process may run on
;   (shared kind n)   a typed array in memory shared with the workers: outside the collector's heap, never moved, never freed
;   (par n f w=nil)   f(0) .. f(n-1) in at most w worker processes at once (default: cores); the list of their results, in order
; A worker is a fork() of the whole program: its own heap and collector, so f needs no copying and the runtime allocator is untouched. The tasks are
; cut into at most 1024 blocks whose numbers are written to a pipe as 4-byte tickets; a worker takes the next block by reading 4 bytes (one read of
; 4 bytes is atomic, so the workers share the queue without locks and the load balances itself). Each worker answers on its own pipe with records
; [task u32][length u32][status][value]: status 0 is the result, 1 is [kind message data] of the error that ended the worker; task 2^32-1 with length 0 is the goodbye of
; a worker whose queue ran out (a worker that closes its pipe without saying it has died in the middle of a task, e.g. by calling exit). Values travel in a binary
; form that keeps numbers (NaN, -0), strings (any bytes), lists, maps, BigInts, typed arrays and nil exactly; functions cannot be sent.
PARB=nil                                       ; the encoder's buffer and fill
PARN=0
PARS=nil                                       ; the decoder's input and position
PARP=0
(= (cores)                                     ; CPUs in this process's affinity mask (sched_getaffinity); 1 if unknown
  b=(strnew 1024) r=($syscall 204 0 1024 ($addr b)) n=0
  (for i (? r>0 r 0) c=($ldb b i) (wh c>0 n+=c&1 c=c>>1))
  (? n>0 n 1))
(= (shared kind n)                             ; zero-filled, like (u8 n) and the others; the kind is "u8" "i8" "u16" "i16" "u32" "i32" "f32" or "f64"
  k=(sw kind "u8" 0 "i8" 1 "u16" 2 "i16" 3 "u32" 4 "i32" 5 "f32" 6 "f64" 7 nil)
  (? ($isnil k) ($throwk 3 "shared: the kind must be \"u8\" \"i8\" \"u16\" \"i16\" \"u32\" \"i32\" \"f32\" or \"f64\""))
  (? (|| (! ($isnum n)) (! (isint n)) n<0 n*(tsize k)>4294967295) ($throwk 2 (strcat2 "Invalid typed array length: " (tostr n))))
  bytes=n*(tsize k) a=($syscall 9 0 bytes+8 3 16417 -1 0)                   ; MAP_SHARED|MAP_ANONYMOUS|MAP_NORESERVE
  (? a<0 ($throwk 4 "cannot allocate shared memory"))
  ($pokew a ($frombits bytes 9+k*256))                                      ; the header of a typed array: type 9, kind, byte length
  ($mkptr a))

; ---- values between processes
(= (par_room k) (? PARN+k>($hlen PARB) (: nb=(strnew (? PARN+k>2*($hlen PARB) PARN+k 2*($hlen PARB))) ($copy nb 0 PARB 0 PARN) (<- PARB nb))))
(= (par_wb b) (par_room 1) ($stb PARB PARN b) (<- PARN PARN+1))
(= (par_w32 n) (par_room 4) (for j 4 ($stb PARB PARN+j ($band ($ushr n 8*j) 255))) (<- PARN PARN+4))
(= (par_ws s) k=($hlen s) (par_w32 k) (par_room k) ($copy PARB PARN s 0 k) (<- PARN PARN+k))
(= (par_enc v)                                 ; append v to the buffer
  (? ($isnum v) (: (par_wb 3) (par_w32 ($bitslo v)) (par_w32 ($bitshi v)))
     ($isnil v) (par_wb 0)
     ($eqp v false) (par_wb 1)
     ($eqp v true) (par_wb 2)
     (isstr v) (: (par_wb 4) (par_ws v))
     (islist v) (: (par_wb 5) (par_w32 #v) (for x v (par_enc x)))
     (ismap v) (: (par_wb 6) (par_w32 #v) (for [k x] v (par_enc k) (par_enc x)))
     (istyped v) (: (par_wb 7) (par_wb (tkind v)) (par_ws v))
     (isbig v) (: (par_wb 8) (par_ws (bigstr v)))
     ($throwk 3 (strcat2 (strcat2 "cannot send a " (ty v)) " between processes"))))
(= (par_u32 s i) (+ ($ldb s i) (* 256 ($ldb s i+1)) (* 65536 ($ldb s i+2)) (* 16777216 ($ldb s i+3))))
(= (par_rb) b=($ldb PARS PARP) (<- PARP PARP+1) b)
(= (par_r32) v=(par_u32 PARS PARP) (<- PARP PARP+4) v)
(= (par_rs) k=(par_r32) s=(substr PARS PARP k) (<- PARP PARP+k) s)
(= (par_dec)                                   ; the next value of the input
  t=(par_rb)
  (sw t
    0 nil
    1 false
    2 true
    3 (: lo=(par_r32) hi=(par_r32) ($frombits hi lo))
    4 (par_rs)
    5 (: n=(par_r32) l=(mklist n) (for i n (lpush l (par_dec))) l)
    6 (: n=(par_r32) m=(map) (for i n k=(par_dec) (mapset m k (par_dec))) m)
    7 (: kind=(par_rb) k=(par_r32) x=(tnew kind k/(tsize kind)) ($copy x 0 PARS PARP k) (<- PARP PARP+k) x)
    8 (bigfrom (par_rs))
    ($throwk 0 "par: a worker sent something that is not a value")))

; ---- a worker
(= (par_wr fd s off n)                         ; write n bytes of s from off: false if the pipe is gone
  ok=true
  (wh (&& ok n>0)
    r=($syscall 1 fd ($addr s)+off n)
    (? r==-4 nil r<=0 ok=false (: off+=r n-=r)))
  ok)
(= (par_task f i)                              ; run f(i) and leave the reply in the buffer: status 0 and the value, or 1 and [kind message data]; returns the status
  (<- PARN 0) (? ($isnil PARB) (<- PARB (strnew 4096)))
  (try (: v=(f i) (par_wb 0) (par_enc v) 0)
       e=>(: k=(errkind e) d=(errdata e) (<- PARN 0) (par_wb 1) (par_enc [k e d]) 1)))
(= (par_worker f n bs tfd rfd ppid)            ; the body of a worker process; never returns
  ($syscall 157 1 9)                           ; PR_SET_PDEATHSIG, SIGKILL: a worker does not outlive its parent
  (? (!= ($syscall 110) ppid) ($syscall 231 1))
  hd=(strnew 8) tk=(strnew 4) ok=true
  (wh ok
    r=($syscall 0 tfd ($addr tk) 4)
    (? r==-4 nil
       r==0 (: (for j 4 ($stb hd j 255) ($stb hd 4+j 0)) (par_wr rfd hd 0 8) ok=false)          ; the queue is empty: tell the parent that this worker is done
       r!=4 ok=false
       (: i=(par_u32 tk 0)*bs end=(? i+bs<n i+bs n)
          (wh (&& ok i<end)
            st=(par_task f i)
            (for j 4 ($stb hd j ($band ($ushr i 8*j) 255)) ($stb hd 4+j ($band ($ushr PARN 8*j) 255)))
            (? (! (&& (par_wr rfd hd 0 8) (par_wr rfd PARB 0 PARN))) ok=false)
            (? st==1 ok=false)
            i+=1))))
  (flush)
  ($syscall 231 0))
(= (par_child f n bs tfd rp ws ppid)           ; in the new process: close the parent's pipe ends, work, exit
  (try (: ($syscall 3 rp[0]) (for w ws ($syscall 3 w.fd)) (par_worker f n bs tfd rp[1] ppid))
       e=>($syscall 231 2))
  ($syscall 231 2))

; ---- the parent
(= (par_pipe)                                  ; [read-end write-end] of a new close-on-exec pipe
  b=(strnew 8) r=($syscall 293 ($addr b) 524288)
  (? r<0 ($throwk 4 "par: cannot create a pipe"))
  [(par_u32 b 0) (par_u32 b 4)])
(= (par_wait pid)                              ; wait for the child to end: its raw status, or -1
  b=(strnew 8) r=-4
  (wh r==-4 r=($syscall 61 pid ($addr b) 0 0))
  (? r<0 -1 (+ ($ldb b 0) (* 256 ($ldb b 1)))))
(= (par_why st)
  (? st<0 "par: lost a worker"
     ($band st 127)==0 (strcat2 "par: a worker exited with code " (tostr ($band ($ushr st 8) 255)))
     (strcat2 "par: a worker was killed by signal " (tostr ($band st 127)))))
(= (par_reap ws)                               ; end every worker that is still there and collect it
  (for w ws
    (? w.fd>=0 (: ($syscall 3 w.fd) w.fd=-1))
    (? w.pid>0 (: ($syscall 62 w.pid 9) (par_wait w.pid) w.pid=-1))))
(= (par_eof w)                                 ; a worker closed its pipe: collect it and see how it ended
  ($syscall 3 w.fd) w.fd=-1
  st=(par_wait w.pid) w.pid=-1
  (? st!=0 ($throwk 4 (par_why st))
     (! w.done) ($throwk 4 "par: a worker exited before it had finished (did a task call exit?)")
     (|| w.fill>0 w.ph==1) ($throwk 4 "par: a worker ended in the middle of a reply")))
(= (par_collect n ws)                          ; read the workers' replies until every pipe is closed: the list of the n results
  res=(mklist n) (for i n (lpush res nil))
  got=0 open=#ws
  (wh open>0
    fds=[] (for w ws (? w.fd>=0 (push fds w.fd)))
    (for fd (fdwait fds -1)
      w=nil (for x ws (? x.fd==fd w=x))
      r=($syscall 0 fd ($addr w.buf)+w.fill w.need-w.fill)
      (? r==-4 nil
         r<0 ($throwk 4 "par: read failed")
         r==0 (: (par_eof w) open-=1)
         (: w.fill+=r
            (? w.fill==w.need
               (? w.ph==0
                  (: len=(par_u32 w.buf 4) w.idx=(par_u32 w.buf 0)
                     (? (&& w.idx==4294967295 len==0) (: w.done=true w.fill=0)
                        (: (? len<2 ($throwk 0 "par: bad reply from a worker"))
                           w.buf=(strnew len) w.need=len w.fill=0 w.ph=1)))
                  (: (<- PARS w.buf) (<- PARP 1)
                     v=(par_dec)
                     (? ($ldb w.buf 0)==1 (par_fail w.idx v))
                     res[w.idx]=v got+=1
                     w.buf=w.hd w.need=8 w.fill=0 w.ph=0)))))))
  (? got!=n ($throwk 0 "par: the workers returned too few results"))
  res)
(= (par_fail i v)                              ; throw again, in the parent, the error that ended task i in a worker
  (co_rethrow v[0] (strcat2 (strcat2 (strcat2 "par: task " (tostr i)) ": ") v[1]) v[2]))
(= (par_run n f w)
  (flush)                                      ; a worker inherits the unwritten output: it must not be written twice
  nb=(? n<1024 n 1024) bs=(cel n/nb) nb=(cel n/bs)
  tk=(strnew 4*nb) (for b nb (for j 4 ($stb tk 4*b+j ($band ($ushr b 8*j) 255))))
  tp=(par_pipe)
  ok=(par_wr tp[1] tk 0 4*nb) ($syscall 3 tp[1])
  (? (! ok) (: ($syscall 3 tp[0]) ($throwk 4 "par: cannot queue the tasks")))
  ws=[] ppid=($syscall 39)
  (try (: (for k w
            rp=(par_pipe)
            pid=($syscall 57)
            (? pid<0 (: ($syscall 3 rp[0]) ($syscall 3 rp[1]) ($throwk 4 "par: cannot start a worker")))
            (? pid==0 (par_child f n bs tp[0] rp ws ppid))
            ($syscall 3 rp[1])
            hd=(strnew 8)
            (push ws {:pid pid :fd rp[0] :hd hd :buf hd :need 8 :fill 0 :ph 0 :idx 0 :done false}))
          ($syscall 3 tp[0])
          (par_collect n ws))
       e=>(: k=(errkind e) d=(errdata e) ($syscall 3 tp[0]) (par_reap ws) (co_rethrow k e d))))
(= (par n f w=nil)                             ; f(0) .. f(n-1) in worker processes: the list of the results
  (? (! (isfn f)) ($throwk 3 (strcat2 "par: expected a function, got " (ty f))))
  (needlen n 2147483647)
  w=(? ($isnil w) (cores) w)
  (? (|| (! ($isnum w)) (! (isint w)) w<1) ($throwk 2 (strcat2 "par: invalid number of workers: " (tostr w))))
  (? w>n w=n) (? w>256 w=256)
  (? n==0 [] (par_run n f w)))
