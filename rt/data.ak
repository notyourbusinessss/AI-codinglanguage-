; Native runtime part 2: strings, lists, symbols, library. Object layouts (word 0 is the header = type | length<<32):
;   STR/SYM/BYTES: [hdr][bytes...]     SYM additionally has [line][col] words after the padded name
;   LIST: [hdr][len (double)][arr][hash id]     ARR: [hdr][cap words]
;   MAP: [hdr][count][entries ARR k,v interleaved][index ARR][used][hash id]

; ---- strings (UTF-8 byte strings)
(= (strnew n) ($newb 1 n n))
CHARS=nil
(= (chr1 b) (? ($isnil CHARS) (: s=(strnew 1) ($stb s 0 b) s) (lget CHARS b)))
(= (chars_init) l=(mklist 256) (for b 256 s=(strnew 1) ($stb s 0 b) (lpush l s)) (<- CHARS l))
(= (strcat2 a b) la=($hlen a) lb=($hlen b) s=(strnew la+lb) ($copy s 0 a 0 la) ($copy s la b 0 lb) s)
(= (strslice s a b) n=b-a r=(strnew n) ($copy r 0 s a n) r)
(= (streq a b) n=($hlen a)
  (? ($eqp a b) true (!= n ($hlen b)) false
     (: i=0 (wh (&& (< i n) (== ($ldb a i) ($ldb b i))) i+=1) (== i n))))
(= (strcmp a b) na=($hlen a) nb=($hlen b) m=(? na<nb na nb) i=0
  (wh (&& (< i m) (== ($ldb a i) ($ldb b i))) i+=1)
  (? i<m (? (< ($ldb a i) ($ldb b i)) -1 1) (? na<nb -1 na>nb 1 0)))
(= (needstr s) (? (! (isstr s)) ($throw (strcat2 "expected string, got " (ty s)))) s)
(= (strfind s p from)             ; index of p in s at or after from, or -1
  n=($hlen s) m=($hlen p) i=from r=-1
  (? m==0 (? from<=n from -1)
     (: (wh (&& r<0 i+m<=n)
          (: j=0 (wh (&& (< j m) (== ($ldb s i+j) ($ldb p j))) j+=1)
             (? j==m r=i i+=1)))
        r)))
(= (idx c x)
  (? (isstr c) (strfind c (needstr x) 0)
     (: l=(toarr c) r=-1 i=0 n=#l (wh (&& r<0 i<n) (? (eq2 (lget l i) x) r=i) i+=1) r)))
(= (has c x)
  (? ($isnil c) false
     (isstr c) (>= (strfind c (needstr x) 0) 0)
     (ismap c) (maphas c x)
     (>= (idx c x) 0)))
(= (starts s p) n=($hlen p)
  (? n>($hlen s) false (: i=0 (wh (&& (< i n) (== ($ldb s i) ($ldb p i))) i+=1) (== i n))))
(= (ends s p) n=($hlen p) m=($hlen s)
  (? n>m false (: i=0 (wh (&& (< i n) (== ($ldb s m-n+i) ($ldb p i))) i+=1) (== i n))))
(= (isspace b) (|| b==32 (&& b>=9 b<=13)))
(= (trim s) n=($hlen s) a=0 b=n
  (wh (&& (< a b) (isspace ($ldb s a))) a+=1)
  (wh (&& (> b a) (isspace ($ldb s b-1))) b-=1)
  (? (&& a==0 b==n) s (strslice s a b)))
(= (up s) n=($hlen s) r=(strnew n)
  (for i n b=($ldb s i) ($stb r i (? (&& b>=97 b<=122) b-32 b))) r)
(= (lo s) n=($hlen s) r=(strnew n)
  (for i n b=($ldb s i) ($stb r i (? (&& b>=65 b<=90) b+32 b))) r)
(= (split s d=nil)
  (needstr s) r=(mklist 8) n=($hlen s)
  (? ($isnil d)
     (: i=0
        (wh i<n
          (wh (&& (< i n) (isspace ($ldb s i))) i+=1)
          (? i<n (: j=i (wh (&& (< j n) (! (isspace ($ldb s j)))) j+=1) (lpush r (strslice s i j)) i=j)))
        r)
     (: (needstr d) dl=($hlen d)
        (? dl==0 (: (for i n (lpush r (chr1 ($ldb s i)))) r)
           (: a=0
              (wh a>=0
                b=(strfind s d a)
                (? b<0 (: (lpush r (strslice s a n)) a=-1) (: (lpush r (strslice s a b)) a=b+dl)))
              r)))))
(= (join l d=nil)
  l=(toarr l) d=(?? d "") n=#l parts=(mklist n) total=0
  (for i n s=(tostr (lget l i)) (lpush parts s) total+=($hlen s))
  total+=($hlen d)*(? n>0 n-1 0)
  r=(strnew total) off=0
  (for i n s=(lget parts i) ($copy r off s 0 ($hlen s)) off+=($hlen s)
    (? i<n-1 (: ($copy r off d 0 ($hlen d)) off+=($hlen d))))
  r)
(= (rpt x k)
  k=(tonum k) k=(? k<0 0 k)
  (? (isstr x) (: n=($hlen x) r=(strnew n*k) (for i k ($copy r i*n x 0 n)) r)
     (: r=(mklist 8) l=(toarr x) (for i k (for y l (lpush r y))) r)))
(= (rep s a b)
  (needstr s)
  (? (! (isstr a)) ($throw "regex replace is not supported by the native target"))
  b=(tostr b)
  (? ($hlen a)==0 s
     (: parts=(split s a) (join parts b))))
(= (padl s n c=nil) s=(tostr s) c=(?? c " ") m=n-($hlen s)
  (? m<=0 s (strcat2 (rpt c m) s)))
(= (padr s n c=nil) s=(tostr s) c=(?? c " ") m=n-($hlen s)
  (? m<=0 s (strcat2 s (rpt c m))))
(= (chr n)
  (? n<128 (chr1 n)
     n<2048 (: r=(strnew 2) ($stb r 0 192+(n>>6)) ($stb r 1 128+(n&63)) r)
     n<65536 (: r=(strnew 3) ($stb r 0 224+(n>>12)) ($stb r 1 128+((n>>6)&63)) ($stb r 2 128+(n&63)) r)
     (: r=(strnew 4) ($stb r 0 240+(n>>18)) ($stb r 1 128+((n>>12)&63)) ($stb r 2 128+((n>>6)&63)) ($stb r 3 128+(n&63)) r)))
(= (ord s) n=($hlen s)
  (? n==0 nil
     (: b=($ldb s 0)
        (? (|| b<128 n<2) b
           b<224 ((b&31)<<6)+(($ldb s 1)&63)
           b<240 ((b&15)<<12)+((($ldb s 1)&63)<<6)+(($ldb s 2)&63)
           ((b&7)<<18)+((($ldb s 1)&63)<<12)+((($ldb s 2)&63)<<6)+(($ldb s 3)&63)))))
(= (bytes s) n=($hlen s) r=(mklist n) (for i n (lpush r ($ldb s i))) r)
; list of byte values -> string (used by wr)
(= (frombytes l) n=#l r=(strnew n) (for i n ($stb r i (lget l i))) r)

; ---- symbols: interned by name (sym); mksym makes a fresh positioned one
(= (symnew s line col) n=($hlen s) pad=(($hlen s)+7)&-8 r=($newb 7 pad+16 n) ($copy r 0 s 0 n)
  ($stw r 1+pad/8 line) ($stw r 2+pad/8 col) r)
SYMTAB=nil
(= (sym s)
  (? (issym s) s
     (: (needstr s)
        (? ($isnil SYMTAB) (<- SYMTAB (map)))
        (? (maphas SYMTAB s) (mapget SYMTAB s)
           (: r=(symnew s 0 0) (mapset SYMTAB s r) r)))))
(= (mksym s line col) (symnew (tostr s) line col))
(= (symline s) (? (issym s) ($ldw s 1+(($hlen s)+7)/8) 0))
(= (symcol s) (? (issym s) ($ldw s 2+(($hlen s)+7)/8) 0))
(= (symstr s) n=($hlen s) r=(strnew n) ($copy r 0 s 0 n) r)

; ---- lists
(= (mklist cap) arr=($new 3 cap cap) l=($new 2 3 3) ($stw l 1 0) ($stw l 2 arr) l)
(= (lgrow arr n) cap=(? ($hlen arr)<4 4 ($hlen arr)*2) a2=($new 3 cap cap) (for i n ($stw a2 i+1 ($ldw arr i+1))) a2)
(= (lpush l x) n=($ldw l 1) arr=($ldw l 2)
  (? n>=($hlen arr) (: arr=(lgrow arr n) ($stw l 2 arr)))
  ($stw arr n+1 x) ($stw l 1 n+1) x)
(= (lget l i) ($ldw ($ldw l 2) i+1))
(= (lset l i x) ($stw ($ldw l 2) i+1 x))
(= (lat l i) n=($ldw l 1) (? i<0 i=n+i) (? (&& i>=0 i<n) (lget l i) nil))
(= (needlist l) (? (! (islist l)) ($throw (strcat2 "expected list, got " (ty l)))) l)
(= (push l ..xs) (needlist l) (for x xs (lpush l x)) l)
(= (pop l) (needlist l) n=($ldw l 1)
  (? n==0 nil (: arr=($ldw l 2) x=($ldw arr n) ($stw arr n nil) ($stw l 1 n-1) x)))
(= (list ..a) a)
(= (copylist l) n=($ldw l 1) r=(mklist n) (for i n (lpush r (lget l i))) r)
(= (+> l ..x) (concat l x))
(= (concat ..ls) total=0 (for l ls total+=($ldw l 1))
  r=(mklist total) (for l ls (for i ($ldw l 1) (lpush r (lget l i)))) r)
(= (.. a b=nil s=nil)
  (? ($isnil b) (: b=a a=0)) s=(?? s 1)
  (? s==0 ($throw "..: zero step"))
  r=(mklist 8)
  (? s>0 (: i=a (wh i<b (lpush r i) i+=s)) (: i=a (wh i>b (lpush r i) i+=s)))
  r)
(= (rev l)
  (? (isstr l) (: n=($hlen l) r=(strnew n) (for i n ($stb r i ($ldb l n-1-i))) r)
     (: l=(toarr l) n=#l r=(mklist n) (for i n (lpush r (lget l n-1-i))) r)))
(= (enum l) l=(toarr l) n=#l r=(mklist n) (for i n (lpush r (list i (lget l i)))) r)
(= (fst l) (? (|| ($isnil l) (== (len l) 0)) nil (at l 0)))
(= (lst l) (? (|| ($isnil l) (== (len l) 0)) nil (at l -1)))
(= (take n l) (slice l 0 n))
(= (drop n l) (slice l n nil))
(= (sub c a b) (slice c a b))
(= (flat l) l=(toarr l) r=(mklist 8) (for x l (? (islist x) (for y x (lpush r y)) (lpush r x))) r)
(= (zip ..ls) ls=(~ toarr ls) m=-1 (for l ls (? (|| m<0 #l<m) m=#l)) m=(? m<0 0 m)
  r=(mklist m) (for i m (lpush r (~ l=>(lget l i) ls))) r)
(= (fnv f)
  (? (isfn f) f
     (|| (islist f) (ismap f) (isstr f)) (x=>(at f x))
     ($throw (strcat2 "not callable: " (show f)))))
(= (~ f l ..more)
  f=(fnv f) l=(toarr l) n=#l
  (? #more==0 (: r=(mklist n) (for i n (lpush r (f (lget l i)))) r)
     (: ls=(~ toarr more) m=n (for x ls (? #x<m m=#x))
        r=(mklist m)
        (for i m (lpush r (apply f (concat [(lget l i)] (~ x=>(lget x i) ls))))) r)))
(= (~? f l) f=(fnv f) l=(toarr l) r=(mklist 8) (for x l (? (f x) (lpush r x))) r)
(= (~~ f l) f=(fnv f) l=(toarr l) r=(mklist 8)
  (for x l y=(f x) (? (islist y) (for z y (lpush r z)) (lpush r y))) r)
(= (~/ f a b=nil)
  f=(fnv f)
  (? ($isnil b)
     (: l=(toarr a) (? #l==0 nil (: r=(lget l 0) (for i 1..#l r=(f r (lget l i))) r)))
     (: l=(toarr b) r=a (for x l r=(f r x)) r)))
(= (any f l) f=(fnv f) l=(toarr l) r=false i=0 n=#l (wh (&& (! r) i<n) (? (f (lget l i)) r=true) i+=1) r)
(= (all f l) f=(fnv f) l=(toarr l) r=true i=0 n=#l (wh (&& r i<n) (? (! (f (lget l i))) r=false) i+=1) r)
(= (ap f l) (apply (fnv f) (toarr l)))
(= (uniq l) l=(toarr l) r=(mklist 8) seen=(map)
  (for x l
    (? (|| (islist x) (ismap x))
       (? (! (any y=>(eq2 x y) r)) (lpush r x))
       (? (! (maphas seen x)) (: (mapset seen x true) (lpush r x)))))
  r)
(= (grp f l) f=(fnv f) m=(map)
  (for x (toarr l) k=(f x) g=(mapget m k) (? g (lpush g x) (mapset m k (list x)))) m)

; ---- sorting (stable merge sort on a copy)
(= (msort src key cmpf)       ; src: list of items; key: list of sort keys parallel to src (or same as src)
  n=#src idx=(mklist n) (for i n (lpush idx i))
  tmp=(mklist n) (for i n (lpush tmp 0))
  w=1
  (wh w<n
    lo=0
    (wh lo<n
      mid=(? lo+w<n lo+w n) hi=(? lo+2*w<n lo+2*w n)
      i=lo j=mid k=lo
      (wh (&& i<mid j<hi)
        (? (<= (cmpf (lget key (lget idx i)) (lget key (lget idx j))) 0) (: (lset tmp k (lget idx i)) i+=1) (: (lset tmp k (lget idx j)) j+=1))
        k+=1)
      (wh i<mid (lset tmp k (lget idx i)) i+=1 k+=1)
      (wh j<hi (lset tmp k (lget idx j)) j+=1 k+=1)
      lo+=2*w)
    (for i n (lset idx i (lget tmp i)))
    w*=2)
  r=(mklist n) (for i n (lpush r (lget src (lget idx i)))) r)
(= (sort a b=nil)
  (? ($isnil b) (: l=(toarr a) (msort l l cmp))
     (: f=(fnv a) l=(toarr b) ks=(mklist #l) (for x l (lpush ks (f x))) (msort l ks cmp))))

; ---- generic container access
(= (len x)
  (? ($isptr x) (: t=($type x) (? (|| t==1 t==7 t==8) ($hlen x) (|| t==2 t==4) ($ldw x 1) t==9 (tlen x) ($throw (strcat2 "len of " (ty x)))))
     ($isnil x) 0
     ($throw (strcat2 "len of " (ty x)))))
(= (# x) (len x))
(= (at x i j=nil)
  (? (islist x) (? (! ($isnum i)) ($throw (strcat2 "@: index must be a number, got " (show i))) (lat x i))
     (isstr x) (? (! ($isnum i)) ($throw (strcat2 "@: index must be a number, got " (show i)))
                    (: n=($hlen x) (? i<0 i=n+i) (? (&& i>=0 i<n) (chr1 ($ldb x i)) nil)))
     (ismap x) (mapget x i)
     ($isnil x) nil
     (istyped x) (: n=(tlen x) (? i<0 i=n+i) (? (&& i>=0 i<n) (tget x i) nil))
     ($throw (strcat2 "cannot index " (ty x)))))
(= (slice x a b=nil)
  (? ($isnil x) nil
     (: n=(len x) a=(?? a 0) b=(?? b n)
        (? a<0 a=n+a) (? b<0 b=n+b) (? a<0 a=0) (? b>n b=n) (? b<a b=a)
        (? (isstr x) (strslice x a b)
           (islist x) (: r=(mklist b-a) (for i a..b (lpush r (lget x i))) r)
           ($throw (strcat2 "cannot slice " (ty x)))))))
(= (toarr x)
  (? (islist x) x
     ($isnil x) (mklist 0)
     (isstr x) (: n=($hlen x) r=(mklist n) (for i n (lpush r (chr1 ($ldb x i)))) r)
     (ismap x) (mapentries x)
     (istyped x) (typed_list x)
     (list x)))
(= (iter x) (? ($isnum x) nil (toarr x)))
(= (put x i v)
  (? (islist x) (: n=($ldw x 1) (? i<0 i=n+i) (? (&& i>=0 i<n) (lset x i v) i==n (lpush x v) ($throw "index out of range")) v)
     (ismap x) (mapset x i v)
     (istyped x) (: n=(tlen x) (? i<0 i=n+i) (? (&& i>=0 i<n) (tput x i v)) v)
     ($throw (strcat2 "cannot assign into " (ty x)))))
(= (dot o k)
  (? (ismap o) (mapget o k)
     ($isnil o) nil
     (&& (isstr k) (streq k "length") (|| (islist o) (isstr o))) (len o)
     nil))
(= (setdot o k v)
  (? (ismap o) (mapset o k v) ($throw (strcat2 "cannot set field on " (ty o)))))
(= (set c k v)
  (? (ismap c) (: m=(mapcopy c) (mapset m k v) m)
     (islist c) (: l=(copylist c) (put l k v) l)
     ($throw (strcat2 "cannot set on " (ty c)))))
(= (del c k)
  (? (ismap c) (: m=(mapcopy c) (mapdel m k) m)
     (islist c) (: l=(copylist c) n=#l (? k<0 k=n+k) r=(mklist n) (for i n (? i!=k (lpush r (lget l i)))) r)
     ($throw (strcat2 "cannot delete from " (ty c)))))
(= (keys m) (? (ismap m) (mapkeys m) ($isnil m) (mklist 0) ($throw (strcat2 "keys of " (ty m)))))
(= (vals m) (? (ismap m) (mapvals m) ($isnil m) (mklist 0) ($throw (strcat2 "vals of " (ty m)))))
(= (prs m) (? (ismap m) (mapentries m) ($isnil m) (mklist 0) ($throw (strcat2 "prs of " (ty m)))))

; ---- math
(= (abs x) x=(tonum x) (? (< x 0) ($fsub -0 x) x))
(= (sqrt x) ($fsqrt (tonum x)))
(= (flr x) ($ffloor (tonum x)))
(= (cel x) ($fceil (tonum x)))
(= (rnd x) ($ffloor ($fadd (tonum x) 0.5)))
(= (int x) ($ftrunc (tonum x)))
(= (minmax sign a)
  (: l=(? (&& #a==1 (|| (islist a[0]) (ismap a[0]))) (toarr a[0]) a) r=nil first=true
     (for x l x=(tonum x) (? (|| first (? sign<0 x<r x>r)) r=x) first=false) r))
(= (min ..a) (minmax -1 a))
(= (max ..a) (minmax 1 a))
(= (sum l) s=0 (for x (toarr l) s=(add2 s (tonum x))) s)
RNGI=nil
(= (rand n=nil)
  (? ($isnil RNGI) (<- RNGI (+ 1 (% (now) 2147483646))))
  (<- RNGI (% (* RNGI 16807) 2147483647))
  r=RNGI/2147483647
  (? ($isnil n) r ($ffloor ($fmul r n))))

(= (apply f l) ($apply f l))
(= (tostr x) (? (isstr x) x (issym x) (symstr x) (isbig x) (bigstr x) (show x)))
(= (++ ..a)
  (? (&& #a>0 (islist a[0]))
       (: total=0 (for l a total+=(len l)) r=(mklist total) (for l a (for i #l (lpush r (lget l i)))) r)
     (: parts=(mklist #a) total=0
        (for x a s=(tostr x) (lpush parts s) total+=($hlen s))
        r=(strnew total) off=0 (for i #a s=(lget parts i) ($copy r off s 0 ($hlen s)) off+=($hlen s)) r)))
(= ($ x) (tostr x))
(= (err ..a) ($throw (join a " ")))
(= (f64bits x) (list ($bitshi x) ($bitslo x)))
