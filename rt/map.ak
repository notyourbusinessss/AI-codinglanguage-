; Native runtime part 3: insertion-ordered hash maps (like JS Map: numbers/strings by value, everything else by identity).
;   MAP: [hdr][count][entries ARR: k,v interleaved][index ARR: open addressing, entry index or nil; nil for small maps][used (incl. tombstones)][hash id]
;   deleted entries keep their slot with key UNDEF until the next rehash.
HID=0
(= (hashid o slot) h=($ldw o slot) (? ($isnil h) (: (<- HID HID+1) h=HID ($stw o slot h))) h)
(= (hashstr s) ($strhash s))
(= (hashof k)
  (? ($isnum k)
       (? (== k 0) 0
          (&& (< -2147483649 k) (< k 2147483648) (== k ($ffloor k))) ($band k 2147483647)
          (: hi=($bitshi k) lo=($bitslo k) ($band ($bxor ($bxor hi ($ushr hi 12)) ($bxor lo ($ushr lo 15))) 2147483647)))
     (! ($isptr k)) (? ($isnil k) 1 ($eqp k true) 2 3)
     (: t=($type k) (? (|| t==1 t==7) (hashstr k) t==2 (hashid k 3) t==4 (hashid k 5) t==10 (hashstr (bigstr k)) 5))))
(= (keyeq a b)     ; a: stored key, b: probe key
  (? ($eqp a b) true
     ($isnum a) (&& ($isnum b) (|| (== a b) (&& (!= a a) (!= b b))))          ; like JS Map: NaN is a key equal to itself
     (! ($isptr a)) ($eqp a b)
     (! ($isptr b)) false
     ($isstr a) ($streq a b)
     (isbig a) (&& (isbig b) (== (bigcmp a b) 0))
     ($eqp a b)))
; Small maps (capacity <= 8 entries) have no index: idx is nil and lookups scan the entries (record-like maps are cheap to build and read).
(= (mapnew cap)
  m=($new 4 5 5) ($stw m 1 0) ($stw m 2 ($new 3 cap*2 cap*2)) ($stw m 3 (? cap>8 ($new 3 cap*2 cap*2) nil)) ($stw m 4 0) m)
; after a failed hashed mapfind the empty index slot where the key belongs is left in the cell at 268435664 (so mapset need not probe again)
(= (mapfind m k)                  ; entry index of key k, or -1 (string and int32 keys: the assembly stubs .mapfind_s / .mapfind_n)
  (? ($isstr k) ($mapfind_s m k -1)
     ($isnum k) (: e=($mapfind_n m k) (? e==-2 (mapfind_other m k) e))
     (mapfind_other m k)))
(= (mapfind_other m k) (? ($isnil ($ldw m 3)) (mapfind_small m k) (mapfind_hashed m k)))
(= (mapfind_small m k)
  ent=($ldw m 2) used=($ldw m 4) r=-1 e=0
  (? ($isstr k)
       (wh (< e used)
         ek=($ldw ent ($fadd ($fadd e e) 1))
         (? (|| ($eqp ek k) (&& ($isstr ek) ($streq ek k))) (: r=e e=used) e=($fadd e 1)))
     ($isnum k)
       (wh (< e used)
         ek=($ldw ent ($fadd ($fadd e e) 1))
         (? (&& ($isnum ek) (|| (== ek k) (&& (!= ek ek) (!= k k)))) (: r=e e=used) e=($fadd e 1)))
     (wh (< e used)
       (? (keyeq ($ldw ent ($fadd ($fadd e e) 1)) k) (: r=e e=used) e=($fadd e 1))))
  r)
(= (mapfind_hashed m k)
  idx=($ldw m 3) ent=($ldw m 2) size=($hlen idx) r=-1
  (? ($isstr k)
       (: i=($fadd ($hslot ($strhash k) size) 1) e=($ldw idx i)
          (wh (! ($isnil e))
            ek=($ldw ent ($fadd ($fadd e e) 1))
            (? (|| ($eqp ek k) (&& ($isstr ek) ($streq ek k))) (: r=e e=nil)
               (: i=($fadd i 1) (? i>size i=1) e=($ldw idx i))))
          ($pokew 268435664 i))
     ($isnum k)
       (: i=($fadd ($hslot (hashof k) size) 1) e=($ldw idx i)
          (wh (! ($isnil e))
            ek=($ldw ent ($fadd ($fadd e e) 1))
            (? (&& ($isnum ek) (|| (== ek k) (&& (!= ek ek) (!= k k)))) (: r=e e=nil)
               (: i=($fadd i 1) (? i>size i=1) e=($ldw idx i))))
          ($pokew 268435664 i))
     (: i=($fadd ($hslot (hashof k) size) 1) e=($ldw idx i)
        (wh (! ($isnil e))
          (? (keyeq ($ldw ent ($fadd ($fadd e e) 1)) k) (: r=e e=nil)
             (: i=($fadd i 1) (? i>size i=1) e=($ldw idx i))))
        ($pokew 268435664 i)))
  r)
(= (mapget m k) e=(mapfind m k) (? e<0 nil ($ldw ($ldw m 2) ($fadd ($fadd e e) 2))))
(= (maphas m k) (>= (mapfind m k) 0))
(= (maprehash m)                  ; compact (drop tombstones), grow when at least half the entries are live, and build the index once the map is no longer small
  live=($ldw m 1) oldent=($ldw m 2) used=($ldw m 4) oldcap=($hlen oldent)/2
  cap=(? live*2>=oldcap oldcap*2 oldcap)
  ent=($new 3 cap*2 cap*2) idx=(? cap>8 ($new 3 cap*2 cap*2) nil) mask=cap*2-1 j=0
  (for e used
    k=($ldw oldent ($fadd ($fadd e e) 1))
    (? (! ($eqp k UNDEF))
       (: ($stw ent ($fadd ($fadd j j) 1) k) ($stw ent ($fadd ($fadd j j) 2) ($ldw oldent ($fadd ($fadd e e) 2)))
          (? idx (: i=($hslot (? ($isstr k) ($strhash k) (hashof k)) mask+1)
                    (wh (! ($isnil ($ldw idx i+1))) i=($band i+1 mask))
                    ($stw idx i+1 j)))
          j=($fadd j 1))))
  ($stw m 2 ent) ($stw m 3 idx) ($stw m 4 j) m)
(= (mapset m k v)
  hashed=(! ($isnil ($ldw m 3))) e=(mapfind m k) slot=(? hashed ($peekw 268435664) nil)
  (? e>=0 ($stw ($ldw m 2) ($fadd ($fadd e e) 2) v)
     (: used=($ldw m 4) ent=($ldw m 2)
        (? 2*used>=($hlen ent) (: (maprehash m) used=($ldw m 4) ent=($ldw m 2) slot=nil))
        ($stw ent ($fadd ($fadd used used) 1) k) ($stw ent ($fadd ($fadd used used) 2) v)
        idx=($ldw m 3)
        (? (! ($isnil idx))
           (: (? ($isnil slot)
                 (: mask=($hlen idx)-1 i=($hslot (? ($isstr k) ($strhash k) (hashof k)) mask+1)
                    (wh (! ($isnil ($ldw idx i+1))) i=($band i+1 mask))
                    slot=i+1))
              ($stw idx slot used)))
        ($stw m 4 used+1) ($stw m 1 ($ldw m 1)+1) v)))
(= (mapdel m k) e=(mapfind m k)
  (? e>=0 (: ent=($ldw m 2) ($stw ent 2*e+1 UNDEF) ($stw ent 2*e+2 nil) ($stw m 1 ($ldw m 1)-1) true) false))
(= (mapcopy m)
  ent=($ldw m 2) idx=($ldw m 3) r=($new 4 5 5)
  ($stw r 1 ($ldw m 1)) ($stw r 4 ($ldw m 4))
  e2=($new 3 ($hlen ent) ($hlen ent)) ($copy e2 0 ent 0 ($hlen ent)*8)
  ($stw r 2 e2)
  (? (! ($isnil idx)) (: i2=($new 3 ($hlen idx) ($hlen idx)) ($copy i2 0 idx 0 ($hlen idx)*8) ($stw r 3 i2)))
  r)
(= (mapentries m) ent=($ldw m 2) used=($ldw m 4) r=(mklist ($ldw m 1)) arr=($ldw r 2) j=0
  (for e used k=($ldw ent ($fadd ($fadd e e) 1))
    (? (! ($eqp k UNDEF))
       (: pa=($new 3 2 2) ($stw pa 1 k) ($stw pa 2 ($ldw ent ($fadd ($fadd e e) 2)))
          pl=($new 2 3 3) ($stw pl 1 2) ($stw pl 2 pa)
          j=($fadd j 1) ($stw arr j pl))))
  ($stw r 1 j) r)
(= (mapkeys m) ent=($ldw m 2) used=($ldw m 4) r=(mklist ($ldw m 1)) arr=($ldw r 2) j=0
  (for e used k=($ldw ent ($fadd ($fadd e e) 1)) (? (! ($eqp k UNDEF)) (: j=($fadd j 1) ($stw arr j k))))
  ($stw r 1 j) r)
(= (mapvals m) ent=($ldw m 2) used=($ldw m 4) r=(mklist ($ldw m 1)) arr=($ldw r 2) j=0
  (for e used k=($ldw ent ($fadd ($fadd e e) 1)) (? (! ($eqp k UNDEF)) (: j=($fadd j 1) ($stw arr j ($ldw ent ($fadd ($fadd e e) 2))))))
  ($stw r 1 j) r)
(= (mapeq a b) n=($ldw a 1)
  (? (!= n ($ldw b 1)) false
     (: ent=($ldw a 2) used=($ldw a 4) ok=true e=0
        (wh (&& ok e<used)
          k=($ldw ent 2*e+1)
          (? (! ($eqp k UNDEF))
             (: j=(mapfind b k) (? (|| j<0 (! (eq2 ($ldw ent 2*e+2) ($ldw ($ldw b 2) 2*j+2)))) ok=false)))
          e+=1)
        ok)))
(= (maplit ..a)                   ; {:k v ..} with 1..8 distinct string keys: the rest list's array [k v k v ..] is the entry array as it is
  n=#a m=($new 4 5 5) ($stw m 1 n/2) ($stw m 2 ($ldw a 2)) ($stw m 4 n/2) m)
(= (map ..a) n=#a/2 cap=4 (wh cap<n cap*=2) m=(mapnew cap) i=0
  (wh i<#a (mapset m (lget a i) (lget a i+1)) i+=2) m)

; field access with a literal key: k is the static key string, h its hash (computed by the compiler), site the address of the call site's inline cache
; (compiled code first tries the cached entry; here, on a miss, the entry found is remembered: the cache holds the byte offset of its value slot)
(= (dotc o k h site)
  (? ($ismap o)
     (: e=($mapfind_s o k h) (? e<0 nil ($ldw ($ldw o 2) ($fadd ($fadd e e) 2))))
     (dot o k)))
(= (setdotc o k h v site)
  (? ($ismap o)
     (: e=($mapfind_s o k h) (? e<0 (mapset o k v) (: ($stw ($ldw o 2) ($fadd ($fadd e e) 2) v) v)))
     (setdot o k v)))
