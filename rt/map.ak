; Native runtime part 3: insertion-ordered hash maps (like JS Map: numbers/strings by value, everything else by identity).
;   MAP: [hdr][count][entries ARR: k,v interleaved][index ARR: open addressing, entry index or nil][used (incl. tombstones)][hash id]
;   deleted entries keep their slot with key UNDEF until the next rehash.
HID=0
(= (hashid o slot) h=($ldw o slot) (? ($isnil h) (: (<- HID HID+1) h=HID ($stw o slot h))) h)
(= (hashstr s) ($strhash s))
(= (hashof k)
  (? ($isnum k)
       (? (== k 0) 0
          (&& (< -2147483649 k) (< k 2147483648) (== k ($ffloor k))) ($band k 2147483647)
          (: hi=($bitshi k) lo=($bitslo k) ($band ($bxor ($bxor hi ($ushr hi 12)) ($bxor lo ($ushr lo 15))) 2147483647)))
     (! ($isptr k)) (? ($isnil k) 1 ($eqp k true) 2 3)
     (: t=($type k) (? (|| t==1 t==7) (hashstr k) t==2 (hashid k 3) t==4 (hashid k 5) t==10 (hashstr (bigstr k)) 5))))
(= (keyeq a b)     ; a: stored key, b: probe key
  (? ($eqp a b) true
     ($isnum a) (&& ($isnum b) (== a b))
     (! ($isptr a)) ($eqp a b)
     (! ($isptr b)) false
     ($isstr a) ($streq a b)
     (isbig a) (&& (isbig b) (== (bigcmp a b) 0))
     ($eqp a b)))
(= (mapnew cap)
  m=($new 4 5 5) ($stw m 1 0) ($stw m 2 ($new 3 cap*2 cap*2)) ($stw m 3 ($new 3 cap*2 cap*2)) ($stw m 4 0) m)
(= (mapfind m k)
  idx=($ldw m 3) ent=($ldw m 2) mask=($hlen idx)-1 i=($band (hashof k) mask) e=($ldw idx i+1)
  (wh (&& (! ($isnil e)) (! (keyeq ($ldw ent 2*e+1) k))) i=($band i+1 mask) e=($ldw idx i+1))
  (? ($isnil e) -1 e))
(= (mapget m k) e=(mapfind m k) (? e<0 nil ($ldw ($ldw m 2) 2*e+2)))
(= (maphas m k) (>= (mapfind m k) 0))
(= (maprehash m)
  live=($ldw m 1) oldent=($ldw m 2) used=($ldw m 4) oldcap=($hlen oldent)/2
  cap=(? live*2>=oldcap oldcap*2 oldcap)
  ent=($new 3 cap*2 cap*2) idx=($new 3 cap*2 cap*2) mask=cap*2-1 j=0
  (for e used
    k=($ldw oldent 2*e+1)
    (? (! ($eqp k UNDEF))
       (: ($stw ent 2*j+1 k) ($stw ent 2*j+2 ($ldw oldent 2*e+2))
          i=($band (hashof k) mask)
          (wh (! ($isnil ($ldw idx i+1))) i=($band i+1 mask))
          ($stw idx i+1 j) j+=1)))
  ($stw m 2 ent) ($stw m 3 idx) ($stw m 4 j) m)
(= (mapset m k v)
  e=(mapfind m k)
  (? e>=0 ($stw ($ldw m 2) 2*e+2 v)
     (: used=($ldw m 4) ent=($ldw m 2)
        (? 2*used>=($hlen ent) (: (maprehash m) used=($ldw m 4) ent=($ldw m 2)))
        ($stw ent 2*used+1 k) ($stw ent 2*used+2 v)
        idx=($ldw m 3) mask=($hlen idx)-1 i=($band (hashof k) mask)
        (wh (! ($isnil ($ldw idx i+1))) i=($band i+1 mask))
        ($stw idx i+1 used)
        ($stw m 4 used+1) ($stw m 1 ($ldw m 1)+1) v)))
(= (mapdel m k) e=(mapfind m k)
  (? e>=0 (: ent=($ldw m 2) ($stw ent 2*e+1 UNDEF) ($stw ent 2*e+2 nil) ($stw m 1 ($ldw m 1)-1) true) false))
(= (mapcopy m)
  ent=($ldw m 2) idx=($ldw m 3) r=($new 4 5 5)
  ($stw r 1 ($ldw m 1)) ($stw r 4 ($ldw m 4))
  e2=($new 3 ($hlen ent) ($hlen ent)) ($copy e2 0 ent 0 ($hlen ent)*8)
  i2=($new 3 ($hlen idx) ($hlen idx)) ($copy i2 0 idx 0 ($hlen idx)*8)
  ($stw r 2 e2) ($stw r 3 i2) r)
(= (mapentries m) ent=($ldw m 2) used=($ldw m 4) r=(mklist ($ldw m 1))
  (for e used k=($ldw ent 2*e+1) (? (! ($eqp k UNDEF)) (lpush r (list k ($ldw ent 2*e+2))))) r)
(= (mapkeys m) ent=($ldw m 2) used=($ldw m 4) r=(mklist ($ldw m 1))
  (for e used k=($ldw ent 2*e+1) (? (! ($eqp k UNDEF)) (lpush r k))) r)
(= (mapvals m) ent=($ldw m 2) used=($ldw m 4) r=(mklist ($ldw m 1))
  (for e used k=($ldw ent 2*e+1) (? (! ($eqp k UNDEF)) (lpush r ($ldw ent 2*e+2)))) r)
(= (mapeq a b) n=($ldw a 1)
  (? (!= n ($ldw b 1)) false
     (: ent=($ldw a 2) used=($ldw a 4) ok=true e=0
        (wh (&& ok e<used)
          k=($ldw ent 2*e+1)
          (? (! ($eqp k UNDEF))
             (: j=(mapfind b k) (? (|| j<0 (! (eq2 ($ldw ent 2*e+2) ($ldw ($ldw b 2) 2*j+2)))) ok=false)))
          e+=1)
        ok)))
(= (map ..a) n=#a/2 cap=4 (wh cap<n cap*=2) m=(mapnew cap) i=0
  (wh i<#a (mapset m (lget a i) (lget a i+1)) i+=2) m)

; field access with a literal key: k is the static key string, h its hash (computed by the compiler)
(= (dotc o k h)
  (? ($ismap o)
     (: idx=($ldw o 3) ent=($ldw o 2) mask=($hlen idx)-1 i=($band h mask) e=($ldw idx i+1) r=nil
        (wh (! ($isnil e))
          ek=($ldw ent 2*e+1)
          (? (|| ($eqp ek k) (&& ($isstr ek) ($streq ek k))) (: r=($ldw ent 2*e+2) e=nil)
             (: i=($band i+1 mask) e=($ldw idx i+1))))
        r)
     (dot o k)))
(= (setdotc o k h v)
  (? ($ismap o)
     (: idx=($ldw o 3) ent=($ldw o 2) mask=($hlen idx)-1 i=($band h mask) e=($ldw idx i+1) found=false
        (wh (! ($isnil e))
          ek=($ldw ent 2*e+1)
          (? (|| ($eqp ek k) (&& ($isstr ek) ($streq ek k))) (: ($stw ent 2*e+2 v) found=true e=nil)
             (: i=($band i+1 mask) e=($ldw idx i+1))))
        (? found v (mapset o k v)))
     (setdot o k v)))
