(wr "/tmp/ak_demo.txt" "alpha 10\nbeta 20\ngamma 30\n")
rows=(~ l=>(split l) (split (trim (rd "/tmp/ak_demo.txt")) "\n"))
(p "total" (sum (~ r=>(num r[1]) rows)))
(p (trim (sh "echo from-subprocess")))
(p (match (re "(\\w+)@(\\w+)\\.com") "mail bob@acme.com now"))
(p (has [1 2 2 3] 2) #{})
(p (json {:ok true :xs [1 2 3]} 0))
(use "../lib/httpd.aklang" as s)
(use "../lib/http.aklang" as h)
srv=(s.listen 0 rq=>(json {:path rq.path :n 1+2}))
(s.spawn ()=>(: res=(h.get (++ "http://127.0.0.1:" (tcpp srv) "/hi")) body=(unjson res.body) (p "server said" body[:path] body[:n]) (exit 0)))
s.run()
