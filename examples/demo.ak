(= (fib n a b) (? n==0 a (fib n-1 b a+b)))
(p "fib 50 =" (fib 50 0 1))
(p (~ x=>x*x (~? x=>0==x%2 1..11)))
db={:a 1 :b 2}
(for k (keys db) (p k db[k]))
(p (let (x 3 y x*2) x+y))
(= (sum_all ..xs) (sum xs))
(p (sum_all 1 2 3 4))
(p (try 1/0 e=>(++ "caught: " e)))
(= (is_ev n) (? n==0 true (is_od n-1)))
(= (is_od n) (? n==0 false (is_ev n-1)))
(p (is_ev 3000000))
path=(req "path")
(p (sw 3 1 "one" [2 3] "few" "many"))
(p Math.max(1 9 4) "abc".toUpperCase() path.basename("/a/b.txt"))
(p (in) (in) (in))
(aw (delay 5))
(p "done" #(args))
