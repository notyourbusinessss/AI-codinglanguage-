; An HTTP server on lib/httpd.aklang (native only): `ak examples/httpd_async.aklang [port]`.
; One task per connection; /slow waits 2 seconds without holding up the other connections.
(use "../lib/httpd.aklang" as s)
(use "../lib/async.aklang" as a)
(= (slow rq) (a.sleep 2000) "slow, but not blocking")
h=(s.router [["GET" "/" (\ (rq) "hello from Ak")]
             ["GET" "/slow" slow]
             ["GET" "/echo/*" (\ (rq) rq.params.rest)]])
l=(s.listen (num (?? (fst (args)) 8080)) h)
(p "listening on" (tcpp l))
s.run()
